# HippOS Raspberry Pi 4 kernel configuration — PLACEHOLDER
#
# Generate a real config from mainline kernel source:
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- bcm2711_defconfig
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- menuconfig
#   cp .config ${REPO_ROOT}/config/kernel/rpi4.config
#
# Without a proper config, build-kernel.sh produces a generic arm64 kernel
# (all defaults) that will NOT boot on Raspberry Pi 4 hardware.
