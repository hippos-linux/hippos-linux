+bool MainWindow::NetPlayHostAndStart(const std::string& path)
+{
+  const UICommon::GameFile game(path);
+  if (!game.IsValid())
+  {
+    ModalMessageBox::critical(nullptr, tr("Error"),
+                              tr("%1 is not a valid game.").arg(QString::fromStdString(path)));
+    return false;
+  }
+
+  m_netplay_dialog->StartWhenAnotherPlayerHasTheGame();
+  return NetPlayHost(game);
+}
