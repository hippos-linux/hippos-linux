#!/bin/bash
set -euo pipefail

STEAM_DEB_URL="https://repo.steampowered.com/steam/archive/stable/steam_latest.deb"
WRAPPER="/usr/local/bin/steam"
BOOTSTRAP="/usr/lib/steam/bootstraplinux_ubuntu12_32.tar.xz"

ARMHF_DEPS=(
    libnss3:armhf libnm0:armhf libdbus-glib-1-2:armhf libnspr4:armhf
    libgudev-1.0-0:armhf libxtst6:armhf libsm6:armhf libice6:armhf libusb-1.0-0:armhf
    libnss3 libnm0 libdbus-glib-1-2 libudev1 libnspr4 libgudev-1.0-0
    libxtst6 libsm6 libice6 libusb-1.0-0
)

install_steam() {
    apt-get update -qq
    apt-get install -y --no-install-recommends "${ARMHF_DEPS[@]}"

    for conflict in steamlink steam-devices; do
        dpkg -s "${conflict}" >/dev/null 2>&1 && apt-get purge -y "${conflict}" || true
    done

    local tmp deb
    tmp="$(mktemp -d)"
    trap 'rm -rf "${tmp}"' RETURN
    curl -fsSL "${STEAM_DEB_URL}" -o "${tmp}/steam.deb"
    dpkg-deb -R "${tmp}/steam.deb" "${tmp}/steam"
    sed -i 's/^Architecture: amd64/Architecture: all/' "${tmp}/steam/DEBIAN/control"
    dpkg-deb -b "${tmp}/steam" "${tmp}/steam-all.deb"
    apt-get install -y "${tmp}/steam-all.deb"

    install -Dm755 /dev/stdin "${WRAPPER}" <<'WRAP'
#!/bin/bash
export STEAMOS=1
export STEAM_RUNTIME=1
export DBUS_FATAL_WARNINGS=0
BOX64_EMULATED_LIBS=libmpg123.so.0 exec /usr/lib/steam/bin_steam.sh -no-cef-sandbox "$@"
WRAP

    if [[ -f "${BOOTSTRAP}" ]]; then
        local bt
        bt="$(mktemp -d)"
        tar -xf "${BOOTSTRAP}" -C "${bt}"
        rm -f "${bt}/ubuntu12_32/crashhandler.so"
        tar -cJf "${BOOTSTRAP}" -C "${bt}" .
        rm -rf "${bt}"
    fi
}

remove_steam() {
    rm -f "${WRAPPER}"
    dpkg -s steam-launcher >/dev/null 2>&1 && apt-get purge -y steam-launcher || true
}

case "${1:-install}" in
    install) install_steam ;;
    remove)  remove_steam ;;
    *) echo "usage: steam install|remove" >&2; exit 2 ;;
esac
