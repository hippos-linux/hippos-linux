#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

. /scripts/functions

kmsg() { echo "hippos-overlay: $*" > /dev/kmsg 2>/dev/null || true; }

BTRFS_MNT="/run/hippos-btrfs"

kmsg "starting (rootmnt=${rootmnt})"

modprobe overlay 2>/dev/null || true

# Bounded wait for device enumeration before the label lookup below — without
# it, a not-yet-settled boot (slow USB enumeration, or a udev remove/re-add
# right after hippos-grow-userdata's blockdev --rereadpt on a previous boot)
# falls through to "booting without overlay" and pushes the mount onto the
# racier systemd/fstab path instead.
udevadm settle --timeout=5 2>/dev/null || true

MAIN_DEV="$(blkid -L HippOS 2>/dev/null)"
if [ -z "${MAIN_DEV}" ]; then
    kmsg "HippOS partition not found — booting without overlay"
    exit 0
fi
kmsg "main device: ${MAIN_DEV}"

mkdir -p "${BTRFS_MNT}"
if ! mount -t btrfs -o subvolid=5,noatime,commit=5,compress=zstd:1 "${MAIN_DEV}" "${BTRFS_MNT}"; then
    kmsg "failed to mount HippOS btrfs top-level — booting without overlay"
    exit 0
fi
kmsg "HippOS btrfs top-level mounted at ${BTRFS_MNT}"

# Determine which rootfs subvol to use from the kernel cmdline.
ROOT_SUBVOL="@rootfs"
for _param in $(cat /proc/cmdline); do
    case "$_param" in
        rootflags=*subvol=*)
            _sv="${_param##*subvol=}"
            ROOT_SUBVOL="${_sv%%,*}"
            ;;
    esac
done
kmsg "rootfs subvol: ${ROOT_SUBVOL}"

if [ ! -d "${BTRFS_MNT}/${ROOT_SUBVOL}" ] || [ ! -d "${BTRFS_MNT}/@overlay" ]; then
    kmsg "required subvolumes missing — booting without overlay"
    umount "${BTRFS_MNT}"
    exit 0
fi

UPPER="${BTRFS_MNT}/@overlay/upper"
WORK="${BTRFS_MNT}/@overlay/work"
mkdir -p "${UPPER}" "${WORK}"

# Overlayfs reports the mounted root's own metadata (uid/gid/mode) straight
# from upperdir's directory entry, unconditionally, from the first mount
# onward — mkdir -p above only sets this on first creation and never touches
# it again. upperdir persists on disk across every boot, so anything that
# ever chowns/chmods live "/" (a stray `sudo chown -R $USER: /` typo is the
# classic way) bakes that into the merged root permanently, surviving every
# future boot with no way to self-correct. Force it back to root:root/0755
# unconditionally on every boot, before the overlay is mounted — cheap and a
# no-op when it's already correct.
chown 0:0 "${UPPER}"
chmod 0755 "${UPPER}"

# Apt installs land in the upper layer, and so do copied-up dpkg/apt state and
# /etc/ld.so.cache. After an OS update those copies would hide the new image's
# own (including its apt holds), so on the first boot of a different deployment
# drop them, together with the installed files, and leave
# hippos-apt-restore.service a flag to reinstall the user's packages.
# /usr/local, /etc and /opt are kept.
# Without a marker (a system from before this check) the previous deployment
# is unknown, but a dpkg status copied up before this image was built is stale.
# The old status and apt marks are kept for hippos-apt-packages, which has no
# recorded package list on such a system.
DEPLOYMENT_MARKER="${BTRFS_MNT}/@overlay/deployment"
UPPER_STATUS="${UPPER}/var/lib/dpkg/status"
STALE=""
if [ -f "${DEPLOYMENT_MARKER}" ]; then
    [ "$(cat "${DEPLOYMENT_MARKER}")" != "${ROOT_SUBVOL}" ] && STALE="deployment changed to ${ROOT_SUBVOL}"
elif [ -f "${UPPER_STATUS}" ] && [ "${UPPER_STATUS}" -ot "${BTRFS_MNT}/${ROOT_SUBVOL}/var/lib/dpkg/status" ]; then
    STALE="dpkg status predates ${ROOT_SUBVOL}"
fi
if [ -n "${STALE}" ]; then
    kmsg "${STALE} — clearing package state from the overlay"
    mkdir -p "${UPPER}/var/lib/hippos"
    [ -f "${UPPER_STATUS}" ] && cp "${UPPER_STATUS}" "${UPPER}/var/lib/hippos/pre-update-dpkg-status"
    [ -f "${UPPER}/var/lib/apt/extended_states" ] && \
        cp "${UPPER}/var/lib/apt/extended_states" "${UPPER}/var/lib/hippos/pre-update-apt-extended-states"
    for _entry in "${UPPER}/usr/"* "${UPPER}/usr/".[!.]*; do
        [ -e "${_entry}" ] || [ -L "${_entry}" ] || continue
        [ "${_entry}" = "${UPPER}/usr/local" ] && continue
        rm -rf "${_entry}"
    done
    rm -rf "${UPPER}/var/lib/dpkg" "${UPPER}/var/lib/apt" "${UPPER}/var/cache/apt" \
           "${UPPER}/etc/ld.so.cache" "${UPPER}/etc/alternatives"
    : > "${UPPER}/var/lib/hippos/apt-restore-pending"
fi
echo "${ROOT_SUBVOL}" > "${DEPLOYMENT_MARKER}"

OVERLAY_OPTS="lowerdir=${BTRFS_MNT}/${ROOT_SUBVOL},upperdir=${UPPER},workdir=${WORK}"
if ! mount -t overlay -o "${OVERLAY_OPTS}" overlay "${rootmnt}"; then
    kmsg "overlay mount failed"
    umount "${BTRFS_MNT}"
    exit 0
fi
kmsg "overlay mounted at ${rootmnt}"

mkdir -p "${rootmnt}/userdata"
if ! mount -t btrfs -o subvol=@userdata,noatime,commit=5,compress=zstd:1 "${MAIN_DEV}" "${rootmnt}/userdata"; then
    kmsg "userdata mount failed — systemd will mount it from fstab"
fi

kmsg "done"
