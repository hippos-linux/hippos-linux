#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

. /scripts/functions

kmsg() { echo "hippos-overlay: $*" > /dev/kmsg 2>/dev/null || true; }

BTRFS_MNT="/run/hippos-btrfs"

kmsg "starting (rootmnt=${rootmnt})"

modprobe overlay 2>/dev/null || true

udevadm settle --timeout=5 2>/dev/null || true

MAIN_DEV="$(blkid -L HippOS 2>/dev/null)"
if [ -z "${MAIN_DEV}" ]; then
    kmsg "HippOS partition not found — booting without overlay"
    exit 0
fi
kmsg "main device: ${MAIN_DEV}"

mkdir -p "${BTRFS_MNT}"
if ! mount -t btrfs -o subvolid=5,noatime "${MAIN_DEV}" "${BTRFS_MNT}"; then
    kmsg "failed to mount HippOS btrfs top-level — booting without overlay"
    exit 0
fi
mount -o remount,compress=zstd:1 "${BTRFS_MNT}" || kmsg "could not turn on btrfs compression"
kmsg "HippOS btrfs top-level mounted at ${BTRFS_MNT}"

ROOT_SUBVOL="@rootfs"
for _param in $(cat /proc/cmdline); do
    case "$_param" in
        rootflags=*subvol=*)
            _sv="${_param##*subvol=}"
            ROOT_SUBVOL="${_sv%%,*}"
            ;;
    esac
done
kmsg "rootfs subvol: ${ROOT_SUBVOL}"

if [ ! -d "${BTRFS_MNT}/${ROOT_SUBVOL}" ] || [ ! -d "${BTRFS_MNT}/@overlay" ]; then
    kmsg "required subvolumes missing — booting without overlay"
    umount "${BTRFS_MNT}"
    exit 0
fi

UPPER="${BTRFS_MNT}/@overlay/upper"
WORK="${BTRFS_MNT}/@overlay/work"
mkdir -p "${UPPER}" "${WORK}"

chown 0:0 "${UPPER}"
chmod 0755 "${UPPER}"

AWK_UNION='function union(a, b,    list, n, i, seen, out) {
    n = split(a "," b, list, ",")
    for (i = 1; i <= n; i++)
        if (list[i] != "" && !(list[i] in seen)) {
            seen[list[i]] = 1
            out = out (out == "" ? "" : ",") list[i]
        }
    return out
}'

replace_upper_etc() {
    cat "${UPPER}/etc/$1.new" > "${UPPER}/etc/$1"
    rm -f "${UPPER}/etc/$1.new"
}

merge_ids() {
    [ -s "${UPPER}/etc/$1" ] || return 0
    awk -F: -v OFS=: -v is_group="$([ "$1" = group ] && echo 1)" "${AWK_UNION}"'
        FNR == NR { upper[$1] = $0; order[++n] = $1; next }
        {
            in_image[$1] = 1; id_used[$3] = 1
            if (is_group && ($1 in upper)) { split(upper[$1], u, ":"); $4 = union($4, u[4]) }
            print
        }
        END {
            for (i = 1; i <= n; i++) {
                split(upper[order[i]], u, ":")
                if (!(order[i] in in_image) && !(u[3] in id_used)) print upper[order[i]]
            }
        }' "${UPPER}/etc/$1" "${BTRFS_MNT}/${ROOT_SUBVOL}/etc/$1" > "${UPPER}/etc/$1.new"
    replace_upper_etc "$1"
}

merge_secrets() {
    [ -s "${UPPER}/etc/$1" ] || return 0
    awk -F: -v OFS=: -v is_gshadow="$([ "$1" = gshadow ] && echo 1)" \
        -v accounts="${UPPER}/etc/$2" -v upper_file="${UPPER}/etc/$1" "${AWK_UNION}"'
        FILENAME == accounts { kept[$1] = 1; next }
        FILENAME == upper_file { upper[$1] = $0; order[++n] = $1; next }
        {
            in_image[$1] = 1
            if (!($1 in upper)) { print; next }
            if (!is_gshadow) { print upper[$1]; next }
            split(upper[$1], u, ":"); $2 = u[2]; $3 = u[3]; $4 = union($4, u[4])
            print
        }
        END {
            for (i = 1; i <= n; i++)
                if (!(order[i] in in_image) && (order[i] in kept)) print upper[order[i]]
        }' "${UPPER}/etc/$2" "${UPPER}/etc/$1" "${BTRFS_MNT}/${ROOT_SUBVOL}/etc/$1" > "${UPPER}/etc/$1.new"
    replace_upper_etc "$1"
}

merge_accounts() {
    merge_ids passwd
    merge_secrets shadow passwd
    merge_ids group
    merge_secrets gshadow group
}

UPPER_PATH_AWK='
function upper_path(path) {
    if (path ~ /^\/usr\/local\//) return ""
    if (path ~ /^\/(bin|sbin|lib|lib32|lib64|libx32)\//) return upper "/usr" path
    if (path ~ /^\/(usr|opt)\//) return upper path
    return ""
}'
upper_system_entries() {
    find "${UPPER}/usr" "${UPPER}/opt" -path "${UPPER}/usr/local" -prune -o -type "$1" -print 2>/dev/null
}
remove_package_files() {
    _scratch="${UPPER}/var/lib/hippos"
    mkdir -p "${_scratch}"
    upper_system_entries f > "${_scratch}/upper-files"
    cat "${UPPER}"/var/lib/dpkg/info/*.md5sums 2>/dev/null | awk -v upper="${UPPER}" "${UPPER_PATH_AWK}"'
        NR == FNR { present[$0]; next }
        { entry = upper_path("/" substr($0, index($0, "  ") + 2)); if (entry in present) print $1 "  " entry }
    ' "${_scratch}/upper-files" - > "${_scratch}/upper-package-sums"
    md5sum -c "${_scratch}/upper-package-sums" 2>/dev/null | sed -n 's/: OK$//p' | tr '\n' '\0' | xargs -0 -r rm -f
    upper_system_entries l > "${_scratch}/upper-links"
    cat "${UPPER}"/var/lib/dpkg/info/*.list 2>/dev/null | awk -v upper="${UPPER}" "${UPPER_PATH_AWK}"'
        NR == FNR { present[$0]; next }
        { entry = upper_path($0); if (entry in present) print entry }
    ' "${_scratch}/upper-links" - | tr '\n' '\0' | xargs -0 -r rm -f
    rm -f "${_scratch}/upper-files" "${_scratch}/upper-package-sums" "${_scratch}/upper-links"
    return 0
}
move_shadowing_files() {
    [ -d "${UPPER}/usr" ] || return 0
    _backup="system/backups/overlay-${DEPLOYMENT}"
    find "${UPPER}/usr" -path "${UPPER}/usr/local" -prune -o ! -type d -print | while IFS= read -r _entry; do
        _rel="${_entry#"${UPPER}"}"
        if [ -c "${_entry}" ]; then
            rm -f "${_entry}"
        elif [ -f "${_entry}" ] && [ ! -L "${_entry}" ] && cmp -s "${_entry}" "${LOWER}${_rel}"; then
            rm -f "${_entry}"
        elif [ -L "${_entry}" ] && [ -L "${LOWER}${_rel}" ] && \
             [ "$(readlink "${_entry}")" = "$(readlink "${LOWER}${_rel}")" ]; then
            rm -f "${_entry}"
        elif [ -e "${LOWER}${_rel}" ] || [ -L "${LOWER}${_rel}" ]; then
            mkdir -p "${BTRFS_MNT}/@userdata/${_backup}${_rel%/*}"
            mv -f "${_entry}" "${BTRFS_MNT}/@userdata/${_backup}${_rel}" && kmsg "${_rel} moved to /userdata/${_backup}"
        fi
    done
    find "${UPPER}/usr" -depth -mindepth 1 -type d ! -path "${UPPER}/usr/local" ! -path "${UPPER}/usr/local/*" \
        -exec rmdir {} + 2>/dev/null
    return 0
}

LOWER="${BTRFS_MNT}/${ROOT_SUBVOL}"
DEPLOYMENT_MARKER="${BTRFS_MNT}/@overlay/deployment"
DEPLOYMENT="$(sed -n 's/^BUILD_ID=//p' "${LOWER}/etc/hippos-version" 2>/dev/null)"
UPPER_STATUS="${UPPER}/var/lib/dpkg/status"
STALE=""
if [ -f "${DEPLOYMENT_MARKER}" ]; then
    [ "$(cat "${DEPLOYMENT_MARKER}")" != "${DEPLOYMENT}" ] && STALE="deployment changed to ${DEPLOYMENT}"
elif [ -f "${UPPER_STATUS}" ] && [ "${UPPER_STATUS}" -ot "${LOWER}/var/lib/dpkg/status" ]; then
    STALE="dpkg status predates ${ROOT_SUBVOL}"
fi
if [ -n "${STALE}" ]; then
    kmsg "${STALE} — clearing package state from the overlay"
    mkdir -p "${UPPER}/var/lib/hippos"
    [ -f "${UPPER_STATUS}" ] && cp "${UPPER_STATUS}" "${UPPER}/var/lib/hippos/pre-update-dpkg-status"
    [ -f "${UPPER}/var/lib/apt/extended_states" ] && \
        cp "${UPPER}/var/lib/apt/extended_states" "${UPPER}/var/lib/hippos/pre-update-apt-extended-states"
    remove_package_files
    move_shadowing_files
    if [ -d "${BTRFS_MNT}/@userdata/system/backups/overlay-${DEPLOYMENT}" ]; then
        mkdir -p "${UPPER}/var/lib/hippos"
        printf '%s\n' "${DEPLOYMENT}" > "${UPPER}/var/lib/hippos/overlay-backup-pending"
        kmsg "overlay backup pending notification written for ${DEPLOYMENT}"
    fi
    rm -rf "${UPPER}/var/lib/dpkg" "${UPPER}/var/lib/apt" "${UPPER}/var/cache/apt" \
           "${UPPER}/etc/ld.so.cache" "${UPPER}/etc/alternatives"
    : > "${UPPER}/var/lib/hippos/apt-restore-pending"
    merge_accounts
    kmsg "account files merged with ${ROOT_SUBVOL}'s"
fi
echo "${DEPLOYMENT}" > "${DEPLOYMENT_MARKER}"

OVERLAY_OPTS="lowerdir=${BTRFS_MNT}/${ROOT_SUBVOL},upperdir=${UPPER},workdir=${WORK}"
if ! mount -t overlay -o "${OVERLAY_OPTS}" overlay "${rootmnt}"; then
    kmsg "overlay mount failed"
    umount "${BTRFS_MNT}"
    exit 0
fi
kmsg "overlay mounted at ${rootmnt}"

mkdir -p "${rootmnt}/userdata"
if ! mount -t btrfs -o subvol=@userdata,noatime "${MAIN_DEV}" "${rootmnt}/userdata"; then
    kmsg "userdata mount failed — systemd will mount it from fstab"
fi

kmsg "done"
