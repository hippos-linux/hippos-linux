#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

. /scripts/functions

kmsg() { echo "hippos-overlay: $*" > /dev/kmsg 2>/dev/null || true; }

BTRFS_MNT="/run/hippos-btrfs"

kmsg "starting (rootmnt=${rootmnt})"

modprobe overlay 2>/dev/null || true

udevadm settle --timeout=5 2>/dev/null || true

MAIN_DEV="$(blkid -L HippOS 2>/dev/null)"
if [ -z "${MAIN_DEV}" ]; then
    kmsg "HippOS partition not found — booting without overlay"
    exit 0
fi
kmsg "main device: ${MAIN_DEV}"

mkdir -p "${BTRFS_MNT}"
if ! mount -t btrfs -o subvolid=5,noatime,commit=5,compress=zstd:1 "${MAIN_DEV}" "${BTRFS_MNT}"; then
    kmsg "failed to mount HippOS btrfs top-level — booting without overlay"
    exit 0
fi
kmsg "HippOS btrfs top-level mounted at ${BTRFS_MNT}"

ROOT_SUBVOL="@rootfs"
for _param in $(cat /proc/cmdline); do
    case "$_param" in
        rootflags=*subvol=*)
            _sv="${_param##*subvol=}"
            ROOT_SUBVOL="${_sv%%,*}"
            ;;
    esac
done
kmsg "rootfs subvol: ${ROOT_SUBVOL}"

if [ ! -d "${BTRFS_MNT}/${ROOT_SUBVOL}" ] || [ ! -d "${BTRFS_MNT}/@overlay" ]; then
    kmsg "required subvolumes missing — booting without overlay"
    umount "${BTRFS_MNT}"
    exit 0
fi

UPPER="${BTRFS_MNT}/@overlay/upper"
WORK="${BTRFS_MNT}/@overlay/work"
mkdir -p "${UPPER}" "${WORK}"

chown 0:0 "${UPPER}"
chmod 0755 "${UPPER}"

AWK_UNION='function union(a, b,    list, n, i, seen, out) {
    n = split(a "," b, list, ",")
    for (i = 1; i <= n; i++)
        if (list[i] != "" && !(list[i] in seen)) {
            seen[list[i]] = 1
            out = out (out == "" ? "" : ",") list[i]
        }
    return out
}'

replace_upper_etc() {
    cat "${UPPER}/etc/$1.new" > "${UPPER}/etc/$1"
    rm -f "${UPPER}/etc/$1.new"
}

merge_ids() {
    [ -s "${UPPER}/etc/$1" ] || return 0
    awk -F: -v OFS=: -v is_group="$([ "$1" = group ] && echo 1)" "${AWK_UNION}"'
        FNR == NR { upper[$1] = $0; order[++n] = $1; next }
        {
            in_image[$1] = 1; id_used[$3] = 1
            if (is_group && ($1 in upper)) { split(upper[$1], u, ":"); $4 = union($4, u[4]) }
            print
        }
        END {
            for (i = 1; i <= n; i++) {
                split(upper[order[i]], u, ":")
                if (!(order[i] in in_image) && !(u[3] in id_used)) print upper[order[i]]
            }
        }' "${UPPER}/etc/$1" "${BTRFS_MNT}/${ROOT_SUBVOL}/etc/$1" > "${UPPER}/etc/$1.new"
    replace_upper_etc "$1"
}

merge_secrets() {
    [ -s "${UPPER}/etc/$1" ] || return 0
    awk -F: -v OFS=: -v is_gshadow="$([ "$1" = gshadow ] && echo 1)" \
        -v accounts="${UPPER}/etc/$2" -v upper_file="${UPPER}/etc/$1" "${AWK_UNION}"'
        FILENAME == accounts { kept[$1] = 1; next }
        FILENAME == upper_file { upper[$1] = $0; order[++n] = $1; next }
        {
            in_image[$1] = 1
            if (!($1 in upper)) { print; next }
            if (!is_gshadow) { print upper[$1]; next }
            split(upper[$1], u, ":"); $2 = u[2]; $3 = u[3]; $4 = union($4, u[4])
            print
        }
        END {
            for (i = 1; i <= n; i++)
                if (!(order[i] in in_image) && (order[i] in kept)) print upper[order[i]]
        }' "${UPPER}/etc/$2" "${UPPER}/etc/$1" "${BTRFS_MNT}/${ROOT_SUBVOL}/etc/$1" > "${UPPER}/etc/$1.new"
    replace_upper_etc "$1"
}

merge_accounts() {
    merge_ids passwd
    merge_secrets shadow passwd
    merge_ids group
    merge_secrets gshadow group
}

DEPLOYMENT_MARKER="${BTRFS_MNT}/@overlay/deployment"
DEPLOYMENT="$(sed -n 's/^BUILD_ID=//p' "${BTRFS_MNT}/${ROOT_SUBVOL}/etc/hippos-version" 2>/dev/null)"
UPPER_STATUS="${UPPER}/var/lib/dpkg/status"
STALE=""
if [ -f "${DEPLOYMENT_MARKER}" ]; then
    [ "$(cat "${DEPLOYMENT_MARKER}")" != "${DEPLOYMENT}" ] && STALE="deployment changed to ${DEPLOYMENT}"
elif [ -f "${UPPER_STATUS}" ] && [ "${UPPER_STATUS}" -ot "${BTRFS_MNT}/${ROOT_SUBVOL}/var/lib/dpkg/status" ]; then
    STALE="dpkg status predates ${ROOT_SUBVOL}"
fi
if [ -n "${STALE}" ]; then
    kmsg "${STALE} — clearing package state from the overlay"
    mkdir -p "${UPPER}/var/lib/hippos"
    [ -f "${UPPER_STATUS}" ] && cp "${UPPER_STATUS}" "${UPPER}/var/lib/hippos/pre-update-dpkg-status"
    [ -f "${UPPER}/var/lib/apt/extended_states" ] && \
        cp "${UPPER}/var/lib/apt/extended_states" "${UPPER}/var/lib/hippos/pre-update-apt-extended-states"
    _KEYRINGS_KEEP="${UPPER}/var/lib/hippos/keyrings.keep"
    if [ -d "${UPPER}/usr/share/keyrings" ]; then
        rm -rf "${_KEYRINGS_KEEP}"
        mv "${UPPER}/usr/share/keyrings" "${_KEYRINGS_KEEP}"
    fi
    for _entry in "${UPPER}/usr/"* "${UPPER}/usr/".[!.]*; do
        [ -e "${_entry}" ] || [ -L "${_entry}" ] || continue
        [ "${_entry}" = "${UPPER}/usr/local" ] && continue
        rm -rf "${_entry}"
    done
    if [ -d "${_KEYRINGS_KEEP}" ]; then
        mkdir -p "${UPPER}/usr/share/keyrings"
        for _key in "${_KEYRINGS_KEEP}"/*; do
            [ -f "${_key}" ] || continue
            [ -e "${BTRFS_MNT}/${ROOT_SUBVOL}/usr/share/keyrings/${_key##*/}" ] && continue
            mv "${_key}" "${UPPER}/usr/share/keyrings/"
        done
        rm -rf "${_KEYRINGS_KEEP}"
    fi
    rm -rf "${UPPER}/var/lib/dpkg" "${UPPER}/var/lib/apt" "${UPPER}/var/cache/apt" \
           "${UPPER}/etc/ld.so.cache" "${UPPER}/etc/alternatives"
    : > "${UPPER}/var/lib/hippos/apt-restore-pending"
    merge_accounts
    kmsg "account files merged with ${ROOT_SUBVOL}'s"
fi
echo "${DEPLOYMENT}" > "${DEPLOYMENT_MARKER}"

OVERLAY_OPTS="lowerdir=${BTRFS_MNT}/${ROOT_SUBVOL},upperdir=${UPPER},workdir=${WORK}"
if ! mount -t overlay -o "${OVERLAY_OPTS}" overlay "${rootmnt}"; then
    kmsg "overlay mount failed"
    umount "${BTRFS_MNT}"
    exit 0
fi
kmsg "overlay mounted at ${rootmnt}"

mkdir -p "${rootmnt}/userdata"
if ! mount -t btrfs -o subvol=@userdata,noatime,commit=5,compress=zstd:1 "${MAIN_DEV}" "${rootmnt}/userdata"; then
    kmsg "userdata mount failed — systemd will mount it from fstab"
fi

kmsg "done"
