# grub.cfg is NOT generated by grub-mkconfig/os-prober reading this file —
# HippOS writes it directly via hippos-upgrade's write_grub_cfg (invoked
# through /usr/sbin/update-grub, see hippos-select-kernel and
# hippos-update-grub.service). That generator only reads GRUB_CMDLINE_LINUX
# and GRUB_CMDLINE_LINUX_DEFAULT below for extra kernel args — GRUB_DEFAULT,
# GRUB_TIMEOUT, GRUB_TIMEOUT_STYLE, GRUB_DISABLE_SUBMENU, GRUB_DISABLE_OS_PROBER
# and the GRUB_TERMINAL/GRUB_SERIAL_COMMAND pair below are the normal Debian
# grub-mkconfig keys but are not consulted by the real generator; left as
# sensible-looking defaults for anyone who runs plain grub-mkconfig by hand,
# not because HippOS's boot path depends on them.
#
# Default kernel variant (standard|lts) is chosen by the system.kernel
# setting, read directly by write_grub_cfg — see hippos-select-kernel, which
# only decides *when* to trigger a regen, and kb/guidance/crt-support-plan.md.
# Menu visibility/timeout is likewise hardcoded in write_grub_cfg (visible,
# 5s) rather than sourced from GRUB_TIMEOUT/GRUB_TIMEOUT_STYLE here.
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="HippOS"
# systemd.default_timeout_start_sec/default_device_timeout_sec=15s used to be
# set here (2026-08), meant to turn a silently-stuck unit into a visible
# [FAILED] within 15s instead of hanging with no error, per beta reports of
# AMD APU/ACPI firmware freezes between sysinit.target and basic.target.
# Removed after a slow-USB2-flash real-hardware test (0.5.9) showed the global
# 15s bound killing perfectly healthy units instead: /boot/efi's device wait
# raced udev on the EFI PARTUUID, dbus/udisks2/logind/NetworkManager start-job
# timeouts cascaded, and hippos-xserver's start-post was killed mid NVIDIA
# driver init (crashing Xorg) on a cold hybrid-GPU boot — see
# hippos-xserver.service's ExecStartPost `timeout` wrapper for the matching
# per-unit fix. The AMD APU hang the 15s bound targeted was already reported
# as "no failing unit ever printed" even at systemd's normal 90s default,
# meaning it wasn't a timeout this knob could catch anyway. Restored to
# upstream systemd defaults (90s) globally; give a unit its own explicit
# TimeoutStartSec= if it specifically needs a shorter bound instead of
# lowering this for every service/device on the system.
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3"
# console=ttyS0,115200 used to be enabled by default here. Real-hardware
# testing found PID 1 permanently blocked in n_tty_write() writing a routine
# status message to /dev/console whenever both tty0 and ttyS0 were registered
# consoles: the manager's own IPC socket (/run/systemd/private) went
# unresponsive (systemctl/busctl calls failed with "Transport endpoint is not
# connected") even though PID 1 was alive and the socket was listening. An A/B
# boot with only console=tty0 did not reproduce this; systemctl/busctl worked
# normally and plymouth-quit(-wait) both completed. Serial console is opt-in
# diagnostic only now — pass console=ttyS0,115200 by hand (or via a dedicated
# recovery entry, if one is added) rather than by default.
GRUB_CMDLINE_LINUX="rootfstype=btrfs rw console=tty0 vt.global_cursor_default=0 nvidia-drm.modeset=1"
GRUB_DISABLE_OS_PROBER=false
GRUB_DISABLE_SUBMENU=y
GRUB_TERMINAL="console serial"
GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"
