# Extra kernel arguments for every HippOS boot entry go in
# GRUB_CMDLINE_LINUX / GRUB_CMDLINE_LINUX_DEFAULT; run `sudo update-grub` after
# editing. The default kernel (standard or LTS) is the system.kernel setting.
# The other keys here are not used by HippOS's boot menu.
# To debug over serial, add console=ttyS0,115200; remove it afterwards, as it
# can stall the boot.
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="HippOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3"
GRUB_CMDLINE_LINUX="rootfstype=btrfs rw console=tty0 vt.global_cursor_default=0 nvidia-drm.modeset=1"
GRUB_DISABLE_OS_PROBER=false
GRUB_DISABLE_SUBMENU=y
GRUB_TERMINAL="console serial"
GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"
