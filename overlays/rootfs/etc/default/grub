# grub.cfg is NOT generated by grub-mkconfig/os-prober reading this file —
# HippOS writes it directly via hippos-upgrade's write_grub_cfg (invoked
# through /usr/sbin/update-grub, see hippos-select-kernel and
# hippos-update-grub.service). That generator only reads GRUB_CMDLINE_LINUX
# and GRUB_CMDLINE_LINUX_DEFAULT below for extra kernel args — GRUB_DEFAULT,
# GRUB_TIMEOUT, GRUB_TIMEOUT_STYLE, GRUB_DISABLE_SUBMENU, GRUB_DISABLE_OS_PROBER
# and the GRUB_TERMINAL/GRUB_SERIAL_COMMAND pair below are the normal Debian
# grub-mkconfig keys but are not consulted by the real generator; left as
# sensible-looking defaults for anyone who runs plain grub-mkconfig by hand,
# not because HippOS's boot path depends on them.
#
# Default kernel variant (standard|lts) is chosen by the system.kernel
# setting, read directly by write_grub_cfg — see hippos-select-kernel, which
# only decides *when* to trigger a regen, and kb/guidance/crt-support-plan.md.
# Menu visibility/timeout is likewise hardcoded in write_grub_cfg (visible,
# 5s) rather than sourced from GRUB_TIMEOUT/GRUB_TIMEOUT_STYLE here.
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="HippOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3"
GRUB_CMDLINE_LINUX="rootfstype=btrfs rw console=tty0 console=ttyS0,115200 vt.global_cursor_default=0"
GRUB_DISABLE_OS_PROBER=false
GRUB_DISABLE_SUBMENU=y
GRUB_TERMINAL="console serial"
GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"
