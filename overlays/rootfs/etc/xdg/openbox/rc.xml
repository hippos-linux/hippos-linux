<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <desktops>
    <number>1</number>
  </desktops>
  <applications>
    <!-- Only the ES session reads this file; the desktop uses lxqt-rc.xml. So
         everything launched from ES has no title bar and fills the screen, and the
         same app stays windowed on the desktop. Dialogs keep their own size. -->
    <application class="*">
      <decor>no</decor>
    </application>
    <application class="*" type="normal">
      <fullscreen>yes</fullscreen>
    </application>
    <!-- GTK hides a fullscreen window's header bar, where Lutris's installer
         keeps its Install and Cancel buttons. -->
    <application class="Lutris">
      <fullscreen>no</fullscreen>
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
