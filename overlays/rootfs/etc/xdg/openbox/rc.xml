<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <desktops>
    <number>1</number>
  </desktops>
  <keyboard>
    <!-- Alt+Enter: switch the window between fullscreen and a maximized window
         that shows the app's own menu bar. -->
    <keybind key="A-Return">
      <action name="ToggleFullscreen"/>
      <action name="Maximize"/>
    </keybind>
  </keyboard>
  <applications>
    <application class="*">
      <decor>no</decor>
    </application>
    <application class="*" type="normal">
      <fullscreen>yes</fullscreen>
    </application>
    <application class="Lutris">
      <fullscreen>no</fullscreen>
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
