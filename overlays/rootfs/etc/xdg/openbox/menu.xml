<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="HippOS">
    <item label="Terminal">
      <action name="Execute"><command>qterminal</command></action>
    </item>
    <separator label="Session"/>
    <item label="Switch to EmulationStation">
      <action name="Execute"><command>/usr/lib/hippos/switch-to-es</command></action>
    </item>
    <separator label="System"/>
    <item label="Shutdown">
      <action name="Execute"><command>systemctl poweroff</command></action>
    </item>
    <item label="Restart">
      <action name="Execute"><command>systemctl reboot</command></action>
    </item>
  </menu>
</openbox_menu>
