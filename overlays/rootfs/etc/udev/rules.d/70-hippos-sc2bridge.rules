# HippOS: Steam Controller 2 over Bluetooth (28de:1303)
# Kernels without hid-steam support for it bind only hid-generic, which exposes
# raw HID plus keyboard/mouse fallback interfaces. hippos-sc2bridge decodes the
# raw reports into a virtual gamepad + mouse and grabs the fallback interfaces,
# so hippos-hotkeys must leave them alone. When hid-steam binds, its own gamepad
# is used and none of this applies.

KERNELS=="0005:28DE:1303.*", DRIVERS=="hid-generic", SUBSYSTEM=="hidraw", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hippos-sc2bridge@%k.service"
KERNELS=="0005:28DE:1303.*", DRIVERS=="hid-generic", SUBSYSTEM=="input", KERNEL=="event*", ENV{HIPPOS_HOTKEYS_IGNORE}="1"
