# Racing wheels: tagged so EmulationStation and the emulators treat them as wheels.
# To add a wheel, copy a line with its input device name (see `cat /proc/bus/input/devices`)
# and, if known, its full rotation in degrees.

ACTION!="add", GOTO="hippos_wheels_end"
SUBSYSTEM!="input", GOTO="hippos_wheels_end"
KERNEL!="event*", GOTO="hippos_wheels_end"

ATTRS{name}=="Thrustmaster F430 Force Feedback", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="270"
ATTRS{name}=="Driving Force GT", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="Thrustmaster Thrustmaster FFB Wheel", ENV{ID_INPUT_WHEEL}="1"
ATTRS{name}=="Thrustmaster TRS Racing wheel", ENV{ID_INPUT_WHEEL}="1"
ATTRS{name}=="G25 Racing Wheel", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="G27 Racing Wheel", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="Microsoft SideWinder Force Feedback Wheel (USB)", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="220"
ATTRS{name}=="Thrustmaster F430 Cockpit Wireless", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="270"
ATTRS{name}=="Thrustmaster F430 Cockpit Wireless PS3", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="270"
ATTRS{name}=="Thrustmaster Thrustmaster Advance Racer", ENV{ID_INPUT_WHEEL}="1"
ATTRS{name}=="Logitech G29 Driving Force Racing Wheel", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="Logitech  Logitech MOMO Racing ", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="240"
ATTRS{name}=="Thrustmaster Thrustmaster T300RS Racing wheel", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="1080"
ATTRS{name}=="Logitech Logitech Driving Force", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="200"
ATTRS{name}=="Logitech Logitech Driving Force Pro", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="Logitech G920 Driving Force Racing Wheel", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="Logitech G923 Racing Wheel for PlayStation 4 and PC", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="Logitech G923 Racing Wheel for PlayStation and PC", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="ThrustMaster, Inc. Ferrari 458 Spider", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="240"
ATTRS{name}=="Thrustmaster Thrustmaster T150RS", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="1080"
ATTRS{name}=="Thrustmaster Thrustmaster T80", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="240"
ATTRS{name}=="FGT Rumble Wheel", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="240"
ATTRS{name}=="Microsoft SideWinder Precision Racing Wheel USB version 1.0", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="270"
ATTRS{name}=="Thrustmaster Thrustmaster Racing Wheel FFB", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="Logitech  PRO Racing Wheel", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="1080"
ATTRS{name}=="Formula Vibration Feedback Wheel", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="180"
ATTRS{name}=="XBOX Game Device", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="250"
ATTRS{name}=="G920 Driving Force Racing Wheel for Xbox One", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="Logitech G923 Racing Wheel for Xbox One and PC", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="900"
ATTRS{name}=="Generic X-Box pad", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="270"
ATTRS{name}=="Microsoft X-Box One pad", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="270"
ATTRS{name}=="Microsoft Xbox Controller", ENV{ID_INPUT_WHEEL}="1", ENV{WHEEL_ROTATION_ANGLE}="270"
ATTRS{name}=="MOZA R9 wheels", ENV{ID_INPUT_WHEEL}="1"
ATTRS{name}=="Gudsen MOZA R12 Base", ENV{ID_INPUT_WHEEL}="1"

ENV{ID_INPUT_WHEEL}=="1", ENV{ID_INPUT_JOYSTICK}="1"

LABEL="hippos_wheels_end"

ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="c261|c26d", RUN+="/usr/sbin/usb_modeswitch -v 046d -p $attr{idProduct} -M 0f00010142 -C 0x03 -m 01 -r 01"
ACTION=="add", SUBSYSTEMS=="usb", ATTRS{idVendor}=="044f", ATTRS{idProduct}=="b671", RUN+="/sbin/modprobe xpad"
