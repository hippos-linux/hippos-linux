
SUBSYSTEM!="sound", GOTO="hippos_audio_hotplug_end"

ACTION=="add", KERNEL=="card*", TEST=="/run/user/1000/bus", \
    RUN+="/bin/systemd-run --no-block --replace --unit=hippos-audio-hotplug /usr/lib/hippos/hippos-audio-setup"

ACTION=="remove", KERNEL=="card*", TEST=="/run/user/1000/bus", \
    RUN+="/bin/systemd-run --no-block --unit=hippos-audio-recover /usr/lib/hippos/hippos-audio-recover"

LABEL="hippos_audio_hotplug_end"
