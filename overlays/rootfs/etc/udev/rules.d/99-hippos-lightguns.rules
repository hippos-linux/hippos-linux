# Light guns show up in games as "HippOS light gun <model> P<n>". To support another gun, add a rule
# setting HIPPOS_LIGHTGUN to a model hippos-lightgun knows and HIPPOS_LIGHTGUN_PLAYER to its player number.
# GunCon 3 and Retro Shooter: to calibrate, hold Select for 3 seconds, then shoot each point the
# crosshair moves to. GunCon 3 calibration is saved in /userdata/system/configs/hippos/lightgun.

ACTION!="add", GOTO="hippos_lightguns_end"
TEST!="/usr/bin/evsieve", GOTO="hippos_lightguns_end"

SUBSYSTEM=="video4linux", ENV{ID_V4L_PRODUCT}=="Sinden*", ATTR{index}=="0", ENV{HIPPOS_LIGHTGUN}="sinden", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="hippos-lightgun@%k.service"

SUBSYSTEM!="input", GOTO="hippos_lightguns_end"
KERNEL!="event*", GOTO="hippos_lightguns_end"

ATTRS{name}=="Aimtrak ATRAK Device #*", ENV{HIPPOS_LIGHTGUN}="aimtrak"
ATTRS{name}=="Ultimarc ATRAK Device #*", ENV{HIPPOS_LIGHTGUN}="aimtrak"
ATTRS{name}=="Ultimarc Ultimarc", ENV{HIPPOS_LIGHTGUN}="aimtrak"

ATTRS{idVendor}=="0b9a", ATTRS{idProduct}=="016a", ENV{HIPPOS_LIGHTGUN}="guncon2"
ATTRS{idVendor}=="0b9a", ATTRS{idProduct}=="0800", ENV{HIPPOS_LIGHTGUN}="guncon3"

ATTRS{name}=="3AGAME 3A-3H Retro Shooter [1-4]*", ENV{HIPPOS_LIGHTGUN}="retroshooter"
ATTRS{name}=="3AGAME 3A-3H Retro Shooter 1*", ENV{HIPPOS_LIGHTGUN_PLAYER}="1"
ATTRS{name}=="3AGAME 3A-3H Retro Shooter 2*", ENV{HIPPOS_LIGHTGUN_PLAYER}="2"
ATTRS{name}=="3AGAME 3A-3H Retro Shooter 3*", ENV{HIPPOS_LIGHTGUN_PLAYER}="3"
ATTRS{name}=="3AGAME 3A-3H Retro Shooter 4*", ENV{HIPPOS_LIGHTGUN_PLAYER}="4"

ATTRS{name}=="Arduino LLC GUN4IR*P[1-4]*", ENV{HIPPOS_LIGHTGUN}="gun4ir"

ATTRS{name}=="OpenFIRE FIRECon P[1-4] *", ENV{HIPPOS_LIGHTGUN}="openfire"
ATTRS{name}=="Props3D Blamcon Lightgun - P[1-4]*", ENV{HIPPOS_LIGHTGUN}="blamcon"
ATTRS{name}=="HONGWEIHUA XGUNNER-P[1-4] *", ENV{HIPPOS_LIGHTGUN}="xgunner"
ATTRS{name}=="*P1*", ENV{HIPPOS_LIGHTGUN}=="openfire|blamcon|xgunner", ENV{HIPPOS_LIGHTGUN_PLAYER}="1"
ATTRS{name}=="*P2*", ENV{HIPPOS_LIGHTGUN}=="openfire|blamcon|xgunner", ENV{HIPPOS_LIGHTGUN_PLAYER}="2"
ATTRS{name}=="*P3*", ENV{HIPPOS_LIGHTGUN}=="openfire|blamcon|xgunner", ENV{HIPPOS_LIGHTGUN_PLAYER}="3"
ATTRS{name}=="*P4*", ENV{HIPPOS_LIGHTGUN}=="openfire|blamcon|xgunner", ENV{HIPPOS_LIGHTGUN_PLAYER}="4"

ATTRS{name}=="Fusion Mini P1*", ENV{HIPPOS_LIGHTGUN}="fusion", ENV{HIPPOS_LIGHTGUN_PLAYER}="1"
ATTRS{name}=="Fusion Mini P2*", ENV{HIPPOS_LIGHTGUN}="fusion", ENV{HIPPOS_LIGHTGUN_PLAYER}="2"
ATTRS{name}=="Fusion Piggie 1*", ENV{HIPPOS_LIGHTGUN}="fusion", ENV{HIPPOS_LIGHTGUN_PLAYER}="3"
ATTRS{name}=="Fusion Piggie 2*", ENV{HIPPOS_LIGHTGUN}="fusion", ENV{HIPPOS_LIGHTGUN_PLAYER}="4"
ATTRS{name}=="Fusion Piggie 3*", ENV{HIPPOS_LIGHTGUN}="fusion", ENV{HIPPOS_LIGHTGUN_PLAYER}="5"
ATTRS{name}=="Fusion Piggie 4*", ENV{HIPPOS_LIGHTGUN}="fusion", ENV{HIPPOS_LIGHTGUN_PLAYER}="6"

ATTRS{name}=="OneHit OneHit #*", ENV{HIPPOS_LIGHTGUN}="onehit"

# Sinden (PC version only): be connected to the internet the first time you plug a gun in.
ATTRS{name}=="Unknown SindenLightgun*", ENV{HIPPOS_LIGHTGUN}="sinden"

# AE lightgun: create an empty file /userdata/system/configs/hippos/aelightgun to use it.
ATTRS{name}=="Arduino LLC Arduino Micro*", TEST=="/userdata/system/configs/hippos/aelightgun", ENV{HIPPOS_LIGHTGUN}="aelightgun"

ENV{HIPPOS_LIGHTGUN}=="?*", ENV{ID_INPUT_MOUSE}="0", ENV{ID_INPUT_JOYSTICK}="0", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="hippos-lightgun@%k.service"

ATTRS{name}=="HippOS uncalibrated gun *", ENV{ID_INPUT_MOUSE}="0", ENV{ID_INPUT_JOYSTICK}="0", \
    ENV{ID_INPUT_KEYBOARD}="0", ENV{ID_INPUT_KEY}="0"

ATTRS{name}=="HippOS light gun *", ENV{ID_INPUT_GUN}="1", ENV{ID_INPUT_MOUSE}="1", \
    ENV{ID_INPUT_JOYSTICK}="0", ENV{ID_INPUT_KEYBOARD}="0", ENV{ID_INPUT_KEY}="0"
ATTRS{name}=="HippOS light gun sinden *", ENV{ID_INPUT_GUN_NEED_BORDERS}="1"

ATTRS{name}=="HJZ Mayflash Wiimote PC Adapter Mouse", ENV{ID_INPUT_GUN}="1", ENV{ID_INPUT_MOUSE}="1"
ATTRS{name}=="Adafruit ItsyBitsy 32u4 3V 8MHz", ENV{ID_INPUT_GUN}="1"

LABEL="hippos_lightguns_end"
