[Unit]
Description=HippOS MergerFS saves pool
After=local-fs.target userdata.mount
Before=hippos-es.service
Wants=userdata.mount

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStopSec=10
ExecStart=/usr/lib/hippos/mount-saves-pool
ExecStop=umount -l /userdata/saves

[Install]
WantedBy=multi-user.target
