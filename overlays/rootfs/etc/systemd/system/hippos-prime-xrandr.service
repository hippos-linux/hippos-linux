[Unit]
Description=HippOS PRIME xrandr output source setup
ConditionPathExists=/run/hippos/prime-xrandr
After=hippos-xserver.service
Requires=hippos-xserver.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=0
ExecStart=/bin/sh -c 'for i in $(seq 1 400); do DISPLAY=:0 timeout 2 xrandr --listproviders 2>/dev/null | grep -q "NVIDIA-G0" && break; sleep 0.5; done; DISPLAY=:0 /run/hippos/prime-xrandr 2>/dev/null || true'

[Install]
WantedBy=graphical.target
