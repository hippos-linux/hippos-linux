[Unit]
Description=HippOS MergerFS BIOS pool
After=local-fs.target userdata.mount
Before=hippos-es.service
Wants=userdata.mount

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStopSec=5
ExecStart=/usr/lib/hippos/mount-bios-pool
ExecStop=umount -l /userdata/bios
ExecStop=pkill -f "mergerfs.*userdata/bios" || true

[Install]
WantedBy=multi-user.target
