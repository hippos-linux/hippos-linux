#!/usr/bin/env python3
import logging
import os
import sys

GAME_NICENESS = -4

try:
    os.setpriority(os.PRIO_PROCESS, 0, GAME_NICENESS)
except PermissionError:
    pass

sys.path.insert(0, '/usr/lib/hippos')

from emulatorlauncher_impl import main

code = main()
logging.shutdown()
sys.stdout.flush()
sys.stderr.flush()
os._exit(code)
