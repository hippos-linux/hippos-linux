#!/bin/bash
# pad2key-launcher <event device> <run|checkconfig|checkconfigsys>
# run is started by hippos-pad2key@<event>.service (99-pad2key.rules), after
# /userdata is mounted, and stays in the foreground for as long as the device.

getConfigName() {
    SAFENAME=$(echo "${1}" | sed -e s+'[^a-zA-Z0-9]'++g) # keep only letters and integers
    echo "${SAFENAME}.v${2}.p${3}.yml"
}

doHelp() {
    echo "pad2key-launcher <event> <run|checkconfig|checkconfigsys>" >&2
}

PHYSDEV=$1
if ! test -e "${PHYSDEV}"
then
    doHelp
    exit 1
fi

# Name and ids from sysfs; ids are 4-digit lowercase hex, as in the config names.
INPUT_SYSFS="/sys/class/input/$(basename "${PHYSDEV}")/device"
PHYSNAME=$(cat "${INPUT_SYSFS}/name")
PHYSVID=$(cat "${INPUT_SYSFS}/id/vendor")
PHYSPID=$(cat "${INPUT_SYSFS}/id/product")

CONFIGNAME=$(getConfigName "${PHYSNAME}" "${PHYSVID}" "${PHYSPID}")
CONFIGFILE=""
test -e "/usr/share/pad2key/inputs/${CONFIGNAME}"               && CONFIGFILE="/usr/share/pad2key/inputs/${CONFIGNAME}"
test -e "/userdata/system/configs/pad2key/inputs/${CONFIGNAME}" && CONFIGFILE="/userdata/system/configs/pad2key/inputs/${CONFIGNAME}"

ACTION=$2

if test "${ACTION}" == "checkconfigsys"
then
    if test -e "/usr/share/pad2key/inputs/${CONFIGNAME}"
    then
       echo 0
       exit 0
    fi
    if test -e "/userdata/system/configs/pad2key/inputs/${CONFIGNAME}"
    then
	echo 0
	exit 0
    fi
    # keep keyboard to 1
    echo 1
    exit 0
fi

if test "${ACTION}" == "checkconfig"
then
    echo "Device ${PHYSNAME} / vendor id: ${PHYSVID} / product id: ${PHYSPID}"
    echo "checking /userdata/system/configs/pad2key/inputs/${CONFIGNAME}..."
    echo "checking /usr/share/pad2key/inputs/${CONFIGNAME}..."

    CONFIGFILE=""
    test -e "/usr/share/pad2key/inputs/${CONFIGNAME}"               && CONFIGFILE="/usr/share/pad2key/inputs/${CONFIGNAME}"
    test -e "/userdata/system/configs/pad2key/inputs/${CONFIGNAME}" && CONFIGFILE="/userdata/system/configs/pad2key/inputs/${CONFIGNAME}"
    if test -n "${CONFIGFILE}"
    then
	echo "Using config ${CONFIGFILE}" >&2
	exit 0
    fi

    echo "No config file found." >&2
    exit 1
else
    if test "${ACTION}" == "run"
    then
	if test -n "${CONFIGFILE}"
	then
	    echo "using config file ${CONFIGFILE}" >&2
	    pad2key --config "${CONFIGFILE}" --rules > "/run/udev/rules.d/99_${CONFIGNAME}.rules" || exit 1
	    udevadm control --reload-rules || exit 1
	    exec pad2key --config "${CONFIGFILE}" --input "${1}" --run
	else
	    # no config file found, do 1 to 1 mapping to enable keyboard
	    # map the same, but this one will have ID_INPUT_KEYBOARD set to 1
	    exec evsieve --input "${1}" --output name="Default virtual keyboard"
	fi
    else
	doHelp
    fi
fi
