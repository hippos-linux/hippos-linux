<!-- Copy to /userdata/system/configs/quickmenu/quickmenu.xml to change the quick menu.
     ${command} runs a shell command and shows its output; refresh="N" re-runs it every N seconds.
     if="${command}" shows a row or tab only when the command prints something.
     afterclick="close" hides the menu after the action, "refresh" re-reads every value,
     "rescreen" moves the menu to the screen chosen in the System tab.
     progressbar takes showvalue="true" to print its percentage inside the bar.
     keypicker opens a keyboard; the chosen key code is added to action ("none" when cleared), display gives the current key code.
     choice_cmd lists one choice per line of display, runs action followed by the matching line of action_arg.
     img and qrcode take height="N%" of the screen; doc opens a manual, map or picture from content.
     In the header, the first feature is the title line and the rest are smaller lines under it. -->
<features>
	<vgroup role="header">
		<feature display='${G=$(curl -s http://127.0.0.1:1234/runningGame | jq -r ".name // empty"); echo "${G:-Quick menu}"}'>
			<text display='${[ "$(hippos-record is_running)" = true ] &amp;&amp; echo "● REC"}' refresh="2" />
			<text display='${cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1 | sed "s/$/%/"}' refresh="30" />
			<text display='${date +%H:%M}' refresh="10" />
		</feature>
		<feature display='${S=$(curl -s http://127.0.0.1:1234/runningGame | jq -r ".systemName // empty"); F=$([ -n "$S" ] &amp;&amp; curl -s http://127.0.0.1:1234/systems | jq -r --arg s "$S" ".[] | select(.name == \$s) | .fullname"); [ -n "$F" ] &amp;&amp; printf "%s  ·  " "$F"; hippos-info}' />
	</vgroup>

	<hgroup name="Game" display="Game" if='${curl -s http://127.0.0.1:1234/runningGame | jq -r ".name // empty"}'>
		<feature>
			<img display='${M=$(curl -s http://127.0.0.1:1234/runningGame | jq -r ".marquee // empty"); [ -n "$M" ] &amp;&amp; echo "http://127.0.0.1:1234$M"}' height="8%" refresh="5" />
			<img display='${T=$(curl -s http://127.0.0.1:1234/runningGame | jq -r ".thumbnail // .image // empty"); [ -n "$T" ] &amp;&amp; echo "http://127.0.0.1:1234$T"}' height="16%" refresh="5" />
			<qrcode display='${C=$(curl -s http://127.0.0.1:1234/runningGame | jq -r ".cheevosId // empty"); [ -n "$C" ] &amp;&amp; [ "$C" != 0 ] &amp;&amp; echo "https://retroachievements.org/game/$C"}' height="16%" refresh="5" />
		</feature>
		<feature display="Playing for">
			<text display='${ps -o etime= -p "$(pgrep -of "python3 /usr/bin/emulatorlauncher")" 2>/dev/null | tr -d " "}' refresh="1" />
		</feature>
		<feature display="Manual">
			<doc content='${M=$(curl -s http://127.0.0.1:1234/runningGame | jq -r ".manual // empty"); [ -n "$M" ] &amp;&amp; echo "http://127.0.0.1:1234$M"}' refresh="5" />
		</feature>
		<feature display="Map">
			<doc content='${M=$(curl -s http://127.0.0.1:1234/runningGame | jq -r ".map // empty"); [ -n "$M" ] &amp;&amp; echo "http://127.0.0.1:1234$M"}' refresh="5" />
		</feature>
		<feature display="Controls">
			<doc content='${S=$(curl -s http://127.0.0.1:1234/runningGame | jq -r ".systemName // empty"); for f in "/userdata/system/configs/controller-overlays/$S.png" "/usr/share/hippos/controller-overlays/$S.png"; do [ -n "$S" ] &amp;&amp; [ -f "$f" ] &amp;&amp; { echo "$f"; break; }; done}' refresh="5" />
		</feature>
		<feature display="Controller as mouse" if="${hippos-controller-mouse status}">
			<switch value="${hippos-controller-mouse status}" action_on="hippos-controller-mouse on" action_off="hippos-controller-mouse off" />
		</feature>
		<feature display="On-screen keyboard">
			<button display="Show / hide" action="hippos-hotkeys --send onscreen-keyboard" afterclick="close" />
		</feature>
		<feature display="Save state">
			<button display="Save" action="hippos-hotkeys --send save_state" afterclick="close" />
		</feature>
		<feature display="Load state">
			<button display="Load" action="hippos-hotkeys --send restore_state" afterclick="close" />
		</feature>
		<feature display="Reset game">
			<button_confirm display="Reset" action="hippos-hotkeys --send reset" afterclick="close" />
		</feature>
		<feature display="Quit game">
			<button_confirm display="Quit" action="hippos-hotkeys --send exit" afterclick="close" />
		</feature>
		<feature display="Game not responding?">
			<button_confirm display="Force quit" action="/usr/lib/hippos/hippos-close-game" afterclick="close" />
		</feature>
	</hgroup>

	<hgroup name="Keys" display="Keys" if='${curl -s http://127.0.0.1:1234/runningGame | jq -r ".name // empty"}'>
		<feature display="Keyboard keys sent by player 1's controller in this game" />
		<feature display="Back to the system's keys" if="${hippos-padtokey edited}">
			<button_confirm display="Reset" action="hippos-padtokey reset" afterclick="refresh" />
		</feature>
		<feature display="Bottom button">
			<text display="${hippos-padtokey get b}" />
			<keypicker display="${hippos-padtokey key b}" action="hippos-padtokey set b" />
		</feature>
		<feature display="Right button">
			<text display="${hippos-padtokey get a}" />
			<keypicker display="${hippos-padtokey key a}" action="hippos-padtokey set a" />
		</feature>
		<feature display="Top button">
			<text display="${hippos-padtokey get x}" />
			<keypicker display="${hippos-padtokey key x}" action="hippos-padtokey set x" />
		</feature>
		<feature display="Left button">
			<text display="${hippos-padtokey get y}" />
			<keypicker display="${hippos-padtokey key y}" action="hippos-padtokey set y" />
		</feature>
		<feature display="L1">
			<text display="${hippos-padtokey get pageup}" />
			<keypicker display="${hippos-padtokey key pageup}" action="hippos-padtokey set pageup" />
		</feature>
		<feature display="R1">
			<text display="${hippos-padtokey get pagedown}" />
			<keypicker display="${hippos-padtokey key pagedown}" action="hippos-padtokey set pagedown" />
		</feature>
		<feature display="L2">
			<text display="${hippos-padtokey get l2}" />
			<keypicker display="${hippos-padtokey key l2}" action="hippos-padtokey set l2" />
		</feature>
		<feature display="R2">
			<text display="${hippos-padtokey get r2}" />
			<keypicker display="${hippos-padtokey key r2}" action="hippos-padtokey set r2" />
		</feature>
		<feature display="L3 (stick press)">
			<text display="${hippos-padtokey get l3}" />
			<keypicker display="${hippos-padtokey key l3}" action="hippos-padtokey set l3" />
		</feature>
		<feature display="R3 (stick press)">
			<text display="${hippos-padtokey get r3}" />
			<keypicker display="${hippos-padtokey key r3}" action="hippos-padtokey set r3" />
		</feature>
		<feature display="Start">
			<text display="${hippos-padtokey get start}" />
			<keypicker display="${hippos-padtokey key start}" action="hippos-padtokey set start" />
		</feature>
		<feature display="Select">
			<text display="${hippos-padtokey get select}" />
			<keypicker display="${hippos-padtokey key select}" action="hippos-padtokey set select" />
		</feature>
		<feature display="D-pad up">
			<text display="${hippos-padtokey get up}" />
			<keypicker display="${hippos-padtokey key up}" action="hippos-padtokey set up" />
		</feature>
		<feature display="D-pad down">
			<text display="${hippos-padtokey get down}" />
			<keypicker display="${hippos-padtokey key down}" action="hippos-padtokey set down" />
		</feature>
		<feature display="D-pad left">
			<text display="${hippos-padtokey get left}" />
			<keypicker display="${hippos-padtokey key left}" action="hippos-padtokey set left" />
		</feature>
		<feature display="D-pad right">
			<text display="${hippos-padtokey get right}" />
			<keypicker display="${hippos-padtokey key right}" action="hippos-padtokey set right" />
		</feature>
		<feature display="Left stick up">
			<text display="${hippos-padtokey get joystick1up}" />
			<keypicker display="${hippos-padtokey key joystick1up}" action="hippos-padtokey set joystick1up" />
		</feature>
		<feature display="Left stick down">
			<text display="${hippos-padtokey get joystick1down}" />
			<keypicker display="${hippos-padtokey key joystick1down}" action="hippos-padtokey set joystick1down" />
		</feature>
		<feature display="Left stick left">
			<text display="${hippos-padtokey get joystick1left}" />
			<keypicker display="${hippos-padtokey key joystick1left}" action="hippos-padtokey set joystick1left" />
		</feature>
		<feature display="Left stick right">
			<text display="${hippos-padtokey get joystick1right}" />
			<keypicker display="${hippos-padtokey key joystick1right}" action="hippos-padtokey set joystick1right" />
		</feature>
		<feature display="Right stick up">
			<text display="${hippos-padtokey get joystick2up}" />
			<keypicker display="${hippos-padtokey key joystick2up}" action="hippos-padtokey set joystick2up" />
		</feature>
		<feature display="Right stick down">
			<text display="${hippos-padtokey get joystick2down}" />
			<keypicker display="${hippos-padtokey key joystick2down}" action="hippos-padtokey set joystick2down" />
		</feature>
		<feature display="Right stick left">
			<text display="${hippos-padtokey get joystick2left}" />
			<keypicker display="${hippos-padtokey key joystick2left}" action="hippos-padtokey set joystick2left" />
		</feature>
		<feature display="Right stick right">
			<text display="${hippos-padtokey get joystick2right}" />
			<keypicker display="${hippos-padtokey key joystick2right}" action="hippos-padtokey set joystick2right" />
		</feature>
	</hgroup>

	<hgroup name="Gun" display="Gun" if="${[ -f /var/run/hippos/gun_help.png ] &amp;&amp; curl -s http://127.0.0.1:1234/runningGame | jq -r '.name // empty'}">
		<feature>
			<img display="/var/run/hippos/gun_help.png" height="45%" />
		</feature>
	</hgroup>

	<hgroup name="System" display="System">
		<feature display="Touch keyboard" if="${hippos-touchscreen-detect >/dev/null &amp;&amp; echo 1}">
			<button display="Show / hide" action="hippos-hotkeys --send onscreen-keyboard" afterclick="close" />
		</feature>
		<feature display="Volume">
			<button display="-" action="hippos-audio setSystemVolume -5" afterclick="refresh" />
			<progressbar display="${hippos-audio getSystemVolume}" min="0" max="100" refresh="2" />
			<button display="+" action="hippos-audio setSystemVolume +5" afterclick="refresh" />
		</feature>
		<feature display="Brightness" if="${hippos-brightness get}">
			<button display="-" action='hippos-brightness set $(( $(hippos-brightness get) > 10 ? $(hippos-brightness get) - 10 : 1 ))' afterclick="refresh" />
			<progressbar display="${hippos-brightness get}" min="0" max="100" refresh="2" />
			<button display="+" action='hippos-brightness set $(( $(hippos-brightness get) &lt; 90 ? $(hippos-brightness get) + 10 : 100 ))' afterclick="refresh" />
		</feature>
		<feature display="Mute sound">
			<switch value="${hippos-audio getSystemMute}" action_on="hippos-audio setSystemVolume mute" action_off="hippos-audio setSystemVolume unmute" refresh="2" />
		</feature>
		<feature display="Plane mode">
			<switch value="${hippos-planemode status}" action_on="hippos-planemode enable" action_off="hippos-planemode disable" refresh="5" />
		</feature>
		<feature display="Power mode">
			<text display='${case "$(hippos-power-mode get)" in highperformance) echo "High performance" ;; balanced) echo "Balanced" ;; powersaver) echo "Power saver" ;; *) echo "Automatic" ;; esac}' refresh="2" />
			<choice display="Automatic" action="hippos-power-mode default" />
			<choice display="High performance" action="hippos-power-mode highperformance" />
			<choice display="Balanced" action="hippos-power-mode balanced" />
			<choice display="Power saver" action="hippos-power-mode powersaver" />
		</feature>
		<feature display="Handheld controller" if="${hippos-handheld available &amp;&amp; echo 1}">
			<choice_cmd display="${hippos-handheld choices controller | cut -f 1}" action="hippos-handheld set" action_arg="${hippos-handheld choices controller | cut -f 2}" />
		</feature>
		<feature display="Button mapping" if="${hippos-handheld available &amp;&amp; echo 1}">
			<choice_cmd display="${hippos-handheld choices profile | cut -f 1}" action="hippos-handheld set" action_arg="${hippos-handheld choices profile | cut -f 2}" />
		</feature>
		<feature display="Menu screen" if='${[ "$(hippos-resolution listOutputs | wc -l)" -gt 1 ] &amp;&amp; echo 1}'>
			<text display='${S=$(hippos-settings get quickmenu.screen); echo "${S:-Auto}"}' refresh="2" />
			<choice display="Auto" action="hippos-settings del quickmenu.screen" afterclick="rescreen" />
			<choice_cmd display="${hippos-resolution listOutputs}" action="hippos-settings set quickmenu.screen" afterclick="rescreen" />
		</feature>
		<feature display="Game not responding?">
			<button_confirm display="Force quit" action="/usr/lib/hippos/hippos-close-game" afterclick="close" />
		</feature>
		<feature display="IP address">
			<text display='${hostname -I | cut -d" " -f1}' refresh="5" />
		</feature>
		<feature display="Free space">
			<text display="${df -h /userdata | awk 'NR==2 {print $4}'}" refresh="10" />
		</feature>
	</hgroup>

	<hgroup name="Outputs" display="Outputs">
		<feature display="Audio output">
			<text display="${hippos-audio list | awk -F '\t' -v d=&quot;$(hippos-audio get)&quot; '$1 == d { print $2 }'}" refresh="3" />
			<choice_cmd display="${hippos-audio list | cut -f 2}" action="hippos-audio set" action_arg="${hippos-audio list | cut -f 1}" />
		</feature>
		<feature display="Audio profile">
			<text display="${hippos-audio list-profiles | awk -F '\t' -v d=&quot;$(hippos-audio get-profile)&quot; '$1 == d { print $2 }'}" refresh="3" />
			<choice_cmd display="${hippos-audio list-profiles | cut -f 2}" action="hippos-audio set-profile" action_arg="${hippos-audio list-profiles | cut -f 1}" />
		</feature>
		<feature display="Video output" if='${curl -s http://127.0.0.1:1234/runningGame | jq -e ".name" >/dev/null &amp;&amp; exit 0; [ "$(hippos-resolution listOutputs | wc -l)" -gt 1 ] &amp;&amp; echo 1}'>
			<text display="${hippos-resolution currentOutput}" refresh="3" />
			<choice_cmd display="${hippos-resolution listOutputs}" action="hippos-resolution setOutput" />
		</feature>
	</hgroup>

	<hgroup name="Record" display="Record">
		<feature display="Recording">
			<switch value="${hippos-record is_running}" action_on="hippos-record start" action_off="hippos-record stop" afterclick="close" refresh="2" />
		</feature>
		<feature display="Quality">
			<text display="${hippos-record get-quality}" refresh="2" />
			<choice display="Ultra (60 fps)" action="hippos-record set-quality ultra" />
			<choice display="High (60 fps)" action="hippos-record set-quality high" />
			<choice display="Medium (30 fps)" action="hippos-record set-quality mid" />
			<choice display="Low (30 fps, half size)" action="hippos-record set-quality low" />
		</feature>
		<feature display="Audio source">
			<text display="${hippos-record get-audio}" refresh="2" />
			<choice display="System sound" action="hippos-record set-audio auto" />
			<choice display="Microphone" action="hippos-record set-audio mic" />
			<choice display="No audio" action="hippos-record set-audio none" />
		</feature>
		<feature display="Record all screens" if='${[ "$(hippos-resolution listOutputs | wc -l)" -gt 1 ] &amp;&amp; echo 1}'>
			<switch value="${hippos-record get-all}" action_on="hippos-record set-all true" action_off="hippos-record set-all false" />
		</feature>
		<feature display="Screenshot">
			<text display='${echo "after $(cat "$XDG_RUNTIME_DIR/quickmenu-screenshot-delay" 2>/dev/null || echo 2) s"}' refresh="1" />
			<button display="Take" action='(sleep "$(cat "$XDG_RUNTIME_DIR/quickmenu-screenshot-delay" 2>/dev/null || echo 2)"; hippos-screenshot) >/dev/null 2>&amp;1 &amp;' afterclick="close" />
			<choice display="Immediately" action='echo 0 > "$XDG_RUNTIME_DIR/quickmenu-screenshot-delay"' />
			<choice display="After 2 seconds" action='echo 2 > "$XDG_RUNTIME_DIR/quickmenu-screenshot-delay"' />
			<choice display="After 5 seconds" action='echo 5 > "$XDG_RUNTIME_DIR/quickmenu-screenshot-delay"' />
			<choice display="After 10 seconds" action='echo 10 > "$XDG_RUNTIME_DIR/quickmenu-screenshot-delay"' />
		</feature>
	</hgroup>

	<vgroup role="footer">
		<feature display="CPU">
			<progressbar display="${hippos-sysstats cpu-usage}" min="0" max="100" showvalue="true" refresh="1" />
			<text display='${T=$(hippos-sysstats cpu-temp); [ -n "$T" ] &amp;&amp; echo "$T°C"}' refresh="3" />
		</feature>
		<feature display="GPU" if="${hippos-sysstats gpu-usage}">
			<progressbar display="${hippos-sysstats gpu-usage}" min="0" max="100" showvalue="true" refresh="1" />
			<text display='${T=$(hippos-sysstats gpu-temp); [ -n "$T" ] &amp;&amp; echo "$T°C"}' refresh="3" />
		</feature>
		<feature display="Screen">
			<text display="${hippos-resolution currentResolution}" />
		</feature>
	</vgroup>
</features>
