#!/bin/sh
# HippOS update-grub wrapper — routes all callers (crt-setup, apt kernel hooks,
# etc.) to hippos-upgrade update-grub so /boot/efi/grub/grub.cfg is updated.
# System grub-mkconfig would write to /boot/grub/grub.cfg (BTRFS rootfs) which
# GRUB never reads — its boot prefix is on the EFI partition at /boot/efi/grub/.
if [ -x /usr/lib/hippos/hippos-upgrade ]; then
    exec /usr/lib/hippos/hippos-upgrade update-grub "$@"
fi
# Not available (e.g. early chroot during build) — exit cleanly so package
# postinst hooks don't fail.
echo "update-grub: hippos-upgrade not available, skipping" >&2
exit 0
