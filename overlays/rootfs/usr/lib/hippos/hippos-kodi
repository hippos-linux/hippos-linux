#!/usr/bin/env bash

command -v kodi >/dev/null || { echo "hippos-kodi: kodi is not installed" >&2; exit 1; }

deadline=$(( $(cut -d. -f1 /proc/uptime) + 5 ))
while fuser -s /dev/snd/pcmC*p 2>/dev/null && (( $(cut -d. -f1 /proc/uptime) < deadline )); do
    pactl list short sinks 2>/dev/null | cut -f2 | while read -r sink; do pactl suspend-sink "${sink}" 1; done
    sleep 0.1
done

EXITCODE_POWERDOWN=64
EXITCODE_RESTARTAPP=65
EXITCODE_REBOOT=66

while true; do
    kodi --standalone -fs
    status=$?
    (( status == EXITCODE_RESTARTAPP )) || break
done

pactl list short sinks 2>/dev/null | cut -f2 | while read -r sink; do pactl suspend-sink "${sink}" 0; done

case "${status}" in
    "${EXITCODE_REBOOT}")    exit 10 ;;
    "${EXITCODE_POWERDOWN}") exit 11 ;;
    *)                       exit 0 ;;
esac
