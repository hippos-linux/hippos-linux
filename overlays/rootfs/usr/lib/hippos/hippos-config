#!/usr/bin/env bash
# ES API: config canupdate/lsoutputs/lscrtoutputs/getRootPassword/overscan/forgetBT/storage
export DISPLAY="${DISPLAY:-:0}"

case "${1:-}" in
    canupdate)
        hippos-upgrade check
        exit $?
        ;;
    lsoutputs)
        xrandr --query 2>/dev/null | awk '/connected/{print $1}'
        ;;
    lscrtoutputs)
        # Canonical DRM connector names (VGA-1, DVI-I-1, DP-1, HDMI-A-1, ...) —
        # NOT lsoutputs' X11/DDX names. hippos-crt-setup stores and consumes
        # crt.output as a DRM name (it's what GRUB's video= kernel parameter
        # needs), so a picker backed by lsoutputs would silently persist the
        # wrong namespace (e.g. "DisplayPort-0" instead of "DP-1").
        #
        # Lists every connector that exists in /sys/class/drm/, not just
        # currently-connected ones: a passive DP/HDMI-to-VGA DAC doesn't
        # always trigger hotplug detection, so filtering to "connected" risks
        # hiding the exact port a CRT user needs to pick. Each line is
        # "name:name (connected)" or "name:name (disconnected)" — id:label,
        # same convention hippos-resolution listCrtBootModes uses — so the
        # UI can show the status without it ever being part of the stored
        # crt.output value.
        for p in /sys/class/drm/card[0-9]*-*; do
            [[ -f "${p}/status" ]] || continue
            name="${p##*/}"; name="${name#card*-}"
            status="disconnected"
            [[ "$(< "${p}/status")" == "connected" ]] && status="connected"
            printf '%s:%s (%s)\n' "${name}" "${name}" "${status}"
        done
        ;;
    getRootPassword)
        # Content only needs to be non-empty/empty for the ES password-field
        # mask — actual value is a debugging aid, not a secret worth reading
        # back. "linux" is root's real account password until changed (set
        # at build time, see configure-rootfs.sh).
        if [[ -f /userdata/system/.root-password-custom ]]; then
            echo "custom"
        else
            echo "linux"
        fi
        ;;
    setRootPassword)
        [[ "${EUID}" -ne 0 ]] && exec sudo "$0" "$@"
        pw="${2:-}"
        [[ -n "${pw}" ]] || { echo "Usage: hippos-config setRootPassword <password>" >&2; exit 1; }
        # hippos shares root's password since it already has passwordless
        # sudo ALL — a different password on hippos wouldn't gate anything,
        # just move the same access to a different login name.
        printf 'root:%s\nhippos:%s\n' "${pw}" "${pw}" | chpasswd
        touch /userdata/system/.root-password-custom
        ;;
    overscan)
        export DISPLAY="${DISPLAY:-:0}"
        _overscan_output() {
            xrandr --query 2>/dev/null | awk '/connected primary/{print $1; exit} /connected/{o=$1} END{if(o)print o}'
        }
        _overscan_apply() {
            local out="${1:-$(_overscan_output)}"
            local left right top bottom hborder vborder
            left=$(hippos-settings get display.overscan.left 2>/dev/null || echo 0)
            right=$(hippos-settings get display.overscan.right 2>/dev/null || echo 0)
            top=$(hippos-settings get display.overscan.top 2>/dev/null || echo 0)
            bottom=$(hippos-settings get display.overscan.bottom 2>/dev/null || echo 0)
            hborder=$(( (${left} + ${right}) / 2 ))
            vborder=$(( (${top} + ${bottom}) / 2 ))
            xrandr --output "${out}" --set underscan on \
                   --set "underscan hborder" "${hborder}" \
                   --set "underscan vborder" "${vborder}" 2>/dev/null \
                || echo "[hippos-config overscan] xrandr underscan not supported on ${out}" >&2
        }
        case "${2:-}" in
            set)
                [[ -n "${3:-}" && -n "${4:-}" && -n "${5:-}" && -n "${6:-}" ]] || {
                    echo "usage: hippos-config overscan set <left> <right> <top> <bottom>" >&2
                    exit 2
                }
                hippos-settings set display.overscan.left   "${3}" 2>/dev/null || true
                hippos-settings set display.overscan.right  "${4}" 2>/dev/null || true
                hippos-settings set display.overscan.top    "${5}" 2>/dev/null || true
                hippos-settings set display.overscan.bottom "${6}" 2>/dev/null || true
                hippos-settings set display.overscan.enabled true  2>/dev/null || true
                _overscan_apply
                ;;
            enable)
                hippos-settings set display.overscan.enabled true 2>/dev/null || true
                _overscan_apply
                ;;
            disable)
                hippos-settings set display.overscan.enabled false 2>/dev/null || true
                _out="$(_overscan_output)"
                xrandr --output "${_out}" --set underscan off 2>/dev/null || true
                ;;
            *)
                exit 0
                ;;
        esac
        ;;
    forgetBT)
        bluetoothctl paired-devices 2>/dev/null | awk '{print $2}' | while read -r mac; do
            bluetoothctl remove "$mac" 2>/dev/null || true
        done
        ;;
    storage)
        HIPPOS_CONFIG=/userdata/system/configs/hippos
        STORAGE_CURRENT="${HIPPOS_CONFIG}/current-storage.conf"
        storage_current() {
            if [[ -s "${STORAGE_CURRENT}" ]]; then
                read -r current < "${STORAGE_CURRENT}" || current=INTERNAL
                printf '%s\n' "${current:-INTERNAL}"
            else
                printf 'INTERNAL\n'
            fi
        }

        storage_list() {
            printf 'INTERNAL\n'
            if command -v hippos-storage-manager >/dev/null 2>&1; then
                hippos-storage-manager list_drives 2>/dev/null | awk -F'|' 'NF >= 2 { print "DEV " $2 " " $1 }'
            elif [[ -x /usr/lib/hippos/hippos-storage-manager ]]; then
                /usr/lib/hippos/hippos-storage-manager list_drives 2>/dev/null | awk -F'|' 'NF >= 2 { print "DEV " $2 " " $1 }'
            fi
        }

        case "${2:-}" in
            list)
                storage_list
                ;;
            current)
                storage_current
                ;;
            INTERNAL|DEV|NET)
                mkdir -p "${HIPPOS_CONFIG}"
                if [[ "${2:-}" == "INTERNAL" ]]; then
                    printf 'INTERNAL\n' > "${STORAGE_CURRENT}"
                elif [[ -n "${3:-}" ]]; then
                    printf '%s %s\n' "${2}" "${3}" > "${STORAGE_CURRENT}"
                else
                    exit 1
                fi
                ;;
            *)
                if [[ -n "${2:-}" ]]; then
                    mkdir -p "${HIPPOS_CONFIG}"
                    printf '%s\n' "${2}" > "${STORAGE_CURRENT}"
                fi
                ;;
        esac
        ;;
    *)
        exit 0
        ;;
esac
