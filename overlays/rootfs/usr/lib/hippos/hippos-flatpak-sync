#!/usr/bin/env python3

from __future__ import annotations

import subprocess
from pathlib import Path

import hippos_quiver
from hippos_appstream import read_app_details
from hippos_flatpak_apps import claimed_apps
from hippos_launcher_sync import GameMetadata, reload_es, sync_gamelist, sync_launchers

USERDATA   = Path('/userdata')
ROMS_DIR   = USERDATA / 'roms' / 'flatpak'
STATE_FILE = USERDATA / 'system' / 'flatpak-launchers.json'
APPS_DIR   = USERDATA / 'roms' / 'webapps'
APPS_STATE_FILE = USERDATA / 'system' / 'linux-apps-flatpak-launchers.json'
NO_ICON_APPS = frozenset({hippos_quiver.APP_ID})

def log(message: str) -> None:
    print(f'[hippos-flatpak-sync] {message}', flush=True)

def installed_apps() -> dict[str, str]:
    try:
        result = subprocess.run(
            ['flatpak', 'list', '--app', '--columns=application,name'],
            capture_output=True, text=True, timeout=30,
        )
        apps: dict[str, str] = {}
        for line in result.stdout.splitlines():
            parts = line.split('\t', 1)
            if len(parts) == 2:
                app_id, name = parts[0].strip(), parts[1].strip()
                if app_id:
                    apps[app_id] = name or app_id
        return apps
    except Exception as exc:
        log(f'flatpak list failed: {exc}')
        return {}

def metadata_for(app_id: str, name: str) -> GameMetadata:
    details = read_app_details(app_id)
    icon = None if app_id in NO_ICON_APPS else details.icon
    return GameMetadata(name, details.description, details.developer, icon)

def sync_folder(roms_dir: Path, state_file: Path, apps: dict[str, str]) -> bool:
    created, updated, removed = sync_launchers(roms_dir, state_file, '.flatpak', apps, 'Flatpak App')
    games = {app_id: metadata_for(app_id, name) for app_id, name in apps.items()}
    details_changed = sync_gamelist(roms_dir, state_file, '.flatpak', games)
    log(f'{roms_dir.name}: found={len(apps)} created={created} updated={updated} removed={removed} '
        f'details_changed={details_changed}')
    return bool(created or updated or removed or details_changed)

def sync() -> int:
    apps = installed_apps()
    claimed = claimed_apps()
    linux_apps = {app_id: name for app_id, name in apps.items() if app_id in claimed}
    flatpak_apps = {app_id: name for app_id, name in apps.items() if app_id not in claimed}
    changed = sync_folder(ROMS_DIR, STATE_FILE, flatpak_apps)
    changed |= sync_folder(APPS_DIR, APPS_STATE_FILE, linux_apps)
    if changed:
        reload_es()
    return 0

if __name__ == '__main__':
    raise SystemExit(sync())
