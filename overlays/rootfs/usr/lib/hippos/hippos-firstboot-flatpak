#!/usr/bin/env bash
set -euo pipefail

MARKER="/userdata/.config/hippos/flatpak-apps-installed"
ATTEMPTS_FILE="/userdata/.config/hippos/flatpak-firstboot-attempts"
MAX_ATTEMPTS=5

log() { echo "[hippos-firstboot-flatpak] $*"; }

if [[ -f "${MARKER}" ]]; then
    log "Already installed — skipping"
    exit 0
fi

if [[ ! -w /userdata ]]; then
    log "/userdata not writable — skipping" >&2
    exit 1
fi

log "Waiting for internet connectivity..."
until curl -s --connect-timeout 5 --max-time 10 -o /dev/null https://flathub.org; do
    sleep 30
done
log "Internet available — proceeding with install"

APPS=(
    com.github.joseexposito.touche
    com.vysp3r.ProtonPlus
    com.github.tchx84.Flatseal
    it.mijorus.gearlever
    org.localsend.localsend_app
    io.missioncenter.MissionCenter
)
if [[ "$(uname -m)" == "x86_64" ]]; then
    APPS+=(com.usebottles.bottles com.heroicgameslauncher.hgl)
fi

log "Ensuring Flathub remote is configured"
runuser -l hippos -c "flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo" \
    || log "Warning: could not add Flathub remote — installs may fail"

log "Fetching Flathub appstream data"
runuser -l hippos -c "flatpak update --appstream --user flathub" \
    || log "Warning: appstream update failed"

log "Installing ${#APPS[@]} flatpak apps to /userdata"

mkdir -p "$(dirname "${ATTEMPTS_FILE}")"
attempt="$(( $(cat "${ATTEMPTS_FILE}" 2>/dev/null || echo 0) + 1 ))"
echo "${attempt}" > "${ATTEMPTS_FILE}"

failed=0
for app in "${APPS[@]}"; do
    if runuser -l hippos -c "flatpak info --user '${app}' >/dev/null 2>&1"; then
        continue
    fi
    log "Installing ${app}"
    runuser -l hippos -c "flatpak install --user --noninteractive --assumeyes flathub '${app}'" \
        && log "  OK: ${app}" \
        || { log "  Warning: failed to install ${app}"; failed=$(( failed + 1 )); }
done

if [[ "${failed}" -eq 0 ]]; then
    mkdir -p "$(dirname "${MARKER}")"
    touch "${MARKER}"
    rm -f "${ATTEMPTS_FILE}"
    log "Done"
elif [[ "${attempt}" -ge "${MAX_ATTEMPTS}" ]]; then
    mkdir -p "$(dirname "${MARKER}")"
    touch "${MARKER}"
    log "Done with ${failed} failure(s) after ${attempt} attempts — giving up, not retrying further"
else
    log "Done with ${failed} failure(s) (attempt ${attempt}/${MAX_ATTEMPTS}) — will retry next boot"
    exit 1
fi
