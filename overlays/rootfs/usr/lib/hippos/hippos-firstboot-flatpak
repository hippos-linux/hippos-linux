#!/usr/bin/env bash
set -euo pipefail

MARKER="/userdata/.config/hippos/flatpak-apps-installed"
ATTEMPTS_FILE="/userdata/.config/hippos/flatpak-firstboot-attempts"
MAX_ATTEMPTS=5

log() { echo "[hippos-firstboot-flatpak] $*"; }

APPS_INSTALLING_FLAG="/run/hippos/apps-installing"
ES_API="http://127.0.0.1:1234"
PROGRESS_ID="firstboot-apps"

es_progress() {
    curl -sf -X POST -d "" "${ES_API}/progress" --url-query "id=${PROGRESS_ID}" "$@" >/dev/null 2>&1 || true
}

if [[ ! -w /userdata ]]; then
    log "/userdata not writable — skipping" >&2
    exit 1
fi

APPS=(
    com.github.joseexposito.touche
    com.github.tchx84.Flatseal
    it.mijorus.gearlever
    org.localsend.localsend_app
    io.missioncenter.MissionCenter
)
if [[ "$(uname -m)" == "x86_64" ]]; then
    APPS+=(com.usebottles.bottles com.heroicgameslauncher.hgl com.vysp3r.ProtonPlus)
fi

offer=()
for app in "${APPS[@]}"; do
    grep -qxF "${app}" "${MARKER}" 2>/dev/null || offer+=("${app}")
done
if [[ "${#offer[@]}" -eq 0 ]]; then
    log "No new apps to offer"
    exit 0
fi

mark_offered() {
    mkdir -p "$(dirname "${MARKER}")"
    printf '%s\n' "${offer[@]}" >> "${MARKER}"
    sort -u -o "${MARKER}" "${MARKER}"
    chown hippos:users "${MARKER}"
}

log "Waiting for internet connectivity..."
until curl -s --connect-timeout 5 --max-time 10 -o /dev/null https://flathub.org; do
    sleep 30
done
log "Internet available — proceeding with install"

log "Ensuring Flathub remote is configured"
runuser -l hippos -c "flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo" \
    || log "Warning: could not add Flathub remote — installs may fail"

log "Fetching Flathub appstream data"
runuser -l hippos -c "flatpak update --appstream --user flathub" \
    || log "Warning: appstream update failed"

log "Installing ${#offer[@]} flatpak apps to /userdata"

mkdir -p "$(dirname "${ATTEMPTS_FILE}")"
attempt="$(( $(cat "${ATTEMPTS_FILE}" 2>/dev/null || echo 0) + 1 ))"
echo "${attempt}" > "${ATTEMPTS_FILE}"

pending=()
for app in "${offer[@]}"; do
    runuser -l hippos -c "flatpak info --user '${app}' >/dev/null 2>&1" || pending+=("${app}")
done

failed=0
installed=0
if [[ "${#pending[@]}" -gt 0 ]]; then
    mkdir -p "$(dirname "${APPS_INSTALLING_FLAG}")"
    touch "${APPS_INSTALLING_FLAG}"
    trap 'rm -f "${APPS_INSTALLING_FLAG}"; es_progress --url-query "done=1"' EXIT
    for i in "${!pending[@]}"; do
        app="${pending[$i]}"
        app_name="$(runuser -l hippos -c "flatpak remote-info --user flathub '${app}'" 2>/dev/null | awk -F' - ' 'NF { print $1; exit }')"
        es_progress --url-query "title=INSTALLING APPS" \
            --url-query "text=${app_name:-${app##*.}} ($(( i + 1 ))/${#pending[@]})" \
            --url-query "percent=$(( i * 100 / ${#pending[@]} ))"
        log "Installing ${app}"
        if runuser -l hippos -c "flatpak install --user --noninteractive --assumeyes flathub '${app}'"; then
            log "  OK: ${app}"
            installed=$(( installed + 1 ))
        else
            log "  Warning: failed to install ${app}"
            failed=$(( failed + 1 ))
        fi
    done
    [[ "${installed}" -eq 0 ]] || systemctl restart hippos-flatpak-sync.service || true
    rm -f "${APPS_INSTALLING_FLAG}"
    es_progress --url-query "done=1"
    trap - EXIT
    if [[ "${installed}" -gt 0 ]]; then
        message="${installed} new apps are installed. Refresh the game lists to show them?"
        [[ "${installed}" -eq 1 ]] && message="1 new app is installed. Refresh the game lists to show it?"
        curl -sf -X POST "${ES_API}/reloadgames" --data "${message}" >/dev/null 2>&1 || true
    fi
fi

if [[ "${failed}" -eq 0 ]]; then
    mark_offered
    rm -f "${ATTEMPTS_FILE}"
    log "Done"
elif [[ "${attempt}" -ge "${MAX_ATTEMPTS}" ]]; then
    mark_offered
    rm -f "${ATTEMPTS_FILE}"
    log "Done with ${failed} failure(s) after ${attempt} attempts — giving up, not retrying further"
else
    log "Done with ${failed} failure(s) (attempt ${attempt}/${MAX_ATTEMPTS}) — will retry next boot"
    exit 1
fi
