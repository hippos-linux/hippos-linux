WINE_LIST_LIMIT = 10

DEB_ARCH       = {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine(), platform.machine())
ES_SYSTEMS_CFG = "/usr/share/emulationstation/es_systems.cfg"

def _gh_get(url):
    req = urllib.request.Request(url, headers={
        "User-Agent":  "hippos-store/1.0",
        "Accept":      "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    })
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read())

def load_catalog():
    req = urllib.request.Request(CATALOG_URL, headers={"User-Agent": "hippos-store/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))["packages"]
    except Exception as exc:
        print(f"Error: could not fetch catalog: {exc}", file=sys.stderr)
        return []

def load_state():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE) as f:
            return json.load(f)
    return {}

def save_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)

def _runner_id(source_id, asset_name):
    stem = asset_name
    for ext in (".tar.xz", ".tar.gz", ".tar.bz2"):
        stem = stem.removesuffix(ext)
    return f"wine::{source_id}::{stem}"

def _runner_install_dir(runner_id):
    stem = runner_id.split("::", 2)[-1]
    return os.path.join(WINE_RUNNERS_DIR, stem)

def load_wine_runners(force_refresh=False):
    if not force_refresh and os.path.exists(WINE_CACHE):
        age = time.time() - os.path.getmtime(WINE_CACHE)
        if age < WINE_CACHE_TTL:
            try:
                with open(WINE_CACHE) as f:
                    return json.load(f)
            except (OSError, ValueError):
                pass

    runners = []
    for src in WINE_SOURCES:
        try:
            releases = _gh_get(src["api"])
            for rel in releases:
                for asset in rel.get("assets", []):
                    if not src["pick"](asset):
                        continue
                    rid = _runner_id(src["id"], asset["name"])
                    runners.append({
                        "id":          rid,
                        "name":        asset["name"].removesuffix(".tar.xz").removesuffix(".tar.gz"),
                        "description": f"{src['label']} — {rel.get('tag_name', '')}",
                        "label":       src["label"],
                        "category":    src["id"],
                        "packager":    src["packager"],
                        "version":     rel.get("tag_name", "unknown"),
                        "download_size": asset.get("size", 0),
                        "url":         asset["browser_download_url"],
                    })
        except Exception as e:
            print(f"WARNING: Could not fetch {src['label']}: {e}", file=sys.stderr)

    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = WINE_CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(runners, f)
    os.replace(tmp, WINE_CACHE)

    return runners

CATALOG_TABS = {
    "ports":   "Games",
    "webapps": "Web Apps",
    "shaders": "Shaders",
    "cheats":  "Cheats",
}

def catalog_section(pkg):
    if pkg.get("type") == "webapp":
        return "Streaming and web apps"
    if pkg.get("type") == "installer":
        return "Launchers"
    if pkg.get("scummvm_id"):
        return "ScummVM classics"
    if pkg.get("category") == "ports":
        return "Open-source games"
    return "RetroArch"

def for_this_machine(pkg):
    arch = pkg.get("arch", "")
    return not arch or arch == DEB_ARCH

def system_full_names():
    names = {}
    try:
        for system in ET.parse(ES_SYSTEMS_CFG).getroot().iter("system"):
            name, fullname = system.findtext("name"), system.findtext("fullname")
            if name and fullname:
                names[name] = fullname
    except (OSError, ET.ParseError):
        pass
    return names

def _pkg_node(root, pkg_id, title, repository, version, description, group, packager, installed, url, download_size, preview_url):
    node = ET.SubElement(root, "package")
    ET.SubElement(node, "name").text              = pkg_id
    ET.SubElement(node, "title").text             = title
    ET.SubElement(node, "repository").text        = repository
    ET.SubElement(node, "available_version").text = version
    ET.SubElement(node, "description").text       = description
    ET.SubElement(node, "group").text             = group
    ET.SubElement(node, "packager").text          = packager
    ET.SubElement(node, "status").text            = "installed" if installed else "available"
    ET.SubElement(node, "url").text               = url
    ET.SubElement(node, "download_size").text     = str(download_size)
    ET.SubElement(node, "installed_size").text    = str(download_size)
    ET.SubElement(node, "preview_url").text       = preview_url

def is_installed(pkg, state):
    if pkg.get("type") == "webapp":
        url = hippos_webapps.normalise_url(pkg.get("webapp_url", ""))
        return any(app.url == url for app in hippos_webapps.load_webapps())
    return pkg["id"] in state

def cmd_list():
    catalog = load_catalog()
    state   = load_state()

    root = ET.Element("packages")

    tab_order = list(CATALOG_TABS)
    for pkg in sorted(catalog, key=lambda p: tab_order.index(p["category"]) if p.get("category") in tab_order else len(tab_order)):
        pkg_id = pkg["id"]
        tab = CATALOG_TABS.get(pkg.get("category", ""))
        if tab is None or not for_this_machine(pkg):
            continue
        _pkg_node(root,
            pkg_id        = pkg_id,
            title         = pkg.get("name", pkg_id),
            repository    = tab,
            version       = pkg.get("version", "latest"),
            description   = pkg.get("description", ""),
            group         = catalog_section(pkg),
            packager      = pkg.get("packager", "HippOS"),
            installed     = is_installed(pkg, state),
            url           = pkg.get("url", ""),
            download_size = pkg.get("download_size", 0),
            preview_url   = pkg.get("preview_url", ""),
        )

    try:
        runners = load_wine_runners()
        counts  = {}
        for runner in runners:
            src_id = runner["category"]
            if counts.get(src_id, 0) >= WINE_LIST_LIMIT:
                continue
            counts[src_id] = counts.get(src_id, 0) + 1
            _pkg_node(root,
                pkg_id        = runner["id"],
                title         = runner["name"],
                repository    = "Wine",
                version       = runner.get("version", "unknown"),
                description   = runner.get("description", runner["name"]),
                group         = runner.get("label", runner["category"]),
                packager      = runner.get("packager", ""),
                installed     = runner["id"] in state,
                url           = runner.get("url", ""),
                download_size = runner.get("download_size", 0),
                preview_url   = "",
            )
    except Exception as e:
        print(f"WARNING: Could not load wine runners: {e}", file=sys.stderr)

    try:
        result = subprocess.run(["hippos-bezelproject", "list"], capture_output=True, text=True, timeout=5)
        full_names = system_full_names()
        for line in result.stdout.splitlines():
            parts = line.split()
            if len(parts) < 2:
                continue
            installed_flag, system_id = parts[0], parts[1]
            _pkg_node(root,
                pkg_id        = f"bezels-{system_id}",
                title         = full_names.get(system_id, system_id.upper()),
                repository    = "Bezels",
                version       = "latest",
                description   = "Game bezels from The Bezel Project",
                group         = "The Bezel Project",
                packager      = "TheBezelProject",
                installed     = installed_flag == "[I]",
                url           = "",
                download_size = 0,
                preview_url   = "",
            )
    except Exception as e:
        print(f"WARNING: Could not load bezels: {e}", file=sys.stderr)

    print("<packages>", flush=True)
    for pkg_node in root:
        print(ET.tostring(pkg_node, encoding="unicode"), flush=True)
    print("</packages>", flush=True)

def _download(url, dest_path, label):
    req = urllib.request.Request(url, headers={"User-Agent": "hippos-store/1.0"})
    print(f"Downloading {label}...", flush=True)
    with urllib.request.urlopen(req) as resp, open(dest_path, "wb") as out:
        total = int(resp.headers.get("Content-Length", 0))
        done  = 0
        while chunk := resp.read(131072):
            out.write(chunk)
            done += len(chunk)
            if total:
                print(f"Downloading {label}... {done * 100 // total}%", flush=True)

def _extract_tarball(archive, dest, strip_components, source_subdir):
    print("Extracting...", flush=True)
    os.makedirs(dest, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            with tarfile.open(archive) as tf:
                members = []
                for m in tf.getmembers():
                    parts = m.name.split("/")
                    if len(parts) <= strip_components:
                        continue
                    m.name = "/".join(parts[strip_components:])
                    if m.name:
                        members.append(m)
                tf.extractall(tmpdir, members=members)
        except tarfile.CompressionError:
            subprocess.run(["tar", "-xf", archive, "-C", tmpdir], check=True)

        src = os.path.join(tmpdir, source_subdir) if source_subdir else tmpdir
        if not os.path.isdir(src):
            src = tmpdir

        for item in os.listdir(src):
            s, d = os.path.join(src, item), os.path.join(dest, item)
            if os.path.isdir(s):
                if os.path.exists(d):
                    shutil.rmtree(d)
                shutil.copytree(s, d)
            else:
                shutil.copy2(s, d)

def _install_wine_runner(pkg):
    dest = _runner_install_dir(pkg["id"])
    os.makedirs(CACHE_DIR, exist_ok=True)
    url  = pkg["url"]
    ext  = ".tar.xz" if url.endswith(".tar.xz") else ".tar.gz"
    archive = os.path.join(CACHE_DIR, pkg["id"].replace("::", "_") + ext)
    _download(url, archive, pkg["name"])
    _extract_tarball(archive, dest, strip_components=1, source_subdir="")
    try:
        os.remove(archive)
    except Exception:
        pass

def _install_catalog_tarball(pkg):
    category     = pkg.get("category", "")
    dest_root    = INSTALL_ROOTS.get(category, "/userdata/roms/ports")
    install_path = pkg.get("install_path", "")
    dest         = os.path.join(dest_root, install_path) if install_path else dest_root
    os.makedirs(CACHE_DIR, exist_ok=True)
    archive = os.path.join(CACHE_DIR, pkg["id"] + ".tar.gz")
    _download(pkg["url"], archive, pkg["name"])
    _extract_tarball(archive, dest, pkg.get("strip_components", 1), pkg.get("source_subdir", ""))

SCUMMVM_ROMS     = "/userdata/roms/scummvm"
SCUMMVM_GAMELIST = "/userdata/roms/scummvm/gamelist.xml"

def _scummvm_add(pkg):
    scummvm_id = pkg["scummvm_id"]
    os.makedirs(SCUMMVM_ROMS, exist_ok=True)
    dot_scummvm = os.path.join(SCUMMVM_ROMS, f"{scummvm_id}.scummvm")
    with open(dot_scummvm, "w") as f:
        f.write(f"{scummvm_id}\n")

    try:
        tree = ET.parse(SCUMMVM_GAMELIST)
        root = tree.getroot()
    except (FileNotFoundError, ET.ParseError):
        root = ET.Element("gameList")

    entry_path = f"./{scummvm_id}.scummvm"
    for existing in root.findall("game"):
        if existing.findtext("path") == entry_path:
            return

    node = ET.SubElement(root, "game")
    ET.SubElement(node, "path").text  = entry_path
    ET.SubElement(node, "name").text  = pkg.get("name", pkg["id"])
    ET.SubElement(node, "desc").text  = pkg.get("description", "")
    ET.SubElement(node, "genre").text = pkg.get("genre", "")

    ET.indent(root, space="    ")
    os.makedirs(SCUMMVM_ROMS, exist_ok=True)
    with open(SCUMMVM_GAMELIST, "wb") as f:
        f.write(b'<?xml version="1.0"?>\n')
        ET.ElementTree(root).write(f, encoding="utf-8", xml_declaration=False)

def _scummvm_remove(pkg):
    scummvm_id = pkg["scummvm_id"]
    dot_scummvm = os.path.join(SCUMMVM_ROMS, f"{scummvm_id}.scummvm")
    if os.path.exists(dot_scummvm):
        os.remove(dot_scummvm)

    entry_path = f"./{scummvm_id}.scummvm"
    try:
        tree = ET.parse(SCUMMVM_GAMELIST)
        root = tree.getroot()
    except (FileNotFoundError, ET.ParseError):
        return

    for node in root.findall("game"):
        if node.findtext("path") == entry_path:
            root.remove(node)
            break

    with open(SCUMMVM_GAMELIST, "wb") as f:
        f.write(b'<?xml version="1.0"?>\n')
        ET.ElementTree(root).write(f, encoding="utf-8", xml_declaration=False)

def _install_apt(pkg):
    apt_pkgs     = pkg.get("apt_packages", [])
    launcher_cmd = pkg.get("launcher_command", "")
    scummvm_id   = pkg.get("scummvm_id", "")
    print(f"Installing {pkg['name']} via apt...", flush=True)
    env = {**os.environ, "DEBIAN_FRONTEND": "noninteractive"}
    subprocess.call(["sudo", "-n", "apt-get", "update", "-qq"], env=env)
    set_claimed(apt_pkgs, True)
    ret = subprocess.call(["sudo", "-n", "apt-get", "install", "-y", "--no-install-recommends"] + apt_pkgs, env=env)
    if ret != 0:
        set_claimed(apt_pkgs, False)
        print(f"ERROR: apt install failed (exit {ret})", flush=True)
        sys.exit(1)
    if scummvm_id:
        _scummvm_add(pkg)
    elif launcher_cmd:
        add_catalog_game(pkg)

def _install_with_installer(pkg):
    print(f"Installing {pkg['name']}...", flush=True)
    ret = hippos_content_installers.run(pkg.get("installer", ""), "install")
    if ret != 0:
        print(f"ERROR: install failed (exit {ret})", flush=True)
        sys.exit(1)
    if pkg.get("launcher_command"):
        add_catalog_game(pkg)

def cmd_install(name):
    state = load_state()

    if name.startswith("bezels-"):
        system_id = name[len("bezels-"):]
        print(f"Installing bezels for {system_id}...", flush=True)
        ret = subprocess.call(["hippos-bezelproject", "install", system_id])
        if ret != 0:
            print(f"ERROR: bezel install failed (exit {ret})", flush=True)
            sys.exit(1)
        return

    if name.startswith("wine::"):
        runners = load_wine_runners()
        pkg = next((r for r in runners if r["id"] == name), None)
        if pkg is None:
            print(f"ERROR: Wine runner '{name}' not found", flush=True)
            sys.exit(1)
        _install_wine_runner(pkg)
        state[name] = {"version": pkg.get("version", "unknown")}
        save_state(state)
        print(f"Done: {pkg['name']} installed to {_runner_install_dir(name)}", flush=True)
        return

    catalog = load_catalog()
    pkg = next((p for p in catalog if p["id"] == name), None)
    if pkg is None:
        print(f"ERROR: Package '{name}' not found", flush=True)
        sys.exit(1)

    if pkg.get("type") == "apt":
        _install_apt(pkg)
    elif pkg.get("type") == "installer":
        _install_with_installer(pkg)
    elif pkg.get("type") == "webapp":
        print(f"Adding {pkg['name']} to Web Apps...", flush=True)
        try:
            hippos_webapps.add(pkg["name"], pkg["webapp_url"], pkg.get("icon_url", ""), pkg.get("description", ""))
        except (OSError, subprocess.CalledProcessError) as exc:
            print(f"ERROR: {exc}", flush=True)
            sys.exit(1)
    else:
        _install_catalog_tarball(pkg)

    state[name] = {"version": pkg.get("version", "latest")}
    save_state(state)
    print(f"Done: {pkg['name']} installed.", flush=True)

def cmd_remove(name):
    state = load_state()

    if name.startswith("bezels-"):
        system_id = name[len("bezels-"):]
        subprocess.call(["hippos-bezelproject", "remove", system_id])
        print(f"Done: bezels for {system_id} removed.", flush=True)
        return

    if name.startswith("wine::"):
        dest = _runner_install_dir(name)
        if os.path.isdir(dest):
            print(f"Removing {dest}...", flush=True)
            shutil.rmtree(dest)
        state.pop(name, None)
        save_state(state)
        print("Done.", flush=True)
        return

    catalog = load_catalog()
    pkg = next((p for p in catalog if p["id"] == name), None)
    if pkg is None:
        print(f"ERROR: Package '{name}' not found", flush=True)
        sys.exit(1)

    if pkg.get("type") == "webapp":
        hippos_webapps.remove(pkg.get("webapp_url", ""))
    elif pkg.get("type") == "installer":
        hippos_content_installers.run(pkg.get("installer", ""), "remove")
        remove_catalog_game(name)
    elif pkg.get("type") == "apt":
        subprocess.call(["sudo", "-n", "apt-get", "remove", "-y"] + pkg.get("apt_packages", []))
        set_claimed(pkg.get("apt_packages", []), False)
        if pkg.get("scummvm_id"):
            _scummvm_remove(pkg)
        else:
            remove_catalog_game(name)
    else:
        dest_root    = INSTALL_ROOTS.get(pkg.get("category", ""), "/userdata/roms/ports")
        install_path = pkg.get("install_path", "")
        if install_path:
            target = os.path.join(dest_root, install_path)
            if os.path.isdir(target):
                print(f"Removing {target}...", flush=True)
                shutil.rmtree(target)

    state.pop(name, None)
    save_state(state)
    print(f"Done: {pkg['name']} removed.", flush=True)

def cmd_refresh():
    load_wine_runners(force_refresh=True)

def cmd_clean_all():
    if os.path.isdir(CACHE_DIR):
        shutil.rmtree(CACHE_DIR)
    if os.path.exists(WINE_CACHE):
        os.remove(WINE_CACHE)

def cmd_update():
    state = load_state()
    for name in list(state.keys()):
        print(f"Updating {name}...", flush=True)
        cmd_install(name)

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "list":
        cmd_list()
    elif cmd == "install" and len(sys.argv) >= 3:
        cmd_install(sys.argv[2])
    elif cmd == "remove" and len(sys.argv) >= 3:
        cmd_remove(sys.argv[2])
    elif cmd == "refresh":
        cmd_refresh()
    elif cmd == "clean-all":
        cmd_clean_all()
    elif cmd == "update":
        cmd_update()
    else:
        print("Usage: hippos-store <list|install NAME|remove NAME|refresh|clean-all|update>")
        sys.exit(1)
