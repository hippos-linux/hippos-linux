#!/usr/bin/env bash
# hippos-power-mode — set CPU governor + Energy Performance Preference
# Usage: hippos-power-mode [ac|battery|highperformance|balanced|powersaver|default]

POLICY0="/sys/devices/system/cpu/cpufreq/policy0"
EPP_PATH="/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference"
EPP_AVAIL_PATH="/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_available_preferences"

[[ -f "${POLICY0}/scaling_governor" && -f "${POLICY0}/scaling_available_governors" ]] || exit 0

has_epp() { [[ -f "${EPP_PATH}" ]]; }

has_governor() {
    grep -qw "$1" "${POLICY0}/scaling_available_governors" 2>/dev/null
}

has_epp_pref() {
    [[ -f "${EPP_AVAIL_PATH}" ]] && grep -qw "$1" "${EPP_AVAIL_PATH}" 2>/dev/null
}

set_governor() {
    local gov="$1"
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [[ -f "${policy}/scaling_governor" ]] || continue
        [[ "$(cat "${policy}/scaling_governor")" == "${gov}" ]] && continue
        echo "${gov}" > "${policy}/scaling_governor" 2>/dev/null || true
    done
}

set_epp() {
    local pref="$1"
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [[ -f "${cpu}" ]] || continue
        echo "${pref}" > "${cpu}" 2>/dev/null || true
    done
}

apply_mode() {
    local mode="$1"
    case "${mode}" in
        highperformance)
            set_governor performance
            has_epp && has_epp_pref performance && set_epp performance
            ;;
        balanced)
            if has_governor schedutil; then set_governor schedutil
            elif has_governor ondemand; then set_governor ondemand
            elif has_governor conservative; then set_governor conservative
            else set_governor powersave; fi
            if has_epp; then
                if has_epp_pref default; then set_epp default
                elif has_epp_pref performance; then set_epp performance; fi
            fi
            ;;
        powersaver)
            set_governor powersave
            has_epp && has_epp_pref power && set_epp power
            ;;
    esac
}

case "$1" in
    ac)
        mode="$(hippos-settings get global.powermode 2>/dev/null || true)"
        [[ -z "${mode}" ]] && mode=balanced
        apply_mode "${mode}"
        ;;
    battery)
        mode="$(hippos-settings get global.batterymode 2>/dev/null || true)"
        [[ -z "${mode}" ]] && mode=balanced
        apply_mode "${mode}"
        ;;
    highperformance|balanced|powersaver)
        apply_mode "$1"
        ;;
    default)
        mode="$(hippos-settings get global.powermode 2>/dev/null || true)"
        [[ -z "${mode}" ]] && mode=balanced
        apply_mode "${mode}"
        ;;
    *)
        echo "Usage: $0 [ac|battery|highperformance|balanced|powersaver|default]" >&2
        exit 1
        ;;
esac
