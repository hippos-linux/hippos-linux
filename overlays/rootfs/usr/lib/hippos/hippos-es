#!/usr/bin/env bash
set -euo pipefail

mkdir -p /userdata/system /run/hippos

# A killed WM leaves _NET_SUPPORTING_WM_CHECK on the root window pointing at
# its destroyed check window, so the property alone doesn't prove a WM is
# still running — the window it names has to exist too.
wm_running() {
    local check_window
    check_window=$(DISPLAY=:0 xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | awk '/window id/ {print $NF}')
    [[ -n "${check_window}" ]] && DISPLAY=:0 xprop -id "${check_window}" >/dev/null 2>&1
}

x_running() {
    DISPLAY=:0 xprop -root >/dev/null 2>&1
}

while true; do
    # session-es can't start without X; exit so systemd's restart and
    # failure handling see a dead X server instead of spinning here.
    if ! x_running; then
        echo "hippos-es: X server :0 is not reachable" >&2
        exit 1
    fi

    # A desktop's own user units outlive its session scope: shell components
    # bind to graphical-session.target, and apps it launched (GNOME's session
    # manager and autostart apps among them) get app-*.scope/app-*.slice units.
    # A leftover session manager stops the next desktop from starting. Never
    # stop app.slice itself: that cuts the user manager off its bus.
    XDG_RUNTIME_DIR=/run/user/1000 systemctl --user stop \
        graphical-session.target 'app-*.scope' 'app-*.slice' 2>/dev/null || true
    pkill -KILL -u hippos -f "ksmserver|startplasma" 2>/dev/null || true
    # Wait for the previous WM to exit; force-kill if it lingers.
    for _ in $(seq 1 20); do
        wm_running || break
        pkill -KILL -u hippos kwin_x11 2>/dev/null || true
        sleep 0.5
    done
    /usr/lib/hippos/session-es || true
    [[ -f /run/hippos/quit-action ]] && break
    sleep 1
done
