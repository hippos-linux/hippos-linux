#!/usr/bin/env bash
# Run userdata migrations when the HippOS version changes.
# Each migration block is guarded by version comparison.

VERSION_FILE=/usr/share/hippos/version
APPLIED_FILE=/userdata/system/.hippos-version

log() { printf '[hippos-migrate] %s\n' "$*"; }

CURRENT=$(cat "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]')
APPLIED=$(cat "$APPLIED_FILE" 2>/dev/null | tr -d '[:space:]' || true)

if [[ -z "$CURRENT" ]]; then
    log "error: no version file at $VERSION_FILE"
    exit 1
fi

if [[ "$APPLIED" == "$CURRENT" ]]; then
    log "already at $CURRENT"
    exit 0
fi

log "migrating '$APPLIED' -> '$CURRENT'"

# ── version_lt <a> <b>: true if a < b (semver) ───────────────────────────────
version_lt() {
    [[ "$1" != "$2" ]] && \
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]]
}

# ── migrations ────────────────────────────────────────────────────────────────
# Add blocks here as new versions introduce breaking changes. Example:
#
# if version_lt "$APPLIED" "0.2.0"; then
#     log "0.2.0: rename foo to bar in hippos.conf"
#     sed -i 's/^foo=/bar=/' /userdata/system/hippos.conf 2>/dev/null || true
# fi

if version_lt "$APPLIED" "0.6.1"; then
    log "0.6.1: CRT activation is now manual-only — migrate crt.enabled=auto"
    # Auto-detection used to decide FOR the user whether to turn CRT mode on
    # (VGA/DVI-I presence + an EDID-absence heuristic). That's gone — an old
    # "auto" can't be safely translated into an explicit crt.output selection
    # (we don't know the hardware/cabling is still the same), so this lands
    # on disabled rather than guessing a connector and applying CRT timings
    # to what might now be a normal LCD/TV. The user re-enables explicitly
    # via System Settings → CRT if they still want it.
    if [[ "$(hippos-settings get crt.enabled 2>/dev/null)" == "auto" ]]; then
        hippos-settings set crt.enabled false
    fi
    if [[ "$(hippos-settings get crt.output 2>/dev/null)" == "auto" ]]; then
        hippos-settings del crt.output
    fi
fi

# Storage manager state files are intentionally plain text and safe to create
# before any external media has been mounted.
HIPPOS_CONFIG=/userdata/system/configs/hippos
mkdir -p "${HIPPOS_CONFIG}"
for name in external-roms.conf roms-sources.conf ignored-storage-devices.txt current-storage.conf; do
    if [[ -e "/userdata/system/${name}" && ! -e "${HIPPOS_CONFIG}/${name}" ]]; then
        mv "/userdata/system/${name}" "${HIPPOS_CONFIG}/${name}"
    fi
done
touch "${HIPPOS_CONFIG}/external-roms.conf"
touch "${HIPPOS_CONFIG}/roms-sources.conf"
touch "${HIPPOS_CONFIG}/ignored-storage-devices.txt"
if [[ ! -s "${HIPPOS_CONFIG}/current-storage.conf" ]]; then
    printf 'INTERNAL\n' > "${HIPPOS_CONFIG}/current-storage.conf"
fi

# ── record applied version ────────────────────────────────────────────────────
mkdir -p /userdata/system
printf '%s\n' "$CURRENT" > "$APPLIED_FILE"
log "done ($CURRENT)"
