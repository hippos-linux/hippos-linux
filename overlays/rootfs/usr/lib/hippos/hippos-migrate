#!/usr/bin/env bash

VERSION_FILE=/usr/share/hippos/version
APPLIED_FILE=/userdata/system/.hippos-version

log() { printf '[hippos-migrate] %s\n' "$*"; }

CURRENT=$(cat "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]')
APPLIED=$(cat "$APPLIED_FILE" 2>/dev/null | tr -d '[:space:]' || true)

if [[ -z "$CURRENT" ]]; then
    log "error: no version file at $VERSION_FILE"
    exit 1
fi

if [[ "$APPLIED" == "$CURRENT" ]]; then
    log "already at $CURRENT"
    exit 0
fi

log "migrating '$APPLIED' -> '$CURRENT'"

version_lt() {
    [[ "$1" != "$2" ]] && \
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]]
}

if version_lt "$APPLIED" "0.6.1"; then
    log "0.6.1: CRT activation is now manual-only — migrate crt.enabled=auto"
    if [[ "$(hippos-settings get crt.enabled 2>/dev/null)" == "auto" ]]; then
        hippos-settings set crt.enabled false
    fi
    if [[ "$(hippos-settings get crt.output 2>/dev/null)" == "auto" ]]; then
        hippos-settings del crt.output
    fi
fi

if version_lt "$APPLIED" "0.6.5"; then
    log "0.6.5: disable picom damage tracking (stale black regions in desktop mode)"
    PICOM_CONF=/userdata/system/.config/picom/picom.conf
    if [[ -f "${PICOM_CONF}" ]] && ! grep -qE '^\s*use-damage\s*=' "${PICOM_CONF}"; then
        printf '\nuse-damage = false;\n' >> "${PICOM_CONF}"
    fi
fi

if [[ -n "$APPLIED" ]] && version_lt "$APPLIED" "0.6.6"; then
    log "0.6.6: TDP settings are now a percentage of the detected CPU maximum"
    TDP_MAX="$(/usr/lib/hippos/hippos-tdp detect-max)"
    hippos-settings dump | grep -E '(^|\.)tdp=[0-9]+(\.[0-9]+)?$' | grep -v '^system\.' | while IFS='=' read -r key watts; do
        if [[ -z "${TDP_MAX}" ]]; then
            hippos-settings del "${key}"
            continue
        fi
        percent=$(awk -v w="${watts}" -v max="${TDP_MAX}" 'BEGIN {
            p = int(w * 100 / max / 5 + 0.5) * 5
            print (p < 10 ? 10 : (p > 120 ? 120 : p))
        }')
        log "  ${key}: ${watts}W of ${TDP_MAX}W -> ${percent}%"
        hippos-settings set "${key}" "${percent}"
    done
fi

if version_lt "$APPLIED" "0.6.7"; then
    log "0.6.7: es-theme-hippos replaces es-theme-hippos-minimal as the default theme"
    ES_SETTINGS=/userdata/system/configs/emulationstation/es_settings.cfg
    if [[ -f "${ES_SETTINGS}" ]]; then
        sed -i 's/name="ThemeSet" value="es-theme-hippos-minimal"/name="ThemeSet" value="es-theme-hippos"/' "${ES_SETTINGS}"
    fi
fi

if version_lt "$APPLIED" "0.6.8"; then
    log "0.6.8: default language is now en_GB; repair hippos.conf owner and touchegg.conf root"
    if ! grep -q '^system.language=' /userdata/system/hippos.conf 2>/dev/null; then
        hippos-settings set system.language en_GB
    fi
    chown hippos:users /userdata/system/hippos.conf
    rm -rf /userdata/emulators/model2emu/current
    TOUCHEGG_CONF=/userdata/.config/touchegg/touchegg.conf
    if [[ -f "${TOUCHEGG_CONF}" ]]; then
        sed -i 's#<touchegg>#<touchégg>#; s#</touchegg>#</touchégg>#' "${TOUCHEGG_CONF}"
    fi
fi

HIPPOS_CONFIG=/userdata/system/configs/hippos
mkdir -p "${HIPPOS_CONFIG}"
for name in external-roms.conf roms-sources.conf ignored-storage-devices.txt current-storage.conf; do
    if [[ -e "/userdata/system/${name}" && ! -e "${HIPPOS_CONFIG}/${name}" ]]; then
        mv "/userdata/system/${name}" "${HIPPOS_CONFIG}/${name}"
    fi
done
touch "${HIPPOS_CONFIG}/external-roms.conf"
touch "${HIPPOS_CONFIG}/roms-sources.conf"
touch "${HIPPOS_CONFIG}/ignored-storage-devices.txt"
if [[ ! -s "${HIPPOS_CONFIG}/current-storage.conf" ]]; then
    printf 'INTERNAL\n' > "${HIPPOS_CONFIG}/current-storage.conf"
fi
chown -R hippos:users "${HIPPOS_CONFIG}"

mkdir -p /userdata/system
printf '%s\n' "$CURRENT" > "$APPLIED_FILE"
log "done ($CURRENT)"
