#!/usr/bin/env bash

VERSION_FILE=/usr/share/hippos/version
APPLIED_FILE=/userdata/system/.hippos-version

log() { printf '[hippos-migrate] %s\n' "$*"; }

CURRENT=$(cat "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]')
APPLIED=$(cat "$APPLIED_FILE" 2>/dev/null | tr -d '[:space:]' || true)

if [[ -z "$CURRENT" ]]; then
    log "error: no version file at $VERSION_FILE"
    exit 1
fi

if [[ "$APPLIED" == "$CURRENT" ]]; then
    log "already at $CURRENT"
    exit 0
fi

log "migrating '$APPLIED' -> '$CURRENT'"

version_lt() {
    [[ "$1" != "$2" ]] && \
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]]
}

if version_lt "$APPLIED" "0.6.1"; then
    log "0.6.1: CRT activation is now manual-only — migrate crt.enabled=auto"
    if [[ "$(hippos-settings get crt.enabled 2>/dev/null)" == "auto" ]]; then
        hippos-settings set crt.enabled false
    fi
    if [[ "$(hippos-settings get crt.output 2>/dev/null)" == "auto" ]]; then
        hippos-settings del crt.output
    fi
fi

if version_lt "$APPLIED" "0.6.5"; then
    log "0.6.5: disable picom damage tracking (stale black regions in desktop mode)"
    PICOM_CONF=/userdata/system/.config/picom/picom.conf
    if [[ -f "${PICOM_CONF}" ]] && ! grep -qE '^\s*use-damage\s*=' "${PICOM_CONF}"; then
        printf '\nuse-damage = false;\n' >> "${PICOM_CONF}"
    fi
fi

if [[ -n "$APPLIED" ]] && version_lt "$APPLIED" "0.6.6"; then
    log "0.6.6: TDP settings are now a percentage of the detected CPU maximum"
    TDP_MAX="$(/usr/lib/hippos/hippos-tdp detect-max)"
    hippos-settings dump | grep -E '(^|\.)tdp=[0-9]+(\.[0-9]+)?$' | grep -v '^system\.' | while IFS='=' read -r key watts; do
        if [[ -z "${TDP_MAX}" ]]; then
            hippos-settings del "${key}"
            continue
        fi
        percent=$(awk -v w="${watts}" -v max="${TDP_MAX}" 'BEGIN {
            p = int(w * 100 / max / 5 + 0.5) * 5
            print (p < 10 ? 10 : (p > 120 ? 120 : p))
        }')
        log "  ${key}: ${watts}W of ${TDP_MAX}W -> ${percent}%"
        hippos-settings set "${key}" "${percent}"
    done
fi

if version_lt "$APPLIED" "0.6.7"; then
    log "0.6.7: es-theme-hippos replaces es-theme-hippos-minimal as the default theme"
    ES_SETTINGS=/userdata/system/configs/emulationstation/es_settings.cfg
    if [[ -f "${ES_SETTINGS}" ]]; then
        sed -i 's/name="ThemeSet" value="es-theme-hippos-minimal"/name="ThemeSet" value="es-theme-hippos"/' "${ES_SETTINGS}"
    fi
fi

if version_lt "$APPLIED" "0.6.8"; then
    log "0.6.8: default language is now en_GB; repair hippos.conf owner and touchegg.conf root"
    if ! grep -q '^system.language=' /userdata/system/hippos.conf 2>/dev/null; then
        hippos-settings set system.language en_GB
    fi
    chown hippos:users /userdata/system/hippos.conf
    rm -rf /userdata/emulators/model2emu/current
    TOUCHEGG_CONF=/userdata/.config/touchegg/touchegg.conf
    if [[ -f "${TOUCHEGG_CONF}" ]]; then
        sed -i 's#<touchegg>#<touchégg>#; s#</touchegg>#</touchégg>#' "${TOUCHEGG_CONF}"
    fi
fi

if version_lt "$APPLIED" "0.6.12"; then
    log "0.6.12: first-boot apps marker lists offered apps, so apps added later still install"
    FLATPAK_MARKER=/userdata/.config/hippos/flatpak-apps-installed
    if [[ -f "${FLATPAK_MARKER}" && ! -s "${FLATPAK_MARKER}" ]]; then
        printf '%s\n' com.github.joseexposito.touche com.vysp3r.ProtonPlus com.github.tchx84.Flatseal \
            it.mijorus.gearlever org.localsend.localsend_app io.missioncenter.MissionCenter \
            com.usebottles.bottles com.heroicgameslauncher.hgl > "${FLATPAK_MARKER}"
        chown hippos:users "${FLATPAK_MARKER}"
    fi

    log "0.6.12: Discover shortcut on the desktop, listed in ES Desktop Shortcuts"
    if [[ -d /userdata/Desktop && ! -e /userdata/Desktop/discover.desktop && -e /usr/share/applications/org.kde.discover.desktop ]]; then
        ln -s /usr/share/applications/org.kde.discover.desktop /userdata/Desktop/discover.desktop
        chown -h hippos:users /userdata/Desktop/discover.desktop
    fi

    log "0.6.12: apt game claims file renamed for Linux Games"
    if [[ -f /userdata/system/ports-apt-claims ]]; then
        mv /userdata/system/ports-apt-claims /userdata/system/linux-games-apt-claims
    fi
fi

if version_lt "$APPLIED" "0.6.13"; then
    log "0.6.13: native games move from Ports to Linux Games"
    python3 -c 'import sys; sys.path.insert(0, "/usr/lib/hippos"); import hippos_linux_games; [print(f"[hippos-migrate] moved {name} to Linux Games") for name in hippos_linux_games.move_native_launchers_from_ports()]'
    log "0.6.13: saves move to the same folders as Batocera (saves/<system>, saves/duckstation, saves/dolphin-emu...)"
    python3 -c 'import logging, sys; sys.path.insert(0, "/usr/lib/hippos"); logging.basicConfig(level=logging.INFO, format="[hippos-migrate] %(message)s"); import hippos_save_migration; hippos_save_migration.migrate()'
    log "0.6.13: ES reboots and shuts down itself after saving; remove the scripts that did it before saving"
    rm -f /userdata/system/configs/emulationstation/scripts/reboot/reboot /userdata/system/configs/emulationstation/scripts/shutdown/shutdown
fi

if version_lt "$APPLIED" "0.6.14"; then
    log "0.6.14: FreeJ2ME-Plus jar comes from the RetroArch package instead of the Content Downloader"
    ln -sfn /opt/emulators/retroarch/freej2me/freej2me_plus-lr.jar /userdata/bios/freej2me_plus-lr.jar
    chown -h hippos:users /userdata/bios/freej2me_plus-lr.jar
fi

if version_lt "$APPLIED" "0.6.15"; then
    log "0.6.15: ES lists ports from the ports folder and each port's own folder, not the files ports bundle deeper down"
    ES_SETTINGS=/userdata/system/configs/emulationstation/es_settings.cfg
    if [[ -f "${ES_SETTINGS}" ]] && ! grep -q 'name="ports.IndexDirectoryDepth"' "${ES_SETTINGS}"; then
        sed -i 's#</config>#\t<string name="ports.IndexDirectoryDepth" value="1" />\n</config>#' "${ES_SETTINGS}"
    fi
fi

if version_lt "$APPLIED" "0.7.0"; then
    log "0.7.0: Supermodel-es and Supermodel-legacy are replaced by Supermodel; their NVRAM and save states are copied to it"
    for build in supermodel-es supermodel-legacy; do
        for data in NVRAM Saves; do
            if [[ -d "/userdata/system/configs/${build}/${data}" ]]; then
                mkdir -p "/userdata/system/configs/supermodel/${data}"
                cp -rn "/userdata/system/configs/${build}/${data}/." "/userdata/system/configs/supermodel/${data}/"
                chown -R hippos:users /userdata/system/configs/supermodel
            fi
        done
    done

    log "0.7.0: SSH and Samba are switched in ES SERVICES (system.services); system.ssh.enabled is replaced"
    if [[ "$(hippos-settings get system.ssh.enabled 2>/dev/null || true)" == "false" ]]; then
        hippos-services disable ssh
    fi
    hippos-settings del system.ssh.enabled

    log "0.7.0: launcher defaults are generated as defaults.json"
    rm -f /var/lib/hippos/emulators/defaults.yml
fi

PORTMASTER_ZIP=/usr/share/hippos/portmaster/PortMaster.zip
PORTMASTER_PARENT=/userdata/.local/share
if version_lt "$APPLIED" "0.7.1" && [[ -f "$PORTMASTER_ZIP" && ! -e "$PORTMASTER_PARENT/PortMaster" ]]; then
    log "0.7.1: PortMaster is installed for the hippos user"
    mkdir -p "$PORTMASTER_PARENT"
    unzip -q "$PORTMASTER_ZIP" -d "$PORTMASTER_PARENT"
    cp "$PORTMASTER_PARENT/PortMaster/hippos/control.txt" "$PORTMASTER_PARENT/PortMaster/control.txt"
    mkdir -p /userdata/roms/ports
    [[ -e /userdata/roms/ports/PortMaster.sh ]] || cp "$PORTMASTER_PARENT/PortMaster/PortMaster.sh" /userdata/roms/ports/PortMaster.sh
    chown hippos:users /userdata/.local "$PORTMASTER_PARENT"
    chown -R hippos:users "$PORTMASTER_PARENT/PortMaster" /userdata/roms/ports/PortMaster.sh
fi

if version_lt "$APPLIED" "0.7.1" && [[ -d /userdata/Desktop ]]; then
    log "0.7.1: the desktop's Discover shortcut is replaced by HippOS Store"
    [[ -L /userdata/Desktop/discover.desktop ]] && rm /userdata/Desktop/discover.desktop
    if [[ ! -e /userdata/Desktop/software.desktop ]]; then
        ln -s /usr/share/applications/hippos-software.desktop /userdata/Desktop/software.desktop
        chown -h hippos:users /userdata/Desktop/software.desktop
    fi
fi

GTK_SETTINGS=/userdata/system/.config/gtk-3.0/settings.ini
if version_lt "$APPLIED" "0.7.1" && grep -qx 'gtk-icon-theme-name=Adwaita' "${GTK_SETTINGS}" 2>/dev/null; then
    log "0.7.1: GTK apps use the desktop's breeze-dark icons"
    sed -i 's/^gtk-icon-theme-name=Adwaita$/gtk-icon-theme-name=breeze-dark/' "${GTK_SETTINGS}"
fi

if version_lt "$APPLIED" "0.7.1" \
    && grep -qx 'system.cpu.governor=schedutil' /userdata/system/hippos.conf 2>/dev/null \
    && grep -qx 'system.cpu.max_freq=1008000' /userdata/system/hippos.conf; then
    log "0.7.1: saved copies of the old RK3326 CPU defaults removed (now ondemand, no cap)"
    sed -i '/^system\.cpu\.governor=schedutil$/d; /^system\.cpu\.max_freq=1008000$/d' /userdata/system/hippos.conf
fi

if version_lt "$APPLIED" "0.7.2"; then
    log "0.7.2: Discover and GNOME Software are left out in favour of HippOS Store"
    [[ -f /userdata/system/apt-packages.list ]] && sed -i '/^plasma-discover$/d' /userdata/system/apt-packages.list
    AUTOSTART=/userdata/system/.config/autostart
    if [[ ! -e "${AUTOSTART}/org.gnome.Software.desktop" ]]; then
        mkdir -p "${AUTOSTART}"
        printf '[Desktop Entry]\nType=Application\nName=GNOME Software\nHidden=true\n' > "${AUTOSTART}/org.gnome.Software.desktop"
        chown -R hippos:users "${AUTOSTART}"
    fi
fi

DESKTOP_DIR=/userdata/Desktop
if version_lt "$APPLIED" "0.7.2" && [[ -d "${DESKTOP_DIR}" ]]; then
    log "0.7.2: HippOS desktop shortcuts are trusted launchers, not links"
    if [[ -L "${DESKTOP_DIR}/software.desktop" ]]; then
        cp --remove-destination /usr/share/applications/hippos-software.desktop "${DESKTOP_DIR}/software.desktop"
        chown hippos:users "${DESKTOP_DIR}/software.desktop"
    fi
    shortcuts=()
    for name in software switch-to-es; do
        [[ -f "${DESKTOP_DIR}/${name}.desktop" ]] && shortcuts+=("${DESKTOP_DIR}/${name}.desktop")
    done
    if (( ${#shortcuts[@]} )); then
        runuser -u hippos -- env HOME=/userdata \
            dbus-run-session -- sh -c 'for shortcut; do gio set "$shortcut" metadata::trust true; done' sh "${shortcuts[@]}" \
            >/dev/null 2>&1
    fi
fi

if version_lt "$APPLIED" "0.7.2" && compgen -G "/userdata/.local/share/applications/[Ww]eb[Aa]pp-*.desktop" >/dev/null; then
    log "0.7.2: web apps from Linux Mint's Web App Manager become HippOS web apps"
    runuser -u hippos -- env HOME=/userdata /usr/lib/hippos/hippos-webapps import-mint
fi

SHORTCUTS_GAMELIST=/userdata/roms/desktopshortcuts/gamelist.xml
if version_lt "$APPLIED" "0.7.3" && [[ -f "${SHORTCUTS_GAMELIST}" ]]; then
    log "0.7.3: the HippOS Store's games-list entry gets its full description"
    sed -i '\|<desc>Install and update apps, emulators and HippOS itself</desc>|d' "${SHORTCUTS_GAMELIST}"
fi

HIPPOS_CONFIG=/userdata/system/configs/hippos
mkdir -p "${HIPPOS_CONFIG}"
for name in external-roms.conf roms-sources.conf ignored-storage-devices.txt current-storage.conf; do
    if [[ -e "/userdata/system/${name}" && ! -e "${HIPPOS_CONFIG}/${name}" ]]; then
        mv "/userdata/system/${name}" "${HIPPOS_CONFIG}/${name}"
    fi
done
touch "${HIPPOS_CONFIG}/external-roms.conf"
touch "${HIPPOS_CONFIG}/roms-sources.conf"
touch "${HIPPOS_CONFIG}/ignored-storage-devices.txt"
if [[ ! -s "${HIPPOS_CONFIG}/current-storage.conf" ]]; then
    printf 'INTERNAL\n' > "${HIPPOS_CONFIG}/current-storage.conf"
fi
chown -R hippos:users "${HIPPOS_CONFIG}"

mkdir -p /userdata/system
printf '%s\n' "$CURRENT" > "$APPLIED_FILE"
log "done ($CURRENT)"
