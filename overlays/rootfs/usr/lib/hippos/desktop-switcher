#!/usr/bin/env bash
set -euo pipefail

declare -A DESKTOP_LABELS=(
    [lxqt]="LXQt"
    [plasma]="KDE Plasma"
    [xfce]="XFCE"
    [gnome]="GNOME"
    [mate]="MATE"
    [cinnamon]="Cinnamon"
)

declare -A DESKTOP_PACKAGES=(
    [lxqt]="lxqt-core"
    [plasma]="kde-plasma-desktop plasma-pa plasma-nm"
    [xfce]="xfce4"
    [gnome]="gnome-core"
    [mate]="mate-desktop-environment-core"
    [cinnamon]="cinnamon"
)

DESKTOP_ORDER=(lxqt xfce mate cinnamon plasma gnome)

declare -A DESKTOP_NOTES=(
    [lxqt]="Lightest on CPU and memory · built in"
    [xfce]="Light on CPU and memory · about 190 MB to install"
    [mate]="Light on CPU and memory · about 380 MB to install"
    [cinnamon]="Medium on CPU and memory · about 390 MB to install"
    [plasma]="Heavy on CPU and memory · about 1.6 GB to install"
    [gnome]="Heaviest on CPU and memory · about 1.3 GB to install"
)

primary_package() {
    read -ra pkgs <<< "${DESKTOP_PACKAGES[$1]}"
    echo "${pkgs[0]}"
}

IMAGE_PACKAGES=/usr/share/hippos/image-packages.list
DESKTOP_RECORDS=/userdata/system/configs/hippos/desktops

installed_packages() {
    dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' \
        | awk -v native=":$(dpkg --print-architecture)" '$1 == "ii" { sub(native "$", "", $2); print $2 }' | sort -u
}

apt_progress() {
    local install_start="$1" kind _package percent message
    tr -d '\r' | while IFS=: read -r kind _package percent message; do
        case "${kind}" in
            dlstatus) printf '%s >>> %d%%\n' "Downloading: ${message}" "$(( ${percent%.*} * install_start / 100 ))" ;;
            pmstatus) printf '%s >>> %d%%\n' "${message}" "$(( install_start + ${percent%.*} * (100 - install_start) / 100 ))" ;;
        esac
    done
}

is_installed() {
    dpkg -l "$(primary_package "$1")" 2>/dev/null | grep -q '^ii'
}

cmd_list() {
    local current; current=$(hippos-settings get system.desktop 2>/dev/null || echo "")
    if [[ "${1:-}" == "--machine" ]]; then
        for key in "${DESKTOP_ORDER[@]}"; do
            local installed=0 is_current=0 removable=0
            is_installed "$key" && installed=1
            [[ "$key" == "$current" ]] && is_current=1
            [[ "$installed" == 1 && "$is_current" == 0 && "$key" != lxqt ]] && removable=1
            printf "%s|%s|%s|%s|%s|%s\n" "$key" "${DESKTOP_LABELS[$key]}" "$installed" "$is_current" "$removable" "${DESKTOP_NOTES[$key]}"
        done
        return 0
    fi
    printf "%-12s %-30s %-12s\n" "ID" "Name" "Status"
    printf "%-12s %-30s %-12s\n" "---" "---" "---"
    for key in "${DESKTOP_ORDER[@]}"; do
        local status="available"
        is_installed "$key" && status="installed"
        local marker=""
        [[ "$key" == "$current" ]] && marker=" *"
        printf "%-12s %-30s %-12s%s\n" "$key" "${DESKTOP_LABELS[$key]}" "$status" "$marker"
    done
}

cmd_install() {
    local key="${1:-}"
    [[ -n "$key" ]] || { echo "Usage: desktop-switcher install <id>"; cmd_list; exit 1; }
    [[ -v DESKTOP_LABELS[$key] ]] || { echo "Unknown desktop: $key"; exit 1; }

    if is_installed "$key"; then
        echo "${DESKTOP_LABELS[$key]} already installed"
        return 0
    fi

    read -ra pkgs <<< "${DESKTOP_PACKAGES[$key]}"
    local before; before="$(installed_packages)"
    echo "Updating package lists >>> 0%"
    sudo apt-get update -q >/dev/null
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -o APT::Status-Fd=1 "${pkgs[@]}" \
        | apt_progress 50
    is_installed "$key"
    mkdir -p "${DESKTOP_RECORDS}"
    comm -13 <(echo "${before}") <(installed_packages) > "${DESKTOP_RECORDS}/${key}.packages"
}

cmd_uninstall() {
    local key="${1:-}"
    [[ -n "$key" ]] || { echo "Usage: desktop-switcher uninstall <id>"; cmd_list; exit 1; }
    [[ -v DESKTOP_LABELS[$key] ]] || { echo "Unknown desktop: $key"; exit 1; }
    [[ "$key" != lxqt ]] || { echo "LXQt is the default desktop and can't be uninstalled"; exit 1; }
    [[ "$key" != "$(cmd_current)" ]] || { echo "${DESKTOP_LABELS[$key]} is the selected desktop; switch to another first"; exit 1; }
    is_installed "$key" || { echo "${DESKTOP_LABELS[$key]} is not installed"; return 0; }

    echo "Preparing >>> 0%"
    comm -12 <(sort -u "${IMAGE_PACKAGES}") <(installed_packages) | xargs -r sudo apt-mark manual >/dev/null
    read -ra pkgs <<< "${DESKTOP_PACKAGES[$key]}"
    sudo apt-mark auto "${pkgs[@]}" >/dev/null
    sudo env DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y -o APT::Status-Fd=1 \
        -o APT::AutoRemove::RecommendsImportant=false -o APT::AutoRemove::SuggestsImportant=false \
        | apt_progress 0
    ! is_installed "$key"
    purge_leftovers "$key"
}

purge_leftovers() {
    local record="${DESKTOP_RECORDS}/$1.packages"
    [[ -f "${record}" ]] || return 0
    local package purgeable=() kept=()
    for package in $(comm -12 <(sort -u "${record}") <(installed_packages) | comm -23 - <(sort -u "${IMAGE_PACKAGES}")); do
        if [[ -z "$(removed_outside_record "${record}" "${package}")" ]]; then
            purgeable+=("${package}")
        else
            kept+=("${package}")
        fi
    done
    [[ "${#kept[@]}" -eq 0 ]] || echo "Keeping ${kept[*]}: other installed packages still need them"
    if [[ "${#purgeable[@]}" -gt 0 && -z "$(removed_outside_record "${record}" "${purgeable[@]}")" ]]; then
        sudo env DEBIAN_FRONTEND=noninteractive apt-get purge -y -o APT::Status-Fd=1 "${purgeable[@]}" | apt_progress 0
    fi
    rm -f "${record}"
}

removed_outside_record() {
    local record="$1"; shift
    apt-get -s purge "$@" 2>/dev/null | awk '/^(Remv|Purg) / { print $2 }' | sort -u \
        | comm -23 - <(sort -u "${record}") | sed '/^$/d'
}

cmd_switch() {
    local key="${1:-}"
    [[ -n "$key" ]] || { echo "Usage: desktop-switcher switch <id|es>"; cmd_list; exit 1; }
    if [[ "$key" == "es" ]]; then
        exec /usr/lib/hippos/switch-to-es
    fi
    [[ -v DESKTOP_LABELS[$key] ]] || { echo "Unknown desktop: $key"; exit 1; }
    if ! is_installed "$key"; then
        echo "${DESKTOP_LABELS[$key]} is not installed — run: desktop-switcher install $key"
        exit 1
    fi
    exec /usr/lib/hippos/switch-to-desktop "$key"
}

cmd_current() {
    hippos-settings get system.desktop
}

case "${1:-list}" in
    list)      cmd_list "${2:-}" ;;
    install)   cmd_install "${2:-}" ;;
    uninstall) cmd_uninstall "${2:-}" ;;
    switch)    cmd_switch "${2:-}" ;;
    current)   cmd_current ;;
    *) echo "Usage: desktop-switcher [list [--machine]|install <id>|uninstall <id>|switch <id>|current]"; exit 1 ;;
esac
