#!/usr/bin/env bash

set -euo pipefail

LOG_TAG="[hippos-crt-teardown]"
log()  { printf '%s %s\n'         "${LOG_TAG}" "$*"; }

XORG_CONF_D="/etc/X11/xorg.conf.d"
GRUB_CRT_CONF="/etc/default/grub.d/50-crt.cfg"

_remove() {
    local f="$1"
    if [[ -e "${f}" ]]; then
        rm -f "${f}"
        log "removed ${f}"
    fi
}

_remove "${XORG_CONF_D}/90-crt-gpu.conf"
_remove "${XORG_CONF_D}/10-crt-ignore.conf"

_remove "/etc/switchres.ini"

_remove "/userdata/system/videomodes.conf"

_remove "/lib/firmware/edid/crt.bin"

if [[ -f "${GRUB_CRT_CONF}" ]]; then
    rm -f "${GRUB_CRT_CONF}"
    log "removed ${GRUB_CRT_CONF}"
    if update-grub 2>/dev/null; then
        log "GRUB updated — CRT kernel params removed"
    else
        log "WARNING: update-grub failed — CRT params will clear after next boot"
    fi
fi

log "CRT teardown complete. X11 config changes take effect after X restart."
