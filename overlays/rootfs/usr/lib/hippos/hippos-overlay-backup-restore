#!/usr/bin/env python3
from __future__ import annotations

import shutil
import sys
import urllib.error
import urllib.request
from pathlib import Path

BACKUP_ROOT = Path('/userdata/system/backups')
ES_API      = 'http://127.0.0.1:1234'


def _post_es(path: str, body: str) -> None:
    req = urllib.request.Request(
        f'{ES_API}{path}',
        data=body.encode('utf-8'),
        method='POST',
        headers={'Content-Type': 'text/plain'},
    )
    try:
        urllib.request.urlopen(req, timeout=3).close()
    except (OSError, urllib.error.URLError):
        pass


def restore(deployment: str) -> int:
    backup_dir = BACKUP_ROOT / f'overlay-{deployment}'
    if not backup_dir.is_dir():
        print(f'Backup directory not found: {backup_dir}', file=sys.stderr)
        return 1

    restored = []
    failed = []
    for src in backup_dir.rglob('*'):
        if not src.is_file():
            continue
        dest = Path('/') / src.relative_to(backup_dir)
        try:
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest)
            restored.append(str(dest))
        except OSError as e:
            failed.append(f'{dest}: {e}')

    if restored:
        noun = 'file' if len(restored) == 1 else 'files'
        _post_es('/notify', f'Restored {len(restored)} {noun} from {deployment} backup.')

    if failed:
        for msg in failed:
            print(msg, file=sys.stderr)
        _post_es('/notify', f'Failed to restore {len(failed)} file(s) — check logs.')
        return 1

    return 0


def main() -> int:
    if len(sys.argv) != 2:
        print(f'Usage: {sys.argv[0]} <deployment>', file=sys.stderr)
        return 1
    return restore(sys.argv[1])


if __name__ == '__main__':
    sys.exit(main())
