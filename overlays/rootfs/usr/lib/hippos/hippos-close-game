#!/usr/bin/env bash
set -u

CLOSE_GRACE_SECONDS=8
CLOSE_KEYS="${1:-KEY_LEFTALT+KEY_F4}"

exec 9>/run/hippos/close-game.lock
flock -n 9 || exit 0

launcher="$(pgrep -of 'python3 /usr/bin/emulatorlauncher')" || exit 0

descendants() {
    local child
    for child in $(pgrep -P "$1"); do
        echo "${child}"
        descendants "${child}"
    done
}

wait_for_launcher() {
    for _ in $(seq "${CLOSE_GRACE_SECONDS}"); do
        sleep 1
        kill -0 "${launcher}" 2>/dev/null || exit 0
    done
}

/usr/lib/hippos/hippos-hotkeys --press ${CLOSE_KEYS//+/ }
wait_for_launcher
kill -TERM $(descendants "${launcher}") 2>/dev/null
wait_for_launcher
kill -KILL $(descendants "${launcher}") 2>/dev/null
