#!/usr/bin/env bash
# Apply saved display settings (output, resolution) via xrandr.
# Called from session-es and session-desktop after DISPLAY is set.

export DISPLAY="${DISPLAY:-:0}"

_CRT_ENABLED="$(hippos-settings get crt.enabled 2>/dev/null || true)"
_CRT_ACTIVE="$(test -f /etc/X11/xorg.conf.d/90-crt-gpu.conf && echo true || echo false)"

_crt_auto_detect() {
    # Return the first connected VGA or DVI-I output with no EDID, or empty string.
    # LCDs on VGA send EDID; CRTs typically don't — zero-byte edid file = CRT.
    local p name edid_size
    for p in /sys/class/drm/card[0-9]*-*; do
        [[ -f "${p}/status" ]] || continue
        [[ "$(< "${p}/status")" == "connected" ]] || continue
        name="${p##*/}"; name="${name#card*-}"
        case "${name}" in VGA-*|DVI-I-*) ;; *) continue ;; esac
        edid_size=0
        [[ -f "${p}/edid" ]] && edid_size="$(wc -c < "${p}/edid")"
        [[ "${edid_size}" -eq 0 ]] && echo "${name}" && return
    done
}

if [[ "${_CRT_ENABLED}" == "true" ]]; then
    sudo /usr/lib/hippos/hippos-crt-setup 2>&1 || true
elif [[ "${_CRT_ENABLED}" == "auto" || -z "${_CRT_ENABLED}" ]]; then
    _detected="$(_crt_auto_detect)"
    if [[ -n "${_detected}" ]]; then
        sudo /usr/lib/hippos/hippos-crt-setup 2>&1 || true
    elif [[ "${_CRT_ACTIVE}" == "true" ]]; then
        sudo /usr/lib/hippos/hippos-crt-teardown 2>&1 || true
    fi
elif [[ "${_CRT_ACTIVE}" == "true" ]]; then
    sudo /usr/lib/hippos/hippos-crt-teardown 2>&1 || true
fi

# After CRT setup, apply the boot resolution via switchres before ES starts.
# Without this, ES inherits the kernel KMS modeline from the video= boot param
# which may be slightly off (e.g. 62Hz instead of 60Hz), preventing CRT sync.
# hippos-resolution minTomaxResolution in CRT mode calls switchres with the
# configured crt.boot_resolution (e.g. 640x480i → switchres 640 480 60),
# generating a standard NTSC 480i modeline at the correct field rate.
if [[ -f /etc/switchres.ini ]] && command -v switchres >/dev/null 2>&1; then
    hippos-resolution minTomaxResolution 2>/dev/null || true
    echo "[hippos-display-setup] CRT boot mode applied via switchres"
fi

OUTPUT=$(hippos-settings get display.output 2>/dev/null || true)
RES=$(hippos-settings get display.resolution 2>/dev/null || true)
ROTATE=$(hippos-settings get display.rotate 2>/dev/null || true)

# Map rotate value to xrandr rotation name (accepts degrees or 1/2/3)
case "${ROTATE}" in
    90|1)  ROTATION="right"    ;;
    180|2) ROTATION="inverted" ;;
    270|3) ROTATION="left"     ;;
    *)     ROTATION="normal"   ;;
esac

_OUTPUT_CONFIGURED="$OUTPUT"
OUTPUT="${OUTPUT:-$(xrandr 2>/dev/null | awk '/ connected/ {print $1; exit}')}"

# Skip xrandr resolution/rotation when CRT is enabled — the kernel sets the
# framebuffer mode via the GRUB video= param and X uses the CRT X11 config.
# Calling --preferred or --auto here would override 15kHz back to 31kHz.
if [[ "${_CRT_ENABLED}" != "true" && "${_CRT_ACTIVE}" != "true" ]]; then
    # Strip max- prefix saved by hippos-resolution setMode (e.g. "max-1920x1080")
    [[ "$RES" == max-* ]] && RES="${RES#max-}"

    if [[ -z "$RES" || "$RES" == "preferred" ]]; then
        # Prefer 1920x1080@60 when unconfigured (safe default for TVs),
        # fall back to --auto if the output doesn't advertise that mode.
        if xrandr --listModes "$OUTPUT" 2>/dev/null | grep -qE '^[[:space:]]*1920x1080[[:space:]]+60\.[0-9]+'; then
            RES="1920x1080"
            echo "[hippos-display-setup] $OUTPUT defaulting to 1920x1080 (safe default)"
        else
            xrandr --output "$OUTPUT" --auto 2>/dev/null || true
            echo "[hippos-display-setup] $OUTPUT --auto (1920x1080@60 not advertised)"
        fi
    fi

    if [[ "$RES" == "preferred" || -z "$RES" ]]; then
        xrandr --output "$OUTPUT" --preferred --rotate "$ROTATION" 2>/dev/null \
            && echo "[hippos-display-setup] $OUTPUT preferred rotate=$ROTATION" \
            || echo "[hippos-display-setup] xrandr failed for $OUTPUT" >&2
    elif [[ "$RES" == *"."* ]]; then
        # mode.rate format saved by hippos-resolution (e.g. "1920x1080.60")
        RATE="${RES##*.}"; RES="${RES%.*}"
        xrandr --output "$OUTPUT" --mode "$RES" --rate "$RATE" --rotate "$ROTATION" 2>/dev/null \
            && echo "[hippos-display-setup] $OUTPUT ${RES}@${RATE}Hz rotate=$ROTATION" \
            || echo "[hippos-display-setup] mode '$RES @ $RATE' not available for $OUTPUT" >&2
    else
        xrandr --output "$OUTPUT" --mode "$RES" --rotate "$ROTATION" 2>/dev/null \
            && echo "[hippos-display-setup] $OUTPUT $RES rotate=$ROTATION" \
            || echo "[hippos-display-setup] mode '$RES' not available for $OUTPUT" >&2
    fi
fi

# Bind touchscreen to the configured output and apply rotation matrix
case "$ROTATION" in
    right)    TOUCH_MATRIX="0 1 0 -1 0 1 0 0 1"  ;;
    left)     TOUCH_MATRIX="0 -1 1 1 0 0 0 0 1"  ;;
    inverted) TOUCH_MATRIX="-1 0 1 0 -1 1 0 0 1" ;;
    *)        TOUCH_MATRIX=""                      ;;
esac

while IFS= read -r dev; do
    if xinput list-props "$dev" 2>/dev/null | grep -q "Coordinate Transformation Matrix"; then
        xinput --map-to-output "$dev" "$OUTPUT" 2>/dev/null \
            && echo "[hippos-display-setup] mapped $dev → $OUTPUT" || true
        if [[ -n "$TOUCH_MATRIX" ]]; then
            xinput set-prop "$dev" "Coordinate Transformation Matrix" $TOUCH_MATRIX 2>/dev/null \
                && echo "[hippos-display-setup] touchscreen transform $ROTATION: $dev" || true
        fi
    fi
done < <(xinput list --name-only 2>/dev/null)

# Apply saved overscan (xrandr underscan) if configured
_OVERSCAN_ON="$(hippos-settings get display.overscan.enabled 2>/dev/null || true)"
if [[ "${_OVERSCAN_ON}" == "true" ]]; then
    _os_left=$(hippos-settings get display.overscan.left   2>/dev/null || echo 0)
    _os_right=$(hippos-settings get display.overscan.right  2>/dev/null || echo 0)
    _os_top=$(hippos-settings get display.overscan.top    2>/dev/null || echo 0)
    _os_bottom=$(hippos-settings get display.overscan.bottom 2>/dev/null || echo 0)
    _os_hborder=$(( (_os_left + _os_right) / 2 ))
    _os_vborder=$(( (_os_top + _os_bottom) / 2 ))
    xrandr --output "${OUTPUT}" --set underscan on \
           --set "underscan hborder" "${_os_hborder}" \
           --set "underscan vborder" "${_os_vborder}" 2>/dev/null \
        && echo "[hippos-display-setup] overscan hborder=${_os_hborder} vborder=${_os_vborder}" \
        || echo "[hippos-display-setup] overscan not supported on ${OUTPUT}" >&2
fi

# Apply saved brightness after display is configured
/usr/lib/hippos/hippos-brightness boot 2>/dev/null || true
