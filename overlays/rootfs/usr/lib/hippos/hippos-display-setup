#!/usr/bin/env bash

export DISPLAY="${DISPLAY:-:0}"

_CRT_ENABLED="$(hippos-settings get crt.enabled 2>/dev/null || true)"
_CRT_ACTIVE="$(test -f /etc/X11/xorg.conf.d/90-crt-gpu.conf && echo true || echo false)"

if [[ "${_CRT_ENABLED}" == "true" ]]; then
    sudo /usr/lib/hippos/hippos-crt-setup 2>&1 || true
elif [[ "${_CRT_ACTIVE}" == "true" ]]; then
    sudo /usr/lib/hippos/hippos-crt-teardown 2>&1 || true
fi

if [[ -f /etc/switchres.ini ]] && command -v switchres >/dev/null 2>&1; then
    hippos-resolution minTomaxResolution 2>/dev/null || true
    echo "[hippos-display-setup] CRT boot mode applied via switchres"
fi

OUTPUT=$(hippos-settings get display.output 2>/dev/null || true)
RES=$(hippos-settings get display.resolution 2>/dev/null || true)
ROTATE=$(hippos-settings get display.rotate 2>/dev/null || true)

case "${ROTATE}" in
    90|1)  ROTATION="right"    ;;
    180|2) ROTATION="inverted" ;;
    270|3) ROTATION="left"     ;;
    *)     ROTATION="normal"   ;;
esac

_OUTPUT_CONFIGURED="$OUTPUT"
OUTPUT="${OUTPUT:-$(xrandr 2>/dev/null | awk '/ connected/ {print $1; exit}')}"

if [[ "${_CRT_ENABLED}" != "true" && "${_CRT_ACTIVE}" != "true" ]]; then
    [[ "$RES" == max-* ]] && RES="${RES#max-}"

    if [[ -z "$RES" || "$RES" == "preferred" ]]; then
        if hippos-resolution --screen "$OUTPUT" listModes 2>/dev/null | grep -q '^1920x1080\.60:'; then
            RES="1920x1080"
            echo "[hippos-display-setup] $OUTPUT defaulting to 1920x1080 (safe default)"
        fi
    fi

    if [[ "$RES" == "preferred" || -z "$RES" ]]; then
        xrandr --output "$OUTPUT" --preferred --rotate "$ROTATION" --primary 2>/dev/null \
            && echo "[hippos-display-setup] $OUTPUT preferred rotate=$ROTATION" \
            || echo "[hippos-display-setup] xrandr failed for $OUTPUT" >&2
    elif [[ "$RES" == *"."* ]]; then
        RATE="${RES##*.}"; RES="${RES%.*}"
        xrandr --output "$OUTPUT" --mode "$RES" --rate "$RATE" --rotate "$ROTATION" --primary 2>/dev/null \
            && echo "[hippos-display-setup] $OUTPUT ${RES}@${RATE}Hz rotate=$ROTATION" \
            || { echo "[hippos-display-setup] mode '$RES @ $RATE' not available for $OUTPUT, using its preferred mode" >&2
                 xrandr --output "$OUTPUT" --preferred --rotate "$ROTATION" --primary 2>/dev/null; }
    else
        xrandr --output "$OUTPUT" --mode "$RES" --rotate "$ROTATION" --primary 2>/dev/null \
            && echo "[hippos-display-setup] $OUTPUT $RES rotate=$ROTATION" \
            || { echo "[hippos-display-setup] mode '$RES' not available for $OUTPUT, using its preferred mode" >&2
                 xrandr --output "$OUTPUT" --preferred --rotate "$ROTATION" --primary 2>/dev/null; }
    fi
fi

case "$(hippos-settings get display.rgb_range 2>/dev/null || true)" in
    limited) RGB_RANGE="Limited 16:235" ;;
    auto)    RGB_RANGE="Automatic" ;;
    *)       RGB_RANGE="Full" ;;
esac
if xrandr --prop 2>/dev/null | awk -v out="$OUTPUT" '$1 == out {found=1; next} /^[^ \t]/ {found=0} found && /Broadcast RGB:/ {ok=1} END {exit !ok}'; then
    xrandr --output "$OUTPUT" --set "Broadcast RGB" "$RGB_RANGE" 2>/dev/null \
        && echo "[hippos-display-setup] $OUTPUT RGB range: $RGB_RANGE" \
        || echo "[hippos-display-setup] could not set RGB range on $OUTPUT" >&2
fi

case "$ROTATION" in
    right)    TOUCH_MATRIX="0 1 0 -1 0 1 0 0 1"  ;;
    left)     TOUCH_MATRIX="0 -1 1 1 0 0 0 0 1"  ;;
    inverted) TOUCH_MATRIX="-1 0 1 0 -1 1 0 0 1" ;;
    *)        TOUCH_MATRIX=""                      ;;
esac

INTERNAL_PANEL=$(xrandr 2>/dev/null | awk '/^(eDP|LVDS|DSI)[^ ]* connected/ {print $1; exit}')

while IFS= read -r dev; do
    if xinput list-props "$dev" 2>/dev/null | grep -q "Coordinate Transformation Matrix"; then
        target="$OUTPUT"
        if [[ -n "$INTERNAL_PANEL" ]] && xinput list --long "$dev" 2>/dev/null | grep -q "Touch mode: direct"; then
            target="$INTERNAL_PANEL"
        fi
        xinput --map-to-output "$dev" "$target" 2>/dev/null \
            && echo "[hippos-display-setup] mapped $dev → $target" || true
        if [[ -n "$TOUCH_MATRIX" && "$target" == "$OUTPUT" ]]; then
            xinput set-prop "$dev" "Coordinate Transformation Matrix" $TOUCH_MATRIX 2>/dev/null \
                && echo "[hippos-display-setup] touchscreen transform $ROTATION: $dev" || true
        fi
    fi
done < <(xinput list --name-only 2>/dev/null)

_OVERSCAN_ON="$(hippos-settings get display.overscan.enabled 2>/dev/null || true)"
if [[ "${_OVERSCAN_ON}" == "true" ]]; then
    _os_left=$(hippos-settings get display.overscan.left   2>/dev/null || echo 0)
    _os_right=$(hippos-settings get display.overscan.right  2>/dev/null || echo 0)
    _os_top=$(hippos-settings get display.overscan.top    2>/dev/null || echo 0)
    _os_bottom=$(hippos-settings get display.overscan.bottom 2>/dev/null || echo 0)
    _os_hborder=$(( (_os_left + _os_right) / 2 ))
    _os_vborder=$(( (_os_top + _os_bottom) / 2 ))
    xrandr --output "${OUTPUT}" --set underscan on \
           --set "underscan hborder" "${_os_hborder}" \
           --set "underscan vborder" "${_os_vborder}" 2>/dev/null \
        && echo "[hippos-display-setup] overscan hborder=${_os_hborder} vborder=${_os_vborder}" \
        || echo "[hippos-display-setup] overscan not supported on ${OUTPUT}" >&2
fi

/usr/lib/hippos/hippos-brightness boot 2>/dev/null || true
