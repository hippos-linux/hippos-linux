        log("No kernel payload in manifest")
        return
    remote = kernel.get("version", "")
    installed = installed_kernel_version()
    if installed != remote:
        print(f"kernel\t{installed or 'not installed'} → {remote}")


def cmd_update_kernel():
    manifest = fetch_manifest(get_channel())
    if not manifest:
        die("Could not fetch manifest")

    kernel_info = manifest.get("payloads", {}).get("kernel", {})
    if not kernel_info:
        die("No kernel payload in manifest")

    remote  = kernel_info.get("version", "")
    url     = kernel_info.get("url", "")
    sha256  = kernel_info.get("sha256", "")

    installed = installed_kernel_version()
    if installed == remote:
        log(f"Kernel already at {remote}")
        sys.exit(0)

    log(f"Updating kernel: {installed or 'not installed'} → {remote}")

    os.makedirs(CACHE_DIR, exist_ok=True)
    deb = os.path.join(CACHE_DIR, f"linux-image-{remote}_{_DEB_ARCH}.deb")

    if not os.path.exists(deb):
        log("Downloading kernel deb...")
        req = _make_request(url)
        with urllib.request.urlopen(req, timeout=300) as resp, open(deb, "wb") as f:
            total = int(resp.headers.get("Content-Length", 0))
            done  = 0
            while chunk := resp.read(262144):
                f.write(chunk)
                done += len(chunk)
                if total:
                    log(f"Downloading... {done * 100 // total}%")

    if sha256:
        log("Verifying checksum...")
        if sha256_file(deb) != sha256:
            os.remove(deb)
            die("SHA256 mismatch — download may be corrupt")
        log("Checksum OK")

    try:
        mount_toplevel()
        running    = current_subvol()
        subvol_path = os.path.join(BTRFS_MNT, running)

        # Snapshot current subvol for rollback before touching /boot
        if installed:
            snap_name = f"@rootfs-kernel-{installed}"
            snap_path = os.path.join(BTRFS_MNT, snap_name)
            if not os.path.exists(snap_path):
                log(f"Snapshotting {running} → {snap_name}...")
                subprocess.run(
                    ["btrfs", "subvolume", "snapshot", "-r", subvol_path, snap_path],
                    check=True,
                )

        # Install kernel deb via dpkg in chroot — handles depmod + update-initramfs.
        # update-grub will fail harmlessly (no real ESP/block devices in chroot).
        log("Installing kernel deb...")
        deb_in_chroot = f"/tmp/kernel-install.deb"
        subprocess.run(["cp", deb, os.path.join(subvol_path, "tmp", "kernel-install.deb")], check=True)
        for fs in ("proc", "sys", "dev", "dev/pts", "run"):
            target = os.path.join(subvol_path, fs)
            os.makedirs(target, exist_ok=True)
            subprocess.run(["mount", "--bind", f"/{fs}", target], check=True)
        try:
            subprocess.run(
                ["chroot", subvol_path, "dpkg", "-i", "--force-confold", deb_in_chroot],
                check=True,
            )
        finally:
            for fs in reversed(("proc", "sys", "dev/pts", "dev", "run")):
                subprocess.run(
                    ["umount", "-l", os.path.join(subvol_path, fs)],
                    check=False,
                )
            try:
                os.remove(os.path.join(subvol_path, "tmp", "kernel-install.deb"))
            except Exception:
                pass

        uuid, partuuid = read_grub_uuid_partuuid()
        if not uuid or not partuuid:
            die("Cannot read UUID/PARTUUID from existing grub.cfg")

        deployments = list_deployments()
        write_grub_cfg(running, deployments, uuid, partuuid)
        log("GRUB updated")

        grubenv = "/boot/efi/grub/grubenv"
        subprocess.run(["grub-editenv", grubenv, "create"], check=False)
        subprocess.run(["grub-editenv", grubenv, "set", "boot_counter=3"], check=True)
        log("Boot counter armed (3 attempts before rollback)")

        # Prune old kernel snapshots — keep only the one we just made
        keep = {snap_name} if installed else set()
        pruned = False
        for sv in deployments:
            if sv.startswith("@rootfs-kernel-") and sv not in keep:
                log(f"Pruning old kernel snapshot {sv}...")
                subprocess.run(
                    ["btrfs", "subvolume", "delete", os.path.join(BTRFS_MNT, sv)],
                    check=False,
                )
                pruned = True
        if pruned:
            write_grub_cfg(running, list_deployments(), uuid, partuuid)
            log("GRUB updated after pruning")
    finally:
        umount_toplevel()

    try:
        os.remove(deb)
    except Exception:
        pass

    log(f"Kernel updated to {remote}. Reboot to apply.")


