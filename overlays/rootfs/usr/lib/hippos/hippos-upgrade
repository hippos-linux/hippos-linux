        args = [a for a in sys.argv[2:] if not a.startswith("-")]
        force = "--force" in sys.argv
        if not args:
            die("Usage: hippos-upgrade update-emulator [--force] <name>")
        cmd_update_emulator(args[0], force=force)
    elif cmd == "update-all-emulators":
        cmd_update_all_emulators()
