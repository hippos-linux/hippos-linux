#!/usr/bin/env python3
"""HippOS system updater — apply updates and manage rollback deployments."""

import hashlib
import json
import os
import glob
import platform
import re
import shlex
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from datetime import datetime

VERSION_FILE      = "/usr/share/hippos/version"
SYSCONF           = "/userdata/system/hippos.conf"
CACHE_DIR         = "/userdata/system/cache/update"
BTRFS_MNT         = "/tmp/hippos-btrfs-update"
LOG_FILE          = "/userdata/system/logs/upgrade.log"
PATCHES_STATE_FILE = "/userdata/system/applied-patches.json"

_DEB_ARCH = {'x86_64': 'amd64', 'aarch64': 'arm64'}.get(platform.machine(), platform.machine())

MANIFEST_URLS = [
    f"https://hippos-linux.org/api/update/manifest-{_DEB_ARCH}.json",
]

_log_fh = None

def _open_log():
    global _log_fh
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        _log_fh = open(LOG_FILE, "a")
        _log_fh.write(f"\n--- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} ---\n")
        _log_fh.flush()
    except Exception:
        _log_fh = None

def log(msg):
    line = f"[hippos-upgrade] {msg}"
    print(line, flush=True)
    if _log_fh:
        try:
            _log_fh.write(line + "\n")
            _log_fh.flush()
        except Exception:
            pass

def die(msg):
    log(f"ERROR: {msg}")
    sys.exit(1)


def current_version():
    try:
        return open(VERSION_FILE).read().strip()
    except FileNotFoundError:
        return "0.0.0"


def parse_current_subvol(mounts_text: str) -> str:
    """Extract the active @rootfs* subvolume name from /proc/mounts content.

    HippOS uses overlayfs for /; lowerdir reveals the active btrfs subvol.
    Falls back to the bare "@rootfs" subvolume — the pre-first-update state —
    if no overlay root is mounted (e.g. running outside the normal boot path).
    """
    for line in mounts_text.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[1] == "/" and parts[2] == "overlay":
            for opt in parts[3].split(","):
                if opt.startswith("lowerdir="):
                    lowerdir = opt[len("lowerdir="):]
                    last = lowerdir.rstrip("/").split("/")[-1]
                    if last.startswith("@rootfs"):
                        return last
    return "@rootfs"


def current_subvol():
    """Return the subvolume name we are currently booted into."""
    return parse_current_subvol(open("/proc/mounts").read())


def get_channel():
    try:
        for line in open(SYSCONF):
            k, _, v = line.strip().partition("=")
            if k.strip() == "updates.type":
                return v.strip().strip('"')
    except FileNotFoundError:
        pass
    return "stable"


def get_beta_token():
    try:
        for line in open(SYSCONF):
            k, _, v = line.strip().partition("=")
            if k.strip() == "updates.token":
                return v.strip().strip('"')
    except FileNotFoundError:
        pass
    return None


def _make_request(url: str) -> urllib.request.Request:
    headers = {"User-Agent": "hippos-upgrade/1.0"}
    token = get_beta_token()
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return urllib.request.Request(url, headers=headers)


def fetch_manifest(channel):
    # Dev channel is gated by token role (KV value 'dev', see betaAuth.ts
    # validateDevToken) and lives at its own path — a stable/beta token
    # cannot read it, so it must not fall back to the regular manifest URLs.
    if channel == "dev":
        urls = [f"https://hippos-linux.org/api/update/manifest-{_DEB_ARCH}-dev.json"]
    else:
        urls = MANIFEST_URLS[:]
        urls.insert(1, f"https://updates.hippos.org/{channel}/manifest.json")
    for url in urls:
        try:
            req = _make_request(url)
            with urllib.request.urlopen(req, timeout=15) as r:
                return json.loads(r.read())
        except urllib.error.HTTPError as e:
            if e.code == 401:
                die("Beta access token is invalid or has been revoked. "
                    "Contact the HippOS team to renew your access.")
            continue
        except Exception:
            continue
    return None


def ver_tuple(v):
    """Normalize a version string to a comparable (major, minor, patch, prerelease) tuple.

    Always pads/truncates major.minor.patch to exactly 3 components so "1.2" and
    "1.2.0" compare equal instead of the shorter string sorting as lower — Python's
    tuple comparison treats a missing trailing element as smaller than any present
    value, and cur/remote version strings aren't guaranteed to have the same number
    of dot-separated parts.

    Dev channel versions carry a "-dev.N" suffix (e.g. "0.5.3-dev.3") — the trailing
    N is kept as a 4th element so successive dev builds on the same base version
    still compare as increasing. Non-prerelease versions get 0 here, which doesn't
    change their relative ordering against each other.
    """
    base, _, pre = v.lstrip("v").partition("-")
    parts = (base.split(".") + ["0", "0", "0"])[:3]
    pre_match = re.search(r"(\d+)$", pre)
    pre_num = int(pre_match.group(1)) if pre_match else 0
    return tuple(int(x) for x in parts) + (pre_num,)


def btrfs_device():
    # HippOS root is overlayfs; find the btrfs device via any btrfs mount.
    for line in open("/proc/mounts"):
        parts = line.split()
        if len(parts) >= 3 and parts[2] == "btrfs":
            return parts[0]
    die("Cannot find btrfs root device")


def mount_toplevel():
    os.makedirs(BTRFS_MNT, exist_ok=True)
    subprocess.run(
        ["mount", "-t", "btrfs", "-o", "subvolid=5", btrfs_device(), BTRFS_MNT],
        check=True
    )


def umount_toplevel():
    subprocess.run(["umount", "-l", BTRFS_MNT], check=False)


def sort_deployment_names(names) -> list[str]:
    """Sort @rootfs-* names by parsed version, not string order.

    "@rootfs-0.5.10" must sort after "@rootfs-0.5.2"; plain string sorting
    gets that backwards once a version component reaches two digits.
    """
    return sorted(names, key=lambda n: ver_tuple(n[len("@rootfs-"):]))


def parse_deployment_names(btrfs_list_output: str) -> list[str]:
    """Parse `btrfs subvolume list -o` output into a version-sorted @rootfs-* list."""
    names = []
    for line in btrfs_list_output.splitlines():
        parts = line.split()
        if parts:
            name = parts[-1]
            if name.startswith("@rootfs-"):
                names.append(name)
    return sort_deployment_names(names)


def list_deployments():
    """Return version-sorted list of @rootfs-* subvolume names."""
    r = subprocess.run(
        ["btrfs", "subvolume", "list", "-o", BTRFS_MNT],
        capture_output=True, text=True
    )
    if r.returncode != 0:
        log(f"WARNING: btrfs subvolume list failed: {r.stderr.strip()}")
    return parse_deployment_names(r.stdout)


def _kernel_sort_key(name):
    """Sort key for vmlinuz-X.Y.Z-hippos filenames."""
    ver = name.replace("vmlinuz-", "").replace("-hippos", "")
    try:
        return tuple(int(x) for x in ver.split("."))
    except ValueError:
        return (0,)


def find_boot_files(subvol_path):
    """Find the newest kernel and matching initrd in subvol /boot."""
    boot = os.path.join(subvol_path, "boot")
    kernels = []
    try:
        for f in os.listdir(boot):
            if f.startswith("vmlinuz-") and f.endswith("-hippos"):
                kernels.append(f)
    except FileNotFoundError:
        pass
    if not kernels:
        return "vmlinuz", "initrd.img"
    kernel = sorted(kernels, key=_kernel_sort_key)[-1]
    kver = kernel[len("vmlinuz-"):]
    initrd = f"initrd.img-{kver}" if os.path.exists(os.path.join(boot, f"initrd.img-{kver}")) else "initrd.img"
    return kernel, initrd


EFI_GRUB_CFG = "/boot/efi/grub/grub.cfg"
GRUB_DEFAULT_CFG = "/etc/default/grub"
GRUB_DEFAULT_CFG_DIR = "/etc/default/grub.d"

_MANAGED_KERNEL_ARG_PREFIXES = (
    "root=",
    "rootfstype=",
    "rootflags=",
)
_MANAGED_KERNEL_ARGS = {
    "ro",
    "rw",
    "quiet",
    "splash",
}


def read_grub_uuid_partuuid():
    """Extract fs-uuid and PARTUUID from grub.cfg on the EFI partition."""
    uuid = partuuid = None
    try:
        for line in open(EFI_GRUB_CFG):
            if "--fs-uuid" in line and not uuid:
                for t in line.split():
                    if len(t) == 36 and t.count("-") == 4:
                        uuid = t
            if "PARTUUID=" in line and not partuuid:
                for t in line.split():
                    if "PARTUUID=" in t:
                        partuuid = t.split("PARTUUID=")[1].split()[0].rstrip("\\")
    except FileNotFoundError:
        pass
    # Live image grub.cfg uses root=LABEL=HippOS — no PARTUUID/UUID baked in.
    # Fall back to reading them directly from the running block device.
    if not partuuid or not uuid:
        try:
            dev = btrfs_device()
            r = subprocess.run(
                ["blkid", "-s", "PARTUUID", "-s", "UUID", "-o", "export", dev],
                capture_output=True, text=True, check=True,
            )
            for line in r.stdout.splitlines():
                if line.startswith("PARTUUID=") and not partuuid:
                    partuuid = line.split("=", 1)[1]
                elif line.startswith("UUID=") and not uuid:
                    uuid = line.split("=", 1)[1]
        except Exception:
            pass
    return uuid, partuuid


def _split_kernel_args(value):
    if not value:
        return []
    try:
        return shlex.split(value)
    except ValueError:
        return value.split()


def _filter_managed_kernel_args(args):
    filtered = []
    for arg in args:
        if arg in _MANAGED_KERNEL_ARGS:
            continue
        if any(arg.startswith(prefix) for prefix in _MANAGED_KERNEL_ARG_PREFIXES):
            continue
        filtered.append(arg)
    return filtered


def _dedupe_kernel_args(*arg_lists):
    merged = []
    seen = set()
    for args in arg_lists:
        for arg in args:
            if arg in seen:
                continue
            merged.append(arg)
            seen.add(arg)
    return merged


def read_grub_cmdline_args():
    """Read persistent kernel args from /etc/default/grub and dropins."""
    config_files = [GRUB_DEFAULT_CFG]
    config_files.extend(sorted(glob.glob(os.path.join(GRUB_DEFAULT_CFG_DIR, "*.cfg"))))

    script = """
GRUB_CMDLINE_LINUX=""
GRUB_CMDLINE_LINUX_DEFAULT=""
for file in "$@"; do
    [ -f "$file" ] || continue
    . "$file"
done
printf '%s\\n%s\\n' "$GRUB_CMDLINE_LINUX" "$GRUB_CMDLINE_LINUX_DEFAULT"
"""

    try:
        result = subprocess.run(
            ["bash", "-c", script, "bash", *config_files],
            capture_output=True,
            text=True,
            check=True,
        )
    except Exception:
        return []

    lines = result.stdout.splitlines()
    linux_args = _filter_managed_kernel_args(
        _split_kernel_args(lines[0] if len(lines) >= 1 else "")
    )
    default_args = _filter_managed_kernel_args(
        _split_kernel_args(lines[1] if len(lines) >= 2 else "")
    )
    return _dedupe_kernel_args(linux_args, default_args)


def os_prober_entries():
    """Run os-prober and return list of GRUB menuentry strings for other OSes."""
    try:
        result = subprocess.run(
            ["os-prober"], capture_output=True, text=True, timeout=30
        )
        lines = result.stdout.strip().splitlines()
    except Exception:
        return []

    entries = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        parts = line.split(":")
        if len(parts) < 4:
            continue
        devpath, label, _short, etype = parts[0], parts[1], parts[2], parts[3]

        if etype == "efi":
            if "@" not in devpath:
                continue
            dev, efi_path = devpath.split("@", 1)
            try:
                dev_uuid = subprocess.run(
                    ["blkid", "-s", "UUID", "-o", "value", dev],
                    capture_output=True, text=True, check=True
                ).stdout.strip()
            except Exception:
                dev_uuid = ""
            if not dev_uuid:
                log(f"os-prober: cannot get UUID for {dev} — skipping '{label}'")
                continue
            log(f"os-prober: found EFI entry '{label}' ({dev} {efi_path})")
            entries.append("\n".join([
                f'menuentry "{label}" {{',
                f'    insmod part_gpt',
                f'    insmod fat',
                f'    search --no-floppy --set=root --fs-uuid {dev_uuid}',
                f'    chainloader {efi_path}',
                f'}}',
                '',
            ]))
    return entries


def write_grub_cfg(default_subvol, all_subvols, uuid, partuuid):
    """Regenerate grub.cfg on the EFI partition with entries for each subvol."""
    extra_args = read_grub_cmdline_args()

    # Build ordered entry list: default first, rest as rollback
    ordered = [default_subvol] + [s for s in reversed(all_subvols) if s != default_subvol]

    # Check for other OSes — if found, show a menu on every boot.
    other_entries = os_prober_entries()
    default_timeout = "5" if other_entries else "0"
    default_style   = "menu" if other_entries else "hidden"

    # Boot-counter logic: grubenv holds boot_counter (set to 3 on each update).
    # Each failed boot decrements it; when it hits 0 the rollback entry is shown.
    # A successful boot clears it via hippos-boot-success.service.
    boot_counter_block = [
        "load_env",
        "set default=0",
        f"set timeout={default_timeout}",
        f"set timeout_style={default_style}",
        "",
        "if [ \"${boot_counter}\" ] ; then",
        "    if [ \"${boot_counter}\" = \"0\" ] ; then",
        "        set default=1",
        "        set timeout=10",
        "        set timeout_style=menu",
        "        set boot_counter=",
        "        save_env boot_counter",
        "    else",
        "        set boot_counter=$((boot_counter - 1))",
        "        save_env boot_counter",
        "    fi",
        "fi",
        "",
    ]

    lines = boot_counter_block
    for subvol in ordered:
        subvol_path = os.path.join(BTRFS_MNT, subvol)
        kernel, initrd = find_boot_files(subvol_path)
        ver = subvol.replace("@rootfs-", "")
        label = f"HippOS {ver}" if subvol != "@rootfs" else "HippOS"
        if subvol != default_subvol:
            label += " (rollback)"
        cmdline_parts = [
            f"root=PARTUUID={partuuid}",
            "rootfstype=btrfs",
            f"rootflags=subvol={subvol}",
            "ro",
            "quiet",
            "splash",
            *extra_args,
        ]
        cmdline = " ".join(cmdline_parts)
        lines += [
            f'menuentry "{label}" {{',
            f'    insmod btrfs',
            f'    insmod part_gpt',
            f'    if ! search --no-floppy --set=root --fs-uuid {uuid} ; then',
            f'        search --no-floppy --set=root --label HippOS',
            f'    fi',
            f'    linux /{subvol}/boot/{kernel} {cmdline}',
            f'    initrd /{subvol}/boot/{initrd}',
            f'}}',
            '',
        ]

    if other_entries:
        lines += other_entries

    os.makedirs(os.path.dirname(EFI_GRUB_CFG), exist_ok=True)
    with open(EFI_GRUB_CFG, "w") as f:
        f.write("\n".join(lines))


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(131072):
            h.update(chunk)
    return h.hexdigest()


