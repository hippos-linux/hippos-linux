def applied_patch_ids():
    try:
        return set(json.load(open(PATCHES_STATE_FILE)))
    except Exception:
        return set()


def mark_patch_applied(patch_id):
    ids = applied_patch_ids()
    ids.add(patch_id)
    os.makedirs(os.path.dirname(PATCHES_STATE_FILE), exist_ok=True)
    with open(PATCHES_STATE_FILE, "w") as f:
        json.dump(sorted(ids), f)


def cmd_list_patches():
    manifest = fetch_manifest(get_channel())
    if not manifest:
        die("Could not fetch manifest")
    patches = manifest.get("payloads", {}).get("patches", [])
    applied = applied_patch_ids()
    for p in patches:
        pid = p.get("id", "")
        dest = p.get("dest", "")
        if pid and pid not in applied:
            print(f"{pid}\t{dest}")


def cmd_apply_patches():
    manifest = fetch_manifest(get_channel())
    if not manifest:
        die("Could not fetch manifest — check network")
    patches = manifest.get("payloads", {}).get("patches", [])
    if not patches:
        log("No patches in manifest")
        return
    applied = applied_patch_ids()
    for p in patches:
        pid  = p.get("id", "")
        dest = p.get("dest", "")
        url  = p.get("url", "")
        sha256 = p.get("sha256", "")
        if not pid or not dest or not url:
            log(f"Patch entry missing id/dest/url — skipping")
            continue
        if pid in applied:
            log(f"Patch {pid}: already applied — skipping")
            continue
        log(f"Applying patch {pid} → {dest}...")
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = os.path.join(CACHE_DIR, f"patch-{pid}-{os.path.basename(dest)}")
        req = _make_request(url)
        with urllib.request.urlopen(req, timeout=60) as resp, open(tmp, "wb") as f:
            f.write(resp.read())
        if sha256:
            log("Verifying checksum...")
            if sha256_file(tmp) != sha256:
                os.remove(tmp)
                die(f"Patch {pid}: SHA256 mismatch — aborting")
            log("Checksum OK")
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        orig_mode = None
        try:
            orig_mode = os.stat(dest).st_mode
        except FileNotFoundError:
            pass
        shutil.move(tmp, dest)
        if orig_mode is not None:
            os.chmod(dest, orig_mode)
        mark_patch_applied(pid)
        log(f"Patch {pid} applied")


def cmd_update_grub():
    """Rewrite grub.cfg with current boot counter logic and btrfs subvol state."""
    try:
        mount_toplevel()
        uuid, partuuid = read_grub_uuid_partuuid()
