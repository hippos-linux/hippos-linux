        cmd_list_frontend_updates()
    elif cmd == "update-frontend":
        if len(sys.argv) < 3:
            die("Usage: hippos-upgrade update-frontend <name>")
        cmd_update_frontend(sys.argv[2])
    elif cmd == "list-kernel-update":
        cmd_list_kernel_update()
    elif cmd == "update-kernel":
        cmd_update_kernel()
    elif cmd == "list-patches":
        cmd_list_patches()
    elif cmd == "apply-patches":
        cmd_apply_patches()
    elif cmd == "update-grub":
        cmd_update_grub()
    else:
        cmd_apply()
