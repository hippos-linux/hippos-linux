def cmd_check():
    """Exit 0 + print info if update available; exit 1 if up to date."""
    cur = current_version()
    manifest = fetch_manifest(get_channel())
    if not manifest:
        sys.exit(1)
    remote = manifest.get("version", "0.0.0")
    if ver_tuple(remote) > ver_tuple(cur):
        print(f"New version available: {remote}")
        print(f"Current version: {cur}")
        sys.exit(0)
    sys.exit(1)


def cmd_list_deployments():
    """Print available rollback deployments, one per line."""
    cur = current_subvol()
    try:
        mount_toplevel()
        for sv in list_deployments():
            if sv != cur:
                ver = sv.replace("@rootfs-", "")
                print(f"{sv}\t{ver}")
    finally:
        umount_toplevel()


def find_menuentry_index(content: str, subvol: str) -> int:
    """Return the index of the menuentry block that boots `subvol`.

    grub.cfg entries are generated in the same order list_deployments()
    returns them, but we match on content (not position) since pruning can
    shift indices between writes. Falls back to entry 0 if no block
    references the subvol.

    Matches only on the kernel/initrd path (`/<subvol>/boot/`), never on the
    `rootflags=subvol=<subvol>` cmdline fragment: subvol names share a
    "@rootfs" / "@rootfs-<version>" prefix, so an unanchored match on the
    cmdline fragment lets "@rootfs" match the first "@rootfs-<version>"
    block instead of the bare @rootfs one.
    """
    entries = content.split("menuentry")
    for i, block in enumerate(entries[1:]):
        if f"/{subvol}/boot/" in block:
            return i
    return 0


def set_grub_default(content: str, target_idx: int) -> str:
    """Rewrite `set default=` to target_idx and disable the 0s auto-boot timeout."""
    new_lines = []
    for line in content.splitlines():
        if line.startswith("set default="):
            new_lines.append(f"set default={target_idx}")
        elif line.startswith("set timeout=0"):
            new_lines.append("set timeout=5")
        else:
            new_lines.append(line)
    return "\n".join(new_lines) + "\n"


def cmd_rollback(subvol):
    """Switch grub default to subvol and reboot."""
    try:
        mount_toplevel()
        available = list_deployments()
        if subvol not in available and subvol != "@rootfs":
            die(f"Deployment '{subvol}' not found. Available: {available}")

        cfg_path = EFI_GRUB_CFG
        content = open(cfg_path).read()

        target_idx = find_menuentry_index(content, subvol)

        with open(cfg_path, "w") as f:
            f.write(set_grub_default(content, target_idx))

        log(f"GRUB default set to entry {target_idx} ({subvol})")
    finally:
        umount_toplevel()

    log("Rollback configured. Reboot to apply.")


@dataclass
class ApplyPlan:
    """Snapshot/create/prune decisions for cmd_apply.

    Computed once from btrfs state as it exists before this apply run
    touches anything, so the whole decision is a pure function of that
    state and can be tested without btrfs, GRUB, or root.
    """
    backup_name: str
    need_snapshot: bool
    new_subvol: str
    need_new_subvol_cleanup: bool
    pre_prune_deployments: list = field(default_factory=list)
    prune: list = field(default_factory=list)
    final_deployments: list = field(default_factory=list)


def plan_apply(running: str, cur_version: str, remote_version: str,
               existing_deployments: list) -> ApplyPlan:
    """Decide what cmd_apply needs to snapshot, create, and prune.

    `existing_deployments` is list_deployments()'s result from *before* this
    run creates anything. `running` may not appear in it — a fresh install's
    running subvolume is the bare "@rootfs", which list_deployments() never
    returns since it only matches the "@rootfs-*" naming pattern.
    """
    backup_name = f"@rootfs-{cur_version}"
    new_subvol = f"@rootfs-{remote_version}"

    # A subvolume named backup_name can already exist for two reasons: a
    # previous apply run snapshotted it and was then interrupted before
    # pruning, or it *is* the running subvolume (steady state once a system
    # has been updated at least once, since running == f"@rootfs-{cur}").
    # Either way there's nothing to snapshot.
    need_snapshot = backup_name not in set(existing_deployments) | {running}

    need_new_subvol_cleanup = new_subvol in existing_deployments

    pre_prune_deployments = sort_deployment_names(
        set(existing_deployments) | {backup_name, new_subvol}
    )
    prune = sort_deployment_names(
        s for s in pre_prune_deployments if s not in (new_subvol, backup_name)
    )
    final_deployments = sort_deployment_names(
        s for s in pre_prune_deployments if s not in prune
    )

    return ApplyPlan(
        backup_name=backup_name,
        need_snapshot=need_snapshot,
        new_subvol=new_subvol,
        need_new_subvol_cleanup=need_new_subvol_cleanup,
        pre_prune_deployments=pre_prune_deployments,
        prune=prune,
        final_deployments=final_deployments,
    )


def cmd_apply():
    cur = current_version()
    channel = get_channel()
    log(f"Current version: {cur}  channel: {channel}")
    log("Fetching manifest...")

    manifest = fetch_manifest(channel)
    if not manifest:
        die("Could not fetch update manifest — check network")

    remote = manifest.get("version", "0.0.0")
    if ver_tuple(remote) <= ver_tuple(cur):
        log(f"Already up to date ({cur})")
        sys.exit(0)

    log(f"New version: {remote}")
    payload = manifest.get("payloads", {}).get("rootfs", {})
    url    = payload.get("url", "")
    sha256 = payload.get("sha256", "")
    if not url:
        die("Manifest has no rootfs payload URL")

    os.makedirs(CACHE_DIR, exist_ok=True)
    archive = os.path.join(CACHE_DIR, f"hippos-rootfs-{remote}.tar.zst")

    if not os.path.exists(archive):
        log("Downloading rootfs payload...")
        req = _make_request(url)
        with urllib.request.urlopen(req) as resp, open(archive, "wb") as f:
            total = int(resp.headers.get("Content-Length", 0))
            done = 0
            while chunk := resp.read(262144):
                f.write(chunk)
                done += len(chunk)
                if total:
                    log(f"Downloading... {done * 100 // total}%")

    if sha256:
        log("Verifying checksum...")
        if sha256_file(archive) != sha256:
            os.remove(archive)
            die("SHA256 mismatch — download may be corrupt")
        log("Checksum OK")

    try:
        mount_toplevel()

        running = current_subvol()
        plan = plan_apply(running, cur, remote, list_deployments())

        backup_path = os.path.join(BTRFS_MNT, plan.backup_name)
        running_path = os.path.join(BTRFS_MNT, running)
        new_path = os.path.join(BTRFS_MNT, plan.new_subvol)

        if plan.need_snapshot:
            log(f"Snapshotting {running} → {plan.backup_name}...")
            subprocess.run(
                ["btrfs", "subvolume", "snapshot", "-r", running_path, backup_path],
                check=True
            )

        if plan.need_new_subvol_cleanup:
            subprocess.run(["btrfs", "subvolume", "delete", new_path], check=True)
        log(f"Creating {plan.new_subvol}...")
        subprocess.run(["btrfs", "subvolume", "create", new_path], check=True)

        log(f"Extracting rootfs...")
        subprocess.run(
            ["tar", "--xattrs", "--acls", "--numeric-owner",
             "-I", "zstd -d", "-xf", archive, "-C", new_path],
            check=True
        )

        # Preserve fstab — the rootfs tarball has the build-time placeholder;
        # the real one contains machine-specific PARTUUIDs for EFI and userdata.
        shutil.copy2("/etc/fstab", os.path.join(new_path, "etc", "fstab"))
        log("fstab preserved from running system")

        uuid, partuuid = read_grub_uuid_partuuid()
        if not uuid or not partuuid:
            die("Cannot read UUID/PARTUUID from existing grub.cfg")

        write_grub_cfg(plan.new_subvol, plan.pre_prune_deployments, uuid, partuuid)
        log(f"GRUB updated — default: {plan.new_subvol}")

        # Arm the boot counter so rollback is offered after 3 failed boot attempts.
        grubenv = "/boot/efi/grub/grubenv"
        subprocess.run(["grub-editenv", grubenv, "create"], check=False)
        subprocess.run(["grub-editenv", grubenv, "set", "boot_counter=3"], check=True)
        log("Boot counter armed (3 attempts before rollback)")

        for stale in plan.prune:
            log(f"Pruning old deployment {stale}...")
            result = subprocess.run(
                ["btrfs", "subvolume", "delete", os.path.join(BTRFS_MNT, stale)],
                check=False,
            )
            if result.returncode != 0:
                log(f"WARNING: failed to prune {stale} (exit {result.returncode}) "
                    f"— it will be retried on the next update")
        if plan.prune:
            write_grub_cfg(plan.new_subvol, plan.final_deployments, uuid, partuuid)
            log("GRUB updated after pruning")
    finally:
        umount_toplevel()

    try:
        os.remove(archive)
    except Exception:
        pass

    log("Update complete. Reboot to apply the new version.")


