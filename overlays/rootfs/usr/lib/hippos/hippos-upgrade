def cmd_update_emulator(name, force=False):
    manifest = fetch_manifest(get_channel())
    if not manifest:
        die("Could not fetch manifest")

    emulators = manifest.get("payloads", {}).get("emulators", {})
    if name not in emulators:
        die(f"Emulator '{name}' not found in manifest. Available: {sorted(emulators.keys())}")

    info = emulators[name]
    remote = info.get("version", "")
    url    = info.get("url", "")
    sha256 = info.get("sha256", "")

    installed = installed_emulator_version(name)
    if installed == remote and not force:
        log(f"{name} is already at {remote}")
        sys.exit(0)

    log(f"{'Force-reinstalling' if force else 'Updating'} {name}: {installed or 'not installed'} → {remote}")

    os.makedirs(CACHE_DIR, exist_ok=True)
    archive = os.path.join(CACHE_DIR, f"hippos-emulator-{name}-{remote}.tar.zst")

    if force and os.path.exists(archive):
        os.remove(archive)

    if not os.path.exists(archive):
        log(f"Downloading {name} {remote}...")
        req = _make_request(url)
        with urllib.request.urlopen(req) as resp, open(archive, "wb") as f:
            total = int(resp.headers.get("Content-Length", 0))
            done = 0
            while chunk := resp.read(262144):
                f.write(chunk)
                done += len(chunk)
                if total:
                    log(f"Downloading... {done * 100 // total}%")

    if sha256:
        log("Verifying checksum...")
        if sha256_file(archive) != sha256:
            os.remove(archive)
            die("SHA256 mismatch — download may be corrupt")
        log("Checksum OK")

    dest = os.path.join(EMULATORS_DIR, name)
    os.makedirs(dest, exist_ok=True)

    log(f"Extracting {name} to {dest}...")
    subprocess.run(
        ["tar", "--xattrs", "--acls", "--numeric-owner",
         "-I", "zstd -d", "-xf", archive, "-C", dest],
        check=True
    )

    try:
        os.remove(archive)
    except Exception:
        pass

    log(f"{name} updated to {remote}")


