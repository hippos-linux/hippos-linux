def _require_root():
    if os.geteuid() != 0:
        result = subprocess.run(["sudo", sys.executable] + sys.argv)
        sys.exit(result.returncode)

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "apply"

    READONLY_CMDS = {"check", "list-emulator-updates",
                     "list-frontend-updates", "list-kernel-update", "list-patches"}
    if cmd not in READONLY_CMDS:
        _require_root()
        _open_log()
        _lock = open(LOCK_FILE, "w")
        fcntl.flock(_lock, fcntl.LOCK_EX)

    if cmd == "check":
        cmd_check()
    elif cmd == "list-deployments":
        cmd_list_deployments()
    elif cmd == "rollback":
        if len(sys.argv) < 3:
            die("Usage: hippos-upgrade rollback <subvol>")
        cmd_rollback(sys.argv[2])
    elif cmd == "list-emulator-updates":
        cmd_list_emulator_updates()
    elif cmd == "update-emulator":
        args = [a for a in sys.argv[2:] if not a.startswith("-")]
        force = "--force" in sys.argv
        if not args:
            die("Usage: hippos-upgrade update-emulator [--force] <name>")
        cmd_update_emulator(args[0], force=force)
    elif cmd == "update-all-emulators":
        cmd_update_all_emulators()
    elif cmd == "list-frontend-updates":
        cmd_list_frontend_updates()
    elif cmd == "update-frontend":
        if len(sys.argv) < 3:
            die("Usage: hippos-upgrade update-frontend <name>")
        cmd_update_frontend(sys.argv[2])
    elif cmd == "list-kernel-update":
        cmd_list_kernel_update()
    elif cmd == "update-kernel":
        cmd_update_kernel()
    elif cmd == "list-patches":
        cmd_list_patches()
    elif cmd == "apply-patches":
        cmd_apply_patches()
    elif cmd == "update-grub":
        cmd_update_grub()
    else:
        cmd_apply()
