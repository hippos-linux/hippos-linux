from dataclasses import dataclass, field
from datetime import datetime

VERSION_FILE      = "/usr/share/hippos/version"
SYSCONF           = "/userdata/system/hippos.conf"
CACHE_DIR         = "/userdata/system/cache/update"
BTRFS_MNT         = "/tmp/hippos-btrfs-update"
BARE_ROOTFS       = "@rootfs"
STAGING_ROOTFS    = "@rootfs.new"
UPDATE_PENDING    = "/run/hippos-update-pending"
LOCK_FILE         = "/run/lock/hippos-upgrade.lock"
KERNEL_SNAPSHOT_PREFIX = "@rootfs-kernel-"
LOG_FILE          = "/userdata/system/logs/upgrade.log"
PATCHES_STATE_FILE = "/userdata/system/applied-patches.json"

_DEB_ARCH = {'x86_64': 'amd64', 'aarch64': 'arm64'}.get(platform.machine(), platform.machine())

MANIFEST_URLS = [
    f"https://hippos-linux.org/api/update/manifest-{_DEB_ARCH}.json",
]

_log_fh = None

def _open_log():
    global _log_fh
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        _log_fh = open(LOG_FILE, "a")
        _log_fh.write(f"\n--- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} ---\n")
        _log_fh.flush()
    except Exception:
        _log_fh = None

def log(msg):
    line = f"[hippos-upgrade] {msg}"
    print(line, flush=True)
    if _log_fh:
        try:
            _log_fh.write(line + "\n")
            _log_fh.flush()
        except Exception:
            pass

def die(msg):
    log(f"ERROR: {msg}")
    sys.exit(1)

def _log_uncaught_exception(exc_type, exc_value, exc_tb):
    log("CRASH: " + "".join(traceback.format_exception(exc_type, exc_value, exc_tb)).rstrip())
    sys.__excepthook__(exc_type, exc_value, exc_tb)

sys.excepthook = _log_uncaught_exception

def current_version():
    try:
        return open(VERSION_FILE).read().strip()
    except FileNotFoundError:
        return "0.0.0"

def parse_current_subvol(mounts_text: str) -> str:
    for line in mounts_text.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[1] == "/" and parts[2] == "overlay":
            for opt in parts[3].split(","):
                if opt.startswith("lowerdir="):
                    lowerdir = opt[len("lowerdir="):]
                    last = lowerdir.rstrip("/").split("/")[-1]
                    if last.startswith("@rootfs"):
                        return last
    return BARE_ROOTFS

def current_subvol():
    return parse_current_subvol(open("/proc/mounts").read())

def get_channel():
    try:
        for line in open(SYSCONF):
            k, _, v = line.strip().partition("=")
            if k.strip() == "updates.type":
                return v.strip().strip('"')
    except FileNotFoundError:
        pass
    return "stable"

def get_beta_token():
    try:
        for line in open(SYSCONF):
            k, _, v = line.strip().partition("=")
            if k.strip() == "updates.token":
                return v.strip().strip('"')
    except FileNotFoundError:
        pass
    return None

def _make_request(url: str) -> urllib.request.Request:
    headers = {"User-Agent": "hippos-upgrade/1.0", "X-HippOS-Version": current_version()}
    token = get_beta_token()
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return urllib.request.Request(url, headers=headers)

def fetch_manifest(channel):
    if channel == "dev":
        urls = [f"https://hippos-linux.org/api/update/manifest-{_DEB_ARCH}-dev.json"]
    else:
        urls = MANIFEST_URLS[:]
        urls.insert(1, f"https://updates.hippos.org/{channel}/manifest.json")
    for url in urls:
        try:
            req = _make_request(url)
            with urllib.request.urlopen(req, timeout=15) as r:
                return json.loads(r.read())
        except urllib.error.HTTPError as e:
            if e.code == 401:
                die("Beta access token is invalid or has been revoked. "
                    "Contact the HippOS team to renew your access.")
            log(f"Manifest fetch failed for {url}: HTTP {e.code}")
            continue
        except Exception as e:
            log(f"Manifest fetch failed for {url}: {e}")
            continue
    return None

def ver_tuple(v):
    base, _, pre = v.lstrip("v").partition("-")
    parts = (base.split(".") + ["0", "0", "0"])[:3]
    pre_match = re.search(r"(\d+)$", pre)
    pre_num = int(pre_match.group(1)) if pre_match else 0
    return tuple(int(x) for x in parts) + (pre_num,)

def btrfs_device():
    for line in open("/proc/mounts"):
        parts = line.split()
        if len(parts) >= 3 and parts[2] == "btrfs":
            return parts[0]
    die("Cannot find btrfs root device")

def mount_toplevel():
    os.makedirs(BTRFS_MNT, exist_ok=True)
    subprocess.run(
        ["mount", "-t", "btrfs", "-o", "subvolid=5", btrfs_device(), BTRFS_MNT],
        check=True
    )

def umount_toplevel():
    subprocess.run(["umount", "-l", BTRFS_MNT], check=False)

def _deployment_sort_key(name):
    if name.startswith(KERNEL_SNAPSHOT_PREFIX):
        return (2, name)
    if name == BARE_ROOTFS:
        return (1, name)
    return (0, ver_tuple(name[len("@rootfs-"):]))

def sort_deployment_names(names) -> list[str]:
    return sorted(names, key=_deployment_sort_key)

def parse_deployment_names(btrfs_list_output: str) -> list[str]:
    names = []
    for line in btrfs_list_output.splitlines():
        parts = line.split()
        if parts:
            name = parts[-1]
            if name == BARE_ROOTFS or name.startswith("@rootfs-"):
                names.append(name)
    return sort_deployment_names(names)

def list_deployments():
    r = subprocess.run(
        ["btrfs", "subvolume", "list", "-o", BTRFS_MNT],
        capture_output=True, text=True
    )
    if r.returncode != 0:
        log(f"WARNING: btrfs subvolume list failed: {r.stderr.strip()}")
    return parse_deployment_names(r.stdout)

def deployment_version(name):
    if name != BARE_ROOTFS:
        return name[len("@rootfs-"):]
    try:
        return open(os.path.join(BTRFS_MNT, BARE_ROOTFS, VERSION_FILE.lstrip("/"))).read().strip()
    except FileNotFoundError:
        return "latest"

def require_no_pending_update():
    if os.path.exists(UPDATE_PENDING):
        die("An update is waiting for a reboot — restart first")

_KERNEL_VARIANTS = ("standard", "lts")
_KERNEL_VARIANT_SUFFIX = {"standard": "-hippos", "lts": "-hippos-lts"}

def _kernel_sort_key(name):
    ver = name[len("vmlinuz-"):] if name.startswith("vmlinuz-") else name
    for suffix in ("-hippos-lts", "-hippos"):
        if ver.endswith(suffix):
            ver = ver[:-len(suffix)]
            break
    try:
        return tuple(int(x) for x in ver.split("."))
    except ValueError:
        return (0,)

def find_kernel_files(subvol_path, variant):
    boot = os.path.join(subvol_path, "boot")
    suffix = _KERNEL_VARIANT_SUFFIX[variant]
    kernels = []
    try:
        for f in os.listdir(boot):
            if not (f.startswith("vmlinuz-") and f.endswith(suffix)):
                continue
            if variant == "standard" and f.endswith("-hippos-lts"):
                continue
            kernels.append(f)
    except FileNotFoundError:
        pass
    if not kernels:
        return None
    kernel = sorted(kernels, key=_kernel_sort_key)[-1]
    kver = kernel[len("vmlinuz-"):]
    initrd = f"initrd.img-{kver}" if os.path.exists(os.path.join(boot, f"initrd.img-{kver}")) else "initrd.img"
    return kernel, initrd

def default_kernel_variant():
    try:
        result = subprocess.run(
            ["hippos-settings", "get", "system.kernel"],
            capture_output=True, text=True, timeout=10,
        )
        variant = result.stdout.strip()
    except Exception:
        variant = ""
    return variant if variant in _KERNEL_VARIANTS else "standard"

EFI_MOUNT = "/boot/efi"
EFI_GRUB_CFG = "/boot/efi/grub/grub.cfg"
EFI_GRUBENV = "/boot/efi/grub/grubenv"
DEPLOYMENT_GRUB_THEME = "usr/share/hippos/grub/themes/hippos"
GRUB_THEME = "/grub/themes/hippos"
EFI_GRUB_THEME = "/boot/efi/grub/themes/hippos"
BOOT_ATTEMPTS = 3
GRUB_DEFAULT_CFG = "/etc/default/grub"
GRUB_DEFAULT_CFG_DIR = "/etc/default/grub.d"

_MANAGED_KERNEL_ARG_PREFIXES = (
    "root=",
    "rootfstype=",
    "rootflags=",
)
_MANAGED_KERNEL_ARGS = {
    "ro",
    "rw",
    "quiet",
    "splash",
}

def read_grub_uuid_partuuid():
    uuid = partuuid = None
    try:
        for line in open(EFI_GRUB_CFG):
            if "--fs-uuid" in line and not uuid:
                for t in line.split():
                    if len(t) == 36 and t.count("-") == 4:
                        uuid = t
            if "PARTUUID=" in line and not partuuid:
                for t in line.split():
                    if "PARTUUID=" in t:
                        partuuid = t.split("PARTUUID=")[1].split()[0].rstrip("\\")
    except FileNotFoundError:
        pass
    if not partuuid or not uuid:
        try:
            dev = btrfs_device()
            r = subprocess.run(
                ["blkid", "-s", "PARTUUID", "-s", "UUID", "-o", "export", dev],
                capture_output=True, text=True, check=True,
            )
            for line in r.stdout.splitlines():
                if line.startswith("PARTUUID=") and not partuuid:
                    partuuid = line.split("=", 1)[1]
                elif line.startswith("UUID=") and not uuid:
                    uuid = line.split("=", 1)[1]
        except Exception:
            pass
    return uuid, partuuid

def _split_kernel_args(value):
    if not value:
        return []
    try:
        return shlex.split(value)
    except ValueError:
        return value.split()

def _filter_managed_kernel_args(args):
    filtered = []
    for arg in args:
        if arg in _MANAGED_KERNEL_ARGS:
            continue
        if any(arg.startswith(prefix) for prefix in _MANAGED_KERNEL_ARG_PREFIXES):
            continue
        filtered.append(arg)
    return filtered

def _dedupe_kernel_args(*arg_lists):
    merged = []
    seen = set()
    for args in arg_lists:
        for arg in args:
            if arg in seen:
                continue
            merged.append(arg)
            seen.add(arg)
    return merged

def read_grub_cmdline_args():
    config_files = [GRUB_DEFAULT_CFG]
    config_files.extend(sorted(glob.glob(os.path.join(GRUB_DEFAULT_CFG_DIR, "*.cfg"))))

    script = """
GRUB_CMDLINE_LINUX=""
GRUB_CMDLINE_LINUX_DEFAULT=""
for file in "$@"; do
    [ -f "$file" ] || continue
    . "$file"
done
printf '%s\\n%s\\n' "$GRUB_CMDLINE_LINUX" "$GRUB_CMDLINE_LINUX_DEFAULT"
"""

    try:
        result = subprocess.run(
            ["bash", "-c", script, "bash", *config_files],
            capture_output=True,
            text=True,
            check=True,
        )
    except Exception:
        return []

    lines = result.stdout.splitlines()
    linux_args = _filter_managed_kernel_args(
        _split_kernel_args(lines[0] if len(lines) >= 1 else "")
    )
    default_args = _filter_managed_kernel_args(
        _split_kernel_args(lines[1] if len(lines) >= 2 else "")
    )
    return _dedupe_kernel_args(linux_args, default_args)

def os_prober_entries():
    try:
        result = subprocess.run(
            ["os-prober"], capture_output=True, text=True, timeout=30
        )
        lines = result.stdout.strip().splitlines()
    except Exception:
        return []

    entries = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        parts = line.split(":")
        if len(parts) < 4:
            continue
        devpath, label, _short, etype = parts[0], parts[1], parts[2], parts[3]

        if etype == "efi":
            if "@" not in devpath:
                continue
            dev, efi_path = devpath.split("@", 1)
            try:
                dev_uuid = subprocess.run(
                    ["blkid", "-s", "UUID", "-o", "value", dev],
                    capture_output=True, text=True, check=True
                ).stdout.strip()
            except Exception:
                dev_uuid = ""
            if not dev_uuid:
                log(f"os-prober: cannot get UUID for {dev} — skipping '{label}'")
                continue
            log(f"os-prober: found EFI entry '{label}' ({dev} {efi_path})")
            entries.append("\n".join([
                f'menuentry "{label}" {{',
                f'    insmod part_gpt',
                f'    insmod fat',
                f'    search --no-floppy --set=root --fs-uuid {dev_uuid}',
                f'    chainloader {efi_path}',
                f'}}',
                '',
            ]))
    return entries

def _grub_menuentry(label, subvol, kernel, initrd, uuid, cmdline, entry_id=None):
    id_option = f' --id={entry_id}' if entry_id else ''
    return [
        f'menuentry "{label}"{id_option} {{',
        f'    insmod btrfs',
        f'    insmod part_gpt',
        f'    if ! search --no-floppy --set=root --fs-uuid {uuid} ; then',
        f'        search --no-floppy --set=root --label HippOS',
        f'    fi',
        f'    linux /{subvol}/boot/{kernel} {cmdline}',
        f'    initrd /{subvol}/boot/{initrd}',
        f'}}',
        '',
    ]

def arm_boot_counter():
    subprocess.run(["grub-editenv", EFI_GRUBENV, "create"], check=False)
    subprocess.run(["grub-editenv", EFI_GRUBENV, "set", f"boot_counter={BOOT_ATTEMPTS}"], check=True)
    log(f"Boot counter armed ({BOOT_ATTEMPTS} attempts before rollback)")

def install_grub_theme(deployment_path):
    source = os.path.join(deployment_path, DEPLOYMENT_GRUB_THEME)
    if not os.path.isdir(source):
        return
    shutil.rmtree(EFI_GRUB_THEME, ignore_errors=True)
    os.makedirs(EFI_GRUB_THEME)
    for name in os.listdir(source):
        shutil.copyfile(os.path.join(source, name), os.path.join(EFI_GRUB_THEME, name))

def efi_partition_mounted():
    return os.path.ismount(EFI_MOUNT)

def require_efi_partition():
    if not efi_partition_mounted():
        die(f"HippOS's boot partition is not mounted at {EFI_MOUNT}, so the boot "
            "menu can't be changed. If another system's boot loader starts HippOS, "
            "point it at the deployment you want instead.")

def update_boot_menu(default_subvol, deployments, uuid, partuuid):
    if not efi_partition_mounted():
        log(f"No HippOS boot partition at {EFI_MOUNT} — boot menu left to the "
            f"system's own boot loader, which must start {BARE_ROOTFS}")
        return
    write_grub_cfg(default_subvol, deployments, uuid, partuuid)
    log(f"GRUB updated — default: {default_subvol}")
    arm_boot_counter()

def write_grub_cfg(default_subvol, all_subvols, uuid, partuuid):
    require_efi_partition()
    extra_args = read_grub_cmdline_args()
    rollback_subvols = [s for s in reversed(all_subvols) if s != default_subvol]
    other_entries = os_prober_entries()
    default_timeout = "5"
    default_style   = "menu"

    default_variant = default_kernel_variant()
    variant_order = [default_variant] + [v for v in _KERNEL_VARIANTS if v != default_variant]

    def base_cmdline(subvol, extra=()):
        return " ".join([
            f"root=PARTUUID={partuuid}",
            "rootfstype=btrfs",
            f"rootflags=subvol={subvol}",
            "ro",
            *extra,
            *extra_args,
        ])

    def kernel_for(subvol_path, variant, required=False):
        found = find_kernel_files(subvol_path, variant)
        if found is None and required:
            found = "vmlinuz", "initrd.img"
        return found

    default_subvol_path = os.path.join(BTRFS_MNT, default_subvol)
    default_kernel, default_initrd = kernel_for(default_subvol_path, default_variant, required=True)
    install_grub_theme(default_subvol_path)

    fallback_id = "hippos_fallback"
    fallback = next(
        (
            (default_subvol, v) for v in variant_order[1:]
            if kernel_for(default_subvol_path, v)
        ),
        None,
    ) or next(
        (
            (subvol, v)
            for subvol in rollback_subvols[:1]
            for v in variant_order
            if kernel_for(os.path.join(BTRFS_MNT, subvol), v)
        ),
        (default_subvol, default_variant),
    )

    lines = [
        "insmod all_video",
        "insmod gfxterm",
        "insmod png",
        "insmod jpeg",
        "set gfxmode=auto",
        "terminal_output gfxterm",
        f"if [ -f {GRUB_THEME}/theme.txt ] ; then",
        f"    set theme={GRUB_THEME}/theme.txt",
        *(f"    loadfont {GRUB_THEME}/{os.path.basename(font)}"
          for font in sorted(glob.glob(os.path.join(EFI_GRUB_THEME, "*.pf2")))),
        "fi",
        "",
        "load_env",
        "set default=0",
        f"set timeout={default_timeout}",
        f"set timeout_style={default_style}",
        "",
        "if [ \"${boot_counter}\" ] ; then",
        "    if [ \"${boot_counter}\" = \"0\" ] ; then",
        f"        set default=\"{fallback_id}\"",
        "        set timeout=10",
        "        set timeout_style=menu",
        "        set boot_counter=",
        "        save_env boot_counter",
        *(line for count in range(BOOT_ATTEMPTS, 0, -1) for line in (
            f"    elif [ \"${{boot_counter}}\" = \"{count}\" ] ; then",
            f"        set boot_counter={count - 1}",
            "        save_env boot_counter",
        )),
        "    fi",
        "fi",
        "",
    ]

    def id_if_fallback(subvol, variant):
        return fallback_id if (subvol, variant) == fallback else None

    lines += _grub_menuentry(
        "HippOS", default_subvol, default_kernel, default_initrd, uuid,
        base_cmdline(default_subvol, ("quiet", "splash")),
        entry_id=id_if_fallback(default_subvol, default_variant),
    )

    advanced = []
    for variant in variant_order[1:]:
        found = kernel_for(default_subvol_path, variant)
        if found is None:
            continue
        kernel, initrd = found
        advanced += _grub_menuentry(
            f"HippOS ({variant.upper() if variant == 'lts' else variant})",
            default_subvol, kernel, initrd, uuid,
            base_cmdline(default_subvol, ("quiet", "splash")),
            entry_id=id_if_fallback(default_subvol, variant),
        )

    for variant in variant_order:
        found = kernel_for(default_subvol_path, variant)
        if found is None:
            continue
        kernel, initrd = found
        suffix = " (LTS, verbose)" if variant == "lts" else " (verbose)"
        advanced += _grub_menuentry(
            f"HippOS{suffix}", default_subvol, kernel, initrd, uuid,
            base_cmdline(default_subvol, ("systemd.log_level=debug",)),
        )

    for variant in variant_order:
        found = kernel_for(default_subvol_path, variant)
        if found is None:
            continue
        kernel, initrd = found
        suffix = " (LTS, debug)" if variant == "lts" else " (debug)"
        advanced += _grub_menuentry(
            f"HippOS{suffix}", default_subvol, kernel, initrd, uuid,
            base_cmdline(default_subvol, ("systemd.log_level=debug", "systemd.unit=rescue.target")),
        )

    for subvol in rollback_subvols:
        subvol_path = os.path.join(BTRFS_MNT, subvol)
        ver = deployment_version(subvol)
        base_label = f"HippOS {ver} (rollback)"
        for variant in variant_order:
            found = kernel_for(subvol_path, variant)
            if found is None:
                continue
            kernel, initrd = found
            label = f"{base_label} (LTS)" if variant == "lts" else base_label
            advanced += _grub_menuentry(
                label, subvol, kernel, initrd, uuid,
                base_cmdline(subvol, ("quiet", "splash")),
                entry_id=id_if_fallback(subvol, variant),
            )

    lines += [
        'submenu "Advanced options" {',
        *(f"    {l}" if l else "" for l in advanced),
        '}',
        '',
        'if fwsetup --is-supported ; then',
        '    menuentry "Firmware settings" {',
        '        fwsetup',
        '    }',
        'fi',
        '',
    ]

    if other_entries:
        lines += other_entries

    os.makedirs(os.path.dirname(EFI_GRUB_CFG), exist_ok=True)
    with open(EFI_GRUB_CFG, "w") as f:
        f.write("\n".join(lines))

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(131072):
            h.update(chunk)
    return h.hexdigest()

def fetch_archive(url, archive, sha256="", timeout=None):
    if os.path.exists(archive):
        if not sha256 or sha256_file(archive) == sha256:
            return
        os.remove(archive)

    part = archive + ".part"
    log(f"Downloading {os.path.basename(archive)}...")
    try:
        req = _make_request(url)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp, open(part, "wb") as f:
                total = int(resp.headers.get("Content-Length", 0))
                done = 0
                while chunk := resp.read(262144):
                    f.write(chunk)
                    done += len(chunk)
                    if total:
                        log(f"Downloading... {done * 100 // total}%")
        except OSError as e:
            die(f"Download interrupted ({e}) — check your connection and free space, then retry")

        if sha256:
            log("Verifying checksum...")
            if sha256_file(part) != sha256:
                die("SHA256 mismatch — download may be corrupt")
            log("Checksum OK")

        os.replace(part, archive)
    finally:
        if os.path.exists(part):
            os.remove(part)

def cmd_check():
    cur = current_version()
    manifest = fetch_manifest(get_channel())
    if not manifest:
        sys.exit(1)
    remote = manifest.get("version", "0.0.0")
    if ver_tuple(remote) > ver_tuple(cur):
        print(f"New version available: {remote}")
        print(f"Current version: {cur}")
        sys.exit(0)
    sys.exit(1)

def cmd_list_deployments():
    cur = current_subvol()
    try:
        mount_toplevel()
        for sv in list_deployments():
            if sv != cur:
                print(f"{sv}\t{deployment_version(sv)}")
    finally:
        umount_toplevel()

def cmd_rollback(subvol):
    try:
        mount_toplevel()
        available = list_deployments()
        if subvol not in available:
            die(f"Deployment '{subvol}' not found. Available: {available}")

        uuid, partuuid = read_grub_uuid_partuuid()
        if not uuid or not partuuid:
            die("Cannot read UUID/PARTUUID from existing grub.cfg")

        write_grub_cfg(subvol, available, uuid, partuuid)
        log(f"GRUB default set to {subvol}")
    finally:
        umount_toplevel()

    log("Rollback configured. Reboot to apply.")

@dataclass
class ApplyPlan:
    prune: list
    retire_running_as: str | None
    final_deployments: list

def plan_apply(running: str, cur_version: str, existing_deployments: list) -> ApplyPlan:
    retire = f"@rootfs-{cur_version}" if running == BARE_ROOTFS else None
    return ApplyPlan(
        prune=sort_deployment_names(s for s in existing_deployments if s != running),
        retire_running_as=retire,
        final_deployments=sort_deployment_names({retire or running, BARE_ROOTFS}),
    )

UPDATE_SPACE_RESERVE = 512 * 1024 * 1024

def update_space_shortfall(free_bytes, payload, archive_cached):
    installed = payload.get("installed_size")
    if installed is None:
        return 0
    needed = installed + UPDATE_SPACE_RESERVE
    if not archive_cached:
        needed += payload.get("size", 0)
    return max(0, needed - free_bytes)

def remove_stale_archives(keep_archive):
    for name in os.listdir(CACHE_DIR):
        path = os.path.join(CACHE_DIR, name)
        if name.startswith("hippos-rootfs-") and path not in (keep_archive, keep_archive + ".part"):
            log(f"Removing stale update download {name}")
            os.remove(path)

def cmd_apply():
    require_no_pending_update()
    cur = current_version()
    channel = get_channel()
    log(f"Current version: {cur}  channel: {channel}")
    log("Fetching manifest...")

    manifest = fetch_manifest(channel)
    if not manifest:
        die("Could not fetch update manifest — check network")

    remote = manifest.get("version", "0.0.0")
    if ver_tuple(remote) <= ver_tuple(cur):
        log(f"Already up to date ({cur})")
        sys.exit(0)

    log(f"New version: {remote}")
    payload = manifest.get("payloads", {}).get("rootfs", {})
    url    = payload.get("url", "")
    sha256 = payload.get("sha256", "")
    if not url:
        die("Manifest has no rootfs payload URL")

    os.makedirs(CACHE_DIR, exist_ok=True)
    archive = os.path.join(CACHE_DIR, f"hippos-rootfs-{remote}.tar.zst")
    remove_stale_archives(archive)

    try:
        mount_toplevel()

        uuid, partuuid = read_grub_uuid_partuuid()
        if not uuid or not partuuid:
            die("Cannot read UUID/PARTUUID from existing grub.cfg")

        running = current_subvol()
        plan = plan_apply(running, cur, list_deployments())
        staging_path = os.path.join(BTRFS_MNT, STAGING_ROOTFS)

        stale = ([STAGING_ROOTFS] if os.path.isdir(staging_path) else []) + plan.prune
        for name in stale:
            log(f"Pruning old deployment {name}...")
            result = subprocess.run(
                ["btrfs", "subvolume", "delete", os.path.join(BTRFS_MNT, name)],
                check=False,
            )
            if result.returncode != 0:
                log(f"WARNING: failed to prune {name} (exit {result.returncode}) "
                    f"— it will be retried on the next update")
        if stale:
            subprocess.run(["btrfs", "subvolume", "sync", BTRFS_MNT], check=False)
        if plan.prune and efi_partition_mounted():
            write_grub_cfg(running, [running], uuid, partuuid)
            log("GRUB updated after pruning")

        shortfall = update_space_shortfall(
            shutil.disk_usage(BTRFS_MNT).free, payload, os.path.exists(archive),
        )
        if shortfall:
            shortfall_mb = (shortfall + 1024 * 1024 - 1) // (1024 * 1024)
            die(f"Not enough free space for this update — free at least "
                f"{shortfall_mb} MB under /userdata (e.g. ROMs or media) and retry")

        fetch_archive(url, archive, sha256)

        log(f"Creating {STAGING_ROOTFS}...")
        subprocess.run(["btrfs", "subvolume", "create", staging_path], check=True)

        log(f"Extracting rootfs...")
        subprocess.run(
            ["tar", "--xattrs", "--acls", "--numeric-owner",
             "-I", "zstd -d", "-xf", archive, "-C", staging_path],
            check=True
        )

        shutil.copy2("/etc/fstab", os.path.join(staging_path, "etc", "fstab"))
        log("fstab preserved from running system")

        if plan.retire_running_as:
            log(f"Renaming {BARE_ROOTFS} → {plan.retire_running_as}...")
            os.rename(os.path.join(BTRFS_MNT, BARE_ROOTFS),
                      os.path.join(BTRFS_MNT, plan.retire_running_as))
        os.rename(staging_path, os.path.join(BTRFS_MNT, BARE_ROOTFS))
        open(UPDATE_PENDING, "w").close()
        log(f"{remote} installed as {BARE_ROOTFS}")

        update_boot_menu(BARE_ROOTFS, plan.final_deployments, uuid, partuuid)
    finally:
        umount_toplevel()

    try:
        os.remove(archive)
    except Exception:
        pass

    log("Update complete. Reboot to apply the new version.")

EMULATORS_DIR = "/userdata/emulators"
FRONTEND_INSTALL_ROOT = "/"

def installed_kernel_version():
    kernels = []
    try:
        for f in os.listdir("/boot"):
            if f.startswith("vmlinuz-") and f.endswith("-hippos"):
                kernels.append(f.replace("vmlinuz-", ""))
    except FileNotFoundError:
        pass
    if not kernels:
        return None
    return sorted(kernels, key=lambda v: tuple(int(x) for x in v.replace("-hippos", "").split(".")))[-1]

def cmd_list_kernel_update():
    manifest = fetch_manifest(get_channel())
    if not manifest:
        die("Could not fetch manifest")
    kernel = manifest.get("payloads", {}).get("kernel", {})
    if not kernel:
        log("No kernel payload in manifest")
        return
    remote = kernel.get("version", "")
    installed = installed_kernel_version()
    if installed != remote:
        print(f"kernel\t{installed or 'not installed'} → {remote}")

def cmd_update_kernel():
    require_no_pending_update()
    manifest = fetch_manifest(get_channel())
    if not manifest:
        die("Could not fetch manifest")

    kernel_info = manifest.get("payloads", {}).get("kernel", {})
    if not kernel_info:
        die("No kernel payload in manifest")

    remote  = kernel_info.get("version", "")
    url     = kernel_info.get("url", "")
    sha256  = kernel_info.get("sha256", "")

    installed = installed_kernel_version()
    if installed == remote:
        log(f"Kernel already at {remote}")
        sys.exit(0)

    log(f"Updating kernel: {installed or 'not installed'} → {remote}")

    os.makedirs(CACHE_DIR, exist_ok=True)
    deb = os.path.join(CACHE_DIR, f"linux-image-{remote}_{_DEB_ARCH}.deb")
    fetch_archive(url, deb, sha256, timeout=300)

    try:
        mount_toplevel()
        running    = current_subvol()
        subvol_path = os.path.join(BTRFS_MNT, running)

        if installed:
            snap_name = f"{KERNEL_SNAPSHOT_PREFIX}{installed}"
            snap_path = os.path.join(BTRFS_MNT, snap_name)
            if not os.path.exists(snap_path):
                log(f"Snapshotting {running} → {snap_name}...")
                subprocess.run(
                    ["btrfs", "subvolume", "snapshot", "-r", subvol_path, snap_path],
                    check=True,
                )

        log("Installing kernel deb...")
        deb_in_chroot = f"/tmp/kernel-install.deb"
        subprocess.run(["cp", deb, os.path.join(subvol_path, "tmp", "kernel-install.deb")], check=True)
        for fs in ("proc", "sys", "dev", "dev/pts", "run"):
            target = os.path.join(subvol_path, fs)
            os.makedirs(target, exist_ok=True)
            subprocess.run(["mount", "--bind", f"/{fs}", target], check=True)
        try:
            subprocess.run(
                ["chroot", subvol_path, "dpkg", "-i", "--force-confold", deb_in_chroot],
                check=True,
            )
            log("Regenerating module dependencies and initramfs...")
            subprocess.run(["chroot", subvol_path, "depmod", "-a", remote], check=True)
            if subprocess.run(
                ["chroot", subvol_path, "update-initramfs", "-c", "-k", remote],
            ).returncode != 0:
                subprocess.run(
                    ["chroot", subvol_path, "update-initramfs", "-u", "-k", remote],
                    check=True,
                )
        finally:
            for fs in reversed(("proc", "sys", "dev/pts", "dev", "run")):
                subprocess.run(
                    ["umount", "-l", os.path.join(subvol_path, fs)],
                    check=False,
                )
            try:
                os.remove(os.path.join(subvol_path, "tmp", "kernel-install.deb"))
            except Exception:
                pass

        uuid, partuuid = read_grub_uuid_partuuid()
        if not uuid or not partuuid:
            die("Cannot read UUID/PARTUUID from existing grub.cfg")

        deployments = list_deployments()
        update_boot_menu(running, deployments, uuid, partuuid)

        keep = {snap_name} if installed else set()
        pruned = False
        for sv in deployments:
            if sv.startswith(KERNEL_SNAPSHOT_PREFIX) and sv not in keep:
                log(f"Pruning old kernel snapshot {sv}...")
                subprocess.run(
                    ["btrfs", "subvolume", "delete", os.path.join(BTRFS_MNT, sv)],
                    check=False,
                )
                pruned = True
        if pruned and efi_partition_mounted():
            write_grub_cfg(running, list_deployments(), uuid, partuuid)
            log("GRUB updated after pruning")
    finally:
        umount_toplevel()

    try:
        os.remove(deb)
    except Exception:
        pass

    log(f"Kernel updated to {remote}. Reboot to apply.")

def installed_emulator_version(name):
    vf = os.path.join(EMULATORS_DIR, name, "version")
    try:
        return open(vf).read().strip()
    except FileNotFoundError:
        return None

INSTALLED_SHA256_FILE = ".hippos-sha256"

def emulator_up_to_date(name, info):
    try:
        installed_sha = open(os.path.join(EMULATORS_DIR, name, INSTALLED_SHA256_FILE)).read().strip()
    except FileNotFoundError:
        installed_sha = None
    return (installed_emulator_version(name) == info.get("version", "")
            and installed_sha == info.get("sha256", ""))

def installed_frontend_version(name):
    vf = f"/usr/share/hippos/frontend-{name}-version"
    try:
        return open(vf).read().strip()
    except FileNotFoundError:
        return None

def manifest_emulators(manifest):
    payloads = manifest.get("payloads", {})
    chosen = dict(payloads.get("emulators", {}))
    os_version = ver_tuple(current_version())
    for name, builds in payloads.get("emulator_builds", {}).items():
        runnable = [b for b in builds if ver_tuple(b["min_os"]) <= os_version]
        if runnable:
            chosen[name] = max(runnable, key=lambda b: ver_tuple(b["min_os"]))
    return chosen

def cmd_list_emulator_updates():
    manifest = fetch_manifest(get_channel())
    if not manifest:
        die("Could not fetch manifest")
    emulators = manifest_emulators(manifest)
    if not emulators:
        log("No emulator payloads in manifest")
        return
    for name, info in sorted(emulators.items()):
        remote = info.get("version", "")
        installed = installed_emulator_version(name)
        if not emulator_up_to_date(name, info):
            status = f"{installed or 'not installed'} → {remote}"
            print(f"{name}\t{status}")

def cmd_update_emulator(name, force=False):
    manifest = fetch_manifest(get_channel())
    if not manifest:
        die("Could not fetch manifest")

    emulators = manifest_emulators(manifest)
    if name not in emulators:
        die(f"Emulator '{name}' not found in manifest. Available: {sorted(emulators.keys())}")

    info = emulators[name]
    remote = info.get("version", "")
    url    = info.get("url", "")
    sha256 = info.get("sha256", "")

    installed = installed_emulator_version(name)
    if emulator_up_to_date(name, info) and not force:
        log(f"{name} is already at {remote}")
        sys.exit(0)

    log(f"{'Force-reinstalling' if force else 'Updating'} {name}: {installed or 'not installed'} → {remote}")

    os.makedirs(CACHE_DIR, exist_ok=True)
    archive = os.path.join(CACHE_DIR, f"hippos-emulator-{name}-{remote}.tar.zst")

    if force and os.path.exists(archive):
        os.remove(archive)

    fetch_archive(url, archive, sha256)

    dest = os.path.join(EMULATORS_DIR, name)
    staging = dest + ".new"
    shutil.rmtree(staging, ignore_errors=True)
    os.makedirs(staging)

    log(f"Extracting {name} to {dest}...")
    subprocess.run(
        ["tar", "--xattrs", "--acls", "--numeric-owner",
         "-I", "zstd -d", "-xf", archive, "-C", staging],
        check=True
    )
    with open(os.path.join(staging, INSTALLED_SHA256_FILE), "w") as f:
        f.write(sha256 + "\n")
    runtime = os.path.join(dest, "current")
    if os.path.isdir(runtime):
        os.rename(runtime, os.path.join(staging, "current"))
    shutil.rmtree(dest, ignore_errors=True)
    os.rename(staging, dest)

    try:
        os.remove(archive)
    except Exception:
        pass

    log(f"{name} updated to {remote}")

def cmd_update_all_emulators():
    manifest = fetch_manifest(get_channel())
    if not manifest:
        die("Could not fetch manifest")
