def _require_root():
    if os.geteuid() != 0:
        result = subprocess.run(["sudo", sys.executable] + sys.argv)
        sys.exit(result.returncode)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "apply"

    # Read-only commands that don't need root
    READONLY_CMDS = {"check", "list-deployments", "list-emulator-updates",
                     "list-frontend-updates", "list-kernel-update", "list-patches"}
    if cmd not in READONLY_CMDS:
        _require_root()
        _open_log()

    if cmd == "check":
        cmd_check()
    elif cmd == "list-deployments":
        cmd_list_deployments()
