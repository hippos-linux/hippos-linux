#!/usr/bin/env bash

wifi_off() { nmcli radio wifi 2>/dev/null | grep -qi "disabled"; }
bt_blocked() {
    local radio
    for radio in /sys/class/rfkill/rfkill*; do
        [[ -r "${radio}/type" && "$(<"${radio}/type")" == bluetooth && "$(<"${radio}/soft")" == 1 ]] && return 0
    done
    return 1
}

case "${1:-status}" in
    status)
        if bt_blocked && wifi_off; then echo "on"; else echo "off"; fi
        ;;
    enable)
        nmcli radio wifi off 2>/dev/null || true
        rfkill block bluetooth 2>/dev/null || true
        ;;
    disable)
        nmcli radio wifi on 2>/dev/null || true
        rfkill unblock bluetooth 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 [status|enable|disable]" >&2
        exit 1
        ;;
esac
