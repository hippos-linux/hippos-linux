#!/usr/bin/env python3
from __future__ import annotations

import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

PENDING    = Path('/var/lib/hippos/overlay-backup-pending')
BACKUP_ROOT = Path('/userdata/system/backups')
ES_API     = 'http://127.0.0.1:1234'
RESTORE_CMD = '/usr/lib/hippos/hippos-overlay-backup-restore'


def _es_ready(timeout: int = 60) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            urllib.request.urlopen(f'{ES_API}/isIdle', timeout=2).close()
            return True
        except (OSError, urllib.error.URLError):
            time.sleep(2)
    return False


def _post_es(path: str, body: str) -> bool:
    req = urllib.request.Request(
        f'{ES_API}{path}',
        data=body.encode('utf-8'),
        method='POST',
        headers={'Content-Type': 'text/plain'},
    )
    try:
        urllib.request.urlopen(req, timeout=3).close()
        return True
    except (OSError, urllib.error.URLError):
        return False


def _desktop_session() -> bool:
    result = subprocess.run(
        ['hippos-settings', 'get', 'system.session'],
        capture_output=True, text=True, check=False,
    )
    return result.stdout.strip() == 'desktop'


def notify(deployment: str, files: list[str]) -> None:
    count = len(files)
    noun = 'file' if count == 1 else 'files'
    summary = f'System {noun} backed up after update'
    body = (
        f'{count} {noun} modified in your previous system conflicted with the '
        f'{deployment} update and were saved to:\n'
        f'/userdata/system/backups/overlay-{deployment}/\n\n'
        f'Restore them now?'
    )

    if _desktop_session():
        from hippos_desktop_notify import DesktopNotifier
        DesktopNotifier(enabled=True).ask(
            summary, body,
            {'Restore': f'sudo {RESTORE_CMD} {deployment}'},
        )
    else:
        if _es_ready():
            _post_es('/confirm', f'{summary}\n{body}\nsudo {RESTORE_CMD} {deployment}')


def main() -> int:
    if not PENDING.exists():
        return 0

    deployment = PENDING.read_text(encoding='utf-8').strip()
    if not deployment:
        PENDING.unlink(missing_ok=True)
        return 0

    backup_dir = BACKUP_ROOT / f'overlay-{deployment}'
    files = [str(f.relative_to(backup_dir)) for f in backup_dir.rglob('*') if f.is_file()]
    if not files:
        PENDING.unlink(missing_ok=True)
        return 0

    PENDING.unlink(missing_ok=True)
    notify(deployment, files)
    return 0


if __name__ == '__main__':
    sys.exit(main())
