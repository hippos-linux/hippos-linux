#!/usr/bin/env python3
from __future__ import annotations

import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

PENDING    = Path('/var/lib/hippos/overlay-backup-pending')
BACKUP_ROOT = Path('/userdata/system/backups')
ES_API     = 'http://127.0.0.1:1234'
VERSION_FILE = Path('/etc/hippos-version')
GENERATED_NAMES = {'icon-theme.cache', 'mimeinfo.cache', 'gschemas.compiled'}


def _es_ready(timeout: int = 60) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            urllib.request.urlopen(f'{ES_API}/isIdle', timeout=2).close()
            return True
        except (OSError, urllib.error.URLError):
            time.sleep(2)
    return False


def _post_es(path: str, body: str) -> bool:
    req = urllib.request.Request(
        f'{ES_API}{path}',
        data=body.encode('utf-8'),
        method='POST',
        headers={'Content-Type': 'text/plain'},
    )
    try:
        urllib.request.urlopen(req, timeout=3).close()
        return True
    except (OSError, urllib.error.URLError):
        return False


def _desktop_session() -> bool:
    result = subprocess.run(
        ['hippos-settings', 'get', 'system.session'],
        capture_output=True, text=True, check=False,
    )
    return result.stdout.strip() == 'desktop'


def _hippos_version() -> str:
    try:
        for line in VERSION_FILE.read_text(encoding='utf-8').splitlines():
            key, _, value = line.partition('=')
            if key == 'HIPPOS_VERSION':
                return value.strip()
    except OSError:
        pass
    return 'this update'


def _user_changed(path: Path) -> bool:
    return '__pycache__' not in path.parts and path.suffix != '.pyc' and path.name not in GENERATED_NAMES


def notify(backup_dir: Path, count: int) -> None:
    noun = 'file' if count == 1 else 'files'
    summary = 'Your changed system files were set aside'
    body = (
        f'HippOS {_hippos_version()} replaced {count} system {noun} you had changed. '
        f'Your versions are kept in {backup_dir}/ in case you need anything from them.'
    )

    if _desktop_session():
        from hippos_desktop_notify import DesktopNotifier
        DesktopNotifier(enabled=True).ask(summary, body, {'Open folder': f'xdg-open {backup_dir}'})
    elif _es_ready():
        _post_es('/messagebox', f'{summary}\n\n{body}')


def main() -> int:
    if not PENDING.exists():
        return 0

    deployment = PENDING.read_text(encoding='utf-8').strip()
    if not deployment:
        PENDING.unlink(missing_ok=True)
        return 0

    backup_dir = BACKUP_ROOT / f'overlay-{deployment}'
    changed = [f for f in backup_dir.rglob('*') if f.is_file() and _user_changed(f.relative_to(backup_dir))]
    PENDING.unlink(missing_ok=True)
    if changed:
        notify(backup_dir, len(changed))
    return 0


if __name__ == '__main__':
    sys.exit(main())
