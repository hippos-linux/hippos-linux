#!/usr/bin/env bash
# hippos-tdp — apply AMD TDP limit via ryzenadj with per-device clamping.
# Reads global.tdp (watts) from hippos.conf. No-op if ryzenadj not installed.

log() { printf '[hippos-tdp] %s\n' "$*"; }

if ! command -v ryzenadj >/dev/null 2>&1; then
    log "ryzenadj not found — skipping"
    exit 0
fi

TDP="$(hippos-settings get global.tdp 2>/dev/null || true)"
if [[ -z "${TDP}" ]]; then
    log "global.tdp not set — using hardware default"
    exit 0
fi
TDP="${TDP%.*}"

# ── Device table: model_key → "label;min_w;max_w" ────────────────────────────
declare -A DEVICES=(
    ["Jupiter"]="Steam Deck LCD;3;15"
    ["Galileo"]="Steam Deck OLED;3;15"
    ["ROG_Ally_RC71L"]="ROG Ally;9;30"
    ["ROG_Ally_RC71L_RC71L"]="ROG Ally;9;30"
    ["ROG_Ally_RC71L_Action"]="ROG Ally;9;30"
    ["ROG_Ally_X_RC72LA"]="ROG Ally X;9;30"
    ["83E1"]="Lenovo Legion Go;5;30"
    ["Loki_Zero"]="AYN Loki Zero;5;20"
    ["AYANEO_2S"]="Ayaneo 2S;15;28"
    ["AIR_Plus"]="Ayaneo Air Plus;5;28"
)

MODEL="$(hippos-model 2>/dev/null || true)"
KNOWN=0
TDP_MIN=1
TDP_MAX=999
APPLY_TEMP=0

if [[ -n "${MODEL}" && -v DEVICES["${MODEL}"] ]]; then
    IFS=';' read -r LABEL TDP_MIN TDP_MAX <<< "${DEVICES[${MODEL}]}"
    KNOWN=1
    APPLY_TEMP=1
    log "Device: ${LABEL} (${MODEL}) — range ${TDP_MIN}–${TDP_MAX}W"
else
    log "Device not in table (${MODEL:-unknown}) — applying without clamping"
fi

# Clamp: allow up to 20% OC above device max
OC_CEIL=$(( TDP_MAX * 120 / 100 ))
if (( TDP < TDP_MIN )); then
    log "TDP ${TDP}W below minimum ${TDP_MIN}W — clamping"
    TDP=${TDP_MIN}
elif (( KNOWN && TDP > OC_CEIL )); then
    log "TDP ${TDP}W above OC ceiling ${OC_CEIL}W — clamping"
    TDP=${OC_CEIL}
fi

TDP_MW=$(( TDP * 1000 ))
SLOW_MW=$(( TDP_MW * 80 / 100 ))

log "Applying ${TDP}W (fast=${TDP_MW}mW slow=${SLOW_MW}mW${APPLY_TEMP:+ temp=90C})"

CMD=(ryzenadj
    --stapm-limit="${TDP_MW}"
    --fast-limit="${TDP_MW}"
    --slow-limit="${SLOW_MW}"
)
(( APPLY_TEMP )) && CMD+=(--tctl-temp=90)

"${CMD[@]}" 2>&1 | while IFS= read -r line; do log "${line}"; done \
    || log "Warning: ryzenadj failed — check kernel module and root privileges"
