#!/usr/bin/env bash
if [[ ! -x /usr/bin/emulationstation ]]; then
    echo "hippos-session: emulationstation not installed, switching to desktop"
    hippos-settings set system.session desktop
    exit 0
fi

if ! mountpoint -q /userdata; then
    echo "hippos-session: WARNING: /userdata is not mounted — settings will not persist across reboots" >&2
    journalctl -k --no-pager | grep -i "btrfs\|userdata" | tail -5 >&2 || true
fi

mkdir -p /userdata/system/configs/emulationstation

export HOME=/userdata
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"
export DISPLAY=:0
export SDL_JOYSTICK_HIDAPI_STEAM=1
unset XAUTHORITY

dbus-update-activation-environment --systemd DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS HOME 2>/dev/null || true

/usr/lib/hippos/hippos-audio-setup
/usr/lib/hippos/hippos-display-setup

if hippos-touchscreen-detect 2>/dev/null; then
    pkill -x touchegg 2>/dev/null || true
    touchegg --daemon &
    sleep 0.5
    touchegg &
fi

unclutter --noevents -b

xset -dpms
xset s off

if [ -f /var/tmp/hippos-nvidia.prime ]; then
    provider_count=$(DISPLAY=:0 xrandr --listproviders 2>/dev/null | grep 'Providers:' | awk '{print $4}')
    if [ "${provider_count:-0}" -ge 2 ]; then
        provider_number=$(DISPLAY=:0 xrandr --listproviders 2>/dev/null | awk '/NVIDIA/ {print $2}' | tr -d ':')
        if [ -n "$provider_number" ]; then
            export __NV_PRIME_RENDER_OFFLOAD=$provider_number
            export __VK_LAYER_NV_optimus=NVIDIA_only
            export __GLX_VENDOR_LIBRARY_NAME=nvidia
            export VDPAU_DRIVER=nvidia
            export LIBVA_DRIVER_NAME=nvidia
        fi
    fi
fi

xsetroot -solid black

# HDMI-CEC: power on TV and switch to our input (runs in background, non-blocking)
/usr/lib/hippos/hippos-cec on &

# Sleep timer: auto-suspend after configured idle period
_SLEEP_TIMER="$(hippos-settings get system.sleep_timer 2>/dev/null || true)"
if [[ -n "$_SLEEP_TIMER" && "$_SLEEP_TIMER" != "0" ]]; then
    xautolock -time "$_SLEEP_TIMER" -locker "/usr/bin/hippos-shutdown suspend" -detectsleep &
fi

# Switch to VT7 once ES is running. Plymouth retains its last frame on VT1
# while we're here, hiding GPU log text that would otherwise flash on screen.
# Poll for the ES process, then give it a moment to render its first frame.
( until pgrep -x emulationstation > /dev/null 2>&1; do sleep 0.1; done
  sleep 0.5
  chvt 7 2>/dev/null || true ) &

# Translate display.output (xrandr name) → SDL display index so ES opens on the right screen.
# SDL enumerates active displays in xrandr output order.
_DISPLAY_OUTPUT=$(hippos-settings get display.output 2>/dev/null || true)
_MONITOR_IDX=""
if [[ -n "$_DISPLAY_OUTPUT" && "$_DISPLAY_OUTPUT" != "all" ]]; then
    _idx=0
    while IFS= read -r _out; do
        if [[ "$_out" == "$_DISPLAY_OUTPUT" ]]; then
            _MONITOR_IDX="$_idx"
            break
        fi
        _idx=$((_idx + 1))
    done < <(xrandr 2>/dev/null | awk '/connected/ && /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/{print $1}')
fi

_ES_CMD="/usr/bin/emulationstation"
[[ -n "$_MONITOR_IDX" ]] && _ES_CMD="$_ES_CMD --monitor $_MONITOR_IDX"

exec openbox --sm-disable --startup "$_ES_CMD"
