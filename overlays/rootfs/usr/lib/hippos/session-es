#!/usr/bin/env bash
if [[ ! -x /usr/bin/emulationstation ]]; then
    echo "hippos-session: emulationstation not installed, switching to desktop"
    hippos-settings set system.session desktop
    exit 0
fi

if ! mountpoint -q /userdata; then
    echo "hippos-session: WARNING: /userdata is not mounted — settings will not persist across reboots" >&2
    journalctl -k --no-pager | grep -i "btrfs\|userdata" | tail -5 >&2 || true
fi

mkdir -p /userdata/system/configs/emulationstation

export HOME=/userdata
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"
export DISPLAY=:0
export SDL_JOYSTICK_HIDAPI_STEAM=1
unset XAUTHORITY

dbus-update-activation-environment --systemd DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS HOME 2>/dev/null || true

/usr/lib/hippos/hippos-audio-setup
/usr/lib/hippos/hippos-display-setup

if hippos-touchscreen-detect 2>/dev/null; then
    pkill -x touchegg 2>/dev/null || true
    touchegg --daemon &
    sleep 0.5
    touchegg &
fi

pkill -x unclutter 2>/dev/null || true
unclutter -idle 3 -root &

# One-shot PRIME provider check (Batocera-style): no polling, no blocking.
# Sets up setprovideroutputsource for HDMI-on-NVIDIA machines if providers are
# already registered; games get PRIME env vars via emulatorlauncher's prime.env read.
if [ -x /run/hippos/prime-xrandr ]; then
    provider_count=$(DISPLAY=:0 xrandr --listproviders 2>/dev/null | grep 'Providers:' | awk '{print $4}')
    if [ "${provider_count:-0}" -ge 2 ]; then
        DISPLAY=:0 /run/hippos/prime-xrandr 2>/dev/null || true
    fi
fi

xsetroot -solid black

exec openbox --sm-disable --startup /usr/bin/emulationstation
