if __name__ == '__main__':
    parser = argparse.ArgumentParser(prog='hippos-hotkeys')
    parser.add_argument('--permanent', action='store_true',
                        help='Write PID file for context switching via SIGHUP')
    parser.add_argument('--send', metavar='ACTION',
                        help='Send a named action and exit')
    parser.add_argument('--new-context', nargs=2, metavar=('NAME', 'JSON'),
                        help='Switch to a new hotkey context')
    parser.add_argument('--disable-common', action='store_true',
                        help='Suppress common context actions in this context')
    parser.add_argument('--default-context', action='store_true',
                        help='Reset to the default emulationstation context')
    parser.add_argument('--reload', action='store_true',
                        help='Signal the daemon to reload its config')
    parser.add_argument('--list', action='store_true',
                        help='List devices and action mappings')
    args = parser.parse_args()

    if args.send:
        cmd_send(args.send)
    elif args.new_context:
        cmd_new_context(args.new_context[0], args.new_context[1], args.disable_common)
    elif args.default_context:
        cmd_default_context()
    elif args.reload:
        cmd_reload()
    elif args.list:
        cmd_list()
    else:
        HotkeyDaemon(permanent=args.permanent).run()
