#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json

import hippos_hotkeys_control


def main() -> None:
    parser = argparse.ArgumentParser(prog='hippos-hotkeys')
    parser.add_argument('--permanent', action='store_true',
                        help='Write PID file for context switching via SIGHUP')
    parser.add_argument('--send', metavar='ACTION',
                        help='Send a named action and exit')
    parser.add_argument('--new-context', nargs=2, metavar=('NAME', 'JSON'),
                        help='Switch to a new hotkey context')
    parser.add_argument('--disable-common', action='store_true',
                        help='Suppress common context actions in this context')
    parser.add_argument('--default-context', action='store_true',
                        help='Reset to the default emulationstation context')
    parser.add_argument('--reload', action='store_true',
                        help='Signal the daemon to reload its config')
    parser.add_argument('--list', action='store_true',
                        help='List devices and action mappings')
    parser.add_argument('--keyboard-shown', choices=('on', 'off'),
                        help='Tell the daemon whether the on-screen keyboard is showing')
    args = parser.parse_args()

    if args.new_context:
        hippos_hotkeys_control.new_context(args.new_context[0], json.loads(args.new_context[1]), args.disable_common)
    elif args.default_context:
        hippos_hotkeys_control.default_context()
    elif args.reload:
        hippos_hotkeys_control.reload()
    elif args.keyboard_shown:
        hippos_hotkeys_control.set_keyboard_shown(args.keyboard_shown == 'on')
    else:
        import hippos_hotkeys_daemon
        if args.send:
            hippos_hotkeys_daemon.cmd_send(args.send)
        elif args.list:
            hippos_hotkeys_daemon.cmd_list()
        else:
            hippos_hotkeys_daemon.HotkeyDaemon(permanent=args.permanent).run()


if __name__ == '__main__':
    main()
