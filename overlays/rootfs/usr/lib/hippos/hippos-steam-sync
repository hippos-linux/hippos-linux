#!/usr/bin/env python3

from __future__ import annotations

import re
import shutil
import sys
from pathlib import Path
from typing import Any

from hippos_launcher_sync import CLIENT_ENTRY, GameMetadata, reload_es, sync_gamelist, sync_launchers

USERDATA = Path("/userdata")
ROMS_DIR = USERDATA / "roms" / "steam"
STATE_FILE = USERDATA / "system" / "steam-launchers.json"
STEAM_LOGO = Path("/usr/share/hippos/steam/steam-logo.jpg")
BIG_PICTURE = GameMetadata(
    "Steam Big Picture",
    "Steam Big Picture is Valve's controller-friendly interface for your full Steam library. Browse your games, access the Steam store, manage downloads, and launch titles from the couch with full gamepad support. Your entire Steam collection is available the moment you sign in.",
    "Valve",
    STEAM_LOGO,
)
STEAM_ROOTS = [
    USERDATA / ".steam" / "steam",
    USERDATA / ".local" / "share" / "Steam",
    USERDATA / "Steam",
]

def log(message: str) -> None:
    print(f"[hippos-steam-sync] {message}")

def tokenize_vdf(text: str) -> list[str]:
    return re.findall(r'"((?:\\.|[^"\\])*)"|([{}])', text)

def unescape_vdf(value: str) -> str:
    return value.replace(r"\"", '"').replace(r"\\", "\\")

def parse_vdf(path: Path) -> dict[str, Any]:
    try:
        tokens = tokenize_vdf(path.read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return {}

    flat = [unescape_vdf(value) if value else brace for value, brace in tokens]
    index = 0

    def parse_object() -> dict[str, Any]:
        nonlocal index
        result: dict[str, Any] = {}
        while index < len(flat):
            token = flat[index]
            index += 1
            if token == "}":
                break
            if token == "{":
                continue
            if index < len(flat) and flat[index] == "{":
                index += 1
                result[token] = parse_object()
            elif index < len(flat):
                result[token] = flat[index]
                index += 1
            else:
                result[token] = ""
        return result

    return parse_object()

def unwrap_single_root(data: dict[str, Any], root_name: str) -> dict[str, Any]:
    if set(data.keys()) == {root_name} and isinstance(data[root_name], dict):
        return data[root_name]
    return data

def steamapps_dirs() -> list[Path]:
    roots: list[Path] = []
    for steam_root in STEAM_ROOTS:
        steamapps = steam_root / "steamapps"
        if steamapps.is_dir():
            roots.append(steamapps)

        libraryfolders = steamapps / "libraryfolders.vdf"
        data = unwrap_single_root(parse_vdf(libraryfolders), "libraryfolders")
        for key, value in data.items():
            library_path = ""
            if isinstance(value, dict):
                path_value = value.get("path")
                if isinstance(path_value, str):
                    library_path = path_value
            elif key.isdigit() and isinstance(value, str):
                library_path = value

            if library_path:
                candidate = Path(library_path) / "steamapps"
                if candidate.is_dir():
                    roots.append(candidate)

    unique: list[Path] = []
    seen: set[str] = set()
    for root in roots:
        resolved = str(root.resolve())
        if resolved not in seen:
            seen.add(resolved)
            unique.append(root)
    return unique

def installed_apps() -> dict[str, str]:
    apps: dict[str, str] = {}
    for steamapps in steamapps_dirs():
        for manifest in sorted(steamapps.glob("appmanifest_*.acf")):
            data = unwrap_single_root(parse_vdf(manifest), "AppState")
            appid = str(data.get("appid", "")).strip()
            name = str(data.get("name", "")).strip()
            if appid and name:
                apps[appid] = name
    return apps

def steam_installed() -> bool:
    return shutil.which("steam", path="/usr/local/bin:/usr/bin:/usr/games") is not None

def sync() -> int:
    apps = installed_apps()
    launchers = dict(apps)
    details: dict[str, GameMetadata] = {}
    if steam_installed():
        launchers[CLIENT_ENTRY] = "Steam"
        details[CLIENT_ENTRY] = BIG_PICTURE
    created, updated, removed = sync_launchers(
        ROMS_DIR, STATE_FILE, '.steam', launchers, 'Steam Game', reserved_stems=('Steam',),
    )
    details_changed = sync_gamelist(ROMS_DIR, STATE_FILE, '.steam', details)
    log(f"found={len(apps)} client={CLIENT_ENTRY in launchers} created={created} updated={updated} removed={removed} details_changed={details_changed}")
    if created or updated or removed or details_changed:
        reload_es()
    return 0

def main(argv: list[str]) -> int:
    if len(argv) > 1 and argv[1] not in {"sync"}:
        print("usage: hippos-steam-sync [sync]", file=sys.stderr)
        return 2
    return sync()

if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
