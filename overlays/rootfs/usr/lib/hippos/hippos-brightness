#!/usr/bin/env bash

MIN_BRIGHTNESS=1

clamp() {
    local pct="$1"
    echo $(( pct < MIN_BRIGHTNESS ? MIN_BRIGHTNESS : (pct > 100 ? 100 : pct) ))
}

case "${1:-boot}" in
    get)
        val="$(brightnessctl -q --class=backlight get 2>/dev/null || true)"
        max="$(brightnessctl -q --class=backlight max 2>/dev/null || true)"
        if [[ -n "${val}" && -n "${max}" && "${max}" -gt 0 ]]; then
            printf '%d\n' $(( val * 100 / max ))
        else
            echo ""
        fi
        ;;
    set)
        PCT="${2:-}"
        if [[ ! "${PCT}" =~ ^[0-9]+$ ]]; then
            printf 'Usage: %s set <0-100>\n' "$0" >&2; exit 1
        fi
        PCT="$(clamp "${PCT}")"
        brightnessctl -q --class=backlight set "${PCT}%" 2>/dev/null || true
        hippos-settings set display.brightness "${PCT}" 2>/dev/null || true
        ;;
    change)
        STEP="${2:-}"
        if [[ ! "${STEP}" =~ ^[+-][0-9]+$ ]]; then
            printf 'Usage: %s change +N|-N\n' "$0" >&2; exit 1
        fi
        CUR="$("$0" get)"
        "$0" set "$(clamp $(( ${CUR:-50} + STEP )))"
        ;;
    boot)
        PCT="$(hippos-settings get display.brightness 2>/dev/null || true)"
        if [[ "${PCT}" =~ ^[0-9]+$ ]]; then
            brightnessctl -q --class=backlight set "$(clamp "${PCT}")%" 2>/dev/null || true
        fi
        ;;
    *)
        printf 'Usage: %s get|set <0-100>|change +N|-N|boot\n' "$0" >&2; exit 1
        ;;
esac
