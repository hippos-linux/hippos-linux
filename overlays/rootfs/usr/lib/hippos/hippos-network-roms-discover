#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import ipaddress
import re
import shutil
import socket
import subprocess
import sys
import tempfile
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, replace
from pathlib import Path

SYSTEM = Path("/userdata/system")
HIPPOS_CONFIG = SYSTEM / "configs" / "hippos"
DISCOVERED = HIPPOS_CONFIG / "roms-discovered.conf"
SOURCES = HIPPOS_CONFIG / "roms-sources.conf"
SETTINGS_GET = "/usr/lib/hippos/hippos-settings"
SMB_PORT = 445
NFS_PORT = 2049
LIKELY_NAMES = {
    "games",
    "hippos",
    "rom",
    "roms",
    "share",
    "userdata",
}

ROM_SYSTEM_FOLDERS = {
    "3do", "arcade", "atomiswave", "dreamcast", "fbneo", "gamecube", "gba", "gbc",
    "genesis", "mame", "mastersystem", "megadrive", "model2", "model3", "n64",
    "naomi", "nds", "neogeo", "nes", "ps2", "ps3", "psp", "psx", "saturn",
    "sega32x", "snes", "switch", "tg16", "wii", "wiiu", "xbox", "xbox360",
}
MAX_FOLDERS_CHECKED = 40

@dataclass(frozen=True)
class Candidate:
    uri: str
    name: str
    source: str
    comment: str = ""
    has_roms: bool | None = None

    @property
    def host(self) -> str:
        if self.uri.startswith("cifs://"):
            return self.uri.removeprefix("cifs://").split("/", 1)[0]
        return self.uri.removeprefix("nfs:").split(":", 1)[0]

    @property
    def ident(self) -> str:
        return hashlib.sha1(self.uri.encode("utf-8")).hexdigest()[:12]

    @property
    def needs_signin(self) -> bool:
        return self.uri.startswith("cifs://") and "/" not in self.uri.removeprefix("cifs://")

    @property
    def likely(self) -> bool:
        if self.has_roms is not None:
            return self.has_roms
        parts = re.split(r"[/_. -]+", self.name.lower())
        return any(part in LIKELY_NAMES for part in parts)

def run(args: list[str], timeout: int = 8) -> str:
    if not shutil.which(args[0]):
        return ""
    try:
        result = subprocess.run(
            args,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout

def setting(key: str, default: str = "") -> str:
    output = run([SETTINGS_GET, "get", key], timeout=2).strip()
    return output if output else default

def is_true(value: str) -> bool:
    return value.lower() in {"1", "true", "yes", "on"}

def safe_name(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", value).strip("_") or value

def cifs_uri(host: str, share: str) -> str:
    return f"cifs://{safe_name(host)}/{safe_name(share)}"

def nfs_uri(host: str, export: str) -> str:
    return f"nfs:{host}:{export}"

def parse_smbclient_list(host: str, output: str, source: str) -> list[Candidate]:
    candidates: list[Candidate] = []
    in_table = False
    for raw in output.splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("Disk|"):
            _, share, *rest = line.split("|")
            candidates.append(Candidate(cifs_uri(host, share), share, source, "|".join(rest)))
            continue
        if re.match(r"^-+$", line):
            in_table = True
            continue
        if in_table:
            match = re.match(r"^(\S+)\s+Disk\s*(.*)$", line)
            if match:
                share, comment = match.groups()
                candidates.append(Candidate(cifs_uri(host, share), share, source, comment.strip()))
    return candidates

def enumerate_smb_host(host: str, source: str) -> list[Candidate]:
    output = run(["smbclient", "-L", f"//{host}", "-N", "-g", "-m", "SMB3", "-t", "3"])
    if not output:
        output = run(["smbclient", "-L", f"//{host}", "-N", "-t", "3"])
    return parse_smbclient_list(host, output, source)

def smbtree_hosts() -> set[str]:
    hosts: set[str] = set()
    for raw in run(["smbtree", "-N", "-b"], timeout=12).splitlines():
        match = re.match(r"^\\\\([^\\\s]+)", raw.strip())
        if match:
            hosts.add(match.group(1))
    return hosts

def local_addresses() -> set[str]:
    addrs: set[str] = {"127.0.0.1", "::1"}
    for raw in run(["ip", "-o", "addr", "show"], timeout=3).splitlines():
        parts = raw.split()
        if len(parts) >= 4 and parts[2] in {"inet", "inet6"}:
            addrs.add(parts[3].split("/", 1)[0])
    return addrs

def host_addresses(host: str) -> set[str]:
    try:
        return {str(ipaddress.ip_address(host))}
    except ValueError:
        pass
    try:
        return {info[4][0] for info in socket.getaddrinfo(host, None)}
    except OSError:
        return set()

def lan_host(host: str, self_addrs: set[str]) -> bool:
    try:
        addr = ipaddress.ip_address(host)
    except ValueError:
        return not host_addresses(host) & self_addrs
    return addr.version == 4 and str(addr) not in self_addrs

def avahi_hosts(service: str) -> set[str]:
    hosts: set[str] = set()
    for raw in run(["avahi-browse", "-rtp", service], timeout=8).splitlines():
        parts = raw.split(";")
        if raw.startswith("=") and len(parts) >= 8:
            host = parts[7] or parts[6].rstrip(".")
            if host:
                hosts.add(host)
    return hosts

def neighbour_hosts() -> set[str]:
    hosts: set[str] = set()
    for raw in run(["ip", "-4", "neigh", "show"], timeout=3).splitlines():
        parts = raw.split()
        if parts and parts[-1] in {"REACHABLE", "STALE", "DELAY", "PROBE"}:
            hosts.add(parts[0])
    return hosts

def port_open(host: str, port: int) -> bool:
    try:
        with socket.create_connection((host, port), timeout=0.5):
            return True
    except OSError:
        return False

def hosts_with_port(hosts: set[str], port: int) -> list[str]:
    ordered = sorted(hosts)
    with ThreadPoolExecutor(max_workers=16) as pool:
        found = pool.map(lambda host: port_open(host, port), ordered)
    return [host for host, is_open in zip(ordered, found) if is_open]

def smb_folders(host: str, share: str, path: str = "") -> set[str] | None:
    command = f'ls "{path}\\*"' if path else "ls"
    output = run(["smbclient", f"//{host}/{share}", "-N", "-t", "3", "-c", command], timeout=8)
    if "NT_STATUS_" in output and not re.search(r"^\s+\S.*\s+D\s+\d+\s", output, re.M):
        return None
    folders = set()
    for line in output.splitlines():
        match = re.match(r"^\s{2}(.+?)\s+([A-Z]*D[A-Z]*)\s+\d+\s", line)
        if match and match.group(1) not in (".", ".."):
            folders.add(match.group(1))
    files = {m.group(1) for m in re.finditer(r"^\s{2}(.+?)\s+[A-Z]*\s+\d+\s", output, re.M)}
    return folders | ({"gamelist.xml"} & files)

def smb_has_roms(candidate: Candidate) -> bool | None:
    host, _, share = candidate.uri.removeprefix("cifs://").partition("/")
    top = smb_folders(host, share)
    if top is None:
        return None
    lowered = {name.lower(): name for name in top}
    if "roms" in lowered or lowered.keys() & ROM_SYSTEM_FOLDERS or "gamelist.xml" in lowered:
        return True
    for folder in sorted(top)[:MAX_FOLDERS_CHECKED]:
        inner = smb_folders(host, share, folder)
        if inner and "roms" in {name.lower() for name in inner}:
            return True
    return False

def discover_smb(hosts: set[str]) -> list[Candidate]:
    candidates: list[Candidate] = []
    for host in hosts_with_port(hosts, SMB_PORT):
        shares = enumerate_smb_host(host, "scan")
        candidates.extend(shares or [Candidate(f"cifs://{safe_name(host)}", host, "scan")])
    checkable = [c for c in candidates if not c.needs_signin]
    with ThreadPoolExecutor(max_workers=8) as pool:
        results = dict(zip((c.uri for c in checkable), pool.map(smb_has_roms, checkable)))
    return [replace(c, has_roms=bool(results[c.uri])) if c.uri in results else c for c in candidates]

def enumerate_nfs_host(host: str) -> list[Candidate]:
    candidates: list[Candidate] = []
    for raw in run(["showmount", "-e", "--no-headers", host], timeout=5).splitlines():
        export = raw.split()[0] if raw.strip() else ""
        if export.startswith("/"):
            name = export.rstrip("/").rsplit("/", 1)[-1] or export
            candidates.append(Candidate(nfs_uri(host, export), name, "scan"))
    return candidates

def discover_nfs(hosts: set[str]) -> list[Candidate]:
    candidates: list[Candidate] = []
    for host in hosts_with_port(hosts, NFS_PORT):
        candidates.extend(enumerate_nfs_host(host))
    return candidates

def unique(candidates: list[Candidate]) -> list[Candidate]:
    seen: set[str] = set()
    result: list[Candidate] = []
    for candidate in candidates:
        if candidate.uri in seen:
            continue
        seen.add(candidate.uri)
        result.append(candidate)
    result.sort(key=lambda c: (not c.likely, c.uri))
    return result

def write_candidates(candidates: list[Candidate]) -> None:
    HIPPOS_CONFIG.mkdir(parents=True, exist_ok=True)
    lines = [
        "# id\tlikely\turi\tname\tsource\tcomment\n",
    ]
    for candidate in candidates:
        lines.append(
            "\t".join(
                [
                    candidate.ident,
                    "?" if candidate.has_roms is None else ("1" if candidate.has_roms else "0"),
                    candidate.uri,
                    candidate.name,
                    candidate.source,
                    candidate.comment,
                ]
            )
            + "\n"
        )
    tmp = DISCOVERED.with_suffix(".tmp")
    tmp.write_text("".join(lines), encoding="utf-8")
    tmp.replace(DISCOVERED)

def read_candidates() -> list[Candidate]:
    candidates: list[Candidate] = []
    if not DISCOVERED.exists():
        return candidates
    for raw in DISCOVERED.read_text(encoding="utf-8").splitlines():
        if not raw or raw.startswith("#"):
            continue
        parts = raw.split("\t")
        if len(parts) < 5:
            continue
        _, likely, uri, name, source, *comment = parts
        has_roms = None if likely == "?" else likely == "1"
        candidates.append(Candidate(uri, name, source, "\t".join(comment), has_roms))
    self_addrs = local_addresses()
    return [candidate for candidate in candidates if not host_addresses(candidate.host) & self_addrs]

def cmd_discover() -> int:
    if not is_true(setting("network.roms.discovery.enabled", "true")):
        return 0
    self_addrs = local_addresses()
    hosts = {h for h in avahi_hosts("_smb._tcp") | avahi_hosts("_nfs._tcp") | neighbour_hosts() | smbtree_hosts()
             if lan_host(h, self_addrs)}
    candidates = unique(discover_smb(hosts) + discover_nfs(hosts))
    write_candidates(candidates)
    if is_true(setting("network.roms.discovery.auto_mount", "false")):
        for candidate in candidates:
            if candidate.likely and not candidate.needs_signin:
                append_source(candidate.uri)
        subprocess.run(["systemctl", "start", "--no-block", "hippos-network-roms.service"], check=False)
    else:
        subprocess.run(["/usr/lib/hippos/hippos-storage-manager", "notify_merges"], check=False)
    for candidate in candidates:
        print(
            "\t".join(
                [
                    candidate.ident,
                    candidate_kind(candidate),
                    candidate.uri,
                    candidate.name,
                    candidate.source,
                ]
            )
        )
    return 0

def candidate_kind(candidate: Candidate) -> str:
    if candidate.needs_signin:
        return "signin"
    return "likely" if candidate.likely else "other"

def cmd_shares(host: str) -> int:
    username, _, password = sys.stdin.read().partition("\n")
    with tempfile.NamedTemporaryFile("w", prefix="hippos-smb-", suffix=".auth") as auth:
        auth.write(f"username={username.strip()}\npassword={password.rstrip(chr(10))}\n")
        auth.flush()
        output = run(["smbclient", "-L", f"//{host}", "-A", auth.name, "-g", "-t", "5"])
    shares = parse_smbclient_list(host, output, "signin")
    for candidate in shares:
        print("\t".join([candidate.uri, candidate.name]))
    return 0 if shares else 1

def append_source(uri: str) -> None:
    HIPPOS_CONFIG.mkdir(parents=True, exist_ok=True)
    existing = SOURCES.read_text(encoding="utf-8").splitlines() if SOURCES.exists() else []
    if any(line.strip().split()[0] == uri for line in existing if line.strip() and not line.lstrip().startswith("#")):
        return
    with SOURCES.open("a", encoding="utf-8") as handle:
        if existing and existing[-1].strip():
            handle.write("\n")
        handle.write(f"{uri}\n")

def cmd_mount(selector: str) -> int:
    if not is_true(setting("network.roms.enabled", "true")):
        print("network ROM mounting is disabled by network.roms.enabled", file=sys.stderr)
        return 1
    candidates = read_candidates()
    match = next((c for c in candidates if c.ident == selector or c.uri == selector), None)
    if match is None and selector.startswith("cifs://"):
        share = selector.removeprefix("cifs://").split("/", 1)[-1]
        match = Candidate(selector, share, "manual")
    if match is None:
        print(f"unknown candidate: {selector}", file=sys.stderr)
        return 1
    append_source(match.uri)
    subprocess.run(["systemctl", "start", "--no-block", "hippos-network-roms.service"], check=False)
    print(match.uri)
    return 0

def usage() -> int:
    print(
        "Usage: hippos-network-roms-discover discover | list | mount <id-or-cifs-uri> | shares <host>\n"
        "  shares reads the username and password from stdin, one per line.",
        file=sys.stderr,
    )
    return 1

def main() -> int:
    args = sys.argv[1:]
    if not args:
        return usage()
    if args[0] == "discover" and len(args) == 1:
        return cmd_discover()
    if args[0] == "list" and len(args) == 1:
        for candidate in read_candidates():
            print(
                "\t".join(
                    [
                        candidate.ident,
                        candidate_kind(candidate),
                        candidate.uri,
                        candidate.name,
                        candidate.source,
                    ]
                )
            )
        return 0
    if args[0] == "shares" and len(args) == 2:
        return cmd_shares(args[1])
    if args[0] == "mount" and len(args) == 2:
        return cmd_mount(args[1])
    return usage()

if __name__ == "__main__":
    sys.exit(main())
