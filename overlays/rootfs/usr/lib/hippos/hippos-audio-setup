#!/usr/bin/env bash

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export PIPEWIRE_RUNTIME_DIR="${XDG_RUNTIME_DIR}"

DEVICE=$(hippos-settings get audio.device 2>/dev/null || true)
VOLUME=$(hippos-settings get audio.volume 2>/dev/null || true)
SAVED_SINK_ATTEMPTS=5

for _ in $(seq 1 10); do
    pactl info >/dev/null 2>&1 && break
    sleep 1
done

_hdmi_sink() {
    LC_ALL=C pactl list sinks short 2>/dev/null | awk '/hdmi/{print $2; exit}'
}

_hdmi_monitor_present() {
    grep -qsE '^monitor_present[[:space:]]+1' /proc/asound/card*/eld#*
}

_wait_hdmi_sink() {
    local sink attempt attempts=1
    _hdmi_monitor_present && attempts=15
    for attempt in $(seq 1 "$attempts"); do
        sink="$(_hdmi_sink)"
        [[ -n "$sink" ]] && echo "$sink" && return
        (( attempt < attempts )) && sleep 1
    done
}

_wait_saved_sink() {
    local attempt
    for attempt in $(seq 1 "$SAVED_SINK_ATTEMPTS"); do
        pactl set-default-sink "$DEVICE" 2>/dev/null && return
        (( attempt < SAVED_SINK_ATTEMPTS )) && sleep 1
    done
    return 1
}

if [[ -n "$DEVICE" && "$DEVICE" != "default" && "$DEVICE" != "auto" ]]; then
    if _wait_saved_sink; then
        echo "[hippos-audio-setup] default sink: $DEVICE"
    else
        echo "[hippos-audio-setup] sink '$DEVICE' not found, waiting for HDMI sink" >&2
        HDMI_SINK="$(_wait_hdmi_sink)"
        if [[ -n "$HDMI_SINK" ]]; then
            pactl set-default-sink "$HDMI_SINK" 2>/dev/null && \
                echo "[hippos-audio-setup] HDMI fallback: $HDMI_SINK" || true
        fi
    fi
else
    HDMI_SINK="$(_wait_hdmi_sink)"
    if [[ -n "$HDMI_SINK" ]]; then
        pactl set-default-sink "$HDMI_SINK" 2>/dev/null && \
            echo "[hippos-audio-setup] auto-selected HDMI sink: $HDMI_SINK" || true
    else
        _hdmi_monitor_present && monitor=present || monitor=absent
        echo "[hippos-audio-setup] no HDMI sink (HDMI monitor $monitor), keeping default: $(LC_ALL=C pactl get-default-sink 2>/dev/null)"
    fi
fi

if [[ -n "$VOLUME" ]]; then
    pactl set-sink-volume @DEFAULT_SINK@ "${VOLUME}%" 2>/dev/null \
        && echo "[hippos-audio-setup] volume: ${VOLUME}%" \
        || echo "[hippos-audio-setup] failed to set volume" >&2
fi
