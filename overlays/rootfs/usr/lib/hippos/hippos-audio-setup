#!/usr/bin/env bash
# Apply saved audio.device setting to PipeWire default sink.
# Called from session-es and session-desktop before launching the session.

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export PIPEWIRE_RUNTIME_DIR="${XDG_RUNTIME_DIR}"

DEVICE=$(hippos-settings get audio.device 2>/dev/null || true)
VOLUME=$(hippos-settings get audio.volume 2>/dev/null || true)

# Give PipeWire up to 10s to be ready — HDMI audio (e.g. NVIDIA) can be slow to appear
for i in $(seq 1 10); do
    pactl info >/dev/null 2>&1 && break
    sleep 1
done

_hdmi_sink() {
    LC_ALL=C pactl list sinks short 2>/dev/null | awk '/hdmi/{print $2; exit}'
}

if [[ -n "$DEVICE" && "$DEVICE" != "default" ]]; then
    if pactl set-default-sink "$DEVICE" 2>/dev/null; then
        echo "[hippos-audio-setup] default sink: $DEVICE"
    else
        echo "[hippos-audio-setup] sink '$DEVICE' not found, trying HDMI fallback" >&2
        # Saved sink name may not match after driver reload or PipeWire renaming.
        HDMI_SINK="$(_hdmi_sink)"
        if [[ -n "$HDMI_SINK" ]]; then
            pactl set-default-sink "$HDMI_SINK" 2>/dev/null && \
                echo "[hippos-audio-setup] HDMI fallback: $HDMI_SINK" || true
        fi
    fi
else
    # No saved preference — prefer HDMI if available (common on TV-connected gaming PCs)
    HDMI_SINK="$(_hdmi_sink)"
    if [[ -n "$HDMI_SINK" ]]; then
        pactl set-default-sink "$HDMI_SINK" 2>/dev/null && \
            echo "[hippos-audio-setup] auto-selected HDMI sink: $HDMI_SINK" || true
    fi
fi

if [[ -n "$VOLUME" ]]; then
    pactl set-sink-volume @DEFAULT_SINK@ "${VOLUME}%" 2>/dev/null \
        && echo "[hippos-audio-setup] volume: ${VOLUME}%" \
        || echo "[hippos-audio-setup] failed to set volume" >&2
fi
