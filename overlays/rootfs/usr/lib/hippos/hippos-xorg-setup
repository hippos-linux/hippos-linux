#!/usr/bin/env bash
# Detect GPU topology and write /etc/X11/xorg.conf.d/91-gpu-setup.conf before
# X starts. Prevents modesetting from probing secondary GPUs as PRIME providers
# on Optimus / hybrid-graphics machines, which causes a fatal pixmap failure.

set -euo pipefail

CONF=/etc/X11/xorg.conf.d/91-gpu-setup.conf

log() { printf '[hippos-xorg-setup] %s\n' "$*"; }

# Find the PCI address of the NVIDIA GPU (if any).
# lspci output: "01:00.0 VGA compatible controller: NVIDIA ..."
NVIDIA_PCI=$(lspci 2>/dev/null | awk '/VGA|3D/ && /NVIDIA/ {print $1; exit}')

if [[ -z "${NVIDIA_PCI}" ]]; then
    log "no NVIDIA GPU found — removing gpu-setup conf if present"
    rm -f "${CONF}"
    exit 0
fi

# Convert lspci format "BB:DD.F" to Xorg BusID format "PCI:B:D:F"
# e.g. "01:00.0" -> "PCI:1:0:0"
BUS=$(printf '%d' "0x${NVIDIA_PCI%%:*}")
DEV_FUNC="${NVIDIA_PCI#*:}"
DEV=$(printf '%d' "0x${DEV_FUNC%%.*}")
FUNC=$(printf '%d' "0x${DEV_FUNC##*.}")
BUSID="PCI:${BUS}:${DEV}:${FUNC}"

log "NVIDIA GPU at ${NVIDIA_PCI} → Xorg BusID ${BUSID}"

# When PRIME is configured, 90-hippos-prime.conf already contains a Device section
# for "NVIDIA GPU". Writing 91-gpu-setup.conf would produce a duplicate Device
# identifier, causing Xorg to register the GPU twice as a GPUDevice provider
# (visible as double "GPUDevice NVIDIA GPU" in the Screen section) and crash X.
PRIME_CONF=/etc/X11/xorg.conf.d/90-hippos-prime.conf
if grep -qs 'Driver.*"nvidia"' "${PRIME_CONF}" 2>/dev/null; then
    log "PRIME conf already assigns NVIDIA GPU — removing ${CONF} (avoid duplicate Device)"
    rm -f "${CONF}"
    exit 0
fi

cat > "${CONF}" << EOF
# Auto-generated by hippos-xorg-setup — do not edit by hand.
# Assigns the NVIDIA GPU to the proprietary nvidia driver so modesetting does
# not also probe it as a PRIME provider (which fails on Optimus laptops when
# no external display is connected to the NVIDIA outputs).
Section "Device"
    Identifier  "NVIDIA GPU"
    Driver      "nvidia"
    BusID       "${BUSID}"
    Option      "AllowEmptyInitialConfiguration" "yes"
EndSection
EOF

log "wrote ${CONF}"
