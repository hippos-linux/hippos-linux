# ── Helpers ────────────────────────────────────────────────────────────────────

def _run(cmd: list[str], *, capture: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=capture, text=True)


def _delegate(script: str, args: list[str]) -> int:
    return subprocess.run([script] + args).returncode


def _setting(key: str) -> str:
    r = subprocess.run([str(HIPPOS_SETTINGS), 'get', key],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ''


def _service_active(name: str) -> bool:
    r = subprocess.run(['systemctl', 'is-active', '--quiet', name])
    return r.returncode == 0


def _service_status(name: str) -> str:
    return 'active' if _service_active(name) else 'inactive'


# ── Commands ───────────────────────────────────────────────────────────────────

def cmd_status() -> int:
    session = _setting('system.session') or 'es'
    desktop = _setting('system.desktop') or 'lxqt'

    print('HippOS Status')
    print(f'  Session:  {session}')
    print(f'  Desktop:  {desktop}')
    print()
    print('  Services:')
    for svc in _HIPPOS_SERVICES:
        state = _service_status(svc)
        short = svc.replace('.service', '')
        print(f'    {short:<30} {state}')

    # Controllers via /dev/input/event*
    try:
        controllers = _detect_controllers()
        print()
        print(f'  Controllers: {len(controllers)} connected')
        for name in controllers:
            print(f'    {name}')
    except Exception:
        pass

    # Uptime
    try:
        r = subprocess.run(['uptime', '-p'], capture_output=True, text=True)
        if r.returncode == 0:
            print(f'\n  Uptime: {r.stdout.strip()}')
    except Exception:
        pass

    return 0


def _detect_controllers() -> list[str]:
    """Read /proc/bus/input/devices for joystick/gamepad entries."""
    devices = []
    try:
        text = Path('/proc/bus/input/devices').read_text()
        current_name = ''
        for line in text.splitlines():
            if line.startswith('N: Name='):
                current_name = line.split('"')[1] if '"' in line else ''
            elif line.startswith('H: Handlers=') and 'js' in line:
                if current_name:
                    devices.append(current_name)
                    current_name = ''
    except OSError:
        pass
    return devices


def cmd_settings(args: list[str]) -> int:
    if not HIPPOS_SETTINGS.exists():
        print('hippos-settings not found', file=sys.stderr)
        return 1
    result = subprocess.run([str(HIPPOS_SETTINGS)] + args)
    return result.returncode


def cmd_switch(args: list[str]) -> int:
    if not args:
        print('Usage: hippos switch es|desktop [de]', file=sys.stderr)
        return 1
    target = args[0]
    if target == 'es':
        return _run(['/usr/lib/hippos/switch-to-es']).returncode
    if target == 'desktop':
        cmd = ['/usr/lib/hippos/switch-to-desktop']
        if len(args) > 1:
            cmd.append(args[1])
        return _run(cmd).returncode
    print(f'Unknown target: {target}', file=sys.stderr)
    return 1


def cmd_restart(args: list[str]) -> int:
    if not args:
        print('Usage: hippos restart es|desktop|xserver', file=sys.stderr)
        return 1
    target = args[0]
    svc_map = {
        'es':       'hippos-es.service',
        'desktop':  'hippos-desktop.service',
        'xserver':  'hippos-xserver.service',
    }
    svc = svc_map.get(target)
    if svc is None:
        print(f'Unknown target: {target}', file=sys.stderr)
        return 1
    return _run(['systemctl', 'restart', svc]).returncode


def cmd_logs(args: list[str]) -> int:
    lines = '50'
    if '--lines' in args:
        i = args.index('--lines')
        if i + 1 < len(args):
            lines = args[i + 1]

    units = []
    for svc in _HIPPOS_SERVICES:
        units += ['-u', svc]

    return _run(['journalctl', '--no-pager', '-n', lines] + units).returncode


def cmd_info() -> int:
    cmds: list[tuple[str, list[str]]] = [
        ('OS',       ['cat', '/etc/os-release']),
        ('Kernel',   ['uname', '-r']),
        ('CPU',      ['grep', '-m1', 'model name', '/proc/cpuinfo']),
        ('Memory',   ['free', '-h']),
        ('Disk',     ['df', '-h', '/userdata']),
    ]
    for label, cmd in cmds:
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            val = r.stdout.strip().splitlines()[0]
            # Trim "model name\t: " prefix from cpuinfo
            if ': ' in val and label == 'CPU':
                val = val.split(': ', 1)[1]
            print(f'{label}: {val}')
    return 0


# ── Controller tools ───────────────────────────────────────────────────────────

def _mapping_filename(name: str, vendor: int, product: int) -> str:
    safe = re.sub(r'[^a-zA-Z0-9_]', '', name.replace(' ', '_'))
    return f'{safe}-{vendor:x}-{product:x}.mapping'


def _find_mapping(filename: str) -> str:
    for d in _DEVICE_MAPPING_DIRS:
        p = d / filename
        if p.exists():
            return str(p)
    return '(none)'


def _load_mapping(path: Path) -> dict:
    import json
    if path.exists():
        try:
            return json.loads(path.read_text())
        except Exception:
            return {}
    return {}


def _save_mapping(path: Path, data: dict) -> None:
    import json
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix('.tmp')
    tmp.write_text(json.dumps(data, indent=4) + '\n')
    tmp.replace(path)


def _valid_actions() -> list[str]:
    import json
    default_map = Path('/usr/share/hippos/hotkeys/default_mapping.json')
    if default_map.exists():
        try:
            data = json.loads(default_map.read_text())
            return sorted(set(data.values()))
        except Exception:
            pass
    return []


def _evdev_gamepads() -> list:
    try:
        import evdev
        from evdev import ecodes
    except ImportError:
        return []
    _GAMEPAD_BUTTONS = {
        ecodes.BTN_SOUTH, ecodes.BTN_EAST, ecodes.BTN_NORTH, ecodes.BTN_WEST,
        ecodes.BTN_START, ecodes.BTN_SELECT, ecodes.BTN_MODE,
    }
    found = []
    for path in sorted(Path('/dev/input').glob('event*')):
        try:
            dev = evdev.InputDevice(str(path))
            caps = dev.capabilities()
            keys = set(caps.get(ecodes.EV_KEY, []))
            if keys & _GAMEPAD_BUTTONS:
                found.append(dev)
        except OSError:
            continue
    return found


def cmd_controller(args: list[str]) -> int:
    subcmd = args[0] if args else 'list'

    if subcmd == 'map':
        return cmd_controller_map(args[1:])

    if subcmd != 'list':
        print('Usage: hippos controller list|map', file=sys.stderr)
        return 1

    found = _evdev_gamepads()
    if not found:
        print('No gamepads detected.')
        return 0

    for i, dev in enumerate(found):
        mf = _mapping_filename(dev.name, dev.info.vendor, dev.info.product)
        mapping_path = _find_mapping(mf)
        print(f'Player {i + 1}: {dev.name}')
        print(f'  Device:  {dev.path}')
        print(f'  VID:PID: {dev.info.vendor:04x}:{dev.info.product:04x}')
        print(f'  Mapping: {mf}')
        print(f'  File:    {mapping_path}')
        print()

    return 0


def cmd_controller_map(args: list[str]) -> int:
    import json
    subcmd = args[0] if args else 'show'
    user_mapping_dir = Path('/userdata/system/configs/hippos-hotkeys/devices')

    if subcmd == 'list-actions':
        actions = _valid_actions()
        if not actions:
            print('(no actions found in default_mapping.json)')
            return 1
        for a in actions:
            print(a)
        return 0

    gamepads = _evdev_gamepads()

    if subcmd == 'show':
        player = int(args[1]) if len(args) > 1 else 1
        if player < 1 or player > len(gamepads):
            print(f'No gamepad at player {player}.', file=sys.stderr)
            return 1
        dev = gamepads[player - 1]
        mf = _mapping_filename(dev.name, dev.info.vendor, dev.info.product)
        # User mapping overrides OS mapping
        user_path = user_mapping_dir / mf
        os_path   = Path('/usr/share/hippos/hotkeys/devices') / mf
        path = user_path if user_path.exists() else (os_path if os_path.exists() else None)
        print(f'Player {player}: {dev.name}')
        print(f'Mapping file: {path or "(none — using default_mapping.json)"}')
        data = _load_mapping(path) if path else {}
        if data:
            for key, action in sorted(data.items()):
                print(f'  {key:<30} -> {action}')
        else:
            print('  (no device-specific bindings)')
        return 0

    if subcmd == 'set':
        if len(args) < 4:
            print('Usage: hippos controller map set <player> <BTN_KEY> <action>', file=sys.stderr)
            return 1
        player, key, action = int(args[1]), args[2], args[3]
        valid = _valid_actions()
        if valid and action not in valid:
            print(f'Unknown action: {action}', file=sys.stderr)
            print(f'Valid: {", ".join(valid)}', file=sys.stderr)
            return 1
        if player < 1 or player > len(gamepads):
            print(f'No gamepad at player {player}.', file=sys.stderr)
            return 1
        dev = gamepads[player - 1]
        mf = _mapping_filename(dev.name, dev.info.vendor, dev.info.product)
        path = user_mapping_dir / mf
        # Start from OS mapping if no user copy yet
        if not path.exists():
            os_path = Path('/usr/share/hippos/hotkeys/devices') / mf
            data = _load_mapping(os_path)
        else:
            data = _load_mapping(path)
        data[key] = action
        _save_mapping(path, data)
        print(f'Set {key} -> {action} in {path}')
        return 0

    if subcmd == 'del':
        if len(args) < 3:
            print('Usage: hippos controller map del <player> <BTN_KEY>', file=sys.stderr)
            return 1
        player, key = int(args[1]), args[2]
        if player < 1 or player > len(gamepads):
            print(f'No gamepad at player {player}.', file=sys.stderr)
            return 1
        dev = gamepads[player - 1]
        mf = _mapping_filename(dev.name, dev.info.vendor, dev.info.product)
        path = user_mapping_dir / mf
        if not path.exists():
            print(f'No user mapping for player {player}.', file=sys.stderr)
            return 1
        data = _load_mapping(path)
        if key not in data:
            print(f'{key} not in mapping.')
            return 0
        del data[key]
        _save_mapping(path, data)
        print(f'Removed {key} from {path}')
        return 0

    print(f'Unknown map subcommand: {subcmd}', file=sys.stderr)
    return 1


# ── Audio tools ────────────────────────────────────────────────────────────────

def _pipewire_env() -> dict[str, str]:
    env = dict(os.environ)
    xdg = env.get('XDG_RUNTIME_DIR', '/run/user/1000')
    env.setdefault('XDG_RUNTIME_DIR', xdg)
    env.setdefault('DBUS_SESSION_BUS_ADDRESS', f'unix:path={xdg}/bus')
    env.setdefault('PIPEWIRE_RUNTIME_DIR', xdg)
    return env


def cmd_audio(args: list[str]) -> int:
    subcmd = args[0] if args else 'list'
    env = _pipewire_env()

    if subcmd == 'list':
        r = subprocess.run(['pactl', 'list', 'sinks', 'short'],
                           capture_output=True, text=True, env=env)
        if r.returncode != 0:
            print('pactl failed — is PipeWire running?', file=sys.stderr)
            return 1
        lines = r.stdout.strip().splitlines()
        if not lines:
            print('No audio output devices found.')
            return 0
        for line in lines:
            parts = line.split('\t')
            idx  = parts[0] if len(parts) > 0 else '?'
            name = parts[1] if len(parts) > 1 else '?'
            state = parts[3] if len(parts) > 3 else ''
            print(f'  [{idx}] {name}  {state}')
        return 0

    if subcmd == 'get':
        r = subprocess.run(['pactl', 'get-default-sink'],
                           capture_output=True, text=True, env=env)
        live = r.stdout.strip() if r.returncode == 0 else '(unknown)'
        saved = _setting('audio.device') or 'default'
        print(f'Live:   {live}')
        print(f'Saved:  {saved}')
        return 0

    if subcmd == 'set':
        if len(args) < 2:
            print('Usage: hippos audio set <sink>', file=sys.stderr)
            return 1
        sink = args[1]
        r = subprocess.run(['pactl', 'set-default-sink', sink],
                           capture_output=True, text=True, env=env)
        if r.returncode != 0:
            print(f'pactl error: {r.stderr.strip()}', file=sys.stderr)
            return 1
        subprocess.run([str(HIPPOS_SETTINGS), 'set', 'audio.device', sink])
        print(f'Default audio output set to: {sink}')
        return 0

    if subcmd == 'volume':
        vol_args = args[1:]
        if not vol_args:
            r = subprocess.run(['pactl', 'get-sink-volume', '@DEFAULT_SINK@'],
                               capture_output=True, text=True, env=env)
            if r.returncode != 0:
                print('pactl failed — is PipeWire running?', file=sys.stderr)
                return 1
            print(r.stdout.strip())
            return 0
        action = vol_args[0]
        if action == 'up':
            delta = '+5%'
        elif action == 'down':
            delta = '-5%'
        elif action == 'set':
            if len(vol_args) < 2:
                print('Usage: hippos audio volume set <pct>', file=sys.stderr)
                return 1
            delta = vol_args[1]
            if not delta.endswith('%'):
                delta += '%'
        else:
            print(f'Unknown volume action: {action}', file=sys.stderr)
            return 1
        r = subprocess.run(['pactl', 'set-sink-volume', '@DEFAULT_SINK@', delta],
                           capture_output=True, text=True, env=env)
        if r.returncode != 0:
            print(f'pactl error: {r.stderr.strip()}', file=sys.stderr)
            return 1
        # Persist: read back actual volume and save
        r2 = subprocess.run(['pactl', 'get-sink-volume', '@DEFAULT_SINK@'],
                            capture_output=True, text=True, env=env)
        if r2.returncode == 0:
            import re as _re
            m = _re.search(r'(\d+)%', r2.stdout)
            if m:
                subprocess.run([str(HIPPOS_SETTINGS), 'set', 'audio.volume', m.group(1)])
        return 0

    print(f'Unknown audio subcommand: {subcmd}', file=sys.stderr)
    print('Usage: hippos audio list|get|set|volume', file=sys.stderr)
    return 1


# ── Display tools ──────────────────────────────────────────────────────────────

def _xrandr_query() -> str:
    r = subprocess.run(['xrandr', '--query'], capture_output=True, text=True,
                       env={**os.environ, 'DISPLAY': os.environ.get('DISPLAY', ':0')})
    return r.stdout if r.returncode == 0 else ''


def cmd_display(args: list[str]) -> int:
    subcmd = args[0] if args else 'list'
    env = {**os.environ, 'DISPLAY': os.environ.get('DISPLAY', ':0')}

    if subcmd == 'list':
        out = _xrandr_query()
        if not out:
            print('xrandr failed — is an X server running?', file=sys.stderr)
            return 1
        print(out, end='')
        return 0

    if subcmd == 'get':
        output = _setting('display.output') or '(auto)'
        res    = _setting('display.resolution') or 'preferred'
        _rot_map = {'0': 'normal', '1': 'right', '2': 'inverted', '3': 'left'}
        rotate = _setting('display.rotate') or '0'
        print(f'Output:     {output}')
        print(f'Resolution: {res}')
        print(f'Rotation:   {_rot_map.get(rotate, "normal")} ({rotate})')
        for line in _xrandr_query().splitlines():
            if '*' in line:
                print(f'Active:     {line.strip()}')
                break
        return 0

    if subcmd == 'set':
        if len(args) < 2:
            print('Usage: hippos display set <WxH[@R]>', file=sys.stderr)
            return 1
        mode = args[1]
        subprocess.run([str(HIPPOS_SETTINGS), 'set', 'display.resolution', mode])
        # Apply now if X is running
        output = _setting('display.output')
        if not output:
            output = _xrandr_current_output()
        if output:
            r = subprocess.run(['xrandr', '--output', output, '--mode', mode],
                               capture_output=True, text=True, env=env)
            if r.returncode != 0:
                print(f'xrandr: {r.stderr.strip()}', file=sys.stderr)
                return 1
        print(f'Resolution set to: {mode}')
        return 0

    if subcmd == 'output':
        if len(args) < 2:
            print('Usage: hippos display output <name>', file=sys.stderr)
            return 1
        subprocess.run([str(HIPPOS_SETTINGS), 'set', 'display.output', args[1]])
        print(f'Default output set to: {args[1]}')
        return 0

    if subcmd == 'rotate':
        if len(args) < 2:
            print('Usage: hippos display rotate <0-3>', file=sys.stderr)
            return 1
        val = args[1]
        if val not in ('0', '1', '2', '3'):
            print('Rotation must be 0, 1, 2, or 3', file=sys.stderr)
            return 1
        _rot_map = {'0': 'normal', '1': 'right', '2': 'inverted', '3': 'left'}
        rotation = _rot_map[val]
        output = _setting('display.output') or _xrandr_current_output()
        if output:
            r = subprocess.run(['xrandr', '--output', output, '--rotate', rotation],
                               capture_output=True, text=True, env=env)
            if r.returncode != 0:
                print(f'xrandr: {r.stderr.strip()}', file=sys.stderr)
                return 1
        subprocess.run([str(HIPPOS_SETTINGS), 'set', 'display.rotate', val])
        print(f'Rotation set to: {rotation} ({val})')
        return 0

    print(f'Unknown display subcommand: {subcmd}', file=sys.stderr)
    return 1


def _xrandr_current_output() -> str:
    for line in _xrandr_query().splitlines():
        if ' connected' in line:
            return line.split()[0]
    return ''


# ── Screenshot ──────────────────────────────────────────────────────────────────

def cmd_screenshot(args: list[str]) -> int:
    import time as _time
    screenshots_dir = Path('/userdata/screenshots')
    screenshots_dir.mkdir(parents=True, exist_ok=True)

    if args:
        out_path = args[0]
    else:
        ts = _time.strftime('%Y%m%d-%H%M%S')
        out_path = str(screenshots_dir / f'hippos-{ts}.png')

    env = {**os.environ, 'DISPLAY': os.environ.get('DISPLAY', ':0')}

    # Try scrot first, then import (ImageMagick), then xwd+convert
    for cmd in (
        ['scrot', '-z', out_path],
        ['import', '-window', 'root', out_path],
    ):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, env=env)
            if r.returncode == 0:
                print(f'Screenshot saved: {out_path}')
                return 0
        except FileNotFoundError:
            continue

    print('No screenshot tool found (install scrot or imagemagick)', file=sys.stderr)
    return 1


# ── Wi-Fi ──────────────────────────────────────────────────────────────────────

def _nmcli(*args: str, capture: bool = True) -> tuple[int, str]:
    r = subprocess.run(['nmcli'] + list(args), capture_output=capture, text=True)
    return r.returncode, (r.stdout + r.stderr).strip()


def _wifi_device() -> str:
    """Return first Wi-Fi device name from nmcli."""
    rc, out = _nmcli('-t', '-f', 'DEVICE,TYPE', 'dev', 'status')
    for line in out.splitlines():
        parts = line.split(':')
        if len(parts) >= 2 and parts[1] == 'wifi':
            return parts[0]
    return 'wlan0'


def cmd_wifi(args: list[str]) -> int:
    subcmd = args[0] if args else 'status'

    if subcmd == 'list':
        rc, out = _nmcli('-t', '-f', 'SSID,SIGNAL,SECURITY,IN-USE', 'dev', 'wifi', 'list')
        if rc != 0:
            print(f'nmcli error: {out}', file=sys.stderr)
            return 1
        if not out.strip():
            print('No networks found.')
            return 0
        print(f'{"SSID":<35} {"Signal":>6}  {"Security":<12} In-use')
        print('-' * 65)
        for line in out.splitlines():
            parts = line.split(':')
            if len(parts) < 4:
                continue
            ssid, signal, security, inuse = parts[0], parts[1], parts[2], parts[3]
            marker = '*' if inuse == '*' else ' '
            print(f'{marker} {ssid:<33} {signal:>6}%  {security:<12}')
        return 0

    if subcmd == 'status':
        rc, out = _nmcli('-t', '-f', 'DEVICE,STATE,CONNECTION', 'dev', 'status')
        if rc != 0:
            print(f'nmcli error: {out}', file=sys.stderr)
            return 1
        for line in out.splitlines():
            parts = line.split(':')
            if len(parts) >= 3 and parts[1] in ('connected', 'disconnected', 'unavailable'):
                print(f'{parts[0]}: {parts[1]}  {parts[2]}')
        return 0

    if subcmd == 'connect':
        if not args[1:]:
            print('Usage: hippos wifi connect <ssid> [--password <pass>]', file=sys.stderr)
            return 1
        ssid = args[1]
        password = ''
        cmd = ['dev', 'wifi', 'connect', ssid]
        if '--password' in args:
            i = args.index('--password')
            if i + 1 < len(args):
                password = args[i + 1]
                cmd += ['password', password]
        rc, out = _nmcli(*cmd)
        print(out)
        if rc == 0:
            subprocess.run([str(HIPPOS_SETTINGS), 'set', 'wifi.enabled', 'true'])
            subprocess.run([str(HIPPOS_SETTINGS), 'set', 'wifi.ssid', ssid])
            if password:
                subprocess.run([str(HIPPOS_SETTINGS), 'set', 'wifi.key', password])
        return rc

    if subcmd == 'forget':
        if len(args) < 2:
            print('Usage: hippos wifi forget <ssid>', file=sys.stderr)
            return 1
        rc, out = _nmcli('con', 'delete', 'id', args[1])
        print(out)
        return rc

    if subcmd in ('on', 'off'):
        rc, out = _nmcli('radio', 'wifi', subcmd)
        print(out or f'Wi-Fi radio {subcmd}')
        if rc == 0:
            subprocess.run([str(HIPPOS_SETTINGS), 'set', 'wifi.enabled',
                            'true' if subcmd == 'on' else 'false'])
        return rc

    if subcmd == 'disconnect':
        dev = _wifi_device()
        rc, out = _nmcli('dev', 'disconnect', dev)
        if rc == 0:
            subprocess.run([str(HIPPOS_SETTINGS), 'set', 'wifi.enabled', 'false'])
        print(out)
        return rc

    print(f'Unknown wifi subcommand: {subcmd}', file=sys.stderr)
    return 1


# ── Bluetooth ───────────────────────────────────────────────────────────────────

def _btctl(*args: str) -> tuple[int, str]:
    r = subprocess.run(['bluetoothctl', *args], capture_output=True, text=True)
    return r.returncode, (r.stdout + r.stderr).strip()


def cmd_bluetooth(args: list[str]) -> int:
    subcmd = args[0] if args else 'list'

    if subcmd == 'power':
        state = args[1] if len(args) > 1 else 'on'
        rc, out = _btctl('power', state)
        print(out)
        return rc

    if subcmd == 'list':
        rc, out = _btctl('paired-devices')
        if not out:
            print('No paired devices.')
        else:
            print(out)
        return rc

    if subcmd == 'scan':
        secs = '10'
        if '--time' in args:
            i = args.index('--time')
            if i + 1 < len(args):
                secs = args[i + 1]
        print(f'Scanning for {secs}s... (put device in pairing mode now)')
        # Power on, then scan with timeout
        _btctl('power', 'on')
        r = subprocess.run(
            ['timeout', secs, 'bluetoothctl', 'scan', 'on'],
            capture_output=True, text=True,
        )
        # List devices found
        _, devices = _btctl('devices')
        if devices:
            print('Discovered:')
            print(devices)
        else:
            print('No devices found.')
        return 0

    if subcmd == 'pair':
        if len(args) < 2:
            print('Usage: hippos bluetooth pair <mac>', file=sys.stderr)
            return 1
        mac = args[1]
        _btctl('power', 'on')
        for cmd in ('pair', 'trust', 'connect'):
            rc, out = _btctl(cmd, mac)
            print(f'{cmd}: {out}')
            if rc != 0 and cmd == 'pair':
                return rc
        return 0

    if subcmd == 'connect':
        if len(args) < 2:
            print('Usage: hippos bluetooth connect <mac>', file=sys.stderr)
            return 1
        rc, out = _btctl('connect', args[1])
        print(out)
        return rc

    if subcmd == 'disconnect':
        if len(args) < 2:
            print('Usage: hippos bluetooth disconnect <mac>', file=sys.stderr)
            return 1
        rc, out = _btctl('disconnect', args[1])
        print(out)
        return rc

    if subcmd == 'remove':
        if len(args) < 2:
            print('Usage: hippos bluetooth remove <mac>', file=sys.stderr)
            return 1
        rc, out = _btctl('remove', args[1])
        print(out)
        return rc

    print(f'Unknown bluetooth subcommand: {subcmd}', file=sys.stderr)
    return 1


