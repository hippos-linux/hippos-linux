# ── Diagnostics ─────────────────────────────────────────────────────────────────

def cmd_diag(args: list[str]) -> int:
    import time as _time
    import io

    out_path = None
    if '--out' in args:
        i = args.index('--out')
        if i + 1 < len(args):
            out_path = args[i + 1]

    if out_path is None:
        ts = _time.strftime('%Y%m%d-%H%M%S')
        out_path = f'/userdata/system/diag-{ts}.txt'

    buf = io.StringIO()

    def section(title: str) -> None:
        buf.write(f'\n{"="*60}\n{title}\n{"="*60}\n')

    def capture(*cmd: str) -> None:
        try:
            r = subprocess.run(list(cmd), capture_output=True, text=True,
                               env={**os.environ, 'DISPLAY': os.environ.get('DISPLAY', ':0')})
            buf.write(r.stdout or '(no output)\n')
            if r.stderr:
                buf.write(r.stderr)
        except FileNotFoundError:
            buf.write(f'(command not found: {cmd[0]})\n')

    section('HippOS Settings')
    capture(str(HIPPOS_SETTINGS), 'list')

    section('Services')
    capture('systemctl', 'status', '--no-pager', '--lines=5',
            *[s for svc in _HIPPOS_SERVICES for s in [svc]])

    section('OS Info')
    capture('uname', '-a')
    capture('cat', '/etc/os-release')

    section('CPU / Memory')
    capture('grep', '-m1', 'model name', '/proc/cpuinfo')
    capture('free', '-h')

    section('Disk')
    capture('df', '-h')

    section('Display')
    capture('xrandr', '--query')

    section('Audio')
    xdg = os.environ.get('XDG_RUNTIME_DIR', '/run/user/1000')
    env_pw = {**os.environ,
              'XDG_RUNTIME_DIR': xdg,
              'DBUS_SESSION_BUS_ADDRESS': f'unix:path={xdg}/bus'}
    try:
        r = subprocess.run(['pactl', 'list', 'sinks', 'short'],
                           capture_output=True, text=True, env=env_pw)
        buf.write(r.stdout or '(no output)\n')
    except FileNotFoundError:
        buf.write('(pactl not found)\n')

    section('Controllers')
    try:
        import evdev
        from evdev import ecodes
        _GP = {ecodes.BTN_SOUTH, ecodes.BTN_EAST, ecodes.BTN_NORTH, ecodes.BTN_WEST}
        for path in sorted(Path('/dev/input').glob('event*')):
            try:
                dev = evdev.InputDevice(str(path))
                caps = dev.capabilities()
                if ecodes.EV_KEY in caps:
                    keys = set(caps.get(ecodes.EV_KEY, []))
                    if keys & _GP:
                        buf.write(f'{dev.path}: {dev.name} '
                                  f'({dev.info.vendor:04x}:{dev.info.product:04x})\n')
            except OSError:
                pass
    except ImportError:
        buf.write('(evdev not available)\n')

    section('Journal (hippos services, last 50 lines)')
    units = []
    for svc in _HIPPOS_SERVICES:
        units += ['-u', svc]
    capture('journalctl', '--no-pager', '-n', '50', *units)

    report = buf.getvalue()
    Path(out_path).parent.mkdir(parents=True, exist_ok=True)
    Path(out_path).write_text(report)
    print(report)
    print(f'\nDiagnostics saved to: {out_path}')
    return 0


def cmd_update(args: list[str]) -> int:
    import datetime
    sub = args[0] if args else 'check'

    if sub == 'check':
        _run(['apt-get', 'update', '-qq'])
        r = subprocess.run(['apt', 'list', '--upgradable'], capture_output=True, text=True)
        lines = [l for l in r.stdout.splitlines() if '/' in l]
        if lines:
            print(f'{len(lines)} package(s) can be updated:')
            for l in lines:
                print(f'  {l}')
        else:
            print('System is up to date.')
        return 0

    if sub == 'apply':
        if os.getuid() != 0:
            print('hippos update apply requires root', file=sys.stderr)
            return 1
        ts       = datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
        snap_dir = Path('/.snapshots')
        snap_dir.mkdir(exist_ok=True)
        snap     = snap_dir / f'pre-update-{ts}'
        r = subprocess.run(['btrfs', 'subvolume', 'snapshot', '-r', '/', str(snap)])
        if r.returncode == 0:
            print(f'Snapshot: {snap}')
        else:
            print('Warning: btrfs snapshot failed — proceeding without snapshot')
        subprocess.run(['apt-get', 'update'])
        result = subprocess.run(['apt-get', 'dist-upgrade', '-y'])
        if result.returncode == 0:
            print('Update complete. Reboot to apply kernel/firmware changes.')
        return result.returncode

    if sub == 'rollback':
        snap_dir = Path('/.snapshots')
        snaps    = sorted(snap_dir.glob('pre-update-*'), reverse=True) if snap_dir.exists() else []
        if not snaps:
            print('No update snapshots found.', file=sys.stderr)
            return 1
        print('Available update snapshots:')
        for i, s in enumerate(snaps[:10]):
            print(f'  {i+1}. {s.name}')
        print()
        print('To rollback (run as root):')
        print(f'  btrfs subvolume set-default {snaps[0]}')
        print(f'  reboot')
        return 0

    print('Usage: hippos update check|apply|rollback', file=sys.stderr)
    return 1


def cmd_preflight(_args: list[str]) -> int:
    passed = failed = warned = 0

    def check(status: str, msg: str) -> None:
        nonlocal passed, failed, warned
        tag = {'pass': '[PASS]', 'fail': '[FAIL]', 'warn': '[WARN]'}[status]
        print(f'{tag} {msg}')
        if status == 'pass':   passed  += 1
        elif status == 'fail': failed  += 1
        else:                  warned  += 1

    # UEFI
    if Path('/sys/firmware/efi').exists():
        check('pass', 'Boot mode: UEFI')
    else:
        check('fail', 'Boot mode: Legacy BIOS — HippOS requires UEFI')

    # RAM
    try:
        mem_kb = int(next(
            l for l in Path('/proc/meminfo').read_text().splitlines()
            if l.startswith('MemTotal')
        ).split()[1])
        mem_gb = mem_kb // (1024 * 1024)
        if mem_gb >= 8:
            check('pass', f'RAM: {mem_gb} GB')
        elif mem_gb >= 4:
            check('warn', f'RAM: {mem_gb} GB (8 GB recommended for Steam/Proton)')
        else:
            check('fail', f'RAM: {mem_gb} GB — 4 GB minimum required')
    except Exception:
        check('warn', 'RAM: could not determine')

    # Disk
    try:
        r = subprocess.run(['df', '-BG', '--output=avail', '/'], capture_output=True, text=True)
        free_gb = int(r.stdout.splitlines()[-1].strip().rstrip('G'))
        if free_gb >= 50:
            check('pass', f'Disk free: {free_gb} GB')
        elif free_gb >= 20:
            check('warn', f'Disk free: {free_gb} GB (50 GB recommended)')
        else:
            check('fail', f'Disk free: {free_gb} GB — 20 GB minimum required')
    except Exception:
        check('warn', 'Disk: could not determine free space')

    # GPU
    try:
        lspci_out = subprocess.run(['lspci'], capture_output=True, text=True).stdout.lower()
        if 'nvidia' in lspci_out:
            nv_loaded = Path('/proc/driver/nvidia').exists() or \
                subprocess.run(['modinfo', 'nvidia'], capture_output=True).returncode == 0
            if nv_loaded:
                check('pass', 'GPU: NVIDIA — proprietary driver loaded')
            else:
                check('warn', 'GPU: NVIDIA detected — proprietary driver not loaded (install nvidia-driver)')
        elif 'amd' in lspci_out or 'radeon' in lspci_out:
            check('pass', 'GPU: AMD — amdgpu/radeon')
        elif 'intel' in lspci_out:
            check('pass', 'GPU: Intel — i915')
        else:
            check('warn', 'GPU: unknown — verify display driver is installed')
    except Exception:
        check('warn', 'GPU: could not query PCI devices')

    # /userdata
    try:
        r = subprocess.run(['mountpoint', '-q', '/userdata'])
        check('pass' if r.returncode == 0 else 'warn',
              '/userdata is mounted' if r.returncode == 0 else '/userdata is not mounted (expected at runtime)')
    except Exception:
        check('warn', '/userdata: could not check mount status')

    print()
    print(f'Summary: {passed} pass, {warned} warn, {failed} fail')
    return 0 if failed == 0 else 1


# ── Entry point ────────────────────────────────────────────────────────────────

def main() -> int:
    args = sys.argv[1:]
    if not args:
        print(_USAGE)
        return 0

    cmd, *rest = args

    if cmd == 'status':
        return cmd_status()
    if cmd == 'settings':
        return cmd_settings(rest)
    if cmd == 'switch':
        return cmd_switch(rest)
    if cmd == 'restart':
        return cmd_restart(rest)
    if cmd == 'logs':
        return cmd_logs(rest)
    if cmd == 'info':
        return cmd_info()
    if cmd in ('shutdown', 'poweroff'):
        return cmd_power('shutdown')
    if cmd == 'reboot':
        return cmd_power('reboot')
    if cmd == 'suspend':
        return cmd_power('suspend')
    if cmd == 'hibernate':
        return cmd_power('hibernate')
    if cmd == 'timezone':
        return cmd_timezone(rest)
    if cmd == 'brightness':
        return cmd_brightness(rest)
    if cmd == 'controller':
        return cmd_controller(rest)
    if cmd == 'audio':
        return cmd_audio(rest)
    if cmd == 'display':
        return cmd_display(rest)
    if cmd == 'screenshot':
        return cmd_screenshot(rest)
    if cmd == 'wifi':
        return cmd_wifi(rest)
    if cmd == 'bluetooth':
        return cmd_bluetooth(rest)
    if cmd == 'diag':
        return cmd_diag(rest)
    if cmd == 'content':
        return _delegate('/usr/lib/hippos/hippos-content', rest)
    if cmd == 'update':
        return cmd_update(rest)
    if cmd == 'preflight':
        return cmd_preflight(rest)

    print(f'Unknown command: {cmd}\n', file=sys.stderr)
    print(_USAGE, file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
