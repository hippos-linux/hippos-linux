#!/usr/bin/env bash
# hippos-select-kernel — trigger a GRUB regen when the kernel variant chosen
# via the system.kernel setting (standard|lts) changes. Runs at every boot,
# root context. Change takes effect on the *next* reboot, same as CRT setup's
# GRUB edits — ES only ever writes the setting (unprivileged, /userdata),
# this script does the privileged update-grub work.
#
# Two kernel variants ship in every image (see build/build-kernel.sh):
#   standard → /boot/vmlinuz-<ver>-hippos
#   lts      → /boot/vmlinuz-<ver>-hippos-lts
# grub.cfg itself is generated by hippos-upgrade's write_grub_cfg (invoked via
# update-grub — see /usr/sbin/update-grub), which reads system.kernel
# directly to decide which variant's menuentry lands at index 0. This script
# does not touch grub.cfg or /etc/default/grub itself — it only decides
# whether a regen is needed, so it's just deferring to that one generator
# rather than duplicating its selection logic.

set -euo pipefail

LOG_TAG="[hippos-select-kernel]"
log()  { printf '%s %s\n' "${LOG_TAG}" "$*"; }
warn() { printf '%s WARNING: %s\n' "${LOG_TAG}" "$*" >&2; }

STATE_FILE="/var/lib/hippos/kernel-variant"

get() { hippos-settings get "$1" 2>/dev/null || true; }

VARIANT="$(get system.kernel)"; VARIANT="${VARIANT:-standard}"

case "${VARIANT}" in
    standard|lts) ;;
    *)
        warn "unknown system.kernel value '${VARIANT}' — defaulting to standard"
        VARIANT="standard"
        ;;
esac

PREV_VARIANT="$(cat "${STATE_FILE}" 2>/dev/null || true)"

if [[ "${PREV_VARIANT}" == "${VARIANT}" ]]; then
    log "GRUB default already reflects '${VARIANT}' — skipping update-grub"
    exit 0
fi

log "system.kernel is '${VARIANT}' (was '${PREV_VARIANT:-unset}') — regenerating GRUB"
if update-grub 2>/dev/null; then
    mkdir -p "$(dirname "${STATE_FILE}")"
    printf '%s\n' "${VARIANT}" > "${STATE_FILE}"
    log "GRUB updated — takes effect on next reboot"
else
    warn "update-grub failed — kernel selection will apply after a later successful update-grub"
fi
