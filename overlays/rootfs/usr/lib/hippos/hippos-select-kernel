#!/usr/bin/env bash
# hippos-select-kernel — pin GRUB_DEFAULT to the kernel variant chosen via the
# system.kernel setting (standard|lts). Runs at every boot, root context.
# Change takes effect on the *next* reboot, same as CRT setup's GRUB edits —
# ES only ever writes the setting (unprivileged, /userdata), this script does
# the privileged GRUB_DEFAULT + update-grub work.
#
# Two kernel variants ship in every image (see build/build-kernel.sh):
#   standard → /boot/vmlinuz-<ver>-hippos
#   lts      → /boot/vmlinuz-<ver>-hippos-lts
# GRUB menuentry titles are generated by grub-mkconfig as
# "<GRUB_DISTRIBUTOR> GNU/Linux, with Linux <kver>" — flat top-level entries
# since GRUB_DISABLE_SUBMENU=y (see /etc/default/grub). configure-rootfs.sh
# pins this same title format for the standard kernel at build time; this
# script is the runtime equivalent for either variant.

set -euo pipefail

LOG_TAG="[hippos-select-kernel]"
log()  { printf '%s %s\n' "${LOG_TAG}" "$*"; }
warn() { printf '%s WARNING: %s\n' "${LOG_TAG}" "$*" >&2; }

GRUB_CFG="/etc/default/grub"
DISTRIBUTOR="HippOS"

get() { hippos-settings get "$1" 2>/dev/null || true; }

VARIANT="$(get system.kernel)"; VARIANT="${VARIANT:-standard}"

case "${VARIANT}" in
    standard|lts) ;;
    *)
        warn "unknown system.kernel value '${VARIANT}' — defaulting to standard"
        VARIANT="standard"
        ;;
esac

# lts kernel filenames also end in -hippos, so the standard lookup must
# exclude them explicitly rather than glob on suffix alone.
if [[ "${VARIANT}" == "lts" ]]; then
    KVER="$(ls -1 /boot/vmlinuz-*-hippos-lts 2>/dev/null \
        | sed 's#^/boot/vmlinuz-##' | sort -V | tail -1)"
else
    KVER="$(ls -1 /boot/vmlinuz-*-hippos 2>/dev/null \
        | grep -v -- '-lts$' | sed 's#^/boot/vmlinuz-##' | sort -V | tail -1)"
fi

if [[ -z "${KVER}" ]]; then
    warn "no installed kernel matches variant '${VARIANT}' — leaving GRUB_DEFAULT unchanged"
    exit 0
fi

NEW_DEFAULT="${DISTRIBUTOR} GNU/Linux, with Linux ${KVER}"
CUR_DEFAULT="$(grep -oP '^GRUB_DEFAULT="\K[^"]*' "${GRUB_CFG}" 2>/dev/null || true)"

if [[ "${CUR_DEFAULT}" == "${NEW_DEFAULT}" ]]; then
    log "GRUB_DEFAULT already pinned to ${VARIANT} (${KVER}) — skipping update-grub"
    exit 0
fi

log "Pinning GRUB default to ${VARIANT} kernel: ${KVER}"
sed -i "s|^GRUB_DEFAULT=.*|GRUB_DEFAULT=\"${NEW_DEFAULT}\"|" "${GRUB_CFG}"

if update-grub 2>/dev/null; then
    log "GRUB updated — takes effect on next reboot"
else
    warn "update-grub failed — kernel selection will apply after a later successful update-grub"
fi
