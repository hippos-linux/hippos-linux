#!/usr/bin/env bash
# ES API: bluetooth enable/disable/list/trust/connect/disconnect/remove/live_devices
# list and live_devices output XML compatible with Batocera EmulationStation

_btctl() { bluetoothctl "$@" 2>&1; }

_list_xml() {
    find /var/lib/bluetooth/ -type f -name info 2>/dev/null | while read -r FILE; do
        grep -qE '^Trusted=true$' "${FILE}" || continue
        DEVNAME=$(grep -E '^Name=' "${FILE}" | sed 's/^Name=//')
        DEVCLASS=$(grep -E '^Class=' "${FILE}" | sed 's/^Class=//')
        DEVADDR=$(basename "$(dirname "${FILE}")")
        DEVTYPE=""
        [ "${DEVCLASS}" = "0x002508" ] && DEVTYPE="joystick"
        [ "${DEVCLASS}" = "0x000508" ] && DEVTYPE="joystick"
        if bluetoothctl -- info "${DEVADDR}" 2>/dev/null | grep -q "Connected: yes"; then
            CONNECTED="yes"
        else
            CONNECTED="no"
        fi
        echo "<device id=\"${DEVADDR}\" name=\"${DEVNAME}\" type=\"${DEVTYPE}\" connected=\"${CONNECTED}\" />"
    done
}

case "${1:-}" in
    enable)  _btctl power on ;;
    disable) _btctl power off ;;
    list)    _list_xml ;;
    trust)
        MAC="${2:-}"
        _btctl power on
        _btctl pair "$MAC"
        _btctl trust "$MAC"
        _btctl connect "$MAC"
        ;;
    connect)    _btctl connect "${2:-}" ;;
    disconnect) _btctl disconnect "${2:-}" ;;
    remove)     _btctl remove "${2:-}" ;;
    forgetBT|forget)
        find /var/lib/bluetooth/ -type f -name info 2>/dev/null | while read -r FILE; do
            DEVADDR=$(basename "$(dirname "${FILE}")")
            _btctl remove "$DEVADDR"
        done
        ;;
    live_devices|start_live_devices)
        _btctl power on >/dev/null 2>&1
        { echo "scan on"; sleep infinity; } | bluetoothctl 2>/dev/null | \
        while IFS= read -r line; do
            if echo "$line" | grep -qE '^\[NEW\] Device'; then
                MAC=$(echo "$line" | grep -oE '([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}' | head -1)
                NAME=$(echo "$line" | sed 's/.*Device [0-9A-Fa-f:]*[[:space:]]*//')
                [ -n "$MAC" ] && echo "<device id=\"${MAC}\" name=\"${NAME}\" status=\"added\" type=\"unknown\" />"
            elif echo "$line" | grep -qE '^\[DEL\] Device'; then
                MAC=$(echo "$line" | grep -oE '([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}' | head -1)
                NAME=$(echo "$line" | sed 's/.*Device [0-9A-Fa-f:]*[[:space:]]*//')
                [ -n "$MAC" ] && echo "<device id=\"${MAC}\" name=\"${NAME}\" status=\"removed\" type=\"unknown\" />"
            fi
        done
        ;;
    stop_live_devices)
        _btctl scan off 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 enable|disable|list|trust <mac>|connect <mac>|disconnect <mac>|remove <mac>|live_devices|stop_live_devices" >&2
        exit 1
        ;;
esac
