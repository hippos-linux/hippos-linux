#!/usr/bin/env python3
"""Usage: hippos-quickmenu

Shows or hides the quick menu (EmulationStation's control center).
"""
from __future__ import annotations

import os
import pwd
import signal
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

from hippos_session_app import SESSION_USER, session_env

ES_CONTROL_CENTER_URL = 'http://127.0.0.1:1234/controlcenter'
ES_API_TIMEOUT_S = 1
PROC = Path('/proc')


def control_center_pid() -> int | None:
    uid = pwd.getpwnam(SESSION_USER).pw_uid
    for proc in PROC.iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid != uid:
                continue
            args = (proc / 'cmdline').read_bytes().split(b'\0')
        except OSError:
            continue
        if os.path.basename(args[0]) == b'emulationstation' and b'--controlcenter' in args:
            return int(proc.name)
    return None


def shown_in_es() -> bool:
    try:
        with urllib.request.urlopen(ES_CONTROL_CENTER_URL, timeout=ES_API_TIMEOUT_S):
            return True
    except (urllib.error.URLError, OSError):
        return False


def control_center_env() -> dict[str, str]:
    env = session_env()
    if 'WAYLAND_DISPLAY' in env:
        env['SDL_VIDEODRIVER'] = 'wayland'
    else:
        env.pop('SDL_VIDEODRIVER', None)
    return env


def toggle() -> None:
    if shown_in_es():
        return
    pid = control_center_pid()
    if pid is not None:
        os.kill(pid, signal.SIGUSR1)
        return
    command = ['emulationstation', '--controlcenter']
    if os.geteuid() == 0:
        command = ['runuser', '-u', SESSION_USER, '--'] + command
    env = control_center_env()
    subprocess.Popen(command, env=env, cwd=env['HOME'], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main(argv: list[str]) -> int:
    if argv:
        print(__doc__, file=sys.stderr)
        return 2
    toggle()
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
