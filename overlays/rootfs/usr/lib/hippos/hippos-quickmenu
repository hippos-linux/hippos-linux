#!/usr/bin/env python3
"""Usage: hippos-quickmenu [--run]

Shows or hides the HippOS quick menu. --run starts the menu process itself.
"""

from __future__ import annotations

import io
import re
import shlex
import signal
import subprocess
import sys
import urllib.request
import xml.etree.ElementTree as ET
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from pathlib import Path

from hippos_session_app import claim, release, toggle

SCRIPT           = Path('/usr/lib/hippos/hippos-quickmenu')
PID_FILE         = Path('/run/hippos/quickmenu.pid')
MENU_FILES       = (Path('/userdata/system/configs/quickmenu/quickmenu.xml'),
                    Path('/usr/share/hippos/quickmenu/quickmenu.xml'))
STYLE_FILES      = (Path('/userdata/system/configs/quickmenu/style.css'),
                    Path('/usr/share/hippos/quickmenu/style.css'))
SCREEN_SETTING   = 'quickmenu.screen'
COMMAND_TIMEOUT_S = 3
IMAGE_TIMEOUT_S  = 5
INACTIVITY_CLOSE_S = 20
GRAB_DELAY_MS    = 250
WIDTH_SHARE      = 0.42
HEIGHT_SHARE     = 0.8
CORNER_SHARE     = 0.022
HINT_ICON_PX     = 22
COMMAND_WORKERS  = 4
DEFAULT_IMAGE_HEIGHT = '10%'

EXPRESSION = re.compile(r'\$\{(.*)\}', re.DOTALL)


@dataclass
class Control:
    kind: str
    attrs: dict[str, str]
    choices: list[dict[str, str]] = field(default_factory=list)
    sources: list[dict[str, str]] = field(default_factory=list)


@dataclass
class Row:
    label: str
    condition: str
    controls: list[Control]


@dataclass
class Page:
    title: str
    condition: str
    rows: list[Row]


@dataclass
class Menu:
    header: list[Row]
    footer: list[Row]
    pages: list[Page]


def _row(element: ET.Element) -> Row:
    controls = [Control(child.tag, dict(child.attrib)) for child in element
                if child.tag not in ('choice', 'choice_cmd')]
    choices = [dict(child.attrib) for child in element if child.tag == 'choice']
    sources = [dict(child.attrib) for child in element if child.tag == 'choice_cmd']
    if choices or sources:
        controls.append(Control('choices', {}, choices, sources))
    return Row(element.get('display', ''), element.get('if', ''), controls)


def parse_menu(text: str) -> Menu:
    root = ET.fromstring(text)
    menu = Menu([], [], [])
    for group in root:
        rows = [_row(feature) for feature in group if feature.tag == 'feature']
        if group.get('role') == 'header':
            menu.header.extend(rows)
        elif group.get('role') == 'footer':
            menu.footer.extend(rows)
        elif group.tag == 'hgroup':
            menu.pages.append(Page(group.get('display', group.get('name', '')), group.get('if', ''), rows))
    return menu


def expression_command(text: str) -> str | None:
    match = EXPRESSION.search(text)
    return match.group(1) if match else None


def fill_expression(text: str, output: str) -> str:
    match = EXPRESSION.search(text)
    return text[:match.start()] + output + text[match.end():]


def is_true(text: str) -> bool:
    return text.strip().lower() in ('1', 'true', 'yes', 'on')


def run_command(command: str) -> str:
    try:
        result = subprocess.run(['bash', '-c', command], capture_output=True, text=True, timeout=COMMAND_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        return ''
    return result.stdout.strip()


def evaluate(text: str) -> str:
    command = expression_command(text)
    return text if command is None else fill_expression(text, run_command(command))


def command_choices(source: dict[str, str]) -> list[tuple[str, str]]:
    labels = evaluate(source.get('display', '')).splitlines()
    values = evaluate(source.get('action_arg', '')).splitlines() if source.get('action_arg') else labels
    action = source.get('action', '')
    return [(label, f'{action} {shlex.quote(value)}') for label, value in zip(labels, values) if label.strip()]


def height_pixels(spec: str, screen_height: int) -> int:
    spec = spec or DEFAULT_IMAGE_HEIGHT
    return int(screen_height * float(spec[:-1]) / 100) if spec.endswith('%') else int(spec)


def image_bytes(location: str) -> bytes:
    if location.startswith(('http://', 'https://')):
        with urllib.request.urlopen(location, timeout=IMAGE_TIMEOUT_S) as response:
            return response.read()
    return Path(location).read_bytes()


def qrcode_png(text: str) -> bytes:
    import qrcode
    buffer = io.BytesIO()
    qrcode.make(text, border=2).save(buffer, format='PNG')
    return buffer.getvalue()


def first_existing(paths: tuple[Path, ...]) -> Path:
    return next(path for path in paths if path.is_file())


def run_menu() -> int:
    if not claim(PID_FILE, SCRIPT):
        return 0

    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    gi.require_version('GdkPixbuf', '2.0')
    gi.require_version('Pango', '1.0')
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango
    from evdev import ecodes
    from hippos_docviewer import DocumentViewer, pixbuf_from_bytes
    from hippos_keypicker import KeyPicker
    from hippos_es_buttons import help_icon, ok_and_back
    from hippos_gamepad_reader import GamepadReader

    hat_directions = {(ecodes.ABS_HAT0Y, -1): 'up', (ecodes.ABS_HAT0Y, 1): 'down',
                      (ecodes.ABS_HAT0X, -1): 'left', (ecodes.ABS_HAT0X, 1): 'right'}
    close_buttons = {'start', 'hotkey'}
    ok_button, back_button = ok_and_back()

    def selected_monitor() -> Gdk.Monitor:
        display = Gdk.Display.get_default()
        wanted = run_command(f'hippos-settings get {SCREEN_SETTING}')
        monitors = [display.get_monitor(index) for index in range(display.get_n_monitors())]
        return next((monitor for monitor in monitors if wanted and monitor.get_model() == wanted),
                    display.get_primary_monitor() or monitors[0])

    class MenuRow(Gtk.ListBoxRow):
        def __init__(self, menu: 'QuickMenu', row: Row) -> None:
            super().__init__()
            self.menu = menu
            self.buttons: list[Gtk.Button] = []
            self.switch: Gtk.Switch | None = None
            self.open_target = None
            self.opens_list = False
            self.title = Gtk.Label(xalign=0)
            self.get_style_context().add_class('row')
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            if row.label:
                self.title.get_style_context().add_class('label')
                line.pack_start(self.title, True, True, 0)
                menu.watch({'display': row.label, 'refresh': '5'}, 'display', self.title.set_text)
            controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, halign=Gtk.Align.END if row.label else Gtk.Align.CENTER)
            controls.get_style_context().add_class('controls')
            for control in row.controls:
                widget = menu.build_control(control, self)
                if widget is not None:
                    controls.pack_start(widget, False, False, 0)
            if self.opens_list:
                chevron = Gtk.Label(label='›')
                chevron.get_style_context().add_class('chevron')
                controls.pack_start(chevron, False, False, 0)
            line.pack_end(controls, not row.label, not row.label, 0)
            self.add(line)
            interactive = bool(self.buttons or self.switch or self.open_target)
            self.set_activatable(interactive)
            self.set_selectable(False)
            self.set_can_focus(interactive)
            if not interactive:
                self.get_style_context().add_class('info')

        def activate_row(self) -> None:
            if self.switch is not None:
                self.switch.set_active(not self.switch.get_active())
            elif len(self.buttons) == 1:
                self.buttons[0].clicked()
            elif self.open_target is not None:
                self.open_target()

        def adjust(self, step: int) -> None:
            if self.switch is not None:
                self.switch.set_active(step > 0)
            elif len(self.buttons) > 1:
                (self.buttons[0] if step < 0 else self.buttons[-1]).clicked()

    def row_list(css_class: str) -> Gtk.ListBox:
        rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        rows.get_style_context().add_class(css_class)
        rows.connect('row-activated', lambda _list, row: row.activate_row())
        return rows

    def hint(button: str, text: str) -> Gtk.Box:
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        try:
            key = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(str(help_icon(button)), HINT_ICON_PX, HINT_ICON_PX))
        except GLib.Error:
            key = Gtk.Label(label=button.upper())
        key.get_style_context().add_class('glyph')
        action = Gtk.Label(label=text)
        box.pack_start(key, False, False, 0)
        box.pack_start(action, False, False, 0)
        return box

    class QuickMenu(Gtk.Window):
        def __init__(self, menu: Menu) -> None:
            super().__init__(type=Gtk.WindowType.TOPLEVEL, title='HippOS quick menu')
            self.executor = ThreadPoolExecutor(max_workers=COMMAND_WORKERS)
            self.refreshers: list = []
            self.timers: list[int] = []
            self.inactivity_timer = 0
            self.armed_confirm: Gtk.Button | None = None
            self.confirm_labels: dict[Gtk.Button, str] = {}
            self.screen_height = selected_monitor().get_geometry().height
            self.reader = GamepadReader(self.on_button, self.on_hat)

            self.set_decorated(False)
            self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
            self.set_keep_above(True)
            self.set_skip_taskbar_hint(True)
            self.connect('key-press-event', self.on_key)
            self.connect('delete-event', lambda *_: self.hide_menu() or True)
            self.connect('size-allocate', self.round_corners)
            self.connect('set-focus', self.on_focus_change)

            self.pages = Gtk.Stack()
            self.pages.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
            self.choice_list = row_list('choices')
            self.choice_title = Gtk.Label(xalign=0)
            self.choice_title.get_style_context().add_class('choice-title')
            choice_scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            choice_scroller.add(self.choice_list)
            self.choice_list.set_focus_vadjustment(choice_scroller.get_vadjustment())
            choice_view = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            choice_view.pack_start(self.choice_title, False, False, 0)
            choice_view.pack_start(choice_scroller, True, True, 0)
            self.viewer = DocumentViewer(self.close_document)
            self.body = Gtk.Stack()
            self.body.get_style_context().add_class('body')
            self.body.add_named(self.pages, 'pages')
            self.body.add_named(choice_view, 'choices')
            self.body.add_named(self.viewer, 'document')
            self.picker = KeyPicker(self.pick_key)
            picker_hints = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, halign=Gtk.Align.CENTER)
            picker_hints.get_style_context().add_class('hints')
            for button, text in (('x', 'Add to combination'), ('y', 'Not mapped')):
                picker_hints.pack_start(hint(button, text), False, False, 0)
            self.picker.pack_end(picker_hints, False, False, 0)
            self.picker_action = ''
            self.picker_row: MenuRow | None = None
            self.body.add_named(self.picker, 'keys')

            self.tabs = Gtk.StackSwitcher(stack=self.pages, halign=Gtk.Align.CENTER)
            self.tabs.get_style_context().add_class('tabs')
            layout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            layout.get_style_context().add_class('quickmenu')
            header = self.build_static(menu.header, inline=False)
            header.get_style_context().add_class('header')
            footer = self.build_static(menu.footer, inline=True)
            footer.get_style_context().add_class('footer')
            hints = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, halign=Gtk.Align.CENTER)
            hints.get_style_context().add_class('hints')
            for button, text in ((ok_button, 'Select'), (back_button, 'Back'), ('lr', 'Tabs'), ('start', 'Close')):
                hints.pack_start(hint(button, text), False, False, 0)
            layout.pack_start(header, False, False, 0)
            layout.pack_start(self.tabs, False, False, 0)
            layout.pack_start(self.body, True, True, 0)
            layout.pack_end(hints, False, False, 0)
            layout.pack_end(footer, False, False, 0)
            self.add(layout)
            self.page_conditions: list[tuple[Gtk.Widget, str]] = []
            for page in menu.pages:
                rows = row_list('page')
                for row in page.rows:
                    self.add_row(rows, row)
                scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
                scroller.add(rows)
                rows.set_focus_vadjustment(scroller.get_vadjustment())
                self.pages.add_titled(scroller, page.title, page.title)
                if page.condition:
                    self.page_conditions.append((scroller, page.condition))
            for tab in self.tabs.get_children():
                tab.set_can_focus(False)
            self.reader.start()

        def round_corners(self, _window, allocation) -> None:
            import cairo
            radius = int(self.screen_height * CORNER_SHARE)
            width, height = allocation.width, allocation.height
            region = cairo.Region(cairo.RectangleInt(0, radius, width, max(0, height - 2 * radius)))
            for y in range(radius):
                inset = radius - int((radius * radius - (radius - y - 0.5) ** 2) ** 0.5)
                region.union(cairo.RectangleInt(inset, y, width - 2 * inset, 1))
                region.union(cairo.RectangleInt(inset, height - 1 - y, width - 2 * inset, 1))
            self.shape_combine_region(region)

        def run_async(self, function, done, *args) -> None:
            future = self.executor.submit(function, *args)
            future.add_done_callback(lambda result: GLib.idle_add(done, result.result()))

        def watch(self, attrs: dict[str, str], key: str, apply) -> None:
            text = attrs.get(key, '')
            command = expression_command(text)
            if command is None:
                apply(text)
                return

            def refresh() -> None:
                self.run_async(run_command, lambda output: apply(fill_expression(text, output)), command)
            self.refreshers.append((refresh, int(attrs.get('refresh', '0') or 0)))

        def add_row(self, rows: Gtk.ListBox, row: Row) -> None:
            line = MenuRow(self, row)
            rows.add(line)
            if row.condition:
                line.set_no_show_all(True)
                self.watch({'if': row.condition, 'refresh': '2'}, 'if',
                           lambda output, line=line: self.set_shown(line, bool(output.strip())))

        def build_static(self, rows: list[Row], inline: bool) -> Gtk.Box:
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL if inline else Gtk.Orientation.VERTICAL,
                          halign=Gtk.Align.CENTER if inline else Gtk.Align.FILL)
            for index, row in enumerate(rows):
                line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
                line.get_style_context().add_class('row')
                if not inline:
                    line.get_style_context().add_class('title' if index == 0 else 'subtitle')
                if row.label:
                    label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.NONE if inline else Pango.EllipsizeMode.END)
                    label.get_style_context().add_class('label')
                    line.pack_start(label, not inline, not inline, 0)
                    self.watch({'display': row.label, 'refresh': '5'}, 'display', label.set_text)
                controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
                for control in row.controls:
                    widget = self.build_control(control, None)
                    if widget is not None:
                        controls.pack_start(widget, False, False, 0)
                if inline:
                    line.pack_start(controls, False, False, 0)
                else:
                    line.pack_end(controls, not row.label, not row.label, 0)
                box.pack_start(line, False, False, 0)
                if row.condition:
                    line.set_no_show_all(True)
                    self.watch({'if': row.condition, 'refresh': '5'}, 'if',
                               lambda output, line=line: self.set_shown(line, bool(output.strip())))
            return box

        def set_shown(self, widget: Gtk.Widget, shown: bool) -> None:
            widget.set_no_show_all(not shown)
            if shown:
                widget.show_all()
            else:
                widget.hide()

        def build_control(self, control: Control, row: MenuRow | None):
            attrs = control.attrs
            kind = control.kind
            if kind == 'text':
                label = Gtk.Label(xalign=1, no_show_all=True)
                label.get_style_context().add_class('value')

                def set_value(output: str) -> None:
                    label.set_text(output)
                    label.set_visible(bool(output.strip()))
                self.watch(attrs, 'display', set_value)
                return label
            if kind == 'progressbar':
                bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER)
                low, high = float(attrs.get('min', 0)), float(attrs.get('max', 100))
                percent = Gtk.Label()
                percent.get_style_context().add_class('bar-value')

                def set_level(output: str) -> None:
                    try:
                        fraction = max(0.0, min(1.0, (float(output) - low) / (high - low)))
                    except ValueError:
                        fraction = 0.0
                    bar.set_fraction(fraction)
                    percent.set_text(f'{round(fraction * 100)}%')
                self.watch(attrs, 'display', set_level)
                if not is_true(attrs.get('showvalue', '')):
                    return bar
                bar.get_style_context().add_class('with-value')
                overlay = Gtk.Overlay(valign=Gtk.Align.CENTER)
                overlay.add(bar)
                overlay.add_overlay(percent)
                return overlay
            if kind in ('button', 'button_confirm'):
                button = Gtk.Button(label=attrs.get('display', ''), can_focus=False, valign=Gtk.Align.CENTER)
                button.get_style_context().add_class('pill')
                if kind == 'button_confirm':
                    button.get_style_context().add_class('danger')
                button.connect('clicked', self.on_action, attrs, kind == 'button_confirm')
                if row is not None:
                    row.buttons.append(button)
                return button
            if kind == 'switch':
                switch = Gtk.Switch(valign=Gtk.Align.CENTER, can_focus=False)
                self.watch(attrs, 'value', lambda output: switch.set_state(is_true(output)))
                switch.connect('state-set', self.on_switch, attrs)
                if row is not None:
                    row.switch = switch
                return switch
            if kind == 'choices':
                if row is not None:
                    row.open_target = lambda: self.open_choices(control, row.title.get_text())
                    row.opens_list = True
                return None
            if kind == 'keypicker':
                if row is not None:
                    row.open_target = lambda: self.open_keypicker(attrs, row)
                    row.opens_list = True
                return None
            if kind == 'choice_item':
                if row is not None:
                    row.open_target = lambda: self.pick_choice(attrs)
                return None
            if kind in ('img', 'qrcode'):
                image = Gtk.Image(no_show_all=True)
                image.get_style_context().add_class('art')
                height = height_pixels(attrs.get('height', ''), self.screen_height)
                self.watch(attrs, 'display', lambda location: self.load_image(image, location, height, kind == 'qrcode'))
                return image
            if kind == 'doc':
                location = {'value': ''}

                def set_location(output: str) -> None:
                    location['value'] = output.strip()
                    if row is not None:
                        self.set_shown(row, bool(location['value']))
                if row is not None:
                    row.set_no_show_all(True)
                    row.open_target = lambda: self.open_document(location['value'])
                    row.opens_list = True
                self.watch({'content': attrs.get('content', ''), 'refresh': attrs.get('refresh', '0')}, 'content',
                           set_location)
                return None
            return None

        def load_image(self, image: Gtk.Image, location: str, height: int, as_qrcode: bool) -> None:
            location = location.strip()
            if not location:
                image.hide()
                return

            def read() -> bytes | None:
                try:
                    return qrcode_png(location) if as_qrcode else image_bytes(location)
                except (OSError, ValueError):
                    return None

            def show(data: bytes | None) -> None:
                if data is None:
                    image.hide()
                    return
                try:
                    pixbuf = pixbuf_from_bytes(data)
                except GLib.Error:
                    image.hide()
                    return
                width = max(1, pixbuf.get_width() * height // max(1, pixbuf.get_height()))
                image.set_from_pixbuf(pixbuf.scale_simple(width, height, GdkPixbuf.InterpType.BILINEAR))
                image.show()
            self.run_async(read, show)

        def on_action(self, button: Gtk.Button, attrs: dict[str, str], confirm: bool) -> None:
            if confirm and self.armed_confirm is not button:
                self.disarm()
                self.armed_confirm = button
                self.confirm_labels[button] = attrs.get('display', '')
                button.set_label('Press again to confirm')
                button.get_style_context().add_class('armed')
                return
            if confirm:
                self.disarm()
            self.run_action(attrs.get('action', ''), attrs.get('afterclick', ''))

        def disarm(self) -> None:
            button = self.armed_confirm
            if button is None:
                return
            self.armed_confirm = None
            button.get_style_context().remove_class('armed')
            button.set_label(self.confirm_labels[button])

        def on_focus_change(self, _window, widget) -> None:
            if self.armed_confirm is not None and self.armed_confirm.get_ancestor(MenuRow) is not widget:
                self.disarm()

        def on_switch(self, switch: Gtk.Switch, state: bool, attrs: dict[str, str]) -> bool:
            self.run_action(attrs.get('action_on' if state else 'action_off', ''), attrs.get('afterclick', 'refresh'))
            switch.set_state(state)
            return True

        def open_choices(self, control: Control, title: str) -> None:
            self.choice_title.set_text(title.upper())
            static = [(choice.get('display', ''), choice.get('action', ''), choice.get('afterclick', 'refresh'))
                      for choice in control.choices]

            def collect() -> list[tuple[str, str, str]]:
                dynamic = []
                for source in control.sources:
                    dynamic += [(label, action, source.get('afterclick', 'refresh'))
                                for label, action in command_choices(source)]
                return dynamic
            self.run_async(collect, lambda dynamic: self.show_choices(static + dynamic))

        def show_choices(self, choices: list[tuple[str, str, str]]) -> None:
            for child in self.choice_list.get_children():
                self.choice_list.remove(child)
            for label, action, afterclick in choices:
                button = {'display': label, 'action': action, 'afterclick': afterclick}
                self.add_row(self.choice_list, Row(label, '', [Control('choice_item', button)]))
            if not choices:
                return
            self.choice_list.show_all()
            self.body.set_visible_child_name('choices')
            self.choice_list.get_children()[0].grab_focus()

        def open_keypicker(self, attrs: dict[str, str], row: MenuRow) -> None:
            self.picker_action = attrs.get('action', '')
            self.picker_row = row

            def show(current: str) -> None:
                self.body.set_visible_child_name('keys')
                self.picker.open(row.title.get_text(), [key for key in current.split() if key != 'none'])
            self.run_async(evaluate, show, attrs.get('display', ''))

        def pick_key(self, keys: list[str]) -> None:
            self.body.set_visible_child_name('pages')
            self.focus_focused_row()
            self.run_action(f"{self.picker_action} {' '.join(keys) or 'none'}", 'refresh')

        def focus_focused_row(self) -> None:
            if self.picker_row is not None and self.picker_row.get_visible():
                self.picker_row.grab_focus()
            else:
                self.focus_page()

        def pick_choice(self, attrs: dict[str, str]) -> None:
            self.body.set_visible_child_name('pages')
            self.focus_page()
            self.run_action(attrs['action'], attrs['afterclick'])

        def open_document(self, location: str) -> None:
            self.body.set_visible_child_name('document')
            self.viewer.open(location, self.body.get_allocated_height())

        def close_document(self) -> None:
            self.body.set_visible_child_name('pages')
            self.focus_page()

        def run_action(self, action: str, afterclick: str) -> None:
            if not action:
                return
            if afterclick == 'close':
                self.hide_menu()

            def after(_output: str) -> None:
                if afterclick == 'refresh':
                    self.refresh_all()
                elif afterclick == 'rescreen':
                    self.place_window()
            self.run_async(run_command, after, action)

        def refresh_all(self) -> None:
            for refresh, _interval in self.refreshers:
                refresh()

        def start_refreshing(self) -> None:
            self.refresh_all()
            for refresh, interval in self.refreshers:
                if interval > 0:
                    self.timers.append(GLib.timeout_add_seconds(interval, lambda refresh=refresh: refresh() or True))
            for page, condition in self.page_conditions:
                self.run_async(run_command, lambda output, page=page: self.set_page_visible(page, bool(output.strip())),
                               expression_command(condition) or condition)

        def set_page_visible(self, page: Gtk.Widget, visible: bool) -> None:
            page.set_visible(visible)
            focus = self.get_focus()
            if focus is None or not focus.is_drawable():
                self.focus_page()

        def stop_refreshing(self) -> None:
            for timer in self.timers:
                GLib.source_remove(timer)
            self.timers.clear()

        def reset_inactivity(self) -> None:
            if self.inactivity_timer:
                GLib.source_remove(self.inactivity_timer)
            self.inactivity_timer = GLib.timeout_add_seconds(INACTIVITY_CLOSE_S, self.on_inactive)

        def on_inactive(self) -> bool:
            self.inactivity_timer = 0
            if self.body.get_visible_child_name() == 'document':
                return False
            self.hide_menu()
            return False

        def place_window(self) -> None:
            area = selected_monitor().get_geometry()
            self.screen_height = area.height
            width, height = int(area.width * WIDTH_SHARE), int(area.height * HEIGHT_SHARE)
            self.set_size_request(width, height)
            self.resize(width, height)
            self.move(area.x + (area.width - width) // 2, area.y + (area.height - height) // 2)

        def show_menu(self) -> None:
            self.body.set_visible_child_name('pages')
            self.place_window()
            self.show_all()
            self.set_focus_visible(True)
            self.present()
            self.start_refreshing()
            self.reset_inactivity()
            GLib.idle_add(self.focus_page)
            GLib.timeout_add(GRAB_DELAY_MS, self.grab_controllers)

        def grab_controllers(self) -> bool:
            if self.get_visible():
                self.reader.set_grab(True)
            return False

        def current_rows(self) -> Gtk.ListBox | None:
            if self.body.get_visible_child_name() == 'choices':
                return self.choice_list
            page = self.pages.get_visible_child()
            return page.get_child().get_child() if page is not None else None

        def focus_page(self) -> bool:
            self.move_focus(0)
            return False

        def move_focus(self, step: int) -> None:
            rows = self.current_rows()
            if rows is None:
                return
            focusable = [row for row in rows.get_children() if row.get_visible() and row.get_can_focus()]
            if not focusable:
                return
            focus = self.get_focus()
            current = focusable.index(focus) if focus in focusable else -1
            if current < 0 or step == 0:
                target = focusable[0]
            else:
                target = focusable[max(0, min(len(focusable) - 1, current + step))]
            target.grab_focus()
            if target is focusable[0]:
                rows.get_focus_vadjustment().set_value(0)

        def adjust_focused(self, step: int) -> None:
            focus = self.get_focus()
            if isinstance(focus, MenuRow):
                focus.adjust(step)

        def activate_focused(self) -> None:
            focus = self.get_focus()
            if isinstance(focus, MenuRow):
                focus.activate_row()
            elif isinstance(focus, Gtk.Button) and self.body.get_visible_child_name() == 'keys':
                focus.clicked()

        def hide_menu(self) -> None:
            self.reader.set_grab(False)
            self.stop_refreshing()
            self.disarm()
            if self.inactivity_timer:
                GLib.source_remove(self.inactivity_timer)
                self.inactivity_timer = 0
            self.hide()

        def toggle(self) -> bool:
            self.hide_menu() if self.get_visible() else self.show_menu()
            return True

        def go_back(self) -> None:
            if self.body.get_visible_child_name() == 'keys':
                self.body.set_visible_child_name('pages')
                self.focus_focused_row()
            elif self.body.get_visible_child_name() == 'choices':
                self.body.set_visible_child_name('pages')
                self.focus_page()
            else:
                self.hide_menu()

        def switch_page(self, step: int) -> None:
            visible = [page for page in self.pages.get_children() if page.get_visible()]
            current = self.pages.get_visible_child()
            if current in visible:
                self.pages.set_visible_child(visible[(visible.index(current) + step) % len(visible)])
                self.focus_page()

        def navigate(self, direction: str) -> None:
            if self.body.get_visible_child_name() == 'keys':
                self.child_focus(getattr(Gtk.DirectionType, direction.upper()))
            elif direction in ('up', 'down'):
                self.move_focus(-1 if direction == 'up' else 1)
            else:
                self.adjust_focused(-1 if direction == 'left' else 1)

        def on_button(self, button: str, pressed: bool) -> bool:
            if not pressed or not self.get_visible():
                return False
            self.reset_inactivity()
            if self.body.get_visible_child_name() == 'document':
                if button in close_buttons:
                    self.hide_menu()
                else:
                    self.viewer.handle_button(button)
            elif button in ('up', 'down', 'left', 'right'):
                self.navigate(button)
            elif button == 'x' and self.body.get_visible_child_name() == 'keys':
                self.picker.toggle_focused()
            elif button == 'y' and self.body.get_visible_child_name() == 'keys':
                self.picker.clear()
            elif button == ok_button:
                self.activate_focused()
            elif button == back_button:
                self.go_back()
            elif button == 'pageup':
                self.switch_page(-1)
            elif button == 'pagedown':
                self.switch_page(1)
            elif button in close_buttons:
                self.hide_menu()
            return False

        def on_hat(self, code: int, value: int) -> bool:
            if not value or not self.get_visible():
                return False
            self.reset_inactivity()
            if self.body.get_visible_child_name() == 'document':
                self.viewer.handle_hat(code, value)
            else:
                self.navigate(hat_directions[(code, value)])
            return False

        def on_key(self, _window, event) -> bool:
            self.reset_inactivity()
            keys = {Gdk.KEY_Up: 'up', Gdk.KEY_Down: 'down', Gdk.KEY_Left: 'left', Gdk.KEY_Right: 'right'}
            if self.body.get_visible_child_name() != 'document' and event.keyval in keys:
                self.navigate(keys[event.keyval])
                return True
            if self.body.get_visible_child_name() == 'keys' and event.keyval in (Gdk.KEY_x, Gdk.KEY_Delete):
                self.picker.toggle_focused() if event.keyval == Gdk.KEY_x else self.picker.clear()
                return True
            if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
                self.activate_focused()
                return True
            if event.keyval == Gdk.KEY_Escape:
                self.close_document() if self.body.get_visible_child_name() == 'document' else self.go_back()
                return True
            if event.keyval in (Gdk.KEY_Page_Up, Gdk.KEY_Page_Down) and self.body.get_visible_child_name() == 'pages':
                self.switch_page(-1 if event.keyval == Gdk.KEY_Page_Up else 1)
                return True
            return False

    provider = Gtk.CssProvider()
    provider.load_from_path(str(first_existing(STYLE_FILES)))
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    window = QuickMenu(parse_menu(first_existing(MENU_FILES).read_text()))
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, window.toggle)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    window.show_menu()
    try:
        Gtk.main()
    finally:
        window.reader.set_grab(False)
        release(PID_FILE)
    return 0


def main(argv: list[str]) -> int:
    if argv == ['--run']:
        return run_menu()
    if not argv:
        toggle(PID_FILE, SCRIPT, ['--run'])
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
