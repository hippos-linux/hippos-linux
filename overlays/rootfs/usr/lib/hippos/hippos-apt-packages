#!/usr/bin/env python3
"""hippos-apt-packages — keep the user's apt installs across OS updates.

  hippos-apt-packages record   apt hook: write /userdata/system/apt-packages.list
  hippos-apt-packages boot     hippos-apt-restore.service: install whatever the OS update
                               could not put into the new system, then record
"""
from __future__ import annotations

import sys

from hippos_apt import (
    PRE_UPDATE_EXTENDED_STATES,
    PRE_UPDATE_STATUS,
    RESTORE_PENDING,
    USER_PACKAGES,
    image_packages,
    has_candidate,
    install_packages,
    installed_user_packages,
    missing_packages,
    pre_update_user_packages,
    recorded_user_packages,
    wait_for_network,
)

RETRY_SOON = 75

def record() -> int:
    image = image_packages()
    if image is None or not USER_PACKAGES.parent.is_dir():
        return 0
    packages = set(installed_user_packages(image))
    if RESTORE_PENDING.exists():
        packages.update(recorded_user_packages())
    tmp = USER_PACKAGES.with_suffix('.tmp')
    tmp.write_text(''.join(f'{p}\n' for p in sorted(packages)), encoding='utf-8')
    tmp.replace(USER_PACKAGES)
    return 0

def restore() -> int:
    packages = recorded_user_packages()
    if not packages and not USER_PACKAGES.exists():
        image = image_packages()
        if image is not None:
            packages = pre_update_user_packages(image)
    packages = missing_packages(packages)
    if packages:
        print('Waiting for a network connection to reinstall your apt packages', flush=True)
        wait_for_network()
        print(f'Reinstalling {len(packages)} apt package(s): {" ".join(packages)}', flush=True)
        updated, failed = install_packages(packages)
        if failed and not updated:
            print(f'Package lists could not be downloaded; retrying soon: {" ".join(failed)}', file=sys.stderr)
            return RETRY_SOON
        dropped = [p for p in failed if not has_candidate(p)]
        retried = [p for p in failed if p not in dropped]
        if dropped:
            print(f'No longer available from apt, dropped: {" ".join(dropped)}', file=sys.stderr)
        if retried:
            print(f'Could not be installed, retrying on the next boot: {" ".join(retried)}', file=sys.stderr)
            return 1
    RESTORE_PENDING.unlink(missing_ok=True)
    PRE_UPDATE_STATUS.unlink(missing_ok=True)
    PRE_UPDATE_EXTENDED_STATES.unlink(missing_ok=True)
    return 0

def main() -> int:
    match sys.argv[1:]:
        case ['record']:
            return record()
        case ['boot']:
            status = restore() if RESTORE_PENDING.exists() else 0
            record()
            return status
        case _:
            print(__doc__.strip(), file=sys.stderr)
            return 1

if __name__ == '__main__':
    sys.exit(main())
