# Lutris's art folders, box art first: a wide banner only fills a tile
# letterboxed. Lutris names its own art by game slug and a store's art by the
# store's slug or app ID.
ART_DIRS = [os.path.join(root, d) for root, dirs in (
    (LUTRIS_DATA,  ["coverart"]),
    (LUTRIS_CACHE, ["coverart", "steam/covers", "egs/game_box_tall",
                    "battlenet/coverart", "ubisoft/covers"]),
    (LUTRIS_DATA,  ["banners"]),
    (LUTRIS_CACHE, ["banners", "steam/header", "steam/banners", "gog/banners/large",
                    "gog/banners/medium", "egs/game_box", "amazon/banners",
                    "flathub/banners", "itchio/cover", "humblebundle/icons"]),
) for d in dirs]
ART_EXTS = (".jpg", ".png")

# Art within this fraction of a tile's aspect ratio is cropped to fill it.
CROP_TOLERANCE = 0.2
# Downscale factor that blurs letterbox and backdrop fills.
BLUR_FACTOR = 24
# Multiplier that darkens blurred fills so the art and text on them stand out.
BLUR_DARKEN = (90, 90, 90)


def scale_to_fill(image: pygame.Surface, w: int, h: int) -> pygame.Surface:
    iw, ih = image.get_size()
    scale = max(w / iw, h / ih)
    sw, sh = max(w, round(iw * scale)), max(h, round(ih * scale))
    scaled = pygame.transform.smoothscale(image, (sw, sh))
    return scaled.subsurface(((sw - w) // 2, (sh - h) // 2, w, h)).copy()


def blurred_fill(image: pygame.Surface, w: int, h: int) -> pygame.Surface:
    small = pygame.transform.smoothscale(
        scale_to_fill(image, w, h), (max(1, w // BLUR_FACTOR), max(1, h // BLUR_FACTOR)))
    surf = pygame.transform.smoothscale(small, (w, h))
    surf.fill(BLUR_DARKEN, special_flags=pygame.BLEND_MULT)
    return surf


def fit_art(image: pygame.Surface, w: int, h: int) -> pygame.Surface:
    iw, ih = image.get_size()
    if abs(iw / ih - w / h) <= CROP_TOLERANCE * (w / h):
        return scale_to_fill(image, w, h)
    tile = blurred_fill(image, w, h)
    scale = min(w / iw, h / ih)
    fw, fh = round(iw * scale), round(ih * scale)
    tile.blit(pygame.transform.smoothscale(image, (fw, fh)), ((w - fw) // 2, (h - fh) // 2))
    return tile


