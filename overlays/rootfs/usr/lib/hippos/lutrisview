# ── Look ──────────────────────────────────────────────────────────────────────
# LUTRISVIEW_THEME names an EmulationStation theme folder whose <variables>
# follow the HippOS theme's names; its colours, fonts and Lutris world art
# replace the Lutris look, so the view matches the frontend it opens from.
THEME_DIR = os.environ.get("LUTRISVIEW_THEME", "")


def theme_variables(theme_dir: str) -> Dict[str, str]:
    if not theme_dir:
        return {}
    try:
        variables = ET.parse(os.path.join(theme_dir, "theme.xml")).getroot().find("variables")
    except (OSError, ET.ParseError) as e:
        logging.warning("theme %s unreadable, using the Lutris look: %s", theme_dir, e)
        return {}
    return {v.tag: (v.text or "").strip() for v in variables} if variables is not None else {}


_THEME = theme_variables(THEME_DIR)


def theme_color(name: str, default: tuple) -> tuple:
    value = _THEME.get(name, "")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4)) if len(value) >= 6 else default


def theme_font(name: str) -> str:
    # pygame shrinks its default font when given None, so name its file.
    value = _THEME.get(name)
    return os.path.normpath(os.path.join(THEME_DIR, value)) if value else pygame.font.get_default_font()


def mix(a: tuple, b: tuple, t: float) -> tuple:
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def text_on(color: tuple) -> tuple:
    """Dark text on light fills, light text on dark ones."""
    r, g, b = color
    return BG if 0.299 * r + 0.587 * g + 0.114 * b > 140 else TEXT


