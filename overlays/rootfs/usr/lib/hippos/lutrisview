class LutrisGame:
    def __init__(self, data: dict):
        self.id         = data["id"]
        self.slug       = data["slug"]
        self.install_slug = data.get("install_slug") or ""
        self.name       = data["name"]
        self.playtime   = data.get("playtime") or 0.0
        # Lutris's playtime text reads "1 day, 16:12:00" past a day.
        self.playtime_secs: Optional[float] = data.get("playtimeSeconds")
        self.lastplayed = data.get("lastplayed") or ""
        self.runner     = data.get("runner") or ""
        self.platform   = data.get("platform") or ""
        self.year       = str(data.get("year") or "")
        self.service    = data.get("service") or ""
        self.appid      = str(data.get("appid") or "")
        self.installed  = bool(data.get("installed", True))
        # CLI provides coverPath directly; avoid re-scanning for installed games
        cover = data.get("coverPath") or None
        self._cover: Optional[str] = cover if (cover and os.path.exists(cover)) else None

    @property
    def cover_key(self) -> str:
        """Unique key for the covers cache — namespaced to avoid games/service_games ID collision."""
        if self.installed:
            return f"g{self.id}"
        return f"s{self.service}:{self.appid or self.id}"

    def find_cover(self):
        names = [n for n in dict.fromkeys((self.slug, self.install_slug, self.appid)) if n]
        for folder in ART_DIRS:
            for name in names:
                for ext in ART_EXTS:
                    p = os.path.join(folder, name + ext)
                    if os.path.exists(p):
                        self._cover = p
                        return

        if self.service in ("steam", "steamwindows") and self.appid:
            base = os.path.expanduser(
                f"~/.steam/steam/appcache/librarycache/{self.appid}/"
            )
            for name in ("library_600x900.jpg", "header.jpg"):
                p = os.path.join(base, name)
                if os.path.exists(p):
                    self._cover = p
                    return

    def cover_path(self) -> Optional[str]:
        if self._cover is None:
            self.find_cover()
        return self._cover

    def playtime_seconds(self) -> float:
        if self.playtime_secs is not None:
            return float(self.playtime_secs)
        if not self.playtime:
            return 0.0

        if isinstance(self.playtime, (int, float)):
            # Older Lutris JSON can expose playtime as hours.
            return float(self.playtime) * 3600.0

        value = str(self.playtime).strip()
        if not value:
            return 0.0

        # Newer Lutris can expose playtime as H:MM:SS.microseconds.
        try:
            parts = value.split(":")
            if len(parts) == 3:
                hours = int(parts[0])
                minutes = int(parts[1])
                seconds = float(parts[2])
                return hours * 3600.0 + minutes * 60.0 + seconds
            if len(parts) == 2:
                minutes = int(parts[0])
                seconds = float(parts[1])
                return minutes * 60.0 + seconds
            return float(value) * 3600.0
        except Exception:
            return 0.0

    def playtime_str(self) -> str:
        seconds = int(self.playtime_seconds())
        if seconds <= 0:
            return "Never played"
        h = seconds // 3600
        m = (seconds % 3600) // 60
        if h:
            return f"{h}h {m}m"
        return f"{m}m" if m else "<1m"

    def lastplayed_str(self) -> str:
        return str(self.lastplayed)[:10] if self.lastplayed else "—"

    def launch_uri(self) -> str:
        return f"lutris:rungameid/{self.id}"

    def install_uri(self) -> str:
        return f"lutris:{self.install_slug}" if self.install_slug else ""


def _infer_service(name: str, runner: str) -> str:
    """Guess store service from game name and runner when the DB has no service set."""
    if runner == "steam":
        return "steam"
    low = name.lower()
    for fragment, service in _NAME_HINTS:
        if fragment in low:
            return service
    return ""


def _enrich_service(games: List[LutrisGame]) -> None:
    """Backfill service field for installed games (not exposed by CLI).
    Strategy: DB service field → slug match in service_games → name heuristic."""
    import sqlite3 as _sqlite3
    db = PGA_DB
    if not os.path.exists(db):
        return
    try:
        conn = _sqlite3.connect(db)
        # 1. service from games table, keyed by game ID
        by_id = {row[0]: (row[1] or "", row[2] or "")   # id → (service, slug)
                 for row in conn.execute(
                     "SELECT id, service, slug FROM games WHERE installed = 1")}
        # 2. service_games slug → service (covers community-script-installed games)
        slug_to_service: Dict[str, str] = {}
        for row in conn.execute(
                "SELECT slug, lutris_slug, service FROM service_games "
                "WHERE service IS NOT NULL AND service != ''"):
            for col in (row[0], row[1]):
                if col:
                    slug_to_service.setdefault(col, row[2])
        conn.close()

        for g in games:
            if g.service:
                continue
            service, slug = by_id.get(g.id, ("", g.slug or ""))
            if service:
                g.service = service
                continue
            # Try slug cross-reference
            if slug and slug in slug_to_service:
                g.service = slug_to_service[slug]
                continue
            # Name/runner heuristic
            inferred = _infer_service(g.name, g.runner)
            if inferred:
                g.service = inferred
    except Exception as e:
        logging.error("_enrich_service failed: %s", e)


def fetch_games() -> List[LutrisGame]:
    """Fetch installed games via Lutris CLI, enriched with service info from DB."""
    try:
        r = subprocess.run(
            ["lutris", "--list-games", "--installed", "-j"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30,
        )
        if r.returncode == 0:
            games = [LutrisGame(g) for g in json.loads(r.stdout)]
            for g in games:
                g.installed = True
            _enrich_service(games)
            return games
        logging.error("lutris --list-games failed: %s", r.stderr.strip())
    except Exception as e:
        logging.error("fetch_games failed: %s", e)
    return []


_EXCLUDED_SERVICES = {"xdg"}


def fetch_store_games() -> Dict[str, List[LutrisGame]]:
    """Query service_games for all store-available games, excluding already-installed ones."""
    import sqlite3 as _sqlite3
    db = PGA_DB
    if not os.path.exists(db):
        return {}
    try:
        conn = _sqlite3.connect(db)
        conn.row_factory = _sqlite3.Row
        rows = conn.execute("""
            SELECT sg.id, sg.service, sg.appid, sg.name, sg.slug, sg.lutris_slug
            FROM service_games sg
            LEFT JOIN games g
                ON g.service = sg.service AND g.service_id = sg.appid AND g.installed = 1
            WHERE g.id IS NULL
              AND sg.name IS NOT NULL AND sg.name != ''
            ORDER BY sg.name
        """).fetchall()
        conn.close()
        grouped: Dict[str, List[LutrisGame]] = {}
        for row in rows:
            service = row["service"] or ""
            if service in _EXCLUDED_SERVICES:
                continue

            # Controller-only install mode needs a concrete Lutris installer slug.
            # Rows without lutris_slug are only "known store library" entries and would
            # force the user into Lutris' mouse/keyboard installer picker.
            installer_slug = row["lutris_slug"] or ""
            if not installer_slug:
                continue

            data = {
                "id":        row["id"],
                "name":      row["name"],
                "slug":      row["slug"] or installer_slug,
                "runner":    "",
                "service":   service,
                "install_slug": installer_slug,
                "appid":     row["appid"] or "",
                "installed": False,
                "playtime":  0,
                "lastplayed": "",
            }
            g = LutrisGame(data)
            grouped.setdefault(service, []).append(g)
        return grouped
    except Exception as e:
        logging.error("fetch_store_games failed: %s", e)
        return {}


