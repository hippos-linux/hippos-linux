#!/usr/bin/env bash
set -euo pipefail

source /usr/lib/hippos/pool-branch.sh

POOL=/userdata/bios
RW=/userdata/.bios-rw
OPTS="cache.files=off,dropcacheonclose=true,allow_other,use_ino,moveonenospc=false,category.create=mspmfs"
MEDIA=/media

log() { printf '[hippos-bios-pool] %s\n' "$*"; }

add_branch() {
    local branch="$1"
    [[ -d "${branch}" ]] || return 0
    [[ "${branch}" == "${RW}" || "${branch}" == "${POOL}" ]] && return 0
    [[ ":${branches}:" == *":${branch}="* ]] && return 0
    local mode
    mode="$(pool_branch_mode "${branch}")"
    if [[ "${mode}" == RW && "$(stat -c '%u' "${branch}" 2>/dev/null)" != "1000" ]]; then
        chown 1000:1000 "${branch}" 2>/dev/null || true
    fi
    branches="${branches}:${branch}=${mode}"
}

if findmnt "${POOL}" >/dev/null 2>&1; then
    log "already mounted at ${POOL}"
    exit 0
fi

mkdir -p "${RW}"
chown 1000:1000 "${RW}"
if [[ -d "${POOL}" && -n "$(ls -A "${POOL}" 2>/dev/null)" && -z "$(ls -A "${RW}" 2>/dev/null)" ]]; then
    log "migrating ${POOL} content to ${RW}"
    find "${POOL}" -mindepth 1 -maxdepth 1 -exec mv -t "${RW}" -- {} +
fi

mkdir -p "${POOL}"
chown 1000:1000 "${POOL}"

branches="${RW}=RW"
for dir in "${MEDIA}"/*/; do
    [[ -d "${dir}" ]] || continue
    add_branch "${dir%/}/bios"
    add_branch "${dir%/}/userdata/bios"

    while IFS= read -r -d '' bios_dir; do
        add_branch "${bios_dir}"
    done < <(find "${dir%/}" -mindepth 1 -maxdepth 2 -type d -iname bios -print0 2>/dev/null)
done

log "branches: ${branches}"

if mergerfs -o "${OPTS}" "${branches}" "${POOL}"; then
    log "mergerfs bios pool mounted at ${POOL}"
else
    log "mergerfs failed — bind-mounting ${RW} directly"
    mount --bind "${RW}" "${POOL}" || true
fi
