#!/usr/bin/env bash
# hippos-nvidia-legacy-resolve — tries NVIDIA's official legacy Linux driver
# branches, newest first, and installs the first one that actually binds
# the card. Only ever run in the background by hippos-gpu-init, after
# nvidia-open has already been probed and failed — never on the
# boot-critical path (see boot-flow.md: never block boot on internet
# access; this needs it, and a DKMS build can take minutes).
#
# Debian doesn't package any legacy branch for Trixie (confirmed against
# packages.debian.org — nvidia-legacy-390xx-driver and
# nvidia-legacy-340xx-driver both come back "not available in this
# suite"), which is exactly why a beta tester on old hardware had to hand-
# build one from Debian unstable sources. Pinning unstable as an APT
# source to get these is the standard "Debian Frankenstein" hazard — the
# resolver can pull unrelated unstable packages transitively even with
# pinning. NVIDIA's own installers are the same distribution channel
# HippOS already uses for nvidia-open, self-contained, and register with
# DKMS (--dkms) so the module rebuilds automatically on kernel updates.

set -uo pipefail

LOG="/var/log/hippos-gpu.log"
STATE="/var/lib/hippos/nvidia-driver-tier"
CACHE_DIR="/var/lib/hippos/nvidia-installers"
mkdir -p /var/log /var/lib/hippos "${CACHE_DIR}"

log() { printf '[hippos-nvidia-legacy] %s\n' "$*" | tee -a "${LOG}"; }

# tier:version:sha256 — newest branch first. Versions are each series'
# final release (all three branches are EOL, so these version numbers are
# permanent, not a moving target); checksums computed locally from the
# downloaded installers (NVIDIA doesn't publish sha256 for the older two).
TIERS=(
    "470:470.256.02:d6451862deb695bb0447f3b7cd6268f73e81168c10e2c10597ff3fa01349b1de"
    "390:390.157:5bebbca6e8fed5d6b9d81070fb9e351f18edc534952553cbdc71e8fd0b9b328a"
    "340:340.108:c671d4f1b7c09bc1af079b98b447adb06d704b04f802f7045a611fa50133b71b"
)

if [[ -f "${STATE}" ]]; then
    log "Already resolved ($(cat "${STATE}")) — nothing to do"
    exit 0
fi

nvidia_pci="$(lspci -mn 2>/dev/null \
    | awk '{ gsub("\"",""); if (($2~/030[0-2]/) && ($3=="10de"||$3=="12d2")) print $1 }')"
if [[ -z "${nvidia_pci}" ]]; then
    log "No NVIDIA GPU present — nothing to resolve"
    exit 0
fi

probe() {
    modprobe nvidia         2>>"${LOG}" || true
    modprobe nvidia-modeset 2>>"${LOG}" || true
    modprobe nvidia-drm     2>>"${LOG}" || true
    modprobe nvidia-uvm     2>>"${LOG}" || true
    local _i
    for _i in $(seq 1 40); do
        [[ -c /dev/nvidia0 ]] && return 0
        sleep 0.25
    done
    return 1
}

cleanup_failed_attempt() {
    local run_file="$1"
    "${run_file}" --uninstall --silent >>"${LOG}" 2>&1 || true
    modprobe -r nvidia-uvm nvidia-drm nvidia-modeset nvidia 2>>"${LOG}" || true
}

for entry in "${TIERS[@]}"; do
    tier="${entry%%:*}"
    rest="${entry#*:}"
    version="${rest%%:*}"
    expected_sha256="${rest#*:}"

    log "Trying legacy tier ${tier} (driver ${version})"
    run_file="${CACHE_DIR}/NVIDIA-Linux-x86_64-${version}.run"
    url="https://us.download.nvidia.com/XFree86/Linux-x86_64/${version}/NVIDIA-Linux-x86_64-${version}.run"

    if [[ ! -f "${run_file}" ]]; then
        log "Downloading ${url}"
        if ! curl -fsSL --max-time 600 -o "${run_file}.tmp" "${url}" 2>>"${LOG}"; then
            log "Download failed for ${version} — trying next tier"
            rm -f "${run_file}.tmp"
            continue
        fi
        mv "${run_file}.tmp" "${run_file}"
    fi

    actual_sha256="$(sha256sum "${run_file}" | awk '{print $1}')"
    if [[ "${actual_sha256}" != "${expected_sha256}" ]]; then
        log "WARNING: checksum mismatch for ${version} (got ${actual_sha256}) — refusing to run it, trying next tier"
        rm -f "${run_file}"
        continue
    fi

    chmod +x "${run_file}"
    log "Installing ${version} (--dkms, non-interactive)"
    if ! "${run_file}" --silent --dkms --no-questions --disable-nouveau >>"${LOG}" 2>&1; then
        log "Installer for ${version} failed — trying next tier"
        cleanup_failed_attempt "${run_file}"
        continue
    fi

    printf 'blacklist nouveau\noptions nouveau modeset=0\n' \
        > /etc/modprobe.d/hippos-nvidia-blacklist.conf
    printf 'options nvidia-drm modeset=1\n' \
        > /etc/modprobe.d/hippos-nvidia-drm.conf

    if probe; then
        log "${tier} (${version}) works for ${nvidia_pci} — resolved, takes effect fully on next boot"
        echo "${tier}" > "${STATE}"
        exit 0
    fi

    log "${version} installed but did not bind ${nvidia_pci} — not supported, trying next tier"
    cleanup_failed_attempt "${run_file}"
    rm -f /etc/modprobe.d/hippos-nvidia-blacklist.conf /etc/modprobe.d/hippos-nvidia-drm.conf
done

log "No legacy tier supports ${nvidia_pci} — resolving to nouveau"
echo "nouveau" > "${STATE}"
