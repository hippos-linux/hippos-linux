#!/usr/bin/env python3
from __future__ import annotations

import sqlite3
from pathlib import Path

from hippos_flatpak_metadata import read_share_details
from hippos_launcher_sync import CLIENT_ENTRY, GameMetadata, reload_es, sync_gamelist, sync_launchers

USERDATA   = Path('/userdata')
DATA_DIR   = USERDATA / '.local' / 'share' / 'lutris'
CACHE_DIR  = USERDATA / '.cache' / 'lutris'
PGA_DB     = DATA_DIR / 'pga.db'
ROMS_DIR   = USERDATA / 'roms' / 'lutris'
STATE_FILE = USERDATA / 'system' / 'lutris-launchers.json'
ART_DIRS = tuple(root / kind for kind in ('coverart', 'banners') for root in (CACHE_DIR, DATA_DIR))
LUTRIS_APP_ID = 'net.lutris.Lutris'

def log(message: str) -> None:
    print(f'[hippos-lutris-sync] {message}', flush=True)

def installed_games() -> dict[str, tuple[str, str]]:
    if not PGA_DB.exists():
        return {}
    with sqlite3.connect(f'file:{PGA_DB}?mode=ro', uri=True, timeout=10) as db:
        rows = db.execute('SELECT id, name, slug FROM games WHERE installed = 1').fetchall()
    return {str(game_id): (name or f'Lutris game {game_id}', slug or '') for game_id, name, slug in rows}

def artwork(slug: str) -> Path | None:
    for directory in ART_DIRS:
        for suffix in ('.jpg', '.png'):
            path = directory / f'{slug}{suffix}'
            if slug and path.is_file():
                return path
    return None

def sync() -> int:
    games = installed_games()
    names = {CLIENT_ENTRY: 'Lutris', **{game_id: name for game_id, (name, _) in games.items()}}
    created, updated, removed = sync_launchers(ROMS_DIR, STATE_FILE, '.lutris', names, 'Lutris Game')

    own = read_share_details(Path('/usr/share'), LUTRIS_APP_ID)
    details = {CLIENT_ENTRY: GameMetadata('Lutris', own.description, own.developer, own.icon)}
    details.update({game_id: GameMetadata(name, image=artwork(slug)) for game_id, (name, slug) in games.items()})
    details_changed = sync_gamelist(ROMS_DIR, STATE_FILE, '.lutris', details)

    log(f'found={len(games)} created={created} updated={updated} removed={removed} details_changed={details_changed}')
    if created or updated or removed or details_changed:
        reload_es()
    return 0

if __name__ == '__main__':
    raise SystemExit(sync())
