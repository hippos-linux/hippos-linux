#!/usr/bin/env bash
set -euo pipefail

source /usr/lib/hippos/pool-branch.sh

POOL=/userdata/roms
RW=/userdata/.roms-rw
OPTS="cache.files=off,dropcacheonclose=true,allow_other,use_ino,moveonenospc=false"
MEDIA=/media
EXTERNAL_ROMS=/userdata/system/configs/hippos/external-roms.conf

log() { printf '[hippos-roms-pool] %s\n' "$*"; }

is_rom_root() {
    local root="$1"
    [[ -d "${root}" ]] || return 1

    local system
    for system in \
        3do arcade atomiswave dreamcast fbneo gamecube gba gbc genesis mame \
        mastersystem megadrive model2 model3 n64 naomi nds neogeo nes ps2 ps3 \
        psp psx saturn sega32x snes switch tg16 wii wiiu xbox xbox360; do
        [[ -d "${root}/${system}" ]] && return 0
    done

    [[ -f "${root}/gamelist.xml" ]]
}

add_branch() {
    local branch="$1"
    [[ -d "${branch}" ]] || return 0
    [[ "$(findmnt -n -o TARGET -T "${branch}" 2>/dev/null)" == "${MEDIA}"/* ]] || return 0
    [[ "${branch}" == "${RW}" || "${branch}" == "${POOL}" ]] && return 0
    [[ ":${branches}:" == *":${branch}="* ]] && return 0
    local mode
    mode="$(pool_branch_mode "${branch}")"
    if [[ "${mode}" == RW && "$(stat -c '%u' "${branch}" 2>/dev/null)" != "1000" ]]; then
        chown 1000:1000 "${branch}" 2>/dev/null || true
    fi
    branches="${branches}:${branch}=${mode}"
}

if findmnt "${POOL}" >/dev/null 2>&1; then
    log "already mounted at ${POOL}"
    exit 0
fi

mkdir -p "${RW}"
chown 1000:1000 "${RW}"
if [[ -d "${POOL}" && -n "$(ls -A "${POOL}" 2>/dev/null)" && -z "$(ls -A "${RW}" 2>/dev/null)" ]]; then
    log "migrating ${POOL} content to ${RW}"
    find "${POOL}" -mindepth 1 -maxdepth 1 -exec mv -t "${RW}" -- {} +
    chown -R 1000:1000 "${RW}"
fi

find "${RW}" -mindepth 2 -maxdepth 2 -name gamelist.xml ! -user 1000 -exec chown 1000:1000 {} +

mkdir -p "${POOL}"
chown 1000:1000 "${POOL}"

branches="${RW}=RW"

if [[ -f "${EXTERNAL_ROMS}" ]]; then
    while IFS= read -r line; do
        [[ -z "${line}" || "${line}" == '#'* ]] && continue
        add_branch "${line}"
    done < "${EXTERNAL_ROMS}"
fi

for dir in "${MEDIA}"/*/; do
    case "$(findmnt -n -o FSTYPE "${dir%/}" 2>/dev/null)" in
        nfs|nfs4|cifs|smb3) ;;
        *) continue ;;
    esac

    add_branch "${dir%/}/roms"
    add_branch "${dir%/}/userdata/roms"

    if is_rom_root "${dir%/}"; then
        add_branch "${dir%/}"
    fi

    while IFS= read -r -d '' roms_dir; do
        add_branch "${roms_dir}"
    done < <(find "${dir%/}" -mindepth 1 -maxdepth 2 -type d -iname roms -print0 2>/dev/null)
done

log "branches: ${branches}"

if mergerfs -o "${OPTS}" "${branches}" "${POOL}"; then
    log "mergerfs pool mounted at ${POOL}"
    find "${POOL}" -mindepth 1 -maxdepth 1 -type d | while read -r d; do
        rw_dir="${RW}/$(basename "${d}")"
        if [[ ! -d "${rw_dir}" ]]; then
            mkdir -p "${rw_dir}"
            chown 1000:1000 "${rw_dir}"
        fi
    done
    /usr/lib/hippos/hippos-merge-gamelists || true
else
    log "mergerfs failed — bind-mounting ${RW} directly"
    mount --bind "${RW}" "${POOL}" || true
fi
