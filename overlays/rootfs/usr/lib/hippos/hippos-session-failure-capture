#!/usr/bin/env bash
# hippos-session-failure-capture — targeted diagnostics for hippos-es.service/
# hippos-desktop.service failing, invoked via those units' own OnFailure=.
#
# capture-boot-logs runs once per boot, close to boot time — it can't see a
# session dying later (mode switch, exiting a game, hours into a session),
# and by the time a user manages to report one of those, the machine has
# often already been rebooted. This runs at the moment of failure instead,
# writes into that same boot's capture-boot-logs directory so it rides along
# with the existing upload/retention path (see hippos-upload-logs,
# capture-boot-logs' own LOG_RETENTION_COUNT pruning), and stays small and
# bounded rather than a second copy of the full boot sweep.
set -uo pipefail

UNIT="${1:?failed unit name required}"
LOG_DIR=/userdata/system/logs/boot
BOOT_ID="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || date +%s)"
OUT_DIR="${LOG_DIR}/${BOOT_ID}"
mkdir -p "${OUT_DIR}"
ln -sfn "${OUT_DIR}" "${LOG_DIR}/latest"

OUT="${OUT_DIR}/session-failure-${UNIT}-$(date +%H%M%S).txt"

{
    echo "===== HippOS session failure: ${UNIT} ====="
    date --iso-8601=seconds
    echo

    echo "----- unit status -----"
    systemctl status "${UNIT}" --no-pager -l 2>&1
    echo

    echo "----- graphical.target -----"
    systemctl is-active graphical.target 2>&1
    echo

    echo "----- session units -----"
    for u in hippos-session.service hippos-es.service hippos-desktop.service hippos-xserver.service; do
        printf '%-28s %s\n' "${u}" "$(systemctl is-active "${u}" 2>&1)"
    done
    echo

    echo "----- X server -----"
    [[ -S /tmp/.X11-unix/X0 ]] && echo "/tmp/.X11-unix/X0: present" || echo "/tmp/.X11-unix/X0: MISSING"
    pgrep -a Xorg 2>&1 || echo "(no Xorg process)"
    echo

    echo "----- VT ownership -----"
    fgconsole 2>&1 || cat /sys/class/tty/tty0/active 2>&1 || echo "(could not determine active VT)"
    echo

    echo "----- DRM master -----"
    for f in /sys/kernel/debug/dri/*/master; do
        [[ -f "${f}" ]] && echo "${f}: $(cat "${f}" 2>&1)"
    done
    echo

    echo "----- loginctl sessions -----"
    loginctl list-sessions --no-pager 2>&1
    echo

    echo "----- ${UNIT} recent journal -----"
    journalctl -u "${UNIT}" -n 100 --no-pager 2>&1
    echo

    echo "----- system journal around this failure (last 200 lines) -----"
    journalctl -n 200 --no-pager 2>&1
} > "${OUT}" 2>&1
