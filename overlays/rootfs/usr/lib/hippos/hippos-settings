#!/bin/sh
# Usage: hippos-settings get <key> | set <key> <value> | del <key> | list | dump | sync
#        hippos-settings-get <key>, hippos-settings-set <key> <value>

USER_CONF=/userdata/system/hippos.conf
HW_DEFAULTS=/run/hippos/hardware-defaults.conf
DEFAULTS_CONF=/usr/share/hippos/hippos-defaults.conf

case "${0##*/}" in
    hippos-settings-get) set -- get "$@" ;;
    hippos-settings-set) set -- set "$@" ;;
esac

if [ "$1" != get ] || [ "$#" -ne 2 ]; then
    exec python3 /usr/lib/hippos/hippos_settings.py "$@"
fi

key="$2"
set --
for conf in "${DEFAULTS_CONF}" "${HW_DEFAULTS}" "${USER_CONF}"; do
    [ -r "${conf}" ] && set -- "$@" "${conf}"
done
[ "$#" -gt 0 ] || exit 1

exec awk -v key="${key}" '
    function trim(s) { sub(/^[ \t\r\f\v]+/, "", s); sub(/[ \t\r\f\v]+$/, "", s); return s }
    {
        line = trim($0)
        if (line == "" || substr(line, 1, 1) == "#") next
        eq = index(line, "=")
        if (eq && trim(substr(line, 1, eq - 1)) == key) { value = trim(substr(line, eq + 1)); found = 1 }
    }
    END { if (found) print value; exit !found }
' "$@"
