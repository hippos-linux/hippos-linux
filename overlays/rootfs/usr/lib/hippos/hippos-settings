#!/usr/bin/env python3
"""hippos-settings — unified HippOS settings backend.

Commands:
  get <key>           print effective value (resolution order below)
  set <key> <value>   write to user conf
  del <key>           remove from user conf
  list                print all effective key=value pairs
  dump                print user conf only

Also callable as hippos-settings-get / hippos-settings-set via symlinks.

Resolution order (highest to lowest):
  /userdata/system/hippos.conf          user settings
  /run/hippos/hardware-defaults.conf    hardware profile defaults (written at boot)
  /usr/share/hippos/hippos-defaults.conf  OS defaults
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

USER_CONF      = Path('/userdata/system/hippos.conf')
HW_DEFAULTS    = Path('/run/hippos/hardware-defaults.conf')
DEFAULTS_CONF  = Path('/usr/share/hippos/hippos-defaults.conf')

_USAGE = 'Usage: hippos-settings get <key> | set <key> <value> | del <key> | list | dump'


def _parse(path: Path) -> dict[str, str]:
    result: dict[str, str] = {}
    if not path.exists():
        return result
    try:
        for line in path.read_text(encoding='utf-8').splitlines():
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if '=' in line:
                k, _, v = line.partition('=')
                result[k.strip()] = v.strip()
    except OSError:
        pass
    return result


def _write(path: Path, data: dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix('.tmp')
    tmp.write_text(''.join(f'{k}={v}\n' for k, v in sorted(data.items())), encoding='utf-8')
    tmp.replace(path)


def cmd_get(key: str) -> int:
    for src in (USER_CONF, HW_DEFAULTS, DEFAULTS_CONF):
        data = _parse(src)
        if key in data:
            print(data[key])
            return 0
    return 1


def cmd_set(key: str, value: str) -> int:
    data = _parse(USER_CONF)
    data[key] = value
    _write(USER_CONF, data)
    return 0


def cmd_del(key: str) -> int:
    data = _parse(USER_CONF)
    if key in data:
        del data[key]
        _write(USER_CONF, data)
    return 0


def cmd_list() -> int:
    merged = {**_parse(DEFAULTS_CONF), **_parse(HW_DEFAULTS), **_parse(USER_CONF)}
    for k, v in sorted(merged.items()):
        print(f'{k}={v}')
    return 0


def cmd_dump() -> int:
    for k, v in sorted(_parse(USER_CONF).items()):
        print(f'{k}={v}')
    return 0


def main() -> int:
    name = os.path.basename(sys.argv[0])
    args = sys.argv[1:]

    if name == 'hippos-settings-get':
        if len(args) == 1:
            return cmd_get(args[0])
        print(f'Usage: {name} <key>', file=sys.stderr)
        return 1

    if name == 'hippos-settings-set':
        if len(args) == 2:
            return cmd_set(args[0], args[1])
        print(f'Usage: {name} <key> <value>', file=sys.stderr)
        return 1

    if not args:
        print(_USAGE, file=sys.stderr)
        return 1

    cmd, *rest = args
    if cmd == 'get' and len(rest) == 1:
        return cmd_get(rest[0])
    if cmd == 'set' and len(rest) == 2:
        return cmd_set(rest[0], rest[1])
    if cmd == 'del' and len(rest) == 1:
        return cmd_del(rest[0])
    if cmd == 'list' and not rest:
        return cmd_list()
    if cmd == 'dump' and not rest:
        return cmd_dump()

    print(_USAGE, file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
