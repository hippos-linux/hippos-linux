#!/usr/bin/env python3
"""HippOS bezel project manager — installs system bezels from The Bezel Project."""

import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request

DECORATIONS_DIR = "/userdata/decorations"
STATE_FILE = "/userdata/system/hippos-store/bezels.json"

SYSTEMS = [
    ("NES",            "NES",         "nes"),
    ("SNES",           "SNES",        "snes"),
    ("MegaDrive",      "MegaDrive",   "megadrive"),
    ("GBA",            "GBA",         "gba"),
    ("GBC",            "GBC",         "gbc"),
    ("GB",             "GB",          "gb"),
    ("MasterSystem",   "MasterSystem","mastersystem"),
    ("GameGear",       "GameGear",    "gamegear"),
    ("N64",            "N64",         "n64"),
    ("PSX",            "PSX",         "psx"),
    ("PS2",            "PS2",         "ps2"),
    ("Dreamcast",      "Dreamcast",   "dreamcast"),
    ("MAME",           "MAME",        "mame"),
    ("FBA",            "FBA",         "fba"),
    ("Atari2600",      "Atari2600",   "atari2600"),
    ("Atari7800",      "Atari7800",   "atari7800"),
    ("ScummVM",        "ScummVM",     "scummvm"),
]

BASE_URL = "https://github.com/thebezelproject/bezelproject-{repo}/archive/refs/heads/master.tar.gz"


def load_state():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE) as f:
            return json.load(f)
    return {}


def save_state(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)


def cmd_list():
    state = load_state()
    for repo, _, system_id in SYSTEMS:
        installed = system_id in state
        prefix = "[I]" if installed else "[A]"
        url = BASE_URL.format(repo=repo)
        dest = os.path.join(DECORATIONS_DIR, "thebezelproject", system_id)
        print(f"{prefix} {system_id} {url} {dest}")


def cmd_install(system_id):
    entry = next(((r, s) for r, _, s in SYSTEMS if s == system_id), None)
    if entry is None:
        print(f"ERROR: Unknown system '{system_id}'", flush=True)
        sys.exit(1)

    repo, _ = entry
    url = BASE_URL.format(repo=repo)
    dest = os.path.join(DECORATIONS_DIR, "thebezelproject", system_id)
    os.makedirs(dest, exist_ok=True)

    print(f"Downloading bezels for {system_id}...", flush=True)
    req = urllib.request.Request(url, headers={"User-Agent": "hippos-bezelproject/1.0"})
    with tempfile.NamedTemporaryFile(suffix=".tar.gz", delete=False) as tmp:
        with urllib.request.urlopen(req, timeout=60) as resp:
            total = int(resp.headers.get("Content-Length", 0))
            done = 0
            while chunk := resp.read(131072):
                tmp.write(chunk)
                done += len(chunk)
                if total:
                    print(f"Downloading... {done * 100 // total}%", flush=True)
        archive = tmp.name

    print("Extracting...", flush=True)
    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            with tarfile.open(archive) as tf:
                members = []
                for m in tf.getmembers():
                    parts = m.name.split("/", 1)
                    if len(parts) < 2 or not parts[1]:
                        continue
                    m.name = parts[1]
                    members.append(m)
                tf.extractall(tmpdir, members=members)
        except tarfile.CompressionError:
            subprocess.run(["tar", "-xf", archive, "--strip-components=1", "-C", tmpdir], check=True)

        for item in os.listdir(tmpdir):
            s = os.path.join(tmpdir, item)
            d = os.path.join(dest, item)
            if os.path.isdir(s):
                if os.path.exists(d):
                    shutil.rmtree(d)
                shutil.copytree(s, d)
            else:
                shutil.copy2(s, d)

    os.unlink(archive)

    state = load_state()
    state[system_id] = {"repo": repo}
    save_state(state)
    print(f"Done: bezels for {system_id} installed to {dest}", flush=True)


def cmd_remove(system_id):
    dest = os.path.join(DECORATIONS_DIR, "thebezelproject", system_id)
    if os.path.isdir(dest):
        print(f"Removing {dest}...", flush=True)
        shutil.rmtree(dest)
    state = load_state()
    state.pop(system_id, None)
    save_state(state)
    print(f"Done: bezels for {system_id} removed.", flush=True)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "list":
        cmd_list()
    elif cmd == "install" and len(sys.argv) >= 3:
        cmd_install(sys.argv[2])
    elif cmd == "remove" and len(sys.argv) >= 3:
        cmd_remove(sys.argv[2])
    else:
        print("Usage: hippos-bezelproject <list|install SYSTEM|remove SYSTEM>")
        sys.exit(1)
