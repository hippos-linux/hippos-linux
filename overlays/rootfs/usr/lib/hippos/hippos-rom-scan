#!/usr/bin/env bash
set -euo pipefail

POOL=/userdata/roms

log() { printf '[hippos-rom-scan] %s\n' "$*"; }

# Rebuild the mergerfs pool to reflect current mount state
if findmnt "${POOL}" >/dev/null 2>&1; then
    umount "${POOL}" 2>/dev/null || true
fi

/usr/lib/hippos/mount-roms-pool
if command -v /usr/lib/hippos/hippos-storage-manager >/dev/null 2>&1; then
    /usr/lib/hippos/hippos-storage-manager scan --roots /userdata/roms /userdata/saves /userdata/system/cache >/dev/null 2>&1 || true
fi
log "pool rebuilt"
