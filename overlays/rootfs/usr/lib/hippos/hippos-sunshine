#!/usr/bin/env bash

command -v sunshine >/dev/null || { echo "hippos-sunshine: sunshine is not installed" >&2; exit 1; }

systemctl --user import-environment DISPLAY XAUTHORITY WAYLAND_DISPLAY XDG_RUNTIME_DIR 2>/dev/null
systemctl --user add-wants default.target sunshine.service >/dev/null 2>&1
systemctl --user start sunshine.service

python3 -c 'import sys; sys.path.insert(0, "/usr/lib/hippos"); import hippos_webapps; hippos_webapps.ensure_chromium()' || exit 1

profile=/userdata/system/webapps/profiles/sunshine
mkdir -p "${profile}"

for _ in $(seq 30); do
    curl -sk -o /dev/null https://localhost:47990 && break
    sleep 1
done

exec chromium --app=https://localhost:47990 --kiosk --user-data-dir="${profile}" \
    --ignore-certificate-errors --no-first-run --no-default-browser-check
