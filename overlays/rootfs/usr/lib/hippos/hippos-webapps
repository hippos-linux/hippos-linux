#!/usr/bin/env python3
"""hippos-webapps - websites as apps in ES's Linux Apps system and the desktop menu.

  hippos-webapps add --url URL [--name NAME] [--icon ICON_URL] [--description TEXT]
  hippos-webapps remove --url URL
  hippos-webapps list
  hippos-webapps sync
  hippos-webapps dialog [--window]   form to add a web app; --window on the desktop
  hippos-webapps import-mint         take over web apps made with Linux Mint's Web App Manager
"""

from __future__ import annotations

import argparse
import subprocess
import sys
import threading

import hippos_webapps

INK = '#0D0A1C'
FIELD = '#1B1730'
PURPLE = '#7B3FFF'
TEXT = '#F4F1FF'
MUTED = '#8F88AE'

DESIGN_WIDTH = 1920
MIN_SCALE = 0.5


def style(scale: float) -> str:
    def px(size: int) -> str:
        return f'{max(1, round(size * scale))}px'
    return f"""
window {{ background-color: {INK}; }}
label {{ color: {TEXT}; font-family: Sora; }}
label.title {{ font-size: {px(44)}; font-weight: 800; }}
label.hint {{ color: {MUTED}; font-size: {px(22)}; }}
label.field {{ font-size: {px(26)}; font-weight: 600; }}
entry {{ background: {FIELD}; color: {TEXT}; caret-color: {TEXT}; font-family: Sora; font-size: {px(30)};
         border: 2px solid {FIELD}; border-radius: {px(14)}; padding: {px(14)} {px(18)}; min-width: {px(900)}; }}
entry:focus {{ border-color: {PURPLE}; }}
button {{ background: {FIELD}; color: {TEXT}; font-family: Sora; font-size: {px(28)}; font-weight: 600;
          border: none; border-radius: {px(14)}; padding: {px(14)} {px(40)}; }}
button.primary {{ background: {PURPLE}; }}
button:hover {{ background: #2C2452; }}
button.primary:hover {{ background: #9466FF; }}
"""


def run_dialog(fullscreen: bool) -> int:
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import GLib, Gtk, Gdk

    monitor = Gdk.Display.get_default().get_monitor(0).get_geometry()
    scale = min(1.0, max(MIN_SCALE, monitor.width / DESIGN_WIDTH))
    provider = Gtk.CssProvider()
    provider.load_from_data(style(scale).encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    window = Gtk.Window(title='Add a web app')
    if fullscreen:
        window.fullscreen()
    else:
        window.set_position(Gtk.WindowPosition.CENTER)
        window.set_border_width(round(40 * scale))
    window.connect('destroy', Gtk.main_quit)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=round(22 * scale), halign=Gtk.Align.CENTER,
                  valign=Gtk.Align.CENTER)
    window.add(box)

    def label(text: str, style: str) -> Gtk.Label:
        widget = Gtk.Label(label=text, xalign=0)
        widget.get_style_context().add_class(style)
        box.pack_start(widget, False, False, 0)
        return widget

    label('Add a web app', 'title')
    label('Any website as an app with its own sign-in.', 'hint')
    label('Address', 'field')
    url_entry = Gtk.Entry(placeholder_text='www.example.com')
    box.pack_start(url_entry, False, False, 0)
    label('Name', 'field')
    name_entry = Gtk.Entry(placeholder_text='Shown in Linux Apps and the desktop menu')
    box.pack_start(name_entry, False, False, 0)
    status = label('', 'hint')

    buttons = Gtk.Box(spacing=round(20 * scale), halign=Gtk.Align.END)
    cancel = Gtk.Button(label='Cancel')
    save = Gtk.Button(label='Add')
    save.get_style_context().add_class('primary')
    buttons.pack_start(cancel, False, False, 0)
    buttons.pack_start(save, False, False, 0)
    box.pack_start(buttons, False, False, round(10 * scale))

    def finished(error: str) -> bool:
        if error:
            status.set_text(error)
            save.set_sensitive(True)
        else:
            window.destroy()
        return False

    def work(name: str, url: str) -> None:
        try:
            hippos_webapps.add(name, url)
            GLib.idle_add(finished, '')
        except subprocess.CalledProcessError:
            GLib.idle_add(finished, 'Could not install Chromium. Check the network and try again.')
        except OSError as exc:
            GLib.idle_add(finished, f'Could not add it: {exc}')

    def on_save(_button: Gtk.Button) -> None:
        url = url_entry.get_text().strip()
        if not url:
            status.set_text('Enter an address first.')
            return
        save.set_sensitive(False)
        status.set_text('Adding… this can take a minute the first time (Chromium is installed).')
        threading.Thread(target=work, args=(name_entry.get_text(), url), daemon=True).start()

    save.connect('clicked', on_save)
    cancel.connect('clicked', lambda _button: window.destroy())
    url_entry.connect('activate', lambda _entry: name_entry.grab_focus())
    name_entry.connect('activate', on_save)

    window.show_all()
    url_entry.grab_focus()
    Gtk.main()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog='hippos-webapps', description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest='command', required=True)
    add = commands.add_parser('add')
    add.add_argument('--url', required=True)
    add.add_argument('--name', default='')
    add.add_argument('--icon', default='')
    add.add_argument('--description', default='')
    remove = commands.add_parser('remove')
    remove.add_argument('--url', required=True)
    commands.add_parser('list')
    commands.add_parser('sync')
    dialog = commands.add_parser('dialog')
    dialog.add_argument('--window', action='store_true')
    commands.add_parser('import-mint')
    args = parser.parse_args()

    if args.command == 'add':
        app = hippos_webapps.add(args.name, args.url, args.icon, args.description)
        print(f'Added {app.name}: {app.url}')
    elif args.command == 'remove':
        if not hippos_webapps.remove(args.url):
            print(f'No web app for {args.url}', file=sys.stderr)
            return 1
    elif args.command == 'list':
        for app in hippos_webapps.load_webapps():
            print(f'{app.name}\t{app.url}')
    elif args.command == 'sync':
        hippos_webapps.sync()
    elif args.command == 'import-mint':
        print(f'Imported {hippos_webapps.import_mint_webapps()} web app(s)')
    else:
        return run_dialog(fullscreen=not args.window)
    return 0


if __name__ == '__main__':
    sys.exit(main())
