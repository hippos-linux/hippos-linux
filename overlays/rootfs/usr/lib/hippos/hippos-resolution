#!/usr/bin/env bash
export DISPLAY="${DISPLAY:-:0}"

XRANDR_STATE=

_load_state() {
    [[ -n "${XRANDR_STATE}" ]] || XRANDR_STATE="$(xrandr --query 2>/dev/null)"
}

_select_output() {
    local configured
    _load_state
    configured="$(hippos-settings get display.output 2>/dev/null || true)"
    if [[ -n "${configured}" ]] && grep -q "^${configured} connected" <<<"${XRANDR_STATE}"; then
        PSCREEN="${configured}"
        return
    fi
    PSCREEN="$(awk '/ connected primary/{p=$1; exit} / connected/{o=$1} END{print (p ? p : o)}' <<<"${XRANDR_STATE}")"
}

_current_mode() {
    awk -v s="$PSCREEN" '
        /^[^ ]+ connected/ { in_s=($1==s) }
        /\*/ && in_s { gsub(/[*+]/,"",$0); print $1; exit }
    ' <<<"${XRANDR_STATE}"
}

_current_resolution() {
    awk -v s="$PSCREEN" '
        $1==s && /connected/ { match($0,/[0-9]+x[0-9]+\+/); if(RSTART) print substr($0,RSTART,RLENGTH-1); exit }
    ' <<<"${XRANDR_STATE}"
}

_crt_active() { [[ -f /etc/switchres.ini ]]; }

_crt_setmode() {
    local mode="$1"
    local w h hz rest
    w="${mode%%x*}"
    rest="${mode#*x}"
    h="${rest%%.*}"
    rest="${rest#*.}"
    hz="${rest%%.*}"
    if ! command -v switchres >/dev/null 2>&1; then
        echo "[hippos-resolution] switchres not found" >&2
        return 1
    fi
    switchres "${w}" "${h}" "${hz}" 2>/dev/null
}

_crt_restore() {
    local boot_res w rest h hz
    boot_res="$(hippos-settings get crt.boot_resolution 2>/dev/null || echo '640x480i')"
    w="${boot_res%%x*}"
    rest="${boot_res#*x}"
    h="${rest%%[i@]*}"
    hz="${boot_res##*@}"; hz="${hz%%[^0-9]*}"
    [[ -z "${hz}" || "${hz}" == "${boot_res}" ]] && hz=60
    switchres "${w}" "${h}" "${hz}" 2>/dev/null || \
        xrandr --output "${PSCREEN}" --auto 2>/dev/null || true
}

_apply_mode() {
    local mode="$1" res rate
    if _crt_active; then
        _crt_setmode "${mode}"
    elif [[ "$mode" == max-* ]]; then
        res="${mode#max-}"
        xrandr --output "$PSCREEN" --mode "$res" 2>/dev/null || xrandr --output "$PSCREEN" --auto
    elif [[ "$mode" == *"."* ]]; then
        res="${mode%.*}"; rate="${mode##*.}"
        xrandr --output "$PSCREEN" --mode "$res" --rate "$rate"
    else
        xrandr --output "$PSCREEN" --mode "$mode"
    fi
}

_print_state() {
    _load_state
    printf '%s\n%s\n%s\n' "$PSCREEN" "$(_current_mode)" "$(_current_resolution)"
}

PSCREEN=
if [[ "${1:-}" == "--screen" ]]; then
    shift; PSCREEN="$1"; shift
fi
[[ -z "$PSCREEN" ]] && _select_output

case "${1:-}" in
    listModes)
        if _crt_active && [[ -f /userdata/system/videomodes.conf ]]; then
            cat /userdata/system/videomodes.conf
        else
            _load_state
            echo "max-1920x1080:maximum 1920x1080"
            echo "max-640x480:maximum 640x480"
            awk -v s="$PSCREEN" '
                /^[^ ]+ connected/ { in_s = ($1 == s) }
                /^[[:space:]]+[0-9]+x[0-9]+/ && in_s {
                    res=$1; hz=$2; gsub(/[*+]/,"",hz)
                    ihz=int(hz+0.5)
                    printf "%s.%d:%s %dHz\n", res, ihz, res, ihz
                }
            ' <<<"${XRANDR_STATE}"
        fi
        ;;
    setMode|applyMode)
        _apply_mode "${2:-}"
        [[ "$1" == setMode ]] && hippos-settings set display.resolution "${2:-}" 2>/dev/null || true
        ;;
    currentMode)
        _load_state
        _current_mode
        ;;
    currentResolution)
        _load_state
        _current_resolution
        ;;
    currentState)
        _print_state
        ;;
    gameMode)
        _load_state
        original="$(_current_mode)"
        if [[ -n "${2:-}" && "${2}" != default ]]; then
            _apply_mode "$2"
            XRANDR_STATE=
        elif _crt_active; then
            _crt_restore
            XRANDR_STATE=
        fi
        _load_state
        printf '%s\n%s\n%s\n' "$PSCREEN" "$original" "$(_current_resolution)"
        ;;
    listOutputs)
        _load_state
        awk '$2 == "connected" || / [0-9]+x[0-9]+\+[0-9]+\+[0-9]+ / {print $1}' <<<"${XRANDR_STATE}"
        ;;
    currentOutput)
        echo "$PSCREEN"
        ;;
    setOutput)
        OUT="${2:-}"
        _load_state
        awk '$2 == "connected" || / [0-9]+x[0-9]+\+[0-9]+\+[0-9]+ / {print $1}' <<<"${XRANDR_STATE}" | while read -r o; do
            [[ "$o" != "$OUT" ]] && xrandr --output "$o" --off 2>/dev/null || true
        done
        xrandr --output "$OUT" --primary --auto
        hippos-settings set display.output "$OUT" 2>/dev/null || true
        ;;
    minTomaxResolution|minTomaxResolution-secure)
        if _crt_active; then _crt_restore; fi
        ;;
    getDisplayMode)   echo "xorg" ;;
    getRotation)      echo "0" ;;
    refreshRate)
        _load_state
        awk -v s="$PSCREEN" '
            /^[^ ]+ connected/ { in_s=($1==s) }
            /\*/ && in_s { for(i=1;i<=NF;i++) if($i~/\*/) { gsub(/[*+]/,"",$i); print $i; exit } }
        ' <<<"${XRANDR_STATE}"
        ;;
    supportVrr)
        vrr_capable=$(xrandr --prop 2>/dev/null | awk -v s="$PSCREEN" '
            /^[^ \t]+ (connected|disconnected)/ { in_s=($1==s) }
            in_s && $1=="vrr_capable:" { print $2; exit }
        ')
        if [[ -n "$vrr_capable" ]]; then
            [[ "$vrr_capable" == 1 ]]
            exit
        fi
        command -v nvidia-settings >/dev/null || exit 1
        vrr_mode=$(nvidia-settings -t -q "[dpy:${PSCREEN}]/DisplayVRRMode" 2>/dev/null)
        [[ "$vrr_mode" == 1 || "$vrr_mode" == 2 ]]
        ;;
    setRotation|setDPI|setReflection|forceMode|supportSystemRotation|supportSystemReflection)
        exit 0
        ;;
    *)
        echo "Unknown action: ${1:-}" >&2; exit 1
        ;;
esac
