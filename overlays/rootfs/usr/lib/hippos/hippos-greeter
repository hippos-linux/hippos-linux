#!/usr/bin/python3
"""hippos-greeter — HippOS login screen for greetd.

Usage: hippos-greeter <session command...>

Shown when system.autologin is off (see hippos-session-setup). Started
without a display, it runs itself again under xinit on its own short-lived
Xorg, which uses the same drivers and xorg.conf.d as the session's and stops
when the greeter exits.
HippOS has one account, so it only asks for hippos's password, and whether
to start in ES or the desktop. A keyboard types directly; a pad or a mouse
uses the on-screen keyboard. On success greetd starts the session command
given on the command line with HIPPOS_START_MODE set to that choice, which
hippos-session also saves as the boot default.
"""
import json
import os
import socket
import struct
import subprocess
import sys
import time
from typing import List, Optional

# Pad buttons are numbered from evdev like ES and LutrisView, not by SDL's
# HIDAPI drivers.
os.environ.setdefault('SDL_JOYSTICK_HIDAPI', '0')
os.environ.setdefault('PYGAME_HIDE_SUPPORT_PROMPT', '1')
import pygame  # noqa: E402

from hippos_theme import DEFAULT_THEME_DIR, Theme, mix  # noqa: E402

USER = 'hippos'

THEME = Theme(DEFAULT_THEME_DIR)
INK = THEME.color('ink', (7, 6, 15))
TEXT = THEME.color('textPrimary', (244, 241, 255))
TEXT_DIM = THEME.color('textMuted', (143, 136, 174))
ACCENT = THEME.color('brandPurple', (123, 63, 255))
ACCENT_2 = THEME.color('brandBlue', (26, 111, 255))
ERROR = (255, 107, 129)
PANEL = mix(INK, TEXT, 0.06)
KEY = mix(INK, TEXT, 0.12)
FONT_DISPLAY = THEME.font('fontDisplay')
FONT_STRONG = THEME.font('fontStrong')
FONT_REGULAR = THEME.font('fontRegular')
# The splash carries the HippOS logo on its left; the panel sits on the right.
BACKGROUND = THEME.art('assets', 'splash.jpg')

PANEL_ALPHA = 225

# evdev order: south, east, north, west, L1, R1, L2, R2, select, start.
BTN_A, BTN_B, BTN_SELECT, BTN_START = 0, 1, 8, 9
STICK_DEADZONE = 0.5
# Held d-pad or stick: first repeat after the delay, then every interval.
REPEAT_DELAY, REPEAT_INTERVAL = 0.35, 0.09

SHIFT, SPACE, DELETE, LOGIN = 'shift', 'space', 'delete', 'login'
POWER, START_IN = 'power', 'start_in'
# Everything a pad or mouse can select, top to bottom. The Power button sits
# alone at the top, away from LOG IN.
CONTROL_ROWS = [
    [POWER],
    [START_IN],
    list('1234567890'),
    list('qwertyuiop'),
    list('asdfghjkl') + ['-'],
    [SHIFT] + list('zxcvbnm') + ['.', '_'],
    [SPACE, DELETE, LOGIN],
]
KEYBOARD_FIRST_ROW = 2
SHIFTED = dict(zip('1234567890-._', '!@#$%^&*()+,?'))
WIDE_KEYS = {SHIFT: 1.5, SPACE: 4, DELETE: 3, LOGIN: 3}
KEY_LABELS = {SHIFT: 'SHIFT', SPACE: 'SPACE', DELETE: 'DELETE', LOGIN: 'LOG IN', POWER: 'POWER'}

POWER_ACTIONS = [('POWER OFF', 'poweroff'), ('RESTART', 'reboot'), ('CANCEL', None)]
# The desktop itself is whichever system.desktop names.
START_MODES = [('EMULATIONSTATION', 'es'), ('DESKTOP', 'desktop')]
START_MODE_VALUES = [value for _, value in START_MODES]
FOOTER_HINTS = [('A', 'TYPE'), ('B', 'DELETE'), ('START', 'LOG IN'), ('SELECT', 'POWER')]


class Greetd:
    """greetd's IPC: a native-endian u32 length, then a JSON message."""

    def __init__(self, path: str):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)

    def request(self, message: dict) -> dict:
        data = json.dumps(message).encode()
        self.sock.sendall(struct.pack('=I', len(data)) + data)
        length = struct.unpack('=I', self._read(4))[0]
        return json.loads(self._read(length))

    def _read(self, size: int) -> bytes:
        buf = b''
        while len(buf) < size:
            chunk = self.sock.recv(size - len(buf))
            if not chunk:
                raise ConnectionError('greetd closed the connection')
            buf += chunk
        return buf


def setting(key: str, default: str) -> str:
    result = subprocess.run(['hippos-settings', 'get', key], capture_output=True, text=True)
    return result.stdout.strip() or default


def login(greetd: Greetd, password: str, session_cmd: List[str], mode: str) -> Optional[str]:
    """Logs hippos in and starts the session in the chosen mode. Returns an
    error to show, or None once greetd has accepted the session."""
    reply = greetd.request({'type': 'create_session', 'username': USER})
    while reply['type'] == 'auth_message':
        response = password if reply['auth_message_type'] in ('secret', 'visible') else None
        reply = greetd.request({'type': 'post_auth_message_response', 'response': response})
    if reply['type'] == 'success':
        reply = greetd.request({'type': 'start_session', 'cmd': session_cmd,
                                'env': [f'HIPPOS_START_MODE={mode}']})
        if reply['type'] == 'success':
            return None
    greetd.request({'type': 'cancel_session'})
    if reply.get('error_type') == 'auth_error':
        return 'Wrong password'
    return reply.get('description') or 'Login failed'


class Popup:
    """A short list over the screen, such as the power menu."""

    def __init__(self, title: str, items: List[tuple], on_choose, selected: int = 0):
        self.title = title
        self.items = items
        self.on_choose = on_choose
        self.selected = selected

    def choose(self, index: int):
        self.on_choose(self.items[index][1])


def scale_to_fill(image: pygame.Surface, w: int, h: int) -> pygame.Surface:
    scale = max(w / image.get_width(), h / image.get_height())
    scaled = pygame.transform.smoothscale(
        image, (round(image.get_width() * scale), round(image.get_height() * scale)))
    x, y = (scaled.get_width() - w) // 2, (scaled.get_height() - h) // 2
    return scaled.subsurface((x, y, w, h)).copy()


class Greeter:
    def __init__(self, session_cmd: List[str]):
        self.session_cmd = session_cmd
        self.greetd = Greetd(os.environ['GREETD_SOCK'])
        pygame.init()
        self.screen = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
        pygame.display.set_caption('HippOS')
        self.w, self.h = self.screen.get_size()
        self.joysticks = {}
        for i in range(pygame.joystick.get_count()):
            j = pygame.joystick.Joystick(i)
            self.joysticks[j.get_instance_id()] = j
        pygame.mouse.set_visible(False)
        pygame.key.start_text_input()

        unit = self.h / 1080
        self.font_title = pygame.font.Font(FONT_DISPLAY, round(44 * unit))
        self.font_text = pygame.font.Font(FONT_REGULAR, round(26 * unit))
        self.font_key = pygame.font.Font(FONT_STRONG, round(24 * unit))
        self.font_small = pygame.font.Font(FONT_REGULAR, round(20 * unit))
        self.font_badge = pygame.font.Font(FONT_STRONG, round(16 * unit))
        self.unit = unit

        self.background = self._background()
        self.password = ''
        self.message = ''
        self.message_is_error = False
        self.shift = False
        self.mode = setting('system.boot_session', 'es')
        if self.mode not in START_MODE_VALUES:
            self.mode = START_MODE_VALUES[0]
        self.row, self.col = KEYBOARD_FIRST_ROW + 1, 0
        self.popup: Optional[Popup] = None
        # What the mouse can click, rebuilt each frame: (rect, target).
        self.click_targets: List[tuple] = []
        self.held: Optional[tuple] = None
        self.next_repeat = 0.0

    def _background(self) -> pygame.Surface:
        try:
            image = pygame.image.load(BACKGROUND).convert()
            return scale_to_fill(image, self.w, self.h)
        except (pygame.error, FileNotFoundError):
            surface = pygame.Surface((self.w, self.h))
            surface.fill(INK)
            return surface

    # ── Input ────────────────────────────────────────────────────────────────

    def run(self):
        clock = pygame.time.Clock()
        while True:
            for event in pygame.event.get():
                self.handle(event)
            self.repeat_held()
            self.draw()
            clock.tick(30)

    def handle(self, event):
        if event.type == pygame.TEXTINPUT and self.popup is None:
            self.type_text(event.text)
        elif event.type == pygame.KEYDOWN:
            if event.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                self.activate()
            elif event.key == pygame.K_BACKSPACE:
                self.password = self.password[:-1]
            elif event.key == pygame.K_ESCAPE:
                self.toggle_power_menu()
            elif event.key in (pygame.K_UP, pygame.K_DOWN, pygame.K_LEFT, pygame.K_RIGHT) \
                    and self.popup is not None:
                self.move(*{pygame.K_UP: (0, -1), pygame.K_DOWN: (0, 1),
                            pygame.K_LEFT: (-1, 0), pygame.K_RIGHT: (1, 0)}[event.key])
        elif event.type == pygame.JOYBUTTONDOWN:
            if event.button == BTN_A:
                self.press_selected()
            elif event.button == BTN_B:
                if self.popup is not None:
                    self.popup = None
                else:
                    self.password = self.password[:-1]
            elif event.button == BTN_START:
                self.activate()
            elif event.button == BTN_SELECT:
                self.toggle_power_menu()
        elif event.type == pygame.JOYHATMOTION:
            self.hold(event.value if event.value != (0, 0) else None, flip_y=True)
        elif event.type == pygame.JOYAXISMOTION and event.axis in (0, 1):
            j = self.joysticks.get(event.instance_id)
            if j:
                x, y = j.get_axis(0), j.get_axis(1)
                dx = (x > STICK_DEADZONE) - (x < -STICK_DEADZONE)
                dy = (y > STICK_DEADZONE) - (y < -STICK_DEADZONE)
                self.hold((dx, dy) if dx or dy else None)
        elif event.type == pygame.MOUSEMOTION:
            pygame.mouse.set_visible(True)
        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            self.click(event.pos)
        elif event.type == pygame.JOYDEVICEADDED:
            j = pygame.joystick.Joystick(event.device_index)
            self.joysticks[j.get_instance_id()] = j
        elif event.type == pygame.JOYDEVICEREMOVED:
            self.joysticks.pop(event.instance_id, None)

    def hold(self, direction: Optional[tuple], flip_y: bool = False):
        """Moves once now and keeps repeating while the direction is held."""
        if direction and flip_y:
            direction = (direction[0], -direction[1])
        if direction == self.held:
            return
        self.held = direction
        if direction:
            self.move(*direction)
            self.next_repeat = time.monotonic() + REPEAT_DELAY

    def repeat_held(self):
        if self.held and time.monotonic() >= self.next_repeat:
            self.move(*self.held)
            self.next_repeat = time.monotonic() + REPEAT_INTERVAL

    def move(self, dx: int, dy: int):
        if self.popup is not None:
            self.popup.selected = (self.popup.selected + dy + dx) % len(self.popup.items)
            return
        if dy:
            old_row = CONTROL_ROWS[self.row]
            self.row = (self.row + dy) % len(CONTROL_ROWS)
            # Keep roughly the same horizontal position across rows of
            # different widths.
            fraction = (self.col + 0.5) / len(old_row)
            self.col = min(int(fraction * len(CONTROL_ROWS[self.row])), len(CONTROL_ROWS[self.row]) - 1)
        if dx:
            self.col = (self.col + dx) % len(CONTROL_ROWS[self.row])

    def press_selected(self):
        if self.popup is not None:
            self.choose_in_popup(self.popup.selected)
            return
        key = CONTROL_ROWS[self.row][self.col]
        if key == POWER:
            self.toggle_power_menu()
        elif key == START_IN:
            self.popup = Popup('START IN', START_MODES, self.set_mode, START_MODE_VALUES.index(self.mode))
        elif key == SHIFT:
            self.shift = not self.shift
        elif key == SPACE:
            self.type_text(' ')
        elif key == DELETE:
            self.password = self.password[:-1]
        elif key == LOGIN:
            self.activate()
        else:
            self.type_text(self.key_char(key))

    def click(self, pos: tuple):
        for rect, target in reversed(self.click_targets):
            if not rect.collidepoint(pos):
                continue
            if target[0] == 'popup_item':
                self.choose_in_popup(target[1])
            elif self.popup is None:
                self.row, self.col = target[1], target[2]
                self.press_selected()
            return
        # A click outside a popup closes it.
        self.popup = None

    def toggle_power_menu(self):
        if self.popup is not None:
            self.popup = None
        else:
            self.popup = Popup('', POWER_ACTIONS, self.run_power_action)

    def choose_in_popup(self, index: int):
        popup, self.popup = self.popup, None
        popup.choose(index)

    def set_mode(self, mode: str):
        self.mode = mode

    def key_char(self, key: str) -> str:
        if not self.shift:
            return key
        return SHIFTED.get(key, key.upper())

    def type_text(self, text: str):
        self.password += text
        self.message = ''

    def activate(self):
        if self.popup is not None:
            self.press_selected()
            return
        if not self.password:
            return
        self.message, self.message_is_error = 'Logging in', False
        self.draw()
        error = login(self.greetd, self.password, self.session_cmd, self.mode)
        if error is None:
            pygame.quit()
            sys.exit(0)
        self.password = ''
        self.message, self.message_is_error = error, True

    def run_power_action(self, action: Optional[str]):
        if action:
            subprocess.run(['systemctl', action], check=False)

    # ── Drawing ──────────────────────────────────────────────────────────────

    def draw(self):
        u = self.unit
        self.click_targets = []
        self.screen.blit(self.background, (0, 0))

        panel_w, panel_h = round(720 * u), round(720 * u)
        panel_x = round(self.w * 0.74 - panel_w / 2)
        panel_y = round((self.h - panel_h) / 2)
        panel = pygame.Surface((panel_w, panel_h), pygame.SRCALPHA)
        pygame.draw.rect(panel, (*PANEL, PANEL_ALPHA), panel.get_rect(), border_radius=round(24 * u))
        self.screen.blit(panel, (panel_x, panel_y))

        cx = panel_x + panel_w // 2
        power = pygame.Rect(0, 0, round(120 * u), round(40 * u))
        power.topright = (panel_x + panel_w - round(20 * u), panel_y + round(20 * u))
        self.draw_control(power, 0, 0, POWER)
        y = panel_y + round(48 * u)
        title = self.font_title.render(USER, True, TEXT)
        self.screen.blit(title, title.get_rect(midtop=(cx, y)))
        y += title.get_height() + round(10 * u)
        hint = self.font_text.render('Enter your password', True, TEXT_DIM)
        self.screen.blit(hint, hint.get_rect(midtop=(cx, y)))
        y += hint.get_height() + round(28 * u)

        field = pygame.Rect(0, 0, panel_w - round(96 * u), round(64 * u))
        field.midtop = (cx, y)
        pygame.draw.rect(self.screen, INK, field, border_radius=round(14 * u))
        pygame.draw.rect(self.screen, ACCENT, field, width=max(2, round(2 * u)), border_radius=round(14 * u))
        # Dots are drawn: the theme fonts have no bullet glyph.
        clip = field.inflate(-round(32 * u), 0)
        radius, step = round(7 * u), round(24 * u)
        # Long passwords scroll so the newest dots stay in view.
        x = clip.left + radius + min(0, clip.width - step * (len(self.password) + 1))
        self.screen.set_clip(clip)
        for _ in self.password:
            pygame.draw.circle(self.screen, TEXT, (x, field.centery), radius)
            x += step
        if int(time.monotonic() * 2) % 2 == 0:
            caret = pygame.Rect(x - radius, field.centery - round(16 * u), max(2, round(2 * u)), round(32 * u))
            pygame.draw.rect(self.screen, TEXT, caret)
        self.screen.set_clip(None)
        y = field.bottom + round(14 * u)

        if self.message:
            msg = self.font_small.render(self.message, True, ERROR if self.message_is_error else TEXT_DIM)
            self.screen.blit(msg, msg.get_rect(midtop=(cx, y)))
        y += round(40 * u)

        y = self.draw_mode_choice(panel_x + round(40 * u), y, panel_w - round(80 * u))
        self.draw_keyboard(panel_x + round(40 * u), y + round(20 * u), panel_w - round(80 * u))
        self.draw_footer()
        if self.popup is not None:
            self.draw_popup()
        pygame.display.flip()

    def draw_control(self, rect: pygame.Rect, r: int, c: int, key: str):
        """Draws one selectable control and registers it for mouse clicks."""
        u = self.unit
        focused = (r, c) == (self.row, self.col) and self.popup is None
        if focused:
            fill = ACCENT
        elif key == LOGIN:
            fill = ACCENT_2
        elif key == SHIFT and self.shift:
            fill = mix(KEY, ACCENT, 0.5)
        else:
            fill = KEY
        pygame.draw.rect(self.screen, fill, rect, border_radius=round(10 * u))
        if key == START_IN:
            label = START_MODES[START_MODE_VALUES.index(self.mode)][0]
        else:
            label = KEY_LABELS.get(key) or self.key_char(key)
        font = self.font_small if key in KEY_LABELS or key == START_IN else self.font_key
        text = font.render(label, True, TEXT)
        self.screen.blit(text, text.get_rect(center=rect.center))
        if key == START_IN:
            # A drop-down arrow, drawn: the theme fonts have no arrow glyphs.
            size = round(7 * u)
            tip = (rect.right - round(24 * u), rect.centery + size // 2)
            pygame.draw.polygon(self.screen, TEXT, [
                (tip[0] - size, tip[1] - size), (tip[0] + size, tip[1] - size), tip])
        self.click_targets.append((rect, ('control', r, c)))

    def draw_mode_choice(self, x0: int, y: int, width: int) -> int:
        """Draws the START IN drop-down; returns the y below it."""
        u = self.unit
        label = self.font_small.render('START IN', True, TEXT_DIM)
        self.screen.blit(label, label.get_rect(midtop=(x0 + width // 2, y)))
        y += label.get_height() + round(8 * u)
        self.draw_control(pygame.Rect(x0, y, width, round(48 * u)), CONTROL_ROWS.index([START_IN]), 0, START_IN)
        return y + round(48 * u)

    def draw_keyboard(self, x0: int, y: int, width: int):
        u = self.unit
        gap = round(8 * u)
        key_h = round(52 * u)
        for r in range(KEYBOARD_FIRST_ROW, len(CONTROL_ROWS)):
            row = CONTROL_ROWS[r]
            units = sum(WIDE_KEYS.get(k, 1) for k in row)
            unit_w = (width - gap * (len(row) - 1)) / max(units, 10)
            row_w = unit_w * units + gap * (len(row) - 1)
            x = x0 + (width - row_w) / 2
            for c, key in enumerate(row):
                key_w = unit_w * WIDE_KEYS.get(key, 1)
                self.draw_control(pygame.Rect(round(x), y, round(key_w), key_h), r, c, key)
                x += key_w + gap
            y += key_h + gap

    def draw_footer(self):
        u = self.unit
        bar_h = round(64 * u)
        bar = pygame.Surface((self.w, bar_h), pygame.SRCALPHA)
        bar.fill((*INK, 200))
        self.screen.blit(bar, (0, self.h - bar_h))
        x = round(32 * u)
        for button, action in FOOTER_HINTS:
            x = self.draw_hint(button, action, x, self.h - bar_h // 2)
        clock = self.font_text.render(time.strftime('%H:%M'), True, TEXT)
        self.screen.blit(clock, clock.get_rect(midright=(self.w - round(32 * u), self.h - bar_h // 2)))

    def draw_hint(self, button: str, action: str, x: int, cy: int) -> int:
        """Draws a pad button badge and its action; returns the next x."""
        u = self.unit
        label = self.font_badge.render(button, True, INK)
        badge_h = round(30 * u)
        badge_w = max(badge_h, label.get_width() + round(16 * u))
        badge = pygame.Rect(x, cy - badge_h // 2, badge_w, badge_h)
        pygame.draw.rect(self.screen, TEXT_DIM, badge, border_radius=badge_h // 2)
        self.screen.blit(label, label.get_rect(center=badge.center))
        text = self.font_small.render(action, True, TEXT_DIM)
        self.screen.blit(text, text.get_rect(midleft=(badge.right + round(10 * u), cy)))
        return badge.right + round(10 * u) + text.get_width() + round(36 * u)

    def draw_popup(self):
        u = self.unit
        popup = self.popup
        shade = pygame.Surface((self.w, self.h), pygame.SRCALPHA)
        shade.fill((*INK, 170))
        self.screen.blit(shade, (0, 0))
        item_h = round(64 * u)
        title = self.font_small.render(popup.title, True, TEXT_DIM) if popup.title else None
        title_h = title.get_height() + round(12 * u) if title else 0
        box = pygame.Rect(0, 0, round(460 * u), title_h + item_h * len(popup.items) + round(48 * u))
        box.center = (self.w // 2, self.h // 2)
        pygame.draw.rect(self.screen, PANEL, box, border_radius=round(20 * u))
        y = box.top + round(24 * u)
        if title:
            self.screen.blit(title, title.get_rect(midtop=(box.centerx, y)))
            y += title_h
        for i, (label, _) in enumerate(popup.items):
            rect = pygame.Rect(box.left + round(24 * u), y, box.width - round(48 * u), item_h - round(8 * u))
            if i == popup.selected:
                pygame.draw.rect(self.screen, ACCENT, rect, border_radius=round(12 * u))
            text = self.font_key.render(label, True, TEXT)
            self.screen.blit(text, text.get_rect(center=rect.center))
            self.click_targets.append((rect, ('popup_item', i)))
            y += item_h


def system_stopping() -> bool:
    """True once a shutdown or reboot is queued. The manager reports itself
    "stopping" only later, after sessions have already started to end."""
    jobs = subprocess.run(['systemctl', 'list-jobs', '--no-legend', 'shutdown.target'],
                          capture_output=True, text=True)
    return bool(jobs.stdout.strip())


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 1
    if 'DISPLAY' not in os.environ:
        # greetd starts the greeter again whenever a session ends, shutdown
        # included, when its Xorg could no longer take the VT.
        if system_stopping():
            return 0
        # Display :1: a crashed greeter leaves its lock owned by _greetd,
        # which hippos couldn't clear for the session's :0.
        os.execvp('xinit', ['xinit', os.path.abspath(sys.argv[0]), *sys.argv[1:], '--',
                            '/usr/lib/xorg/Xorg', ':1', f"vt{os.environ.get('XDG_VTNR', '7')}",
                            '-keeptty', '-nolisten', 'tcp', '-logfile', '/tmp/Xorg.greeter.log'])
    Greeter(sys.argv[1:]).run()
    return 0


if __name__ == '__main__':
    sys.exit(main())
