#!/usr/bin/env bash
# Shares are listed in /userdata/system/configs/hippos/roms-sources.conf, one per line:
#   cifs://host/share [mount options]     for example cifs://nas/Games credentials=/path,saves=ro
#   nfs:host:/export [saves=ro]
# Games and BIOS files are always read-only. Save folders on the share are written back to
# when the server allows it; add saves=ro to keep them read-only.
set -euo pipefail

source /usr/lib/hippos/pool-branch.sh

CONFIG=/userdata/system/configs/hippos/roms-sources.conf
MEDIA=/media

log() { printf '[hippos-network-roms] %s\n' "$*"; }

setting() {
    /usr/lib/hippos/hippos-settings get "$1" 2>/dev/null || printf '%s\n' "${2:-}"
}

is_true() {
    case "$1" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

split_options() {
    local option
    mount_options=""
    saves_mode=rw
    IFS=, read -ra option_list <<< "$1"
    for option in "${option_list[@]}"; do
        case "${option}" in
            "") ;;
            saves=*) saves_mode="${option#saves=}" ;;
            *) mount_options="${mount_options:+${mount_options},}${option}" ;;
        esac
    done
}

writable() {
    runuser -u hippos -- sh -c ': > "$1" && rm -f "$1"' sh "$1/.hippos-write-test" 2>/dev/null
}

mount_writable_saves() {
    local type="$1" remote="$2" mnt="$3" options="$4" dir
    while IFS= read -r -d '' dir; do
        mountpoint -q "${dir}" && continue
        if ! mount -t "${type}" "${remote}/${dir#"${mnt}"/}" "${dir}" -o "${options}"; then
            log "could not mount ${dir} for writing; its saves stay read-only"
            continue
        fi
        if writable "${dir}"; then
            log "saves in ${dir} are written back to the share"
        else
            umount "${dir}" || umount -l "${dir}"
            log "the server refuses writes to ${dir}; its saves stay read-only"
        fi
    done < <(share_saves_dirs "${mnt}")
}

if ! is_true "$(setting network.roms.enabled true)"; then
    log "disabled by network.roms.enabled"
    exit 0
fi

[[ -f "${CONFIG}" ]] || { log "no config at ${CONFIG}"; exit 0; }

mkdir -p "${MEDIA}"
changed=0

while IFS= read -r line; do
    [[ -z "${line}" || "${line}" == '#'* ]] && continue
    source_name="${line%% *}"
    extra=""
    [[ "${line}" == *' '* ]] && extra="${line#* }"
    split_options "${extra}"

    if [[ "${source_name}" == nfs:* ]]; then
        share="${source_name#nfs:}"
        label="$(printf '%s' "${share}" | sed 's|/|_|g;s|^_||;s|:||')"
        mnt="${MEDIA}/${label}"
        mkdir -p "${mnt}"
        if mountpoint -q "${mnt}"; then
            log "already mounted: ${share}"
            continue
        fi
        nfs_options="noatime,soft,timeo=30,retry=0"
        if mount -t nfs -o "ro,${nfs_options}" "${share}" "${mnt}"; then
            log "mounted NFS ${share} at ${mnt}"
            changed=1
            [[ "${saves_mode}" == rw ]] && mount_writable_saves nfs "${share%/}" "${mnt}" "rw,${nfs_options}"
        else
            log "failed to mount NFS ${share}"
            rmdir "${mnt}" 2>/dev/null || true
        fi

    elif [[ "${source_name}" == cifs:* ]]; then
        share_path="${source_name#cifs://}"
        label="$(printf '%s' "${share_path}" | tr '/' '_')"
        mnt="${MEDIA}/${label}"
        mkdir -p "${mnt}"
        if mountpoint -q "${mnt}"; then
            log "already mounted: //${share_path}"
            continue
        fi
        cifs_options="noatime,soft,vers=3.0,uid=1000,gid=1000"
        [[ -n "${mount_options}" ]] && cifs_options="${cifs_options},${mount_options}"
        [[ "${cifs_options}" != *username=* && "${cifs_options}" != *credentials=* ]] && cifs_options="${cifs_options},guest"
        if mount -t cifs "//${share_path}" "${mnt}" -o "ro,${cifs_options}"; then
            log "mounted CIFS //${share_path} at ${mnt}"
            changed=1
            [[ "${saves_mode}" == rw ]] && mount_writable_saves cifs "//${share_path%/}" "${mnt}" "rw,${cifs_options}"
        else
            log "failed to mount CIFS //${share_path}"
            rmdir "${mnt}" 2>/dev/null || true
        fi
    fi
done < "${CONFIG}"

if [[ "${changed}" -eq 1 ]]; then
    /usr/lib/hippos/hippos-rom-scan
    systemctl restart --no-block hippos-bios-pool.service hippos-saves-pool.service
    curl -sf http://127.0.0.1:1234/reloadgames >/dev/null 2>&1 || true
fi
