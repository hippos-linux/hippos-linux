#!/usr/bin/env bash
set -euo pipefail

CONFIG=/userdata/system/configs/hippos/roms-sources.conf
MEDIA=/media

log() { printf '[hippos-network-roms] %s\n' "$*"; }

setting() {
    /usr/lib/hippos/hippos-settings get "$1" 2>/dev/null || printf '%s\n' "${2:-}"
}

is_true() {
    case "$1" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

if ! is_true "$(setting network.roms.enabled true)"; then
    log "disabled by network.roms.enabled"
    exit 0
fi

[[ -f "${CONFIG}" ]] || { log "no config at ${CONFIG}"; exit 0; }

mkdir -p "${MEDIA}"
changed=0

while IFS= read -r line; do
    [[ -z "${line}" || "${line}" == '#'* ]] && continue

    if [[ "${line}" == nfs:* ]]; then
        share="${line#nfs:}"
        label="$(printf '%s' "${share}" | sed 's|/|_|g;s|^_||;s|:||')"
        mnt="${MEDIA}/${label}"
        mkdir -p "${mnt}"
        if mountpoint -q "${mnt}"; then
            log "already mounted: ${share}"
            continue
        fi
        if mount -t nfs -o ro,noatime,soft,timeo=30,retry=0 "${share}" "${mnt}"; then
            log "mounted NFS ${share} at ${mnt}"
            changed=1
        else
            log "failed to mount NFS ${share}"
            rmdir "${mnt}" 2>/dev/null || true
        fi

    elif [[ "${line}" == cifs:* ]]; then
        rest="${line#cifs://}"
        share_path="${rest%% *}"
        opts="${rest#"${share_path}"}"
        opts="${opts# }"
        label="$(printf '%s' "${share_path}" | tr '/' '_')"
        mnt="${MEDIA}/${label}"
        mkdir -p "${mnt}"
        if mountpoint -q "${mnt}"; then
            log "already mounted: //${share_path}"
            continue
        fi
        mount_opts="ro,noatime,soft,vers=3.0,uid=1000,gid=1000"
        [[ -n "${opts}" ]] && mount_opts="${mount_opts},${opts}"
        [[ "${mount_opts}" != *username=* && "${mount_opts}" != *credentials=* ]] && mount_opts="${mount_opts},guest"
        if mount -t cifs "//${share_path}" "${mnt}" -o "${mount_opts}"; then
            log "mounted CIFS //${share_path} at ${mnt}"
            changed=1
        else
            log "failed to mount CIFS //${share_path}"
            rmdir "${mnt}" 2>/dev/null || true
        fi
    fi
done < "${CONFIG}"

if [[ "${changed}" -eq 1 ]]; then
    /usr/lib/hippos/hippos-rom-scan
    systemctl restart --no-block hippos-bios-pool.service
    curl -sf http://127.0.0.1:1234/reloadgames >/dev/null 2>&1 || true
fi
