#!/usr/bin/env bash

set -euo pipefail

UPLOAD_URL="${HIPPOS_UPLOAD_URL:-https://logs.hippos-linux.org/upload-logs}"

echo "HippOS Log Uploader"
echo "==================="

TOKEN="$(hippos-settings get updates.token 2>/dev/null || true)"
if [[ -n "${TOKEN}" ]]; then
    echo "Token:  ${TOKEN:0:8}…"
    echo "Server: ${UPLOAD_URL}"
else
    echo "No beta token configured, the logs will only be saved on this device."
    echo "Set it in EmulationStation under UPDATES & DOWNLOADS > ACCESS TOKEN,"
    echo "or add 'updates.token=<your-token>' to /userdata/system/hippos.conf"
    echo "Your token was sent by DM when you received the Early Access role."
fi
echo ""

if [[ $# -gt 0 ]]; then
    ISSUE="$*"
else
    echo "Describe the issue (press Enter twice when done):"
    ISSUE=""
    while IFS= read -r _line; do
        [[ -z "${_line}" && -z "${ISSUE}" ]] && continue   # skip leading blanks
        [[ -z "${_line}" ]] && break                        # blank line = done
        ISSUE="${ISSUE}${_line}"$'\n'
    done
    ISSUE="${ISSUE%$'\n'}"
fi
ISSUE="${ISSUE#"${ISSUE%%[! $'\t']*}"}"  # ltrim
ISSUE="${ISSUE%"${ISSUE##*[! $'\t']}"}"  # rtrim
if [[ -z "${ISSUE}" ]]; then
    echo "Error: Issue description is required."
    exit 1
fi
echo ""

WORK="$(mktemp -d /tmp/hippos-upload.XXXXXX)"
trap 'rm -rf "${WORK}"' EXIT
LOGS="${WORK}/logs"
mkdir -p "${LOGS}"
printf '%s\n' "${ISSUE}" > "${LOGS}/issue.txt"

echo -n "  Settings...            "
{
    echo "=== hippos.conf (secrets redacted) ==="
    sed -E 's/^([^="]*\.(key|token|password|passwd|pass|psk|secret)\s*=\s*).*/\1<redacted>/' \
        /userdata/system/hippos.conf 2>/dev/null || echo "(not found)"
} > "${LOGS}/settings.txt" 2>&1
echo "done"

echo -n "  Refreshing boot capture..."
sudo /usr/lib/hippos/capture-boot-logs 2>/dev/null || true
echo " done"

echo -n "  Boot capture...        "
if [[ -d /userdata/system/logs/boot/latest ]]; then
    cp -rL /userdata/system/logs/boot/latest "${LOGS}/boot-capture"
    _count="$(find /userdata/system/logs/boot/latest/ -type f | wc -l)"
    echo " ${_count} file(s)"
else
    echo " directory not found"
fi

echo -n "  OS update log...       "
if [[ -f /userdata/system/logs/upgrade.log ]]; then
    tail -n 5000 /userdata/system/logs/upgrade.log > "${LOGS}/upgrade.log"
    echo "done"
else
    echo "not found"
fi

BUNDLE="${WORK}/hippos-logs.tar.gz"
echo -n "  Bundling...            "
tar -czf "${BUNDLE}" -C "${WORK}" logs/
_size="$(du -sh "${BUNDLE}" | cut -f1)"
echo "${_size}"

SAVED_BUNDLE="/userdata/system/logs/hippos-logs-$(date +%Y%m%d-%H%M%S).tar.gz"
save_bundle() {
    mkdir -p "${SAVED_BUNDLE%/*}"
    cp "${BUNDLE}" "${SAVED_BUNDLE}"
    echo ""
    echo "Logs saved to ${SAVED_BUNDLE}"
    echo "Copy that file to a USB stick or over the network share and send it in."
    exit 1
}

[[ -n "${TOKEN}" ]] || save_bundle

echo ""
echo -n "Uploading... "
HTTP_STATUS="$(curl -s -o /dev/null -w "%{http_code}" \
    -X POST "${UPLOAD_URL}" \
    -H "X-HippOS-Token: ${TOKEN}" \
    -F "issue=${ISSUE}" \
    -F "logs=@${BUNDLE};type=application/gzip" \
    --max-time 120 2>/dev/null || true)"

if [[ "${HTTP_STATUS}" == "200" ]]; then
    echo "done"
    echo ""
    echo "Logs uploaded."
    exit 0
fi

echo "failed"
echo ""
case "${HTTP_STATUS}" in
    401) echo "Error: Invalid token. Check updates.token in /userdata/system/hippos.conf" ;;
    404) echo "Error: Token not recognised — your beta access may have been revoked." ;;
    413) echo "Error: Log bundle too large. Try again after clearing old logs." ;;
    000) echo "Error: Could not reach upload server. Check your internet connection." ;;
    *)   echo "Error: Unexpected response (HTTP ${HTTP_STATUS})." ;;
esac
save_bundle
