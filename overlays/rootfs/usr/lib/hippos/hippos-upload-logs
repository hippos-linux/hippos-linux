#!/usr/bin/env bash
# hippos-upload-logs — collect system logs and post them to Discord.
# Requires updates.token in /userdata/system/hippos.conf (sent via Discord DM
# when you received Early Access or Dev Access). Beta tokens post to your beta
# thread; the shared dev token posts to the dev channel instead.

set -euo pipefail

UPLOAD_URL="${HIPPOS_UPLOAD_URL:-https://logs.hippos-linux.org/upload-logs}"

echo "HippOS Log Uploader"
echo "==================="

# ── Token ─────────────────────────────────────────────────────────────────────

TOKEN="$(hippos-settings get updates.token 2>/dev/null || true)"
if [[ -z "${TOKEN}" ]]; then
    echo "Error: No beta token configured."
    echo "Add 'updates.token=<your-token>' to /userdata/system/hippos.conf"
    echo "Your token was sent by DM when you received the Early Access role."
    exit 1
fi
echo "Token:  ${TOKEN:0:8}…"
echo "Server: ${UPLOAD_URL}"
echo ""

# ── Issue description ─────────────────────────────────────────────────────────

echo "Describe the issue (press Enter twice when done):"
ISSUE=""
while IFS= read -r _line; do
    [[ -z "${_line}" && -z "${ISSUE}" ]] && continue   # skip leading blanks
    [[ -z "${_line}" ]] && break                        # blank line = done
    ISSUE="${ISSUE}${_line}"$'\n'
done
ISSUE="${ISSUE%$'\n'}"
ISSUE="${ISSUE#"${ISSUE%%[! $'\t']*}"}"  # ltrim
ISSUE="${ISSUE%"${ISSUE##*[! $'\t']}"}"  # rtrim
if [[ -z "${ISSUE}" ]]; then
    echo "Error: Issue description is required."
    exit 1
fi
echo ""

# ── Collect ───────────────────────────────────────────────────────────────────
#
# capture-boot-logs (runs automatically at boot, into
# /userdata/system/logs/boot/<boot_id>/) is the canonical, comprehensive
# system snapshot — version/kernel/CPU/memory/PCI/storage/GPU/display/EDID/
# service status+journals/GRUB/modprobe conf/coredumps/and more. This tool
# used to re-collect most of that itself by hand, duplicating it and drifting
# out of sync (e.g. stale unit names journalctl'd here that no longer exist).
# Re-run it now rather than trust whatever the boot-time run already wrote:
# boot_id is stable for the whole session, so this overwrites that same
# directory with a fresh, up-to-the-moment capture (journalctl -b covers the
# whole current boot regardless of when it's invoked) — meaningfully better
# for a runtime issue reported hours into a session, not just a boot issue.

WORK="$(mktemp -d /tmp/hippos-upload.XXXXXX)"
trap 'rm -rf "${WORK}"' EXIT
LOGS="${WORK}/logs"
mkdir -p "${LOGS}"
printf '%s\n' "${ISSUE}" > "${LOGS}/issue.txt"

echo -n "  Settings...            "
{
    echo "=== hippos.conf (token redacted) ==="
    sed 's/\(updates\.token\s*=\s*\).*/\1<redacted>/' \
        /userdata/system/hippos.conf 2>/dev/null || echo "(not found)"
} > "${LOGS}/settings.txt" 2>&1
echo "done"

echo -n "  Refreshing boot capture..."
# capture-boot-logs normally runs as root via its systemd service and writes
# into a root-owned directory — needs sudo here since this tool runs as the
# interactive hippos user (which already has passwordless sudo, see
# /etc/sudoers.d/hippos).
sudo /usr/lib/hippos/capture-boot-logs 2>/dev/null || true
echo " done"

echo -n "  Boot capture...        "
# Just this boot's capture, not the whole retained history under
# /userdata/system/logs/boot/ (up to 20 boots — see LOG_RETENTION_COUNT in
# capture-boot-logs) — a support bundle needs the current issue, not a
# multi-boot log archive.
if [[ -d /userdata/system/logs/boot/latest ]]; then
    # -L: `latest` is itself a symlink (see capture-boot-logs); plain `cp -r`
    # copies the symlink itself rather than dereferencing it, so the bundle
    # ends up with a dangling link to a path that doesn't exist off-device
    # instead of the actual capture files.
    cp -rL /userdata/system/logs/boot/latest "${LOGS}/boot-capture"
    _count="$(find /userdata/system/logs/boot/latest -type f | wc -l)"
    echo " ${_count} file(s)"
else
    echo " directory not found"
fi

# ── Bundle ────────────────────────────────────────────────────────────────────

BUNDLE="${WORK}/hippos-logs.tar.gz"
echo -n "  Bundling...            "
tar -czf "${BUNDLE}" -C "${WORK}" logs/
_size="$(du -sh "${BUNDLE}" | cut -f1)"
echo "${_size}"

# ── Upload ────────────────────────────────────────────────────────────────────

echo ""
echo -n "Uploading... "
HTTP_STATUS="$(curl -s -o /dev/null -w "%{http_code}" \
    -X POST "${UPLOAD_URL}" \
    -H "X-HippOS-Token: ${TOKEN}" \
    -F "issue=${ISSUE}" \
    -F "logs=@${BUNDLE};type=application/gzip" \
    --max-time 120 2>/dev/null || true)"

case "${HTTP_STATUS}" in
    200)
        echo "done"
        echo ""
        echo "Logs posted to Discord."
        ;;
    401)
        echo "failed"
        echo ""
        echo "Error: Invalid token. Check updates.token in /userdata/system/hippos.conf"
        exit 1
        ;;
    404)
        echo "failed"
        echo ""
        echo "Error: Token not recognised — your beta access may have been revoked."
        exit 1
        ;;
    413)
        echo "failed"
        echo ""
        echo "Error: Log bundle too large. Try again after clearing old logs."
        exit 1
        ;;
    000)
        echo "failed"
        echo ""
        echo "Error: Could not reach upload server. Check your internet connection."
        exit 1
        ;;
    *)
        echo "failed"
        echo ""
        echo "Error: Unexpected response (HTTP ${HTTP_STATUS})."
        exit 1
        ;;
esac
