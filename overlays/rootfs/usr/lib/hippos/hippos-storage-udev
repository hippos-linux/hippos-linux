#!/usr/bin/env bash

ACTION="$1"
DEVNAME="$2"
DEVTYPE="$3"

READY_FLAG="/run/hippos-storage-ready"
DELAY_DIR="/run/hippos-storage-delay"

dispatch() {
    systemd-run --no-block --collect --quiet /usr/lib/hippos/hippos-storage-event "$1" "${DEVNAME}" "${DEVTYPE}"
}

if [[ "${ACTION}" == "add" ]]; then
    if [[ -f "${READY_FLAG}" ]]; then
        dispatch mount
    else
        mkdir -p "${DELAY_DIR}"
        printf '%s:%s\n' "${DEVNAME}" "${DEVTYPE}" \
            > "${DELAY_DIR}/$(date +%s%N).${DEVNAME}.add"
    fi
else
    rm -f "${DELAY_DIR:+${DELAY_DIR}}"/*."${DEVNAME}".add 2>/dev/null || true
    dispatch umount
fi
