#!/usr/bin/env bash
# Re-apply display settings when a display is hotplugged (HDMI connect/disconnect).
# Spawned from a udev rule via systemd-run so it runs outside the udev timeout.

export DISPLAY=":0"
export XAUTHORITY=""

# Only act when X is running (ES/desktop session active)
[[ -S "/tmp/.X11-unix/X0" ]] || exit 0

# Wait for the kernel to finish enumerating the new display
sleep 2

echo "[hippos-display-hotplug] display change detected, re-applying display config"
exec /usr/lib/hippos/hippos-display-setup
