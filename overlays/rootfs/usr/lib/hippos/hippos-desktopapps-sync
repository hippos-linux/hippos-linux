#!/usr/bin/env python3

from __future__ import annotations

from pathlib import Path

from hippos_apt import image_packages, installed_user_packages, package_files
from hippos_flatpak_metadata import hicolor_icon
from hippos_launcher_sync import GameMetadata, reload_es, sync_gamelist, sync_launchers
from hippos_ports import DesktopApp, claimed_packages, read_desktop_file

USERDATA   = Path('/userdata')
ROMS_DIR   = USERDATA / 'roms' / 'desktopapps'
STATE_FILE = USERDATA / 'system' / 'desktopapps-launchers.json'
SYSTEM_APPLICATIONS = Path('/usr/share/applications')
USER_SHARES = (USERDATA / '.local' / 'share', USERDATA / 'system' / '.local' / 'share')
ICON_SHARES = (*USER_SHARES, Path('/usr/share'))
PIXMAPS = Path('/usr/share/pixmaps')
ANDROID_APP_CATEGORY = 'X-WayDroid-App'

def log(message: str) -> None:
    print(f'[hippos-desktopapps-sync] {message}', flush=True)

def user_package_entries() -> list[Path]:
    image = image_packages()
    if image is None:
        return []
    claimed = claimed_packages()
    return [
        path
        for package in installed_user_packages(image) if package not in claimed
        for path in package_files(package)
        if path.parent == SYSTEM_APPLICATIONS and path.suffix == '.desktop'
    ]

def user_entries() -> list[Path]:
    return [path for share in USER_SHARES for path in sorted((share / 'applications').rglob('*.desktop'))]

def find_icon(icon: str | None) -> Path | None:
    if not icon:
        return None
    if icon.startswith('/'):
        return Path(icon) if Path(icon).is_file() else None
    for share in ICON_SHARES:
        if found := hicolor_icon(share, icon):
            return found
    return next((path for path in (PIXMAPS / f'{icon}.png', PIXMAPS / f'{icon}.svg') if path.is_file()), None)

def installed_apps() -> dict[str, DesktopApp]:
    apps = {}
    for path in user_package_entries():
        if (app := read_desktop_file(path)) is not None and 'Game' not in app.categories:
            apps[str(path)] = app
    for path in user_entries():
        if (app := read_desktop_file(path)) is not None and ANDROID_APP_CATEGORY not in app.categories:
            apps[str(path)] = app
    return apps

def sync() -> int:
    apps = installed_apps()
    created, updated, removed = sync_launchers(
        ROMS_DIR, STATE_FILE, '.app', {key: app.name for key, app in apps.items()}, 'Desktop App')
    games = {key: GameMetadata(app.name, app.comment, None, find_icon(app.icon)) for key, app in apps.items()}
    details_changed = sync_gamelist(ROMS_DIR, STATE_FILE, '.app', games)
    log(f'found={len(apps)} created={created} updated={updated} removed={removed} details_changed={details_changed}')
    if created or updated or removed or details_changed:
        reload_es()
    return 0

if __name__ == '__main__':
    raise SystemExit(sync())
