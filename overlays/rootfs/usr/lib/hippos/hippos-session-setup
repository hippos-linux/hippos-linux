#!/usr/bin/env bash
# hippos-session-setup — root preparation before greetd starts hippos-session.
set -uo pipefail

# Wait for a DRM device to be probed before X starts; without one Xorg fails
# with "failed to create screen resources".
for _ in $(seq 1 40); do
    compgen -G '/dev/dri/card*' >/dev/null && break
    sleep 0.25
done

/usr/lib/hippos/hippos-xorg-setup

# Login is opt-in. Without it, greetd's initial_session logs hippos straight
# in; greetd runs that once per boot, so system.login applies from the next
# boot. The greeter is only reached when login is on, or after a logout.
SESSION_CMD="systemd-cat -t hippos-session /usr/lib/hippos/hippos-session"
{
    printf '[terminal]\nvt = 7\n\n'
    if [[ "$(hippos-settings get system.login 2>/dev/null)" != true ]]; then
        printf '[initial_session]\nuser = "hippos"\ncommand = "%s"\n\n' "${SESSION_CMD}"
    fi
    printf '[default_session]\nuser = "_greetd"\ncommand = "tuigreet --remember --cmd \x27%s\x27"\n' "${SESSION_CMD}"
} > /etc/greetd/config.toml
