#!/usr/bin/env bash

set -euo pipefail

LOG_TAG="[hippos-crt-setup]"
log()  { printf '%s %s\n'         "${LOG_TAG}" "$*"; }
warn() { printf '%s WARNING: %s\n' "${LOG_TAG}" "$*" >&2; }

XORG_CONF_D="/etc/X11/xorg.conf.d"
CRT_X11_DIR="/usr/share/hippos/crt/x11"
SWITCHRES_INI="/etc/switchres.ini"
SWITCHRES_TEMPLATE="/usr/share/hippos/crt/switchres.ini.template"
VIDEOMODES_BASE="/usr/share/hippos/crt/videomodes"
VIDEOMODES_DEST="/userdata/system/videomodes.conf"
EDID_SRC_DIR="/usr/share/hippos/crt/edid"
EDID_DEST_DIR="/lib/firmware/edid"
GRUB_CRT_CONF="/etc/default/grub.d/50-crt.cfg"

get() { hippos-settings get "$1" 2>/dev/null || true; }

_connected_outputs() {
    local p status name
    for p in /sys/class/drm/card[0-9]*-*; do
        [[ -f "${p}/status" ]] || continue
        status="$(< "${p}/status")"
        [[ "${status}" == "connected" ]] || continue
        name="${p##*/}"         # card0-VGA-1
        name="${name#card*-}"   # VGA-1
        echo "${name}"
    done
}

_detect_gpu_driver() {
    local card drv
    for card in /sys/class/drm/card[0-9]; do
        drv="$(readlink "${card}/device/driver" 2>/dev/null \
            | xargs basename 2>/dev/null || true)"
        case "${drv}" in
            amdgpu|radeon|i915|nvidia) echo "${drv}"; return ;;
        esac
    done
    echo "modesetting"
}

_detect_dcn() {
    local f
    for f in /sys/kernel/debug/dri/*/amdgpu_ip_info; do
        [[ -f "${f}" ]] || continue
        grep -qi "dcn" "${f}" 2>/dev/null && echo "dcn" && return
    done
    dmesg 2>/dev/null | grep -qi "amdgpu.*dcn\b\|dcn.*display" && echo "dcn" && return
    echo "dce"
}

_connector_type() {
    local output="${1}"
    case "${output}" in
        VGA-*)              echo "vga"     ;;
        DVI-I-*|DVI-D-*|DVI-A-*) echo "dvi" ;;
        HDMI-A-*|HDMI-B-*) echo "hdmi"    ;;
        DP-*)               echo "dp"      ;;
        eDP-*)              echo "edp"     ;;
        LVDS-*)             echo "lvds"    ;;
        *)                  echo "unknown" ;;
    esac
}

_detect_r9_380() {
    lspci -n 2>/dev/null | grep -qi "1002:6938\|1002:6939"
}

_detect_sea_islands() {
    lspci -n 2>/dev/null | grep -qiE \
        "1002:66[45][0-9a-f]|1002:67[ab][0-9a-f]|1002:13[01][0-9a-f]|1002:98[34][0-9a-f]"
}

_drm_to_x11_name() {
    local drm_name="$1"
    [[ -n "${DISPLAY:-}" ]] || { echo "${drm_name}"; return; }
    local base_type="${drm_name%-*}"
    local -a x11_outputs
    mapfile -t x11_outputs < <(
        xrandr --query 2>/dev/null \
          | awk -v b="${base_type}" '/ (connected|disconnected)/ && $1 ~ "^"b"-" {print $1}' \
          | sort
    )
    if [[ "${#x11_outputs[@]}" -eq 1 ]]; then
        echo "${x11_outputs[0]}"; return
    fi
    local drm_idx="${drm_name##*-}"
    if [[ "${drm_idx}" -gt 0 && "${#x11_outputs[@]}" -gt 0 ]]; then
        local x11_idx=$(( drm_idx - 1 ))
        [[ "${x11_idx}" -lt "${#x11_outputs[@]}" ]] && echo "${x11_outputs[${x11_idx}]}" && return
    fi
    echo "${drm_name}"
}

_x11_connected_outputs() {
    if [[ -n "${DISPLAY:-}" ]]; then
        xrandr --query 2>/dev/null | awk '/ connected/ {print $1}'
    else
        _connected_outputs
    fi
}

MONITOR_PROFILE="$(get crt.monitor_profile)"; MONITOR_PROFILE="${MONITOR_PROFILE:-generic_15}"
CRT_OUTPUT="$(get crt.output)"
INTERLACE="$(get crt.interlace)";           INTERLACE="${INTERLACE:-true}"
SUPER_WIDTH="$(get crt.super_width)";       SUPER_WIDTH="${SUPER_WIDTH:-auto}"
DOTCLOCK_MIN="$(get crt.dotclock_min)";     DOTCLOCK_MIN="${DOTCLOCK_MIN:-auto}"
BOOT_RES="$(get crt.boot_resolution)";      BOOT_RES="${BOOT_RES:-640x480i}"

if [[ -z "${CRT_OUTPUT}" || "${CRT_OUTPUT}" == "auto" ]]; then
    warn "crt.output is not set — select CRT VIDEO OUTPUT in System Settings → CRT"
    exit 1
fi

CRT_OUTPUT_X11="$(_drm_to_x11_name "${CRT_OUTPUT}")"
if [[ "${CRT_OUTPUT_X11}" != "${CRT_OUTPUT}" ]]; then
    log "X11 output name resolved: ${CRT_OUTPUT} (DRM) → ${CRT_OUTPUT_X11} (X11)"
fi

log "profile=${MONITOR_PROFILE} output=${CRT_OUTPUT} x11=${CRT_OUTPUT_X11}"

GPU_DRIVER="$(_detect_gpu_driver)"
log "GPU driver: ${GPU_DRIVER}"

if [[ "${GPU_DRIVER}" == "amdgpu" ]] && _detect_sea_islands; then
    warn "Sea Islands GPU (GCN 2.x) detected with amdgpu driver — interlaced modes may not work."
    warn "If you get a blank screen at 240i/480i, add 'radeon.si_support=1 amdgpu.si_support=0' to GRUB kernel params."
fi

CONNECTOR_TYPE="$(_connector_type "${CRT_OUTPUT}")"
log "connector type: ${CONNECTOR_TYPE}"

if [[ "${DOTCLOCK_MIN}" == "auto" || "${SUPER_WIDTH}" == "auto" ]]; then
    case "${GPU_DRIVER}" in
        amdgpu|radeon)
            case "${CONNECTOR_TYPE}" in
                hdmi) _auto_dotclock="25.0"; _auto_super="3840" ;;
                dp)   _auto_dotclock="0.0";  _auto_super="2560" ;;
                *)    _auto_dotclock="0.0";  _auto_super="2560" ;;
            esac
            ;;
        nvidia)
            case "${CONNECTOR_TYPE}" in
                dp) _auto_dotclock="0.0";  _auto_super="3840" ;;
                *)  _auto_dotclock="25.0"; _auto_super="3840" ;;
            esac
            ;;
        i915)
            case "${CONNECTOR_TYPE}" in
                dp) _auto_dotclock="0.0";  _auto_super="1920" ;;
                *)  _auto_dotclock="25.0"; _auto_super="1920" ;;
            esac
            ;;
        *)
            _auto_dotclock="0.0"; _auto_super="2560"
            ;;
    esac
    [[ "${DOTCLOCK_MIN}" == "auto" ]] && DOTCLOCK_MIN="${_auto_dotclock}"
    [[ "${SUPER_WIDTH}"  == "auto" ]] && SUPER_WIDTH="${_auto_super}"
    log "resolved auto: dotclock_min=${DOTCLOCK_MIN} super_width=${SUPER_WIDTH} (gpu=${GPU_DRIVER} connector=${CONNECTOR_TYPE})"
fi

case "${GPU_DRIVER}" in
    amdgpu|radeon|nvidia) VIDEOMODES_DIR="${VIDEOMODES_BASE}/amd"   ;;
    *)                    VIDEOMODES_DIR="${VIDEOMODES_BASE}/intel"  ;;
esac

mkdir -p "${XORG_CONF_D}"

case "${GPU_DRIVER}" in
    amdgpu) _gpu_conf="${CRT_X11_DIR}/90-crt-amdgpu.conf"     ;;
    radeon) _gpu_conf="${CRT_X11_DIR}/90-crt-radeon.conf"      ;;
    nvidia) _gpu_conf="${CRT_X11_DIR}/90-crt-nvidia.conf"      ;;
    *)      _gpu_conf="${CRT_X11_DIR}/90-crt-modesetting.conf" ;;
esac

if [[ -f "${_gpu_conf}" ]]; then
    cp "${_gpu_conf}" "${XORG_CONF_D}/90-crt-gpu.conf"
    log "wrote ${XORG_CONF_D}/90-crt-gpu.conf (from $(basename "${_gpu_conf}"))"
else
    warn "GPU X11 template not found: ${_gpu_conf}"
fi

{
    printf '# CRT mode - managed by hippos-crt-setup. Do not edit manually.\n'
    while read -r output; do
        [[ "${output}" == "${CRT_OUTPUT_X11}" ]] && continue
        printf 'Section "Monitor"\n'
        printf '    Identifier "%s"\n' "${output}"
        printf '    Option "Ignore" "true"\n'
        printf 'EndSection\n\n'
    done < <(_x11_connected_outputs)
} > "${XORG_CONF_D}/10-crt-ignore.conf"
log "wrote ${XORG_CONF_D}/10-crt-ignore.conf"

{
    printf '# CRT mode - managed by hippos-crt-setup. Do not edit manually.\n'
    printf 'Section "Monitor"\n'
    printf '    Identifier  "%s"\n'                "${CRT_OUTPUT_X11}"
    printf '    HorizSync   15.0-90.0\n'
    printf '    VertRefresh 49.0-130.0\n'
    printf '    Option      "DPMS"         "false"\n'
    printf '    Option      "DefaultModes" "false"\n'
    printf 'EndSection\n'
} > "${XORG_CONF_D}/15-crt-monitor.conf"
log "wrote ${XORG_CONF_D}/15-crt-monitor.conf"

if [[ ! -f "${SWITCHRES_TEMPLATE}" ]]; then
    warn "switchres.ini template missing: ${SWITCHRES_TEMPLATE}"
else
    INTERLACE_VAL=1
    [[ "${INTERLACE}" == "false" || "${INTERLACE}" == "0" ]] && INTERLACE_VAL=0

    IFE=0
    if [[ "${GPU_DRIVER}" == "amdgpu" ]]; then
        [[ "$(_detect_dcn)" == "dcn" ]] && IFE=1
    fi
    log "interlace_force_even=${IFE}"

    sed \
        -e "s/@MONITOR@/${MONITOR_PROFILE}/g" \
        -e "s/@DISPLAY@/${CRT_OUTPUT_X11}/g" \
        -e "s/@INTERLACE@/${INTERLACE_VAL}/g" \
        -e "s/@DOTCLOCK_MIN@/${DOTCLOCK_MIN}/g" \
        -e "s/@SUPER_WIDTH@/${SUPER_WIDTH}/g" \
        -e "s/@IFE@/${IFE}/g" \
        "${SWITCHRES_TEMPLATE}" > "${SWITCHRES_INI}"
    log "wrote ${SWITCHRES_INI}"
fi

VIDEOMODES_SRC="${VIDEOMODES_DIR}/videomodes.conf_${MONITOR_PROFILE}"
if [[ -f "${VIDEOMODES_SRC}" ]]; then
    mkdir -p "$(dirname "${VIDEOMODES_DEST}")"
    cp "${VIDEOMODES_SRC}" "${VIDEOMODES_DEST}"
    chmod 644 "${VIDEOMODES_DEST}"
    log "installed videomodes.conf for ${MONITOR_PROFILE}"
else
    warn "no videomodes.conf for profile '${MONITOR_PROFILE}' (${VIDEOMODES_SRC} not found)"
fi

EDID_INSTALLED=0

_boot_w="${BOOT_RES%%x*}"
_boot_rest="${BOOT_RES#*x}"
_boot_h="${_boot_rest%%[i@]*}"          # strip trailing i or @freq
_boot_hz="${BOOT_RES##*@}"; _boot_hz="${_boot_hz%%[^0-9]*}"
[[ -z "${_boot_hz}" || "${_boot_hz}" == "${BOOT_RES}" ]] && _boot_hz=60

_edid_w=$(( _boot_w + 1 ))

if command -v switchres >/dev/null 2>&1 && [[ -f "${SWITCHRES_INI}" ]]; then
    _edid_tmp="$(mktemp -d)"
    if ( cd "${_edid_tmp}" && \
         switchres "${_edid_w}" "${_boot_h}" "${_boot_hz}" \
             -i "${SWITCHRES_INI}" -e 2>/dev/null ) && \
       [[ -f "${_edid_tmp}/${MONITOR_PROFILE}.bin" ]]; then
        mkdir -p "${EDID_DEST_DIR}"
        mv "${_edid_tmp}/${MONITOR_PROFILE}.bin" "${EDID_DEST_DIR}/crt.bin"
        chmod 644 "${EDID_DEST_DIR}/crt.bin"
        EDID_INSTALLED=1
        log "generated EDID: ${MONITOR_PROFILE} ${_edid_w}x${_boot_h}@${_boot_hz} → ${EDID_DEST_DIR}/crt.bin"
    else
        warn "switchres EDID generation failed — booting without drm.edid_firmware"
    fi
    rm -rf "${_edid_tmp}"
else
    warn "switchres not found or switchres.ini missing — skipping EDID generation"
fi

BOOT_RES_KRN="${BOOT_RES%%@*}"

GRUB_CMDLINE="video=${CRT_OUTPUT}:${BOOT_RES_KRN}eS"
GRUB_CMDLINE+=" console=tty3 loglevel=0 vt.global_cursor_default=0 mitigations=off"
if [[ "${EDID_INSTALLED}" -eq 1 ]]; then
    GRUB_CMDLINE+=" drm.edid_firmware=${CRT_OUTPUT}:edid/crt.bin"
fi

if [[ "${GPU_DRIVER}" == "amdgpu" ]] && _detect_r9_380; then
    warn "R9 380 (Tonga) detected — appending amdgpu.dc=0 to GRUB kernel params"
    GRUB_CMDLINE+=" amdgpu.dc=0"
fi

mkdir -p "$(dirname "${GRUB_CRT_CONF}")"
_new_grub_conf="$(printf '# CRT mode - managed by hippos-crt-setup. Do not edit manually.\nGRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT %s"\n' "${GRUB_CMDLINE}")"
_old_grub_conf="$(cat "${GRUB_CRT_CONF}" 2>/dev/null || true)"

if [[ "${_new_grub_conf}" != "${_old_grub_conf}" ]]; then
    printf '%s\n' "${_new_grub_conf}" > "${GRUB_CRT_CONF}"
    if update-grub 2>/dev/null; then
        log "GRUB updated: ${GRUB_CMDLINE}"
    else
        warn "update-grub failed — CRT params will apply after next boot"
    fi
else
    log "GRUB dropin unchanged — skipping update-grub"
fi

log "CRT setup complete. X11 config changes take effect after X restart."
