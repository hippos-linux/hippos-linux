#!/usr/bin/env bash
# ES API: info --full — system info for ES about screen
case "${1:-}" in
    --full)
        _cpu_cores="$(grep -m1 'cpu cores' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | xargs)"
        _cpu_threads="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
        echo "CPU:$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | xargs) (${_cpu_cores}C/${_cpu_threads}T)"
        echo "MEMORY:$(free -h | awk '/^Mem:/{print $3 " / " $2}')"
        echo "KERNEL:$(uname -r)"
        echo "HOSTNAME:$(hostname)"
        ;;
    *)
        echo "HippOS $(cat /usr/share/hippos/version 2>/dev/null || echo 0.1.0)"
        ;;
esac
