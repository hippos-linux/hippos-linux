[Unit]
Description=HippOS First-Boot Flatpak App Installer
After=network.target local-fs.target hippos-migrate.service
ConditionPathExists=/usr/bin/startlxqt

[Service]
Type=simple
TimeoutStopSec=10
ExecStart=/usr/lib/hippos/hippos-firstboot-flatpak
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
