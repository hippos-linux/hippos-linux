[Unit]
Description=HippOS NVIDIA legacy driver resolution (background, on-demand)
# Needs network for the .run download and can take minutes for the DKMS
# build — deliberately not part of the graphical.target chain. Only ever
# triggered by hippos-gpu-init (systemctl start --no-block) after
# nvidia-open has already been probed and failed; never enabled/wanted by
# any target, so it's a no-op on hardware that doesn't need it.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/hippos/hippos-nvidia-legacy-resolve
StandardOutput=journal
StandardError=journal
