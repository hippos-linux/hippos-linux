[Unit]
Description=HippOS Lutris launcher sync
After=local-fs.target userdata.mount
Wants=userdata.mount
# Lutris writes pga.db several times per launch, install and exit.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/hippos/hippos-lutris-sync
Nice=10

[Install]
WantedBy=multi-user.target
