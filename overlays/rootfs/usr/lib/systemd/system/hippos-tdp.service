[Unit]
Description=HippOS AMD TDP configuration
# hardware-init writes the device defaults (global.tdp) this reads.
After=hippos-migrate.service hippos-hardware-init.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/hippos/hippos-tdp boot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
