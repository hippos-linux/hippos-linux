[Unit]
Description=Watch for Flatpak app installs/removals
After=local-fs.target userdata.mount

[Path]
PathChanged=/var/lib/flatpak/exports/share/applications
PathChanged=/userdata/.local/share/flatpak/exports/share/applications
Unit=hippos-flatpak-sync.service

[Install]
WantedBy=multi-user.target
