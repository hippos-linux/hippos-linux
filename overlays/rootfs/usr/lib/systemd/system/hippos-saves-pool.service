[Unit]
Description=HippOS MergerFS saves pool
After=local-fs.target userdata.mount hippos-storage.service
Before=hippos-es.service
Wants=userdata.mount

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=180
TimeoutStopSec=5
ExecStart=/usr/lib/hippos/mount-saves-pool
ExecStop=umount -l /userdata/saves
# The lazy unmount usually ends mergerfs first; "-" accepts finding nothing.
ExecStop=-pkill -f "mergerfs.*userdata/saves"

[Install]
WantedBy=multi-user.target
