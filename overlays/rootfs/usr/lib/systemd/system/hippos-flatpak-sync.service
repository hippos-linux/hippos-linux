[Unit]
Description=HippOS Flatpak launcher sync
After=local-fs.target userdata.mount hippos-firstboot-flatpak.service
Wants=userdata.mount

[Service]
Type=oneshot
# Apps install per-user under /userdata; flatpak run as root can't see them.
User=hippos
ExecStart=/usr/lib/hippos/hippos-flatpak-sync
Nice=10

[Install]
WantedBy=multi-user.target
