[Unit]
Description=HippOS Flatpak launcher sync
After=local-fs.target userdata.mount hippos-firstboot-flatpak.service hippos-roms-pool.service
Wants=userdata.mount
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=hippos
ExecStart=/usr/lib/hippos/hippos-flatpak-sync
Nice=10

[Install]
WantedBy=multi-user.target
