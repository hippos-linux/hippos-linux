[Unit]
Description=HippOS Desktop Session
After=local-fs.target userdata.mount hippos-xserver.service user@1000.service
Wants=hippos-xserver.service
Conflicts=hippos-es.service

[Service]
Type=simple
User=hippos
# Without this, systemd never registers a logind session for this login —
# subject.user goes unresolved for polkit checks (see 49-hippos-session.rules)
# and the KDE polkit agent can't register at all ("Cannot create unix
# session: No session for pid ..."). PAMName=systemd-user (the first fix
# here) didn't actually solve that: pam_systemd treats the literal PAM
# service name "systemd-user" as the sentinel for user@.service's own
# manager-bookkeeping session, forcing Class=manager no matter which unit
# invokes it — and a manager-class session still isn't a valid polkit
# subject. hippos-session (usr/lib/pam.d/hippos-session) mirrors its
# no-auth-stack shape (still no password prompt) under our own name so this
# registers as a normal Class=user session instead.
PAMName=hippos-session
ExecStartPre=/bin/sh -c 'prev=""; for i in $(seq 1 30); do cur=$(DISPLAY=:0 xrandr --current 2>/dev/null | sed -n "/^Screen/s/.*current \\([0-9]*\\) x \\([0-9]*\\).*/\\1x\\2/p"); [ "$cur" = "$prev" ] && [ -n "$cur" ] && exit 0; prev=$cur; sleep 1; done; exit 0'
ExecStart=/usr/lib/hippos/session-desktop
ExecStopPost=/bin/sh -c 'XDG_RUNTIME_DIR=/run/user/1000 systemctl --user stop plasmashell.service ksmserver.service "plasma-*.service" 2>/dev/null; pkill -TERM -u hippos -f "kwin|plasmashell|startplasma|ksmserver|lxqt|xfce|gnome-session|mate-session|cinnamon" 2>/dev/null; sleep 1; pkill -KILL -u hippos -f "kwin|plasmashell|startplasma|ksmserver|lxqt|xfce|gnome-session|mate-session|cinnamon" 2>/dev/null; true'
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
