[Unit]
Description=HippOS userdata version migration
After=local-fs.target hippos-roms-pool.service hippos-saves-pool.service hippos-bios-pool.service
Before=greetd.service hippos-system-init.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/hippos/hippos-migrate

[Install]
WantedBy=multi-user.target
