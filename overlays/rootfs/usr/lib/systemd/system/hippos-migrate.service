[Unit]
Description=HippOS userdata version migration
After=local-fs.target
# Before the defaults sync, so settings it adds are never migrated as old values.
Before=hippos-es.service hippos-desktop.service hippos-system-init.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/hippos/hippos-migrate

[Install]
WantedBy=multi-user.target
