[Unit]
Description=HippOS EmulationStation Session
After=local-fs.target systemd-user-sessions.service userdata.mount plymouth-quit-wait.service hippos-roms-pool.service hippos-bios-pool.service hippos-saves-pool.service hippos-xserver.service user@1000.service opt-emulators.mount
Wants=local-fs.target userdata.mount hippos-roms-pool.service hippos-bios-pool.service hippos-saves-pool.service hippos-xserver.service opt-emulators.mount
Conflicts=hippos-desktop.service

[Service]
Type=simple
User=hippos
# See hippos-desktop.service for why this is needed and why it's
# PAMName=hippos-session rather than the stock systemd-user PAM service.
PAMName=hippos-session
# Bounded fallback check: After=hippos-xserver.service (below) already means
# X0 exists by the time we get here on the normal path, since hippos-xserver
# now fails its own start job if X0 never appears (see that unit). This just
# guards races/manual starts instead of hanging forever the way an
# unconditional `until` loop under TimeoutStartSec=infinity did — that combo
# let a dead Xorg leave this unit stuck in "activating (start-pre)" forever,
# which in turn wedged hippos-session.service and graphical.target.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 0.5; done; echo "hippos-es: /tmp/.X11-unix/X0 did not appear within 15s — hippos-xserver.service did not provide a usable X server" >&2; exit 1'
ExecStart=/usr/lib/hippos/hippos-es
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
