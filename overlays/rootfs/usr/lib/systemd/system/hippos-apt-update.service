[Unit]
Description=HippOS apt cache refresh
# network.target, not network-online.target — WantedBy=multi-user.target means
# multi-user.target (and graphical.target behind it) waits for this unit's start
# job to conclude regardless of Wants= being a soft dependency; a real-connectivity
# wait here delayed the whole boot by NetworkManager-wait-online.service's own
# timeout on a machine with no network yet. The ConditionPathExists= below already
# makes this re-attempt every boot until it actually succeeds, so it doesn't need
# to block for connectivity now — a boot with no network just tries again next boot.
After=network.target
ConditionPathExists=!/var/lib/apt/lists/deb.debian.org_debian_dists_trixie_InRelease

[Service]
Type=oneshot
ExecStart=/usr/bin/apt-get update -qq
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
