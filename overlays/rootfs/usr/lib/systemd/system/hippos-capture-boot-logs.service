[Unit]
Description=Capture HippOS boot diagnostics
# greetd starts the session; the script polls for its outcome.
After=greetd.service userdata.mount
Wants=userdata.mount

[Service]
Type=oneshot
# Script polls session state (up to 180s) then graphical.target (up to 120s)
# before capturing; 600s leaves headroom for the full diagnostic sweep after.
TimeoutStartSec=600
ExecStart=/usr/lib/hippos/capture-boot-logs

[Install]
WantedBy=multi-user.target
