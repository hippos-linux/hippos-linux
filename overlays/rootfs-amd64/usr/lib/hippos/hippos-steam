#!/usr/bin/env bash
# hippos-steam — launch Steam with HippOS settings applied.
set -euo pipefail

get() { hippos-settings get "$1" 2>/dev/null || true; }

mkdir -p /userdata/system/logs

# Deck / GamepadUI mode
declare -a STEAM_FLAGS=()
BIG_PICTURE=false
if [[ "${1:-}" == "--big-picture" ]]; then
    BIG_PICTURE=true
    shift
fi
# Steam bootstrap hasn't run yet if steam.sh is absent — gamepadui blocks the
# setup wizard and update download on first launch, so fall back to desktop mode.
STEAM_BOOTSTRAPPED=false
[[ -f "/userdata/.local/share/Steam/steam.sh" ]] && STEAM_BOOTSTRAPPED=true
if [[ "$(get steam.deckmode)" == "true" || "${BIG_PICTURE}" == "true" ]]; then
    if [[ "${STEAM_BOOTSTRAPPED}" == "true" ]]; then
        STEAM_FLAGS+=(-steamos3 -steampal -gamepadui)
    else
        echo "[hippos-steam] Steam first-run detected — launching in setup mode (gamepadui skipped)" >&2
        python3 - <<'PYEOF'
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib
win = Gtk.Window(title="Steam Setup")
win.set_default_size(520, 190)
win.set_position(Gtk.WindowPosition.CENTER)
win.set_resizable(False)
win.connect("destroy", Gtk.main_quit)
box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
box.set_margin_top(28); box.set_margin_bottom(28)
box.set_margin_start(36); box.set_margin_end(36)
win.add(box)
title = Gtk.Label()
title.set_markup("<b><big>Steam First-Time Setup</big></b>")
box.pack_start(title, False, False, 0)
body = Gtk.Label()
body.set_markup(
    "Steam needs to complete initial setup before Big Picture mode can be used.\n\n"
    "Please <b>log in to Steam</b> in the window that follows.\n"
    "Big Picture mode will activate automatically on next launch."
)
body.set_line_wrap(True)
body.set_justify(Gtk.Justification.CENTER)
box.pack_start(body, True, True, 0)
btn = Gtk.Button(label="OK")
btn.connect("clicked", lambda *_: Gtk.main_quit())
box.pack_start(btn, False, False, 0)
win.show_all()
GLib.timeout_add_seconds(10, Gtk.main_quit)
Gtk.main()
PYEOF
    fi
fi

# Overlay injection
declare -a ENV_PREFIX=()
[[ "$(get global.mangohud)" == "true" ]] && ENV_PREFIX+=(MANGOHUD=1)
[[ "$(get global.vkbasalt)" == "true" ]] && ENV_PREFIX+=(ENABLE_VKBASALT=1)

steam_running() {
    pgrep -u hippos -f '(^|/)(steam|steamwebhelper)( |$)' >/dev/null 2>&1
}

set +e
# SDL_JOYSTICK_HIDAPI=0: prevent double-detection of controllers via HIDAPI+evdev,
# which causes Steam Input's desktop config to intercept mouse clicks on UI elements.
# XDG_SESSION_TYPE=x11: ensures Steam uses X11 input handling, not Wayland fallback.
ENV_PREFIX+=(
    SDL_JOYSTICK_HIDAPI=0
    XDG_SESSION_TYPE=x11
)
env "${ENV_PREFIX[@]}" steam "${STEAM_FLAGS[@]}" "$@"
status=$?
set -e

for _ in {1..30}; do
    steam_running && break
    sleep 1
done

# steamwebhelper is designed to outlive the main window closing (background
# updates, friends list, overlay) — this can't use a short timeout without
# risking cutting off a game that's still genuinely being played. The real
# exit path is the controller hotkey (contexts/steam.json runs `steam
# -shutdown` directly, since Alt+F4 only closes Steam's window rather than
# quitting the client — confirmed real-world: tangocat, antaeusdk hit a
# black screen with no way back to ES after Alt+F4 alone). This loop is
# only the fallback once that's actually been used; the bound below exists
# purely so a genuinely stuck/orphaned helper can never wedge the display
# forever requiring a hard reboot, not as a way to end a real session.
STEAM_WAIT_LIMIT=$((12 * 60 * 60))  # 12h
elapsed=0
while steam_running; do
    sleep 5
    elapsed=$((elapsed + 5))
    if [[ ${elapsed} -ge ${STEAM_WAIT_LIMIT} ]]; then
        echo "[hippos-steam] steamwebhelper still running after ${STEAM_WAIT_LIMIT}s — returning control without killing it" >&2
        break
    fi
done

/usr/lib/hippos/hippos-steam-sync sync >/userdata/system/logs/steam-sync.log 2>&1 || true
exit "${status}"
