[Unit]
Description=Watch for Quiver Launcher app installs/removals
After=local-fs.target userdata.mount

[Path]
PathChanged=/userdata/.var/app/io.github.tgeorgiadis.QuiverLauncher/data/QuiverLauncher/Apps
PathModified=/userdata/.var/app/io.github.tgeorgiadis.QuiverLauncher/data/QuiverLauncher/apps.json
Unit=hippos-quiver-sync.service

[Install]
WantedBy=multi-user.target
