[Unit]
Description=HippOS Quiver Launcher library sync
After=local-fs.target userdata.mount
Wants=userdata.mount
# Quiver can install or remove several apps in quick succession.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/hippos/hippos-quiver-sync
Nice=10

[Install]
WantedBy=multi-user.target
