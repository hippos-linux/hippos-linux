<?xml version="1.0" encoding="UTF-8"?>
<!--
Theme: HippOS
World artwork, chrome and layout are generated by tools/generate-theme-art.py.
System logos in art/ come from es-theme-minimal by Lilbud / crcerror (CC-BY-NC-SA).
Sora font: SIL Open Font License, see assets/fonts/OFL.txt.
-->
<theme defaultView="detailed">
  <formatVersion>7</formatVersion>

  <variables>
    <ink>07060F</ink>
    <brandPurple>7B3FFF</brandPurple>
    <brandBlue>1A6FFF</brandBlue>
    <textPrimary>F4F1FF</textPrimary>
    <textSecondary>C8C2E0</textSecondary>
    <textMuted>8F88AE</textMuted>
    <accentText>B79CFF</accentText>
    <fontLight>./assets/fonts/Sora-Light.ttf</fontLight>
    <fontRegular>./assets/fonts/Sora-Regular.ttf</fontRegular>
    <fontStrong>./assets/fonts/Sora-SemiBold.ttf</fontStrong>
    <fontDisplay>./assets/fonts/Sora-ExtraBold.ttf</fontDisplay>
  </variables>

  <view name="splash">
    <image name="background">
      <path>./assets/splash.jpg</path>
      <linearSmooth>true</linearSmooth>
    </image>
    <text name="label">
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.02</fontSize>
      <color>${textSecondary}</color>
    </text>
    <image name="progressbar">
      <color>${brandPurple}</color>
      <colorEnd>${brandBlue}</colorEnd>
      <gradientType>horizontal</gradientType>
    </image>
    <splash name="splash">
      <backgroundColor>${ink}</backgroundColor>
    </splash>
  </view>

  <view name="screen">
    <text name="clock">
      <pos>0.872 0.0100</pos>
      <size>0.09 0.04</size>
      <fontPath>${fontStrong}</fontPath>
      <fontSize>0.023</fontSize>
      <color>${textPrimary}</color>
      <horizontalAlignment>right</horizontalAlignment>
      <verticalAlignment>center</verticalAlignment>
    </text>
    <controllerActivity name="controllerActivity">
      <pos>0.74 0.016</pos>
      <size>0.13 0.028</size>
      <horizontalAlignment>right</horizontalAlignment>
      <itemSpacing>0.004</itemSpacing>
      <imagePath>./assets/gamepad.svg</imagePath>
      <color>FFFFFF70</color>
      <activityColor>${accentText}</activityColor>
      <hotkeyColor>6B9BFF</hotkeyColor>
    </controllerActivity>
  </view>

  <view name="menu">
    <menuBackground name="menubg">
      <path>./assets/menu-frame.png</path>
      <cornerSize>32 32</cornerSize>
      <color>0D0A1CFF</color>
      <scrollbarColor>${brandPurple}</scrollbarColor>
      <scrollbarSize>0.004</scrollbarSize>
      <scrollbarCorner>0.5</scrollbarCorner>
    </menuBackground>
    <menuText name="menutitle">
      <fontPath>${fontDisplay}</fontPath>
      <fontSize>0.032</fontSize>
      <color>${textPrimary}</color>
    </menuText>
    <menuText name="menufooter">
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.017</fontSize>
      <color>${textMuted}</color>
    </menuText>
    <menuText name="menutext">
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.021</fontSize>
      <color>${textSecondary}</color>
      <selectorColor>${brandPurple}</selectorColor>
      <selectorColorEnd>${brandBlue}</selectorColorEnd>
      <selectedColor>FFFFFF</selectedColor>
      <separatorColor>FFFFFF12</separatorColor>
    </menuText>
    <menuTextSmall name="menutextsmall">
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.015</fontSize>
      <color>${textMuted}</color>
    </menuTextSmall>
  </view>

  <view name="system">
    <helpsystem name="help">
      <textColor>FFFFFFB0</textColor>
      <iconColor>FFFFFFB0</iconColor>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.019</fontSize>
    </helpsystem>

    <!-- Scales around the flare, so the pulsing sprite stays on the planet's limb. -->
    <image name="world" extra="true">
      <path>./worlds/${system.theme}.jpg</path>
      <default>./worlds/default.jpg</default>
      <pos>0.5 0.5</pos>
      <origin>0.5 0.5</origin>
      <minSize>1 1</minSize>
      <linearSmooth>true</linearSmooth>
      <zIndex>0</zIndex>
      <scaleOrigin>0.543 0.478</scaleOrigin>
      <storyboard event="activate" repeat="forever" autoReverse="true">
        <animation property="scale" from="1" to="1.05" duration="38000" mode="EaseInOut"/>
      </storyboard>
    </image>
    <image name="flare" extra="true">
      <path>./assets/flare.png</path>
      <pos>0.543 0.478</pos>
      <origin>0.5 0.5</origin>
      <size>0.40 0.71</size>
      <linearSmooth>true</linearSmooth>
      <zIndex>1</zIndex>
      <storyboard event="activate" repeat="forever" autoReverse="true">
        <animation property="opacity" from="0.15" to="0.85" duration="5200" mode="EaseInOut"/>
      </storyboard>
    </image>
    <image name="floor" extra="true">
      <path>./assets/white.png</path>
      <pos>0 0.56</pos>
      <size>1 0.44</size>
      <color>07060F00</color>
      <colorEnd>07060FF8</colorEnd>
      <gradientType>vertical</gradientType>
      <zIndex>2</zIndex>
    </image>
    <image name="wordmark" extra="true">
      <path>./assets/wordmark.png</path>
      <pos>0.045 0.018</pos>
      <maxSize>0.105 0.032</maxSize>
      <linearSmooth>true</linearSmooth>
      <zIndex>3</zIndex>
    </image>

    <text name="eyebrow" extra="true">
      <text>${system.manufacturer}</text>
      <pos>0.045 0.492</pos>
      <size>0.46 0.04</size>
      <fontPath>${fontStrong}</fontPath>
      <fontSize>0.022</fontSize>
      <color>${accentText}</color>
      <forceUppercase>true</forceUppercase>
      <zIndex>3</zIndex>
      <storyboard event="activate">
        <animation property="opacity" from="0" to="1" duration="500" mode="EaseOut"/>
      </storyboard>
    </text>
    <text name="title" extra="true">
      <text>${system.fullName}</text>
      <pos>0.045 0.235</pos>
      <size>0.43 0.255</size>
      <fontPath>${fontDisplay}</fontPath>
      <fontSize>0.066</fontSize>
      <lineSpacing>1.08</lineSpacing>
      <color>FFFFFF</color>
      <verticalAlignment>bottom</verticalAlignment>
      <zIndex>3</zIndex>
      <storyboard event="activate">
        <animation property="opacity" from="0" to="1" duration="520" mode="EaseOut"/>
        <animation property="offsetX" from="-0.018" to="0" duration="640" mode="EaseOutCubic"/>
      </storyboard>
    </text>
    <text name="systemInfo">
      <pos>0.045 0.532</pos>
      <size>0.46 0.04</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.023</fontSize>
      <color>${textSecondary}</color>
      <backgroundColor>00000000</backgroundColor>
      <alignment>left</alignment>
      <zIndex>3</zIndex>
    </text>

    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0 0.70</pos>
      <size>1 0.205</size>
      <color>00000000</color>
      <logoScale>1.3</logoScale>
      <logoSize>0.125 0.08</logoSize>
      <maxLogoCount>6</maxLogoCount>
      <minLogoOpacity>0.42</minLogoOpacity>
      <defaultTransition>fade</defaultTransition>
      <transitionSpeed>520</transitionSpeed>
      <scrollSound>./assets/sounds/scroll.wav</scrollSound>
      <zIndex>4</zIndex>
    </carousel>
    <image name="logo">
      <path>./art/${system.theme}.svg</path>
      <color>FFFFFF</color>
      <linearSmooth>true</linearSmooth>
    </image>
    <text name="logoText">
      <fontPath>${fontDisplay}</fontPath>
      <fontSize>0.042</fontSize>
      <color>FFFFFF</color>
    </text>
  </view>

  <view name="video, basic, detailed, grid">
    <sound name="back"><path>./assets/sounds/back.wav</path></sound>
    <sound name="launch"><path>./assets/sounds/launch.wav</path></sound>
    <sound name="menuOpen"><path>./assets/sounds/menu.wav</path></sound>

    <helpsystem name="help">
      <textColor>FFFFFFB0</textColor>
      <iconColor>FFFFFFB0</iconColor>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.019</fontSize>
    </helpsystem>

    <image name="world" extra="true">
      <path>./worlds/${system.theme}.jpg</path>
      <default>./worlds/default.jpg</default>
      <pos>0.5 0.5</pos>
      <origin>0.5 0.5</origin>
      <minSize>1 1</minSize>
      <color>D0CCDC</color>
      <linearSmooth>true</linearSmooth>
      <zIndex>0</zIndex>
    </image>
    <image name="listShade" extra="true">
      <path>./assets/white.png</path>
      <pos>0 0</pos>
      <size>0.56 1</size>
      <color>07060FF0</color>
      <colorEnd>07060F00</colorEnd>
      <gradientType>horizontal</gradientType>
      <zIndex>1</zIndex>
    </image>
    <image name="floor" extra="true">
      <path>./assets/white.png</path>
      <pos>0 0.52</pos>
      <size>1 0.48</size>
      <color>07060F00</color>
      <colorEnd>07060FF6</colorEnd>
      <gradientType>vertical</gradientType>
      <zIndex>1</zIndex>
    </image>
    <image name="systemLogo" extra="true">
      <path>./art/${system.theme}.svg</path>
      <default>./assets/wordmark.png</default>
      <pos>0.045 0.052</pos>
      <maxSize>0.17 0.07</maxSize>
      <color>FFFFFF</color>
      <linearSmooth>true</linearSmooth>
      <zIndex>3</zIndex>
    </image>
    <text name="logoText">
      <visible>false</visible>
    </text>
    <image name="logo">
      <visible>false</visible>
    </image>
    <text name="gameCount" extra="true">
      <text>LIBRARY  {system:total}</text>
      <pos>0.045 0.13</pos>
      <size>0.30 0.03</size>
      <fontPath>${fontStrong}</fontPath>
      <fontSize>0.017</fontSize>
      <color>${accentText}</color>
      <zIndex>3</zIndex>
    </text>
    <text name="md_lbl_rating, md_lbl_players, md_lbl_genre, md_lbl_developer, md_lbl_publisher, md_lbl_releasedate, md_lbl_lastplayed, md_lbl_playcount, md_lbl_gametime">
      <visible>false</visible>
    </text>
    <text name="md_publisher, md_playcount, md_gametime">
      <visible>false</visible>
    </text>
    <datetime name="md_lastplayed">
      <visible>false</visible>
    </datetime>
  </view>

  <view name="video, basic, detailed">
    <textlist name="gamelist">
      <pos>0.033 0.185</pos>
      <size>0.40 0.70</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.025</fontSize>
      <lineSpacing>2.0</lineSpacing>
      <alignment>left</alignment>
      <horizontalMargin>0.014</horizontalMargin>
      <primaryColor>${textSecondary}</primaryColor>
      <secondaryColor>${accentText}</secondaryColor>
      <selectedColor>FFFFFF</selectedColor>
      <selectorColor>${brandPurple}</selectorColor>
      <selectorColorEnd>${brandBlue}00</selectorColorEnd>
      <selectorGradientType>horizontal</selectorGradientType>
      <scrollSound>./assets/sounds/scroll.wav</scrollSound>
      <zIndex>3</zIndex>
    </textlist>
  </view>

  <view name="detailed, video">
    <video name="md_video">
      <pos>0.735 0.335</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.46 0.46</maxSize>
      <delay>0.9</delay>
      <roundCorners>0.012</roundCorners>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <snapshotSource>image</snapshotSource>
      <defaultSnapshot>./assets/no-art.jpg</defaultSnapshot>
      <effect>none</effect>
      <zIndex>4</zIndex>
    </video>
    <!-- md_video already falls back to this image; showing both misaligns them on non-16:9 screens. -->
    <image name="md_image, md_marquee, md_thumbnail">
      <visible>false</visible>
    </image>
    <text name="md_name">
      <visible>true</visible>
      <pos>0.505 0.595</pos>
      <size>0.46 0.06</size>
      <fontPath>${fontDisplay}</fontPath>
      <fontSize>0.038</fontSize>
      <color>FFFFFF</color>
      <singleLineScroll>true</singleLineScroll>
      <alignment>left</alignment>
      <zIndex>5</zIndex>
    </text>
    <datetime name="md_releasedate">
      <visible>true</visible>
      <pos>0.505 0.655</pos>
      <size>0.06 0.03</size>
      <format>%Y</format>
      <fontPath>${fontStrong}</fontPath>
      <fontSize>0.019</fontSize>
      <color>${accentText}</color>
      <alignment>left</alignment>
      <zIndex>5</zIndex>
    </datetime>
    <text name="md_genre">
      <visible>true</visible>
      <pos>0.565 0.655</pos>
      <size>0.17 0.03</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.019</fontSize>
      <color>${textSecondary}</color>
      <singleLineScroll>true</singleLineScroll>
      <alignment>left</alignment>
      <zIndex>5</zIndex>
    </text>
    <text name="md_developer">
      <visible>true</visible>
      <pos>0.735 0.655</pos>
      <size>0.14 0.03</size>
      <fontPath>${fontRegular}</fontPath>
      <fontSize>0.019</fontSize>
      <color>${textSecondary}</color>
      <singleLineScroll>true</singleLineScroll>
      <alignment>left</alignment>
      <zIndex>5</zIndex>
    </text>
    <text name="md_players">
      <visible>false</visible>
    </text>
    <rating name="md_rating">
      <visible>true</visible>
      <pos>0.965 0.670</pos>
      <origin>1 0.5</origin>
      <size>0.085 0.019</size>
      <color>FFFFFF</color>
      <unfilledColor>FFFFFF30</unfilledColor>
      <zIndex>5</zIndex>
    </rating>
    <text name="md_description">
      <pos>0.505 0.705</pos>
      <size>0.46 0.18</size>
      <fontPath>${fontLight}</fontPath>
      <fontSize>0.019</fontSize>
      <lineSpacing>1.5</lineSpacing>
      <color>${textSecondary}</color>
      <alignment>left</alignment>
      <verticalAlignment>top</verticalAlignment>
      <autoScroll>vertical</autoScroll>
      <autoScrollDelay>3000</autoScrollDelay>
      <zIndex>5</zIndex>
    </text>
  </view>

  <view name="grid">
    <imagegrid name="gamegrid">
      <pos>0.033 0.205</pos>
      <size>0.934 0.70</size>
      <margin>0.012 0.022</margin>
      <autoLayout>5 2</autoLayout>
      <autoLayoutSelectedZoom>1.06</autoLayoutSelectedZoom>
      <animateSelection>true</animateSelection>
      <scrollDirection>vertical</scrollDirection>
      <scrollSound>./assets/sounds/scroll.wav</scrollSound>
      <zIndex>3</zIndex>
    </imagegrid>
    <gridtile name="default">
      <backgroundColor>FFFFFF00</backgroundColor>
      <selectionMode>image</selectionMode>
      <padding>6 6</padding>
      <imageColor>FFFFFFB8</imageColor>
    </gridtile>
    <gridtile name="selected">
      <backgroundColor>${brandPurple}</backgroundColor>
      <imageColor>FFFFFFFF</imageColor>
    </gridtile>
    <text name="md_name">
      <visible>true</visible>
      <pos>0.33 0.052</pos>
      <size>0.50 0.05</size>
      <fontPath>${fontDisplay}</fontPath>
      <fontSize>0.03</fontSize>
      <color>FFFFFF</color>
      <singleLineScroll>true</singleLineScroll>
      <alignment>left</alignment>
      <zIndex>5</zIndex>
    </text>
    <text name="md_description, md_genre, md_developer, md_players">
      <visible>false</visible>
    </text>
    <datetime name="md_releasedate">
      <visible>false</visible>
    </datetime>
    <rating name="md_rating">
      <visible>false</visible>
    </rating>
    <image name="md_image">
      <visible>false</visible>
    </image>
    <video name="md_video">
      <visible>false</visible>
    </video>
  </view>
</theme>
